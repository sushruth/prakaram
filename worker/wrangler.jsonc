{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prakaram-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prakaram-db",
      "database_id": "prakaram-d1-preview-id"
    }
  ],
  "vars": {
    "RP_NAME": "Prakaram Vedic Companion",
    "RP_ID": "localhost",
    "EXPECTED_ORIGIN": "http://localhost:5173",
    "JWT_SECRET": "vedic-prakaram-super-secret-key-32-chars-minimum"
  }
}
