{
  "id": "ganapati-prarthana",
  "title": {
    "sanskrit": "गणपति प्रार्थना",
    "transliteration": "Gaṇapati Prārthanā",
    "english": "Invocation to Lord Ganapati"
  },
  "metadata": {
    "veda": "Rigveda Samhita 2.23.1 & Atharvaveda",
    "source": "Saswara Veda Mantrah (Ramakrishna Math)",
    "rishi": "Gritsamada Shaunaka",
    "devata": "Brihaspati / Ganapati",
    "chandas": "Jagati (48 syllables)"
  },
  "sections": [
    {
      "id": "ganapati-1",
      "title": "Gananam Tva (Rigveda 2.23.1)",
      "sectionNumber": 1,
      "chunks": [
        {
          "id": "gp-1",
          "chunkNumber": 1,
          "sanskrit": "ॐ ग॒णानां᳚ त्वा ग॒णप॑तिं हवामहे",
          "translation": "Om, we invoke Thee, the Lord of celestial hosts."
        },
        {
          "id": "gp-2",
          "chunkNumber": 2,
          "sanskrit": "क॒विं क॑वी॒नामु॑प॒मश्र॑वस्तमम् ।",
          "translation": "The Supreme Seer among seers, bestower of highest fame."
        },
        {
          "id": "gp-3",
          "chunkNumber": 3,
          "sanskrit": "ज्ये॒ष्ठ॒राजं॒ ब्रह्म॑णां ब्रह्मणस्पत॒",
          "translation": "The King of sacred mantras, Lord of the cosmos."
        },
        {
          "id": "gp-4",
          "chunkNumber": 4,
          "sanskrit": "आ नः॑ शृ॒ण्वन्नू॒तिभिः॑ सीद॒ साद॑नम् ॥",
          "translation": "Hear our prayers and be seated gracefully in our sacrificial home."
        },
        {
          "id": "gp-5",
          "chunkNumber": 5,
          "sanskrit": "प्रणो॑ दे॒वी सर॑स्वती॒ वाजे॑भिर्वा॒जिनी॑वती । धी॒नाम॑वि॒त्र्य॑वतु ॥",
          "translation": "May Goddess Saraswati, rich in wisdom and nourishment, protect and inspire our intellect."
        },
        {
          "id": "gp-6",
          "chunkNumber": 6,
          "sanskrit": "श्री म॑हाग॒णप॑तये॒ नमः॑ ॥",
          "translation": "Salutations to the Supreme Lord Ganesha."
        }
      ]
    }
  ]
}
