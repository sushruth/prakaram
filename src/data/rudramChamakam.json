        {
          "id": "rc-10-13",
          "chunkNumber": 147,
          "sanskrit": "चक्षु॑र्य॒ज्ञेन॑ कल्पता॒ग्॒ श्रोत्रं॑-यँ॒ज्ञेन॑ कल्पतां॒"
        },
        {
          "id": "rc-10-14",
          "chunkNumber": 148,
          "sanskrit": "मनो॑ य॒ज्ञेन॑ कल्पतां॒"
