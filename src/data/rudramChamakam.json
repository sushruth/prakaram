        {
          "id": "rc-7-5",
          "chunkNumber": 106,
          "sanskrit": "शु॒क्रश्च॑ मे मं॒थी च॑ म"
        },
        {
          "id": "rc-7-6",
          "chunkNumber": 107,
          "sanskrit": "आग्रय॒णश्च॑ मे वैश्वदे॒वश्च॑ मे"
        },
        {
          "id": "rc-7-7",
          "chunkNumber": 108,
          "sanskrit": "ध्रु॒वश्च॑ मे वैश्वान॒रश्च॑ म"
        },
        {
          "id": "rc-7-8",
          "chunkNumber": 109,
          "sanskrit": "ऋतुग्र॒हाश्च॑ मेऽतिग्रा॒ह्या᳚श्च म"
        },
        {
          "id": "rc-7-9",
          "chunkNumber": 110,
          "sanskrit": "ऐंद्रा॒ग्नश्च॑ मे वैश्वदे॒वश्च॑ मे"
        },
        {
          "id": "rc-7-10",
          "chunkNumber": 111,
          "sanskrit": "मरुत्व॒तीया᳚श्च मे माहें॒द्रश्च॑ म"
        },
        {
          "id": "rc-7-11",
          "chunkNumber": 112,
          "sanskrit": "आदि॒त्यश्च॑ मे सावि॒त्रश्च॑ मे"
