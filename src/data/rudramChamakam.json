        {
          "id": "rc-9-5",
          "chunkNumber": 129,
          "sanskrit": "य॒ज्ञेन॑ कल्पंता॒मृक्च॑ मे॒"
        },
        {
          "id": "rc-9-6",
          "chunkNumber": 130,
          "sanskrit": "साम॑ च मे॒ स्तोम॑श्च मे॒"
        },
        {
          "id": "rc-9-7",
          "chunkNumber": 131,
          "sanskrit": "यजु॑श्च मे दी॒क्षा च॑ मे॒"
        },
        {
          "id": "rc-9-8",
          "chunkNumber": 132,
          "sanskrit": "तप॑श्च म ऋ॒तुश्च॑ मे"
        },
        {
          "id": "rc-9-9",
          "chunkNumber": 133,
          "sanskrit": "व्र॒तं च॑ मेऽहोरा॒त्रयो᳚र्वृ॒ष्ट्या बृ॑हद्रथंत॒रे च॑ मे"
        },
        {
          "id": "rc-9-10",
          "chunkNumber": 134,
          "sanskrit": "य॒ज्ञेन॑ कल्पेताम् ॥ ९ ॥"
        }
      ]
    },
    {
      "id": "rudram-chamakam-10",
      "title": "Anuvaka 10",
      "sectionNumber": 10,
      "chunks": [
        {
          "id": "rc-10-1",
          "chunkNumber": 135,
          "sanskrit": "गर्भा᳚श्च मे व॒त्साश्च॑ मे॒"
        },
        {
          "id": "rc-10-2",
          "chunkNumber": 136,
          "sanskrit": "त्र्यवि॑श्च मे त्र्य॒वीच॑ मे"
