          "id": "rc-5-8",
          "chunkNumber": 77,
          "sanskrit": "कृष्टप॒च्यं च॑ मेऽकृष्टप॒च्यं च॑ मे"
        },
        {
          "id": "rc-5-9",
          "chunkNumber": 78,
          "sanskrit": "ग्रा॒म्याश्च॑ मे प॒शव॑ आर॒ण्याश्च॑ य॒ज्ञेन॑ कल्पंतां"
        },
        {
          "id": "rc-5-10",
          "chunkNumber": 79,
          "sanskrit": "वि॒त्तं च॑ मे॒ वित्ति॑श्च मे"
        },
        {
          "id": "rc-5-11",
          "chunkNumber": 80,
          "sanskrit": "भू॒तं च॑ मे॒ भूति॑श्च मे॒"
        },
        {
          "id": "rc-5-12",
          "chunkNumber": 81,
          "sanskrit": "वसु॑ च मे वस॒तिश्च॑ मे॒"
        },
        {
          "id": "rc-5-13",
          "chunkNumber": 82,
          "sanskrit": "कर्म॑ च मे॒ शक्ति॑श्च॒ मेऽर्थ॑श्च म॒"
        },
        {
          "id": "rc-5-14",
          "chunkNumber": 83,
          "sanskrit": "एम॑श्च म॒ इति॑श्च मे॒ गति॑श्च मे ॥ ५ ॥"
        }
      ]
    },
    {
      "id": "rudram-chamakam-6",
      "title": "Anuvaka 6",
      "sectionNumber": 6,
      "chunks": [
        {
          "id": "rc-6-1",
          "chunkNumber": 84,
          "sanskrit": "अ॒ग्निश्च॑ म॒ इंद्र॑श्च मे॒"
        },
        {
          "id": "rc-6-2",
          "chunkNumber": 85,
          "sanskrit": "सोम॑श्च म॒ इंद्र॑श्च मे"
