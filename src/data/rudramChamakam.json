          "id": "rc-4-7",
          "chunkNumber": 59,
          "sanskrit": "र॒यिश्च॑ मे॒ राय॑श्च मे"
        },
        {
          "id": "rc-4-8",
          "chunkNumber": 60,
          "sanskrit": "पु॒ष्टं च॑ मे॒ पुष्टि॑श्च मे"
        },
        {
          "id": "rc-4-9",
          "chunkNumber": 61,
          "sanskrit": "वि॒भु च॑ मे प्र॒भु च॑ मे"
        },
        {
          "id": "rc-4-10",
          "chunkNumber": 62,
          "sanskrit": "ब॒हु च॑ मे॒ भूय॑श्च मे"
        },
        {
          "id": "rc-4-11",
          "chunkNumber": 63,
          "sanskrit": "पू॒र्णं च॑ मे पू॒र्णत॑रं च॒ मेऽक्षि॑तिश्च मे॒ कूय॑वाश्च॒ मेऽन्नं॑ च॒ मेऽक्षु॑च्च मे"
        },
        {
          "id": "rc-4-12",
          "chunkNumber": 64,
          "sanskrit": "व्री॒हय॑श्च मे॒ यवा᳚श्च मे॒"
        },
        {
          "id": "rc-4-13",
          "chunkNumber": 65,
          "sanskrit": "माषा᳚श्च मे॒ तिला᳚श्च मे"
        },
        {
          "id": "rc-4-14",
          "chunkNumber": 66,
          "sanskrit": "मु॒द्गाश्च॑ मे ख॒ल्वा᳚श्च मे"
        },
        {
          "id": "rc-4-15",
          "chunkNumber": 67,
          "sanskrit": "गो॒धूमा᳚श्च मे म॒सुरा᳚श्च मे"
        },
        {
          "id": "rc-4-16",
          "chunkNumber": 68,
          "sanskrit": "प्रि॒यंग॑वश्च॒ मेऽण॑वश्च मे"
        },
        {
          "id": "rc-4-17",
          "chunkNumber": 69,
          "sanskrit": "श्या॒माका᳚श्च मे नी॒वारा᳚श्च मे ॥ ४ ॥"
        }
      ]
    },
    {
      "id": "rudram-chamakam-5",
      "title": "Anuvaka 5",
      "sectionNumber": 5,
      "chunks": [
        {
          "id": "rc-5-1",
          "chunkNumber": 70,
          "sanskrit": "अश्मा॑ च मे॒ मृत्ति॑का च मे"
        },
        {
          "id": "rc-5-2",
          "chunkNumber": 71,
          "sanskrit": "गि॒रय॑श्च मे॒ पर्व॑ताश्च मे॒"
        },
        {
          "id": "rc-5-3",
          "chunkNumber": 72,
          "sanskrit": "सिक॑ताश्च मे॒ वन॒स्पत॑यश्च मे॒"
        },
        {
          "id": "rc-5-4",
          "chunkNumber": 73,
          "sanskrit": "हिर॑ण्यं च॒ मेऽय॑श्च मे॒"
        },
