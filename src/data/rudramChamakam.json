        {
          "id": "rc-7-12",
          "chunkNumber": 113,
          "sanskrit": "सारस्व॒तश्च॑ मे पौ॒ष्णश्च॑ मे"
        },
        {
          "id": "rc-7-13",
          "chunkNumber": 114,
          "sanskrit": "पात्नीव॒तश्च॑ मे हारियोज॒नश्च॑ मे ॥ ७ ॥"
        }
      ]
    },
    {
      "id": "rudram-chamakam-8",
      "title": "Anuvaka 8",
      "sectionNumber": 8,
      "chunks": [
        {
          "id": "rc-8-1",
          "chunkNumber": 115,
          "sanskrit": "इ॒ध्मश्च॑ मे ब॒र्॒हिश्च॑ मे॒"
        },
        {
          "id": "rc-8-2",
          "chunkNumber": 116,
          "sanskrit": "वेदि॑श्च मे॒ धिष्णि॑याश्च मे॒"
        },
        {
          "id": "rc-8-3",
          "chunkNumber": 117,
          "sanskrit": "स्रुच॑श्च मे चम॒साश्च॑ मे॒"
        },
        {
          "id": "rc-8-4",
          "chunkNumber": 118,
          "sanskrit": "ग्रावा॑णश्च मे॒ स्वर॑वश्च म"
        },
        {
          "id": "rc-8-5",
          "chunkNumber": 119,
          "sanskrit": "उपर॒वाश्च॑ मेऽधि॒षव॑णे च मे"
        },
        {
          "id": "rc-8-6",
          "chunkNumber": 120,
          "sanskrit": "द्रोणकल॒शश्च॑ मे वाय॒व्या॑नि च मे"
        },
        {
          "id": "rc-8-7",
          "chunkNumber": 121,
          "sanskrit": "पूत॒भृच्च॑ म आधव॒नीय॑श्च म॒"
        },
        {
          "id": "rc-8-8",
          "chunkNumber": 122,
          "sanskrit": "आग्नी᳚ध्रं च मे हवि॒र्धानं॑ च मे"
        },
        {
          "id": "rc-8-9",
          "chunkNumber": 123,
          "sanskrit": "गृ॒हाश्च॑ मे॒ सद॑श्च मे पुरो॒डाशा᳚श्च मे"
        },
        {
          "id": "rc-8-10",
          "chunkNumber": 124,
          "sanskrit": "पच॒ताश्च॑ मेऽवभृ॒थश्च॑ मे स्वगाका॒रश्च॑ मे ॥ ८ ॥"
        }
      ]
    },
    {
      "id": "rudram-chamakam-9",
      "title": "Anuvaka 9",
      "sectionNumber": 9,
      "chunks": [
        {
          "id": "rc-9-1",
          "chunkNumber": 125,
          "sanskrit": "अ॒ग्निश्च॑ मे घ॒र्मश्च॑ मे॒ऽर्कश्च॑ मे॒"
