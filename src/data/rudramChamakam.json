      "sectionNumber": 7,
      "chunks": [
        {
          "id": "rc-7-1",
          "chunkNumber": 102,
          "sanskrit": "अ॒ग्ं॒शुश्च॑ मे र॒श्मिश्च॒ मेऽदा᳚भ्यश्च॒ मेऽधि॑पतिश्च म"
        },
        {
          "id": "rc-7-2",
          "chunkNumber": 103,
          "sanskrit": "उपा॒ग्ं॒शुश्च॑ मेऽंतर्या॒मश्च॑ म"
