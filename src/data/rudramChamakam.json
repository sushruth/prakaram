          "id": "rc-11-16",
          "chunkNumber": 166,
          "sanskrit": "व्यश्नि॑यश्चांत्याय॒नश्चांत्य॑श्च"
        },
        {
          "id": "rc-11-17",
          "chunkNumber": 167,
          "sanskrit": "भौव॒नश्च॒ भुव॑न॒श्चाधि॑पतिश्च ॥ ११ ॥"
        }
      ]
    },
    {
      "id": "rudram-chamakam-12",
      "title": "Concluding mantras",
      "sectionNumber": 12,
      "chunks": [
        {
          "id": "rc-12-1",
          "chunkNumber": 168,
          "sanskrit": "ॐ इडा॑ देव॒हू-र्मनु॑र्यज्ञ॒नी-र्बृह॒स्पति॑रुक्थाम॒दानि॑"
        },
        {
          "id": "rc-12-2",
          "chunkNumber": 169,
          "sanskrit": "शग्ंसिष॒द्विश्वे॑ दे॒वाः सू᳚क्त॒वाचः॒ पृथि॑विमात॒र्मा"
        },
        {
          "id": "rc-12-3",
          "chunkNumber": 170,
          "sanskrit": "मा॑ हिग्ंसी॒र्मधु॑ मनिष्ये॒ मधु॑ जनिष्ये॒"
        },
        {
          "id": "rc-12-4",
          "chunkNumber": 171,
          "sanskrit": "मधु॑ वक्ष्यामि॒ मधु॑ वदिष्यामि॒"
        },
        {
          "id": "rc-12-5",
          "chunkNumber": 172,
          "sanskrit": "मधु॑मतीं दे॒वेभ्यो॒ वाच॒मुद्यासग्ंशुश्रूषे॒ण्यां᳚"
        },
        {
          "id": "rc-12-6",
          "chunkNumber": 173,
          "sanskrit": "मनु॒ष्ये᳚भ्य॒स्तं"
        },
        {
          "id": "rc-12-7",
          "chunkNumber": 174,
          "sanskrit": "मा॑ दे॒वा अ॑वंतु शो॒भायै॑ पि॒तरोऽनु॑मदंतु ॥"
        },
        {
          "id": "rc-12-8",
          "chunkNumber": 175,
          "sanskrit": "ॐ शांतिः॒ शांतिः॒ शांतिः॑ ॥"
        }
      ]
    }
