  "sections": [
    {
      "id": "rudram-chamakam-1",
      "title": "Anuvaka 1",
      "sectionNumber": 1,
      "chunks": [
        {
          "id": "rc-1-1",
          "chunkNumber": 1,
          "sanskrit": "ॐ अग्ना॑विष्णू स॒जोष॑से॒माव॑र्धंतु वां॒ गिरः॑ ।"
        },
        {
          "id": "rc-1-2",
          "chunkNumber": 2,
          "sanskrit": "द्यु॒म्नैर्वाजे॑भि॒राग॑तम् ।"
        },
        {
          "id": "rc-1-3",
          "chunkNumber": 3,
          "sanskrit": "वाज॑श्च मे प्रस॒वश्च॑ मे॒"
        },
        {
          "id": "rc-1-4",
          "chunkNumber": 4,
          "sanskrit": "प्रय॑तिश्च मे॒ प्रसि॑तिश्च मे"
        },
        {
          "id": "rc-1-5",
          "chunkNumber": 5,
          "sanskrit": "धी॒तिश्च॑ मे॒ क्रतु॑श्च मे॒"
        },
        {
          "id": "rc-1-6",
          "chunkNumber": 6,
          "sanskrit": "स्वर॑श्च मे॒ श्लोक॑श्च मे"
        },
        {
          "id": "rc-1-7",
          "chunkNumber": 7,
          "sanskrit": "श्रा॒वश्च॑ मे॒ श्रुति॑श्च मे॒"
        },
        {
          "id": "rc-1-8",
          "chunkNumber": 8,
          "sanskrit": "ज्योति॑श्च मे॒ सुव॑श्च मे"
        },
        {
          "id": "rc-1-9",
          "chunkNumber": 9,
          "sanskrit": "प्रा॒णश्च॑ मेऽपा॒नश्च॑ मे"
        },
        {
          "id": "rc-1-10",
          "chunkNumber": 10,
          "sanskrit": "व्या॒नश्च॒ मेऽसु॑श्च मे"
        },
        {
          "id": "rc-1-11",
          "chunkNumber": 11,
          "sanskrit": "चि॒त्तं च॑ म॒ आधी॑तं च मे॒"
        },
        {
          "id": "rc-1-12",
          "chunkNumber": 12,
          "sanskrit": "वाक्च॑ मे॒ मन॑श्च मे॒"
        },
        {
          "id": "rc-1-13",
          "chunkNumber": 13,
          "sanskrit": "चक्षु॑श्च मे॒ श्रोत्रं॑ च मे॒"
        },
        {
          "id": "rc-1-14",
          "chunkNumber": 14,
          "sanskrit": "दक्ष॑श्च मे॒ बलं॑ च म॒"
        },
        {
          "id": "rc-1-15",
          "chunkNumber": 15,
          "sanskrit": "ओज॑श्च मे॒ सह॑श्च म॒"
        },
        {
          "id": "rc-1-16",
          "chunkNumber": 16,
          "sanskrit": "आयु॑श्च मे ज॒रा च॑ म"
        },
        {
          "id": "rc-1-17",
          "chunkNumber": 17,
          "sanskrit": "आ॒त्मा च॑ मे त॒नूश्च॑ मे॒"
        },
        {
          "id": "rc-1-18",
          "chunkNumber": 18,
          "sanskrit": "शर्म॑ च मे॒ वर्म॑ च॒ मेऽंगा॑नि च मे॒ऽस्थानि॑ च मे॒"
        },
        {
          "id": "rc-1-19",
          "chunkNumber": 19,
          "sanskrit": "परूग्ं॑षि च मे॒ शरी॑राणि च मे ॥ १ ॥"
        }
      ]
    },
    {
      "id": "rudram-chamakam-2",
      "title": "Anuvaka 2",
      "sectionNumber": 2,
      "chunks": [
        {
          "id": "rc-2-1",
          "chunkNumber": 20,
          "sanskrit": "जैष्ठ्यं॑ च म॒ आधि॑पत्यं च मे"
        },
        {
          "id": "rc-2-2",
          "chunkNumber": 21,
          "sanskrit": "म॒न्युश्च॑ मे॒ भाम॑श्च॒ मेऽम॑श्च॒ मेऽंभ॑श्च मे"
        },
        {
          "id": "rc-2-3",
          "chunkNumber": 22,
          "sanskrit": "जे॒मा च॑ मे महि॒मा च॑ मे"
        },
        {
          "id": "rc-2-4",
          "chunkNumber": 23,
          "sanskrit": "वरि॒मा च॑ मे प्रथि॒मा च॑ मे"
        },
        {
          "id": "rc-2-5",
          "chunkNumber": 24,
          "sanskrit": "व॒र्ष्मा च॑ मे द्राघु॒या च॑ मे"
        },
        {
          "id": "rc-2-6",
          "chunkNumber": 25,
          "sanskrit": "वृ॒द्धं च॑ मे॒ वृद्धि॑श्च मे"
        },
        {
          "id": "rc-2-7",
          "chunkNumber": 26,
          "sanskrit": "स॒त्यं च॑ मे श्र॒द्धा च॑ मे॒"
        },
        {
          "id": "rc-2-8",
          "chunkNumber": 27,
          "sanskrit": "जग॑च्च मे॒ धनं॑ च मे॒"
        },
        {
          "id": "rc-2-9",
          "chunkNumber": 28,
          "sanskrit": "वश॑श्च मे॒ त्विषि॑श्च मे"
        },
        {
          "id": "rc-2-10",
          "chunkNumber": 29,
          "sanskrit": "क्री॒डा च॑ मे॒ मोद॑श्च मे"
        },
        {
          "id": "rc-2-11",
          "chunkNumber": 30,
          "sanskrit": "जा॒तं च॑ मे जनि॒ष्यमा॑णं च मे"
        },
        {
          "id": "rc-2-12",
          "chunkNumber": 31,
          "sanskrit": "सू॒क्तं च॑ मे सुकृ॒तं च॑ मे"
        },
        {
          "id": "rc-2-13",
          "chunkNumber": 32,
          "sanskrit": "वि॒त्तं च॑ मे॒ वेद्यं॑ च मे"
        },
        {
          "id": "rc-2-14",
          "chunkNumber": 33,
          "sanskrit": "भू॒तं च॑ मे भवि॒ष्यच्च॑ मे"
        },
        {
          "id": "rc-2-15",
          "chunkNumber": 34,
          "sanskrit": "सु॒गं च॑ मे सु॒पथं॑ च म"
        },
        {
          "id": "rc-2-16",
          "chunkNumber": 35,
          "sanskrit": "ऋ॒द्धं च॑ म॒ ऋद्धि॑श्च मे"
        },
        {
          "id": "rc-2-17",
          "chunkNumber": 36,
          "sanskrit": "कॢ॒प्तं च॑ मे॒ कॢप्ति॑श्च मे"
        },
        {
          "id": "rc-2-18",
          "chunkNumber": 37,
          "sanskrit": "म॒तिश्च॑ मे सुम॒तिश्च॑ मे ॥ २ ॥"
        }
      ]
    },
    {
      "id": "rudram-chamakam-3",
      "title": "Anuvaka 3",
      "sectionNumber": 3,
      "chunks": [
        {
          "id": "rc-3-1",
          "chunkNumber": 38,
          "sanskrit": "शं च॑ मे॒ मय॑श्च मे"
        },
        {
          "id": "rc-3-2",
          "chunkNumber": 39,
          "sanskrit": "प्रि॒यं च॑ मेऽनुका॒मश्च॑ मे॒ काम॑श्च मे"
        },
        {
          "id": "rc-3-3",
          "chunkNumber": 40,
          "sanskrit": "सौमन॒सश्च॑ मे भ॒द्रं च॑ मे॒"
        },
        {
          "id": "rc-3-4",
          "chunkNumber": 41,
          "sanskrit": "श्रेय॑श्च मे॒ वस्य॑श्च मे॒"
        },
        {
          "id": "rc-3-5",
          "chunkNumber": 42,
          "sanskrit": "यश॑श्च मे॒ भग॑श्च मे॒ द्रवि॑णं च मे"
        },
        {
          "id": "rc-3-6",
          "chunkNumber": 43,
          "sanskrit": "यं॒ता च॑ मे ध॒र्ता च॑ मे॒"
        },
        {
          "id": "rc-3-7",
          "chunkNumber": 44,
          "sanskrit": "क्षेम॑श्च मे॒ धृति॑श्च मे॒"
        },
        {
          "id": "rc-3-8",
          "chunkNumber": 45,
          "sanskrit": "विश्वं॑ च मे॒ मह॑श्च मे"
        },
        {
          "id": "rc-3-9",
          "chunkNumber": 46,
          "sanskrit": "सं॒विँच्च॑ मे॒ ज्ञात्रं॑ च मे॒"
        },
        {
          "id": "rc-3-10",
          "chunkNumber": 47,
          "sanskrit": "सूश्च॑ मे प्र॒सूश्च॑ मे॒"
        },
        {
          "id": "rc-3-11",
          "chunkNumber": 48,
          "sanskrit": "सीरं॑ च मे ल॒यश्च॑ म"
        },
        {
          "id": "rc-3-12",
          "chunkNumber": 49,
          "sanskrit": "ऋ॒तं च॑ मे॒ऽमृतं॑ च मेऽय॒क्ष्मं च॒ मेऽना॑मयच्च मे"
        },
        {
          "id": "rc-3-13",
          "chunkNumber": 50,
          "sanskrit": "जी॒वातु॑श्च मे दीर्घायु॒त्वं च॑ मेऽनमि॒त्रं च॒ मेऽभ॑यं च मे"
        },
        {
          "id": "rc-3-14",
          "chunkNumber": 51,
          "sanskrit": "सु॒गं च॑ मे॒ शय॑नं च मे"
        },
        {
          "id": "rc-3-15",
          "chunkNumber": 52,
          "sanskrit": "सू॒षा च॑ मे सु॒दिनं॑ च मे ॥ ३ ॥"
        }
      ]
    },
    {
      "id": "rudram-chamakam-4",
      "title": "Anuvaka 4",
      "sectionNumber": 4,
      "chunks": [
        {
          "id": "rc-4-1",
          "chunkNumber": 53,
          "sanskrit": "ऊर्क्च॑ मे सू॒नृता॑ च मे॒"
        },
        {
          "id": "rc-4-2",
          "chunkNumber": 54,
          "sanskrit": "पय॑श्च मे॒ रस॑श्च मे"
        },
