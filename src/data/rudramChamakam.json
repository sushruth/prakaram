          "id": "rc-10-6",
          "chunkNumber": 140,
          "sanskrit": "तुर्य॒वाट् च॑ मे तुर्यौ॒ही च॑ मे"
        },
        {
          "id": "rc-10-7",
          "chunkNumber": 141,
          "sanskrit": "पष्ठ॒वाट् च॑ मे पष्ठौ॒ही च॑ म"
        },
