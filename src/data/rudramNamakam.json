  "sections": [
    {
      "id": "rudram-namakam-1",
      "title": "Anuvaka 1",
      "sectionNumber": 1,
      "chunks": [
        {
          "id": "rn-1-1",
          "chunkNumber": 1,
          "sanskrit": "ॐ नमो भगवते॑ रुद्रा॒य ॥"
        },
        {
          "id": "rn-1-2",
          "chunkNumber": 2,
          "sanskrit": "नम॑स्ते रुद्र म॒न्यव॑ उ॒तोत॒ इष॑वे॒ नमः॑ ।"
        },
        {
          "id": "rn-1-3",
          "chunkNumber": 3,
          "sanskrit": "नम॑स्ते अस्तु॒ धन्व॑ने बा॒हुभ्या॑मु॒त ते॒ नमः॑ ॥"
        },
        {
          "id": "rn-1-4",
          "chunkNumber": 4,
          "sanskrit": "या त॒ इषुः॑ शि॒वत॑मा शि॒वं ब॒भूव॑ ते॒ धनुः॑ ।"
        },
        {
          "id": "rn-1-5",
          "chunkNumber": 5,
          "sanskrit": "शि॒वा श॑र॒व्या॑ या तव॒ तया॑ नो रुद्र मृडय ।"
        },
        {
          "id": "rn-1-6",
          "chunkNumber": 6,
          "sanskrit": "या ते॑ रुद्र शि॒वा त॒नूरघो॒राऽपा॑पकाशिनी ।"
        },
        {
          "id": "rn-1-7",
          "chunkNumber": 7,
          "sanskrit": "तया॑ नस्त॒नुवा॒ शंत॑मया॒ गिरि॑शंता॒भिचा॑कशीहि ॥"
        },
        {
          "id": "rn-1-8",
          "chunkNumber": 8,
          "sanskrit": "यामिषुं॑ गिरिशंत॒ हस्ते॒ बिभ॒र्ष्यस्त॑वे ।"
        },
        {
          "id": "rn-1-9",
          "chunkNumber": 9,
          "sanskrit": "शि॒वां गि॑रित्र॒ तां कु॑रु॒ मा हिग्ं॑सीः॒ पुरु॑षं॒ जग॑त्॥"
        },
        {
          "id": "rn-1-10",
          "chunkNumber": 10,
          "sanskrit": "शि॒वेन॒ वच॑सा त्वा॒ गिरि॒शाच्छा॑ वदामसि ।"
        },
        {
          "id": "rn-1-11",
          "chunkNumber": 11,
          "sanskrit": "यथा॑ नः॒ सर्व॒मिज्जग॑दय॒क्ष्मग्ं सु॒मना॒ अस॑त् ॥"
        },
        {
          "id": "rn-1-12",
          "chunkNumber": 12,
          "sanskrit": "अध्य॑वोचदधिव॒क्ता प्र॑थ॒मो दैव्यो॑ भि॒षक् ।"
        },
        {
          "id": "rn-1-13",
          "chunkNumber": 13,
          "sanskrit": "अहीग्॑श्च॒ सर्वां᳚जं॒भय॒न्-थ्सर्वा᳚श्च यातुधा॒न्यः॑ ॥"
        },
        {
          "id": "rn-1-14",
          "chunkNumber": 14,
          "sanskrit": "अ॒सौ यस्ता॒म्रो अ॑रु॒ण उ॒त ब॒भ्रुस्सु॑मं॒गलः॑ ।"
        },
        {
          "id": "rn-1-15",
          "chunkNumber": 15,
          "sanskrit": "ये चे॒माग्ं रु॒द्रा अ॒भितो॑ दि॒क्षु श्रि॒ताः स॑हस्र॒शोऽवै॑षा॒ग्ं॒ हेड॑ ईमहे ॥"
        },
        {
          "id": "rn-1-16",
          "chunkNumber": 16,
          "sanskrit": "अ॒सौ यो॑ऽव॒सर्प॑ति॒ नील॑ग्रीवो॒ विलो॑हितः ।"
        },
        {
          "id": "rn-1-17",
          "chunkNumber": 17,
          "sanskrit": "उ॒तैनं॑ गो॒पा अ॑दृश॒न्नदृ॑शन्नुदहा॒र्यः॑ ।"
        },
        {
          "id": "rn-1-18",
          "chunkNumber": 18,
          "sanskrit": "उ॒तैनं॒-विँश्वा॑ भू॒तानि॒ स दृ॒ष्टो मृ॑डयाति नः ॥"
        },
        {
          "id": "rn-1-19",
          "chunkNumber": 19,
          "sanskrit": "नमो॑ अस्तु॒ नील॑ग्रीवाय सहस्रा॒क्षाय॑ मी॒ढुषे᳚ ।"
        },
        {
          "id": "rn-1-20",
          "chunkNumber": 20,
          "sanskrit": "अथो॒ ये अ॑स्य॒ सत्वा॑नो॒ऽहं तेभ्यो॑ऽकर॒न्नमः॑ ॥"
        },
        {
          "id": "rn-1-21",
          "chunkNumber": 21,
          "sanskrit": "प्रमुं॑च॒ धन्व॑न॒स्त्वमु॒भयो॒रार्त्नि॑ यो॒र्ज्याम् ।"
        },
        {
          "id": "rn-1-22",
          "chunkNumber": 22,
          "sanskrit": "याश्च॑ ते॒ हस्त॒ इष॑वः॒ परा॒ ता भ॑गवो वप ॥"
        },
        {
          "id": "rn-1-23",
          "chunkNumber": 23,
          "sanskrit": "अ॒व॒तत्य॒ धनु॒स्त्वग्ं सह॑स्राक्ष॒ शते॑षुधे ।"
        },
        {
          "id": "rn-1-24",
          "chunkNumber": 24,
          "sanskrit": "नि॒शीर्य॑ श॒ल्यानां॒ मुखा॑ शि॒वो नः॑ सु॒मना॑ भव ॥"
        },
        {
          "id": "rn-1-25",
          "chunkNumber": 25,
          "sanskrit": "विज्यं॒ धनुः॑ कप॒र्दिनो॒ विश॑ल्यो॒ बाण॑वाग्ं उ॒त ।"
        },
        {
          "id": "rn-1-26",
          "chunkNumber": 26,
          "sanskrit": "अने॑शन्न॒स्येष॑व आ॒भुर॑स्य निषं॒गथिः॑ ॥"
        },
        {
          "id": "rn-1-27",
          "chunkNumber": 27,
          "sanskrit": "या ते॑ हे॒तिर्मी॑डुष्टम॒ हस्ते॑ ब॒भूव॑ ते॒ धनुः॑ ।"
        },
        {
          "id": "rn-1-28",
          "chunkNumber": 28,
          "sanskrit": "तया॒ऽस्मान्, वि॒श्वत॒स्त्वम॑य॒क्ष्मया॒ परि॑ब्भुज ॥"
        },
        {
          "id": "rn-1-29",
          "chunkNumber": 29,
          "sanskrit": "नम॑स्ते अ॒स्त्वायु॑धा॒याना॑तताय धृ॒ष्णवे᳚ ।"
        },
        {
          "id": "rn-1-30",
          "chunkNumber": 30,
          "sanskrit": "उ॒भाभ्या॑मु॒त ते॒ नमो॑ बा॒हुभ्यां॒ तव॒ धन्व॑ने ॥"
        },
        {
          "id": "rn-1-31",
          "chunkNumber": 31,
          "sanskrit": "परि॑ ते॒ धन्व॑नो हे॒तिर॒स्मान् वृ॑णक्तु वि॒श्वतः॑ ।"
        },
        {
          "id": "rn-1-32",
          "chunkNumber": 32,
          "sanskrit": "अथो॒ य इ॑षु॒धिस्तवा॒रे अ॒स्मन्निधे॑हि॒ तम् ॥ १ ॥"
        }
      ]
    },
    {
      "id": "rudram-namakam-2",
      "title": "Anuvaka 2",
      "sectionNumber": 2,
      "chunks": [
        {
          "id": "rn-2-1",
          "chunkNumber": 33,
          "sanskrit": "श्री शंभ॑वे॒ नमः॑ ॥"
        },
        {
          "id": "rn-2-2",
          "chunkNumber": 34,
          "sanskrit": "नम॑स्ते अस्तु भगवन्-विश्वेश्व॒राय॑ महादे॒वाय॑ त्र्यंब॒काय॑ त्रिपुरांत॒काय॑ त्रिकाग्निका॒लाय॑ कालाग्निरु॒द्राय॑ नीलकं॒ठाय॑ मृत्युंज॒याय॑ सर्वेश्व॒राय॑ सदाशि॒वाय॑ [शंक॒राय॑] श्रीमन्-महादे॒वाय॒ नमः॑ ।"
        },
        {
          "id": "rn-2-3",
          "chunkNumber": 35,
          "sanskrit": "नमो॒ हिर॑ण्य बाहवे सेना॒न्ये॑ दि॒शां च॒ पत॑ये॒ नमो॒"
        },
        {
          "id": "rn-2-4",
          "chunkNumber": 36,
          "sanskrit": "नमो॑ वृ॒क्षेभ्यो॒ हरि॑केशेभ्यः पशू॒नां पत॑ये॒ नमो॒"
        },
        {
          "id": "rn-2-5",
          "chunkNumber": 37,
          "sanskrit": "नमः॑ स॒स्पिंज॑राय॒ त्विषी॑मते पथी॒नां पत॑ये॒ नमो॒"
        },
        {
          "id": "rn-2-6",
          "chunkNumber": 38,
          "sanskrit": "नमो॑ बभ्लु॒शाय॑ विव्या॒धिनेऽन्ना॑नां॒ पत॑ये॒ नमो॒"
        },
        {
          "id": "rn-2-7",
          "chunkNumber": 39,
          "sanskrit": "नमो॒ हरि॑केशायोपवी॒तिने॑ पु॒ष्टानां॒ पत॑ये॒ नमो॒"
        },
        {
          "id": "rn-2-8",
          "chunkNumber": 40,
          "sanskrit": "नमो॑ भ॒वस्य॑ हे॒त्यै जग॑तां॒ पत॑ये॒ नमो॒"
        },
        {
          "id": "rn-2-9",
          "chunkNumber": 41,
          "sanskrit": "नमो॑ रु॒द्राया॑तता॒विने॒ क्षेत्रा॑णां॒ पत॑ये॒ नमो॒"
        },
        {
          "id": "rn-2-10",
          "chunkNumber": 42,
          "sanskrit": "नम॑स्सू॒तायाहं॑त्याय॒ वना॑नां॒ पत॑ये॒ नमो॒"
        },
        {
          "id": "rn-2-11",
          "chunkNumber": 43,
          "sanskrit": "नमो॒ रोहि॑ताय स्थ॒पत॑ये वृ॒क्षाणां॒ पत॑ये॒ नमो॒"
        },
        {
          "id": "rn-2-12",
          "chunkNumber": 44,
          "sanskrit": "नमो॑ मं॒त्रिणे॑ वाणि॒जाय॒ कक्षा॑णां॒ पत॑ये॒ नमो॒"
        },
        {
          "id": "rn-2-13",
          "chunkNumber": 45,
          "sanskrit": "नमो॑ भुवं॒तये॑ वारिवस्कृ॒ता-यौष॑धीनां॒ पत॑ये॒ नमो॒"
        },
        {
          "id": "rn-2-14",
          "chunkNumber": 46,
          "sanskrit": "नम॑ उ॒च्चैर्घो॑षायाक्रं॒दय॑ते पत्ती॒नां पत॑ये॒ नमो॒"
        },
        {
          "id": "rn-2-15",
          "chunkNumber": 47,
          "sanskrit": "नमः॑ कृत्स्नवी॒ताय॒ धाव॑ते॒ सत्त्व॑नां॒ पत॑ये॒ नमः॑ ॥ २ ॥"
        }
      ]
    },
    {
      "id": "rudram-namakam-3",
      "title": "Anuvaka 3",
      "sectionNumber": 3,
      "chunks": [
        {
          "id": "rn-3-1",
          "chunkNumber": 48,
          "sanskrit": "नमः॒ सह॑मानाय निव्या॒धिन॑ आव्या॒धिनी॑नां॒ पत॑ये॒ नमो॒"
        },
        {
          "id": "rn-3-2",
          "chunkNumber": 49,
          "sanskrit": "नमः॑ ककु॒भाय॑ निषं॒गिणे᳚ स्ते॒नानां॒ पत॑ये॒ नमो॒"
        },
        {
          "id": "rn-3-3",
          "chunkNumber": 50,
          "sanskrit": "नमो॑ निषं॒गिण॑ इषुधि॒मते॒ तस्क॑राणां॒ पत॑ये॒ नमो॒"
        },
        {
          "id": "rn-3-4",
          "chunkNumber": 51,
          "sanskrit": "नमो॒ वंच॑ते परि॒वंच॑ते स्तायू॒नां पत॑ये॒ नमो॒"
        },
        {
          "id": "rn-3-5",
          "chunkNumber": 52,
          "sanskrit": "नमो॑ निचे॒रवे॑ परिच॒रायार॑ण्यानां॒ पत॑ये॒ नमो॒"
        },
        {
          "id": "rn-3-6",
          "chunkNumber": 53,
          "sanskrit": "नमः॑ सृका॒विभ्यो॒ जिघाग्ं॑सद्भ्यो मुष्ण॒तां पत॑ये॒ नमो॒"
        },
        {
          "id": "rn-3-7",
          "chunkNumber": 54,
          "sanskrit": "नमो॑ऽसि॒मद्भ्यो॒ नक्तं॒चर॑द्भ्यः प्रकृं॒तानां॒ पत॑ये॒ नमो॒"
        },
        {
          "id": "rn-3-8",
          "chunkNumber": 55,
          "sanskrit": "नम॑ उष्णी॒षिणे॑ गिरिच॒राय॑ कुलुं॒चानां॒ पत॑ये॒ नमो॒"
        },
        {
          "id": "rn-3-9",
          "chunkNumber": 56,
          "sanskrit": "नम॒ इषु॑मद्भ्यो धन्वा॒विभ्य॑श्च वो॒ नमो॒"
        },
        {
          "id": "rn-3-10",
          "chunkNumber": 57,
          "sanskrit": "नम॑ आतन्-वा॒नेभ्यः॑ प्रति॒दधा॑नेभ्यश्च वो॒ नमो॒"
        },
        {
          "id": "rn-3-11",
          "chunkNumber": 58,
          "sanskrit": "नम॑ आ॒यच्छ॑द्भ्यो विसृ॒जद्भ्य॑श्च वो॒ नमो॒"
        },
        {
          "id": "rn-3-12",
          "chunkNumber": 59,
          "sanskrit": "नमोऽस्य॑द्भ्यो॒ विद्य॑द्भ्यश्च वो॒ नमो॒"
        },
        {
          "id": "rn-3-13",
          "chunkNumber": 60,
          "sanskrit": "नम॒ आसी॑नेभ्यः॒ शया॑नेभ्यश्च वो॒ नमो॒"
        },
        {
          "id": "rn-3-14",
          "chunkNumber": 61,
          "sanskrit": "नमः॑ स्व॒पद्भ्यो॒ जाग्र॑द्भ्यश्च वो॒ नमो॒"
        },
        {
          "id": "rn-3-15",
          "chunkNumber": 62,
          "sanskrit": "नम॒स्तिष्ठ॑द्भ्यो॒ धाव॑द्भ्यश्च वो॒ नमो॒"
        },
        {
          "id": "rn-3-16",
          "chunkNumber": 63,
          "sanskrit": "नमः॑ स॒भाभ्यः॑ स॒भाप॑तिभ्यश्च वो॒ नमो॒"
        },
        {
          "id": "rn-3-17",
          "chunkNumber": 64,
          "sanskrit": "नमो॒ अश्वे॒भ्योऽश्व॑पतिभ्यश्च वो॒ नमः॑ ॥ ३ ॥"
        }
      ]
    },
    {
      "id": "rudram-namakam-4",
      "title": "Anuvaka 4",
      "sectionNumber": 4,
      "chunks": [
        {
          "id": "rn-4-1",
          "chunkNumber": 65,
          "sanskrit": "नम॑ आव्या॒धिनी᳚भ्यो वि॒विध्यं॑तीभ्यश्च वो॒ नमो॒"
        },
        {
          "id": "rn-4-2",
          "chunkNumber": 66,
          "sanskrit": "नम॒ उग॑णाभ्यस्तृग्ं-ह॒तीभ्य॑श्च वो॒ नमो॒"
        },
        {
          "id": "rn-4-3",
          "chunkNumber": 67,
          "sanskrit": "नमो॑ गृ॒त्सेभ्यो॑ गृ॒त्सप॑तिभ्यश्च वो॒ नमो॒"
        },
        {
          "id": "rn-4-4",
          "chunkNumber": 68,
          "sanskrit": "नमो॒ व्राते᳚भ्यो॒ व्रात॑पतिभ्यश्च वो॒ नमो॒"
        },
        {
          "id": "rn-4-5",
          "chunkNumber": 69,
          "sanskrit": "नमो॑ ग॒णेभ्यो॑ ग॒णप॑तिभ्यश्च वो॒ नमो॒"
        },
        {
          "id": "rn-4-6",
          "chunkNumber": 70,
          "sanskrit": "नमो॒ विरू॑पेभ्यो वि॒श्वरू॑पेभ्यश्च वो॒ नमो॒"
        },
        {
          "id": "rn-4-7",
          "chunkNumber": 71,
          "sanskrit": "नमो॑ मह॒द्भ्यः॑, क्षुल्ल॒केभ्य॑श्च वो॒ नमो॒"
        },
        {
          "id": "rn-4-8",
          "chunkNumber": 72,
          "sanskrit": "नमो॑ र॒थिभ्यो॑ऽर॒थेभ्य॑श्च वो॒ नमो॒"
        },
        {
          "id": "rn-4-9",
          "chunkNumber": 73,
          "sanskrit": "नमो॒ रथे᳚भ्यो॒ रथ॑पतिभ्यश्च वो॒ नमो॒"
        },
        {
          "id": "rn-4-10",
          "chunkNumber": 74,
          "sanskrit": "नमः॒ सेना᳚भ्यः सेना॒निभ्य॑श्च वो॒ नमो॒"
        },
        {
          "id": "rn-4-11",
          "chunkNumber": 75,
          "sanskrit": "नमः॑, क्ष॒त्तृभ्यः॑ संग्रही॒तृभ्य॑श्च वो॒ नमो॒"
        },
        {
          "id": "rn-4-12",
          "chunkNumber": 76,
          "sanskrit": "नम॒स्तक्ष॑भ्यो रथका॒रेभ्य॑श्च वो॒ नमो॒"
        },
        {
          "id": "rn-4-13",
          "chunkNumber": 77,
          "sanskrit": "नमः॒ कुला॑लेभ्यः क॒र्मारे᳚भ्यश्च वो॒ नमो॒"
        },
        {
          "id": "rn-4-14",
          "chunkNumber": 78,
