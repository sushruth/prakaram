    {
      "id": "rudram-namakam-10",
      "title": "Anuvaka 10",
      "sectionNumber": 10,
      "chunks": [
        {
          "id": "rn-10-1",
          "chunkNumber": 162,
          "sanskrit": "द्रापे॒ अंध॑सस्पते॒ दरि॑द्र॒न्नील॑लोहित ।"
        },
        {
          "id": "rn-10-2",
          "chunkNumber": 163,
          "sanskrit": "ए॒षां पुरु॑षाणामे॒षां प॑शू॒नां मा भेर्माऽरो॒ मो ए॑षां॒ किंच॒नाम॑मत् ।"
        },
        {
          "id": "rn-10-3",
          "chunkNumber": 164,
          "sanskrit": "या ते॑ रुद्र शि॒वा त॒नूः शि॒वा वि॒श्वाह॑भेषजी ।"
        },
        {
          "id": "rn-10-4",
          "chunkNumber": 165,
          "sanskrit": "शि॒वा रु॒द्रस्य॑ भेष॒जी तया॑ नो मृड जी॒वसे᳚ ॥"
        },
        {
          "id": "rn-10-5",
          "chunkNumber": 166,
          "sanskrit": "इ॒माग्ं रु॒द्राय॑ त॒वसे॑ कप॒र्दिने᳚ क्ष॒यद्वी॑राय॒ प्रभ॑रामहे म॒तिम् ।"
        },
        {
          "id": "rn-10-6",
          "chunkNumber": 167,
          "sanskrit": "यथा॑ न॒श्शमस॑द्द्वि॒पदे॒ चतु॑ष्पदे॒ विश्वं॑ पु॒ष्टं ग्रामे॑ अ॒स्मिन्नना॑तुरम् ।"
        },
        {
          "id": "rn-10-7",
          "chunkNumber": 168,
          "sanskrit": "मृ॒डा नो॑ रुद्रो॒त नो॒ मय॑स्कृधि क्ष॒यद्वी॑राय॒ नम॑सा विधेम ते ।"
        },
        {
          "id": "rn-10-8",
          "chunkNumber": 169,
          "sanskrit": "यच्छं च॒ योश्च॒ मनु॑राय॒जे पि॒ता तद॑श्याम॒ तव॑ रुद्र॒ प्रणी॑तौ ।"
        },
        {
          "id": "rn-10-9",
          "chunkNumber": 170,
          "sanskrit": "मा नो॑ म॒हांत॑मु॒त मा नो॑ अर्भ॒कं मा न॒ उक्षं॑तमु॒त मा न॑ उक्षि॒तम् ।"
        },
        {
          "id": "rn-10-10",
          "chunkNumber": 171,
          "sanskrit": "मा नो॑ऽवधीः पि॒तरं॒ मोत मा॒तरं॑ प्रि॒या मा न॑स्त॒नुवो॑ रुद्र रीरिषः ।"
        },
        {
          "id": "rn-10-11",
          "chunkNumber": 172,
          "sanskrit": "मा न॑स्तो॒के तन॑ये॒ मा न॒ आयु॑षि॒ मा नो॒ गोषु॒ मा नो॒ अश्वे॑षु रीरिषः ।"
        },
        {
          "id": "rn-10-12",
          "chunkNumber": 173,
          "sanskrit": "वी॒रान्मा नो॑ रुद्र भामि॒तोऽव॑धीर्ह॒विष्मं॑तो॒ नम॑सा विधेम ते ।"
        },
        {
          "id": "rn-10-13",
          "chunkNumber": 174,
          "sanskrit": "आ॒रात्ते॑ गो॒घ्न उ॒त पू॑रुष॒घ्ने क्ष॒यद्वी॑राय सु॒म्नम॒स्मे ते॑ अस्तु ।"
        },
        {
          "id": "rn-10-14",
          "chunkNumber": 175,
          "sanskrit": "रक्षा॑ च नो॒ अधि॑ च देव ब्रू॒ह्यधा॑ च नः॒ शर्म॑ यच्छ द्वि॒बर्हाः᳚ ।"
        },
        {
          "id": "rn-10-15",
          "chunkNumber": 176,
          "sanskrit": "स्तु॒हि श्रु॒तं ग॑र्त॒सदं॒-युँवा॑नं मृ॒गन्न भी॒ममु॑पह॒त्नुमु॒ग्रम् ।"
        },
        {
          "id": "rn-10-16",
          "chunkNumber": 177,
          "sanskrit": "मृ॒डा ज॑रि॒त्रे रु॑द्र॒ स्तवा॑नो अ॒न्यंते॑ अ॒स्मन्निव॑पंतु॒ सेनाः᳚ ।"
        },
        {
          "id": "rn-10-17",
          "chunkNumber": 178,
          "sanskrit": "परि॑णो रु॒द्रस्य॑ हे॒तिर्वृ॑णक्तु॒ परि॑ त्वे॒षस्य॑ दुर्म॒ति र॑घा॒योः ।"
        },
        {
          "id": "rn-10-18",
          "chunkNumber": 179,
          "sanskrit": "अव॑ स्थि॒रा म॒घव॑द्भ्य-स्तनुष्व॒ मीढ्व॑स्तो॒काय॒ तन॑याय मृडय ।"
        },
        {
          "id": "rn-10-19",
          "chunkNumber": 180,
          "sanskrit": "मीढु॑ष्टम॒ शिव॑तम शि॒वो नः॑ सु॒मना॑ भव ।"
        },
        {
          "id": "rn-10-20",
          "chunkNumber": 181,
          "sanskrit": "प॒र॒मे वृ॒क्ष आयु॑धन्नि॒धाय॒ कृत्तिं॒-वँसा॑न॒ आच॑र॒ पिना॑कं॒ बिभ्र॒दाग॑हि ।"
        },
        {
          "id": "rn-10-21",
          "chunkNumber": 182,
          "sanskrit": "विकि॑रिद॒ विलो॑हित॒ नम॑स्ते अस्तु भगवः ।"
        },
        {
          "id": "rn-10-22",
          "chunkNumber": 183,
          "sanskrit": "यास्ते॑ स॒हस्रग्ं॑ हे॒तयो॒न्यम॒स्मन्निव॑पंतु॒ ताः ।"
        },
        {
          "id": "rn-10-23",
          "chunkNumber": 184,
          "sanskrit": "स॒हस्रा॑णि सहस्र॒धा बा॑हु॒वोस्तव॑ हे॒तयः॑ ।"
        },
        {
          "id": "rn-10-24",
          "chunkNumber": 185,
          "sanskrit": "तासा॒मीशा॑नो भगवः परा॒चीना॒ मुखा॑ कृधि ॥ १० ॥"
        }
      ]
    },
    {
      "id": "rudram-namakam-11",
      "title": "Anuvaka 11",
      "sectionNumber": 11,
      "chunks": [
        {
          "id": "rn-11-1",
          "chunkNumber": 186,
          "sanskrit": "स॒हस्रा॑णि सहस्र॒शो ये रु॒द्रा अधि॒ भूम्या᳚म् ।"
        },
        {
          "id": "rn-11-2",
          "chunkNumber": 187,
          "sanskrit": "तेषाग्ं॑ सहस्रयोज॒नेऽव॒धन्वा॑नि तन्मसि ।"
        },
        {
          "id": "rn-11-3",
          "chunkNumber": 188,
          "sanskrit": "अ॒स्मिन्म॑ह॒त्य॑र्ण॒वे᳚ऽंतरि॑क्षे भ॒वा अधि॑ ।"
        },
        {
          "id": "rn-11-4",
          "chunkNumber": 189,
          "sanskrit": "नील॑ग्रीवाः शिति॒कंठाः᳚ श॒र्वा अ॒धः, क्ष॑माच॒राः ।"
        },
        {
          "id": "rn-11-5",
          "chunkNumber": 190,
          "sanskrit": "नील॑ग्रीवाः शिति॒कंठा॒ दिवग्ं॑ रु॒द्रा उप॑श्रिताः ।"
        },
        {
          "id": "rn-11-6",
          "chunkNumber": 191,
          "sanskrit": "ये वृ॒क्षेषु॑ स॒स्पिंज॑रा॒ नील॑ग्रीवा॒ विलो॑हिताः ।"
        },
        {
          "id": "rn-11-7",
          "chunkNumber": 192,
          "sanskrit": "ये भू॒ताना॒मधि॑पतयो विशि॒खासः॑ कप॒र्दिनः॑ ।"
        },
        {
          "id": "rn-11-8",
          "chunkNumber": 193,
          "sanskrit": "ये अन्ने॑षु वि॒विध्यं॑ति॒ पात्रे॑षु॒ पिब॑तो॒ जनान्॑ ।"
        },
        {
          "id": "rn-11-9",
          "chunkNumber": 194,
          "sanskrit": "ये प॒थां प॑थि॒रक्ष॑य ऐलबृ॒दा॑ य॒व्युधः॑ ।"
        },
        {
          "id": "rn-11-10",
          "chunkNumber": 195,
          "sanskrit": "ये ती॒र्थानि॑ प्र॒चरं॑ति सृ॒कावं॑तो निषं॒गिणः॑ ।"
        },
        {
          "id": "rn-11-11",
          "chunkNumber": 196,
          "sanskrit": "य ए॒तावं॑तश्च॒ भूयाग्ं॑सश्च॒ दिशो॑ रु॒द्रा वि॑तस्थि॒रे ।"
        },
        {
          "id": "rn-11-12",
          "chunkNumber": 197,
          "sanskrit": "तेषाग्ं॑ सहस्रयोज॒नेऽव॒धन्वा॑नि तन्मसि ।"
        },
        {
          "id": "rn-11-13",
          "chunkNumber": 198,
          "sanskrit": "नमो॑ रु॒द्रेभ्यो॒ ये पृ॑थि॒व्यां-येँ᳚ऽंतरि॑क्षे॒ ये दि॒वि येषा॒मन्नं॒-वाँतो॑ व॒र्ष॒मिष॑व॒स्तेभ्यो॒ दश॒ प्राची॒र्दश॑ दक्षि॒णा दश॑ प्र॒तीची॒-र्दशो-दी॑ची॒-र्दशो॒र्ध्वास्तेभ्यो॒ नम॒स्ते नो॑ मृडयंतु॒ ते यं द्वि॒ष्मो यश्च॑ नो॒ द्वेष्टि॒ तं-वोँ॒ जंभे॑ दधामि ॥ ११ ॥"
        }
      ]
    },
    {
      "id": "rudram-namakam-12",
      "title": "Concluding mantras",
      "sectionNumber": 12,
      "chunks": [
        {
          "id": "rn-12-1",
          "chunkNumber": 199,
          "sanskrit": "त्र्यं॑बकं-यँजामहे सुगं॒धिं पु॑ष्टि॒वर्ध॑नम् ।"
        },
        {
          "id": "rn-12-2",
          "chunkNumber": 200,
          "sanskrit": "उ॒र्वा॒रु॒कमि॑व॒ बंध॑नान्मृ॒त्योर्मु॑क्षीय॒ माऽमृता᳚त् ।"
        },
        {
          "id": "rn-12-3",
          "chunkNumber": 201,
          "sanskrit": "यो रु॒द्रो अ॒ग्नौ यो अ॒प्सु य ओष॑धीषु॒ यो रु॒द्रो विश्वा॒ भुव॑ना वि॒वेश॒ तस्मै॑ रु॒द्राय॒ नमो॑ अस्तु ।"
        },
        {
          "id": "rn-12-4",
          "chunkNumber": 202,
          "sanskrit": "तमु॑ ष्टुहि॒ यः स्वि॒षुस्सु॒धन्वा॒ यो विश्व॑स्य॒ क्षय॑ति भेष॒जस्य॑ ।"
        },
        {
          "id": "rn-12-5",
          "chunkNumber": 203,
          "sanskrit": "यक्ष्वा᳚म॒हे सौ᳚मन॒साय॑ रु॒द्रं नमो᳚भिर्दे॒वमसु॑रं दुवस्य ।"
        },
        {
          "id": "rn-12-6",
          "chunkNumber": 204,
          "sanskrit": "अ॒यं मे॒ हस्तो॒ भग॑वान॒यं मे॒ भग॑वत्तरः ।"
        },
        {
          "id": "rn-12-7",
          "chunkNumber": 205,
          "sanskrit": "अ॒यं मे᳚ वि॒श्वभे᳚षजो॒ऽयग्ं शि॒वाभि॑मर्शनः ।"
        },
        {
          "id": "rn-12-8",
          "chunkNumber": 206,
          "sanskrit": "ये ते॑ स॒हस्र॑म॒युतं॒ पाशा॒ मृत्यो॒ मर्त्या॑य॒ हंत॑वे ।"
        },
        {
          "id": "rn-12-9",
          "chunkNumber": 207,
          "sanskrit": "तान् य॒ज्ञस्य॑ मा॒यया॒ सर्वा॒नव॑ यजामहे ।"
        },
        {
          "id": "rn-12-10",
          "chunkNumber": 208,
          "sanskrit": "मृ॒त्यवे॒ स्वाहा॑ मृ॒त्यवे॒ स्वाहा᳚ ।"
        },
        {
          "id": "rn-12-11",
          "chunkNumber": 209,
          "sanskrit": "ॐ नमो भगवते रुद्राय विष्णवे मृत्यु॑र्मे पा॒हि ॥"
        },
        {
          "id": "rn-12-12",
          "chunkNumber": 210,
          "sanskrit": "प्राणानां ग्रंथिरसि रुद्रो मा॑ विशां॒तकः ।"
        },
        {
          "id": "rn-12-13",
          "chunkNumber": 211,
          "sanskrit": "तेनान्नेना᳚प्याय॒स्व ॥"
        },
        {
          "id": "rn-12-14",
          "chunkNumber": 212,
          "sanskrit": "नमो रुद्राय विष्णवे मृत्यु॑र्मे पा॒हि ॥"
        },
        {
          "id": "rn-12-15",
          "chunkNumber": 213,
          "sanskrit": "सदाशि॒वोम् ।"
        },
        {
          "id": "rn-12-16",
          "chunkNumber": 214,
          "sanskrit": "ॐ शांतिः॒ शांतिः॒ शांतिः॑ ।"
        }
      ]
    }
  ]
}
