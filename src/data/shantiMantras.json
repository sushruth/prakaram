{
  "id": "shanti-mantras",
  "title": {
    "sanskrit": "शान्ति मन्त्राः",
    "transliteration": "Śānti Mantrāḥ",
    "english": "Vedic Peace Invocations"
  },
  "metadata": {
    "veda": "Krishna Yajurveda & Taittiriya Upanishad",
    "source": "Saswara Veda Mantrah (Ramakrishna Math)",
    "rishi": "Vedic Rishis",
    "devata": "Parabrahman & Devas",
    "chandas": "Anushtubh & Trishtubh"
  },
  "sections": [
    {
      "id": "shanti-1",
      "title": "Taittiriya Shanti Mantra",
      "sectionNumber": 1,
      "chunks": [
        {
          "id": "shanti-1-1",
          "chunkNumber": 1,
          "sanskrit": "ॐ शं नो॑ मि॒त्रः शं वरु॑णः ।",
          "translation": "May Mitra be auspicious to us; may Varuna be auspicious to us."
        },
        {
          "id": "shanti-1-2",
          "chunkNumber": 2,
          "sanskrit": "शं नो॑ भवत्वर्य॒मा ।",
          "translation": "May Aryaman be auspicious to us."
        },
        {
          "id": "shanti-1-3",
          "chunkNumber": 3,
          "sanskrit": "शं न॒ इन्द्रो॒ बृह॒स्पतिः॑ ।",
          "translation": "May Indra and Brihaspati be auspicious to us."
        },
        {
          "id": "shanti-1-4",
          "chunkNumber": 4,
          "sanskrit": "शं नो॒ विष्णू॑रुरुक्र॒मः ।",
          "translation": "May Vishnu of wide strides be auspicious to us."
        },
        {
          "id": "shanti-1-5",
          "chunkNumber": 5,
          "sanskrit": "नमो॒ ब्रह्म॑णे । नम॑स्ते वायो ।",
          "translation": "Salutations to Brahman! Salutations to Vayu!"
        },
        {
          "id": "shanti-1-6",
          "chunkNumber": 6,
          "sanskrit": "त्वमे॒व प्र॒त्यक्षं॒ ब्रह्मा॑सि ।",
          "translation": "Thou alone art the visible Brahman."
        },
        {
          "id": "shanti-1-7",
          "chunkNumber": 7,
          "sanskrit": "त्वामे॒व प्र॒त्यक्षं॒ ब्रह्म॑ वदिष्यामि ।",
          "translation": "Thee alone shall I declare as visible Brahman."
        },
        {
          "id": "shanti-1-8",
          "chunkNumber": 8,
          "sanskrit": "ऋ॒तं व॑दिष्यामि । स॒त्यं व॑दिष्यामि ।",
          "translation": "I shall speak the Right; I shall speak the Truth."
        },
        {
          "id": "shanti-1-9",
          "chunkNumber": 9,
          "sanskrit": "तन्माम॑वतु । तद्व॒क्तार॑मवतु ।",
          "translation": "May That protect me; may That protect the teacher."
        },
        {
          "id": "shanti-1-10",
          "chunkNumber": 10,
          "sanskrit": "अव॑तु॒ माम् । अव॑तु व॒क्तारम्᳚ ।",
          "translation": "May It protect me! May It protect the speaker!"
        },
        {
          "id": "shanti-1-11",
          "chunkNumber": 11,
          "sanskrit": "ॐ शान्तिः॒ शान्तिः॒ शान्तिः॑ ॥",
          "translation": "Om, Peace, Peace, Peace."
        }
      ]
    },
    {
      "id": "shanti-2",
      "title": "Sahana Vavatu",
      "sectionNumber": 2,
      "chunks": [
        {
          "id": "shanti-2-1",
          "chunkNumber": 1,
          "sanskrit": "ॐ स॒ह ना॑ववतु । स॒ह नौ॑ भुनक्तु ।",
          "translation": "Om, may He protect us both together; may He nourish us both together."
        },
        {
          "id": "shanti-2-2",
          "chunkNumber": 2,
          "sanskrit": "स॒ह वी॒र्यं॑ करवावहै ।",
          "translation": "May we work together with great energy."
        },
        {
          "id": "shanti-2-3",
          "chunkNumber": 3,
          "sanskrit": "ते॒ज॒स्विना॒वधी॑तमस्तु॒ मा वि॑द्विषा॒वहै᳚ ।",
          "translation": "May our study be vigorous and effective; may we never harbor animosity."
        },
        {
          "id": "shanti-2-4",
          "chunkNumber": 4,
          "sanskrit": "ॐ शान्तिः॒ शान्तिः॒ शान्तिः॑ ॥",
          "translation": "Om, Peace, Peace, Peace."
        }
      ]
    }
  ]
}
