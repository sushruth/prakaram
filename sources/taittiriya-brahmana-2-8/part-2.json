{
  "sections": [
    {
      "id": "taittiriya-brahmana-2-8-9",
      "title": "Aṣṭaka 2 · Prapāṭhaka 8 · Anuvāka 9",
      "sectionNumber": 9,
      "chunks": [
        {
          "id": "tb-2-8-9-1",
          "chunkNumber": 1,
          "sanskrit": "ता सू᳚र्या चन्द्र॒मसा॑ विश्व॒भृत्त॑मा म॒हत्।",
          "section": 9
        },
        {
          "id": "tb-2-8-9-2",
          "chunkNumber": 2,
          "sanskrit": "तेजो॒ वसु॑मद्राजतो दि॒वि।"
        },
        {
          "id": "tb-2-8-9-3",
          "chunkNumber": 3,
          "sanskrit": "सामा᳚त्माना चरतः सामचा॒रिणा᳚।"
        },
        {
          "id": "tb-2-8-9-4",
          "chunkNumber": 4,
          "sanskrit": "ययो᳚र्व्र॒तं न म॒मे जातु॑ दे॒वयोः᳚॥"
        },
        {
          "id": "tb-2-8-9-5",
          "chunkNumber": 5,
          "sanskrit": "उ॒भावन्तौ॒ परि॑यात॒ अर्म्या᳚।"
        },
        {
          "id": "tb-2-8-9-6",
          "chunkNumber": 6,
          "sanskrit": "दि॒वो न र॒श्मीꣴ स्त॑नु॒तोव्य॑र्ण॒वे।"
        },
        {
          "id": "tb-2-8-9-7",
          "chunkNumber": 7,
          "sanskrit": "उ॒भा भु॑व॒न्ती भुव॑ना क॒विक्र॑तू।"
        },
        {
          "id": "tb-2-8-9-8",
          "chunkNumber": 8,
          "sanskrit": "सूर्या॒ न च॒न्द्रा च॑रतो ह॒ताम॑ती॥"
        },
        {
          "id": "tb-2-8-9-9",
          "chunkNumber": 9,
          "sanskrit": "पती᳚ द्यु॒मद् वि॑श्व॒विदा॑ उ॒भा दि॒वः।"
        },
        {
          "id": "tb-2-8-9-10",
          "chunkNumber": 10,
          "sanskrit": "सूर्या॑ उ॒भा च॒न्द्रम॑सा विचख्ष॒णा वि॒श्ववा॑रा वरिवो॒भा वरे᳚ण्या।"
        },
        {
          "id": "tb-2-8-9-11",
          "chunkNumber": 11,
          "sanskrit": "ता नो॑ऽवतं मति॒मन्ता॒ महि॑व्रता॥"
        },
        {
          "id": "tb-2-8-9-12",
          "chunkNumber": 12,
          "sanskrit": "वि॒श्व॒वप॑री प्र॒तर॑णा तर॒न्ता।"
        },
        {
          "id": "tb-2-8-9-13",
          "chunkNumber": 13,
          "sanskrit": "सु॒व॒र्विदा॑ दृ॒शये॒ भूरि॑रश्मी।"
        },
        {
          "id": "tb-2-8-9-14",
          "chunkNumber": 14,
          "sanskrit": "सूर्या॒ हि च॒न्द्रा वसु॑त्वे॒षद॑र्शता।"
        },
        {
          "id": "tb-2-8-9-15",
          "chunkNumber": 15,
          "sanskrit": "म॒न॒स्विनो॒भाऽनु॑ चर॒तो नु॒ सं दिव᳚म्॥"
        },
        {
          "id": "tb-2-8-9-16",
          "chunkNumber": 16,
          "sanskrit": "अ॒स्य श्रवो॑ न॒द्यः॑ स॒प्त बि॑भ्रति।"
        },
        {
          "id": "tb-2-8-9-17",
          "chunkNumber": 17,
          "sanskrit": "द्यावा॒ ख्षामा॑ पृथि॒वी द॑र्श॒तव्ँवपुः॑।"
        },
        {
          "id": "tb-2-8-9-18",
          "chunkNumber": 18,
          "sanskrit": "अ॒स्मे सू᳚र्या चन्द्र॒मसा॑ऽभि॒चख्षे᳚।"
        },
        {
          "id": "tb-2-8-9-19",
          "chunkNumber": 19,
          "sanskrit": "श्र॒द्धे कमि॑न्द्र चरतो विचर्तु॒रम् पू॒र्वा॒प॒रं च॑रतो मा॒य यै॒तौ।"
        },
        {
          "id": "tb-2-8-9-20",
          "chunkNumber": 20,
          "sanskrit": "शिशू॒ क्रीड॑न्तौ॒ परि॑यातो अद्ध्व॒रम्।"
        },
        {
          "id": "tb-2-8-9-21",
          "chunkNumber": 21,
          "sanskrit": "विश्वा᳚न्य॒न्यो भुव॑नाऽभि॒चष्टे᳚।"
        },
        {
          "id": "tb-2-8-9-22",
          "chunkNumber": 22,
          "sanskrit": "ऋ॒तून॒न्यो वि॒दध॑ज्जायते॒ पुनः॑॥"
        },
        {
          "id": "tb-2-8-9-23",
          "chunkNumber": 23,
          "sanskrit": "हिर॑ण्यवर्णाः॒ शुच॑यः पाव॒का §110, यासा॒ꣳ॒ राजा᳚ §111।"
        },
        {
          "id": "tb-2-8-9-24",
          "chunkNumber": 24,
          "sanskrit": "यासां᳚ दे॒वाः §112, शि॒वेन॑ मा॒ चख्षु॑षा पश्यत §113।"
        },
        {
          "id": "tb-2-8-9-25",
          "chunkNumber": 25,
          "sanskrit": "आपो॑ भ॒द्रा §114, आदित्प॑श्यामि §115॥"
        },
        {
          "id": "tb-2-8-9-26",
          "chunkNumber": 26,
          "sanskrit": "नास॑दासी॒न्नो सदा॑सीत् त॒दानी᳚म्।"
        },
        {
          "id": "tb-2-8-9-27",
          "chunkNumber": 27,
          "sanskrit": "नासी॒द्रजो॒ नो व्यो॑माप॒रो यत्।"
        },
        {
          "id": "tb-2-8-9-28",
          "chunkNumber": 28,
          "sanskrit": "किमाव॑रीवः॒ कुह॒ कस्य॒ शर्म॑न्न् अम्भः॒ किमा॑सी॒द् गह॑नं गभी॒रम्॥"
        },
        {
          "id": "tb-2-8-9-29",
          "chunkNumber": 29,
          "sanskrit": "न मृ॒त्युर॒मृतं॒ तर्हि॒ न।"
        },
        {
          "id": "tb-2-8-9-30",
          "chunkNumber": 30,
          "sanskrit": "रात्रि॑या॒ अह्न॑ आसीत् प्रके॒तः।"
        },
        {
          "id": "tb-2-8-9-31",
          "chunkNumber": 31,
          "sanskrit": "आनी॑दवा॒तꣴ स्व॒धया॒ तदेक᳚म्।"
        },
        {
          "id": "tb-2-8-9-32",
          "chunkNumber": 32,
          "sanskrit": "तस्मा᳚द्धा॒न्यं न प॒रः (प॒रं) किंच॒ नास॑॥"
        },
        {
          "id": "tb-2-8-9-33",
          "chunkNumber": 33,
          "sanskrit": "तम॑ आसी॒त् तम॑सा गू॒ढमग्रे᳚ प्रके॒तम्।"
        },
        {
          "id": "tb-2-8-9-34",
          "chunkNumber": 34,
          "sanskrit": "स॒लि॒लꣳ सर्व॑मा इ॒दम्।"
        },
        {
          "id": "tb-2-8-9-35",
          "chunkNumber": 35,
          "sanskrit": "तु॒च्छे ना॒भ्वपि॑हित॒य्ँयदासी᳚त्।"
        },
        {
          "id": "tb-2-8-9-36",
          "chunkNumber": 36,
          "sanskrit": "तम॑स॒ स्तन्म॑हि॒ना जा॑य॒तैक᳚म्॥"
        },
        {
          "id": "tb-2-8-9-37",
          "chunkNumber": 37,
          "sanskrit": "काम॒स्तदग्रे॒ सम॑वर्त्त॒ताधि॑ मन॑सो॒ रेतः॑ प्रथ॒मय्ँयदासी᳚त्।"
        },
        {
          "id": "tb-2-8-9-38",
          "chunkNumber": 38,
          "sanskrit": "स॒ तो बन्धु॒मस॑ति॒ निर॑विन्दन्न् (निर॑विदन्न्)।"
        },
        {
          "id": "tb-2-8-9-39",
          "chunkNumber": 39,
          "sanskrit": "हृ॒दि प्र॒तीष्या॑ क॒वयो॑ मनी॒षा॥"
        },
        {
          "id": "tb-2-8-9-40",
          "chunkNumber": 40,
          "sanskrit": "ति॒र॒श्चीनो॒ वित॑तो र॒श्मिरे॑षाम्।"
        },
        {
          "id": "tb-2-8-9-41",
          "chunkNumber": 41,
          "sanskrit": "अ॒धः स्वि॑दा॒सी(३) दु॒परि॑ स्विदासी(३)त्।"
        },
        {
          "id": "tb-2-8-9-42",
          "chunkNumber": 42,
          "sanskrit": "रे॒तो॒धा आ॑सन् महि॒मान॑ आसन्न्।"
        },
        {
          "id": "tb-2-8-9-43",
          "chunkNumber": 43,
          "sanskrit": "स्व॒धा अ॒वस्ता॒त् प्रय॑तिः प॒रस्ता᳚त्॥"
        },
        {
          "id": "tb-2-8-9-44",
          "chunkNumber": 44,
          "sanskrit": "को अ॒द्धा वे॑द॒ क इ॒ह प्रवो॑चत्।"
        },
        {
          "id": "tb-2-8-9-45",
          "chunkNumber": 45,
          "sanskrit": "कुत॒ आजा॑ता॒ कुत॑ इ॒यव्ँविसृ॑ष्टिः।"
        },
        {
          "id": "tb-2-8-9-46",
          "chunkNumber": 46,
          "sanskrit": "अ॒र्वाग्दे॒वा अ॒स्य वि॒सर्ज॑नाय अथा॒ को वे॑द॒ यत॑ आब॒भूव॑॥"
        },
        {
          "id": "tb-2-8-9-47",
          "chunkNumber": 47,
          "sanskrit": "इ॒यव्ँविसृ॑ष्टि॒र् यत॑ आब॒भूव॑।"
        },
        {
          "id": "tb-2-8-9-48",
          "chunkNumber": 48,
          "sanskrit": "यदि॑ वा द॒धे यदि॑ वा॒ न।"
        },
        {
          "id": "tb-2-8-9-49",
          "chunkNumber": 49,
          "sanskrit": "यो अ॒स्याद्ध्य॑ख्षः पर॒मे व्यो॑मन्न्।"
        },
        {
          "id": "tb-2-8-9-50",
          "chunkNumber": 50,
          "sanskrit": "सो अ॒ङ्ग वे॑द॒ यदि॑ वा॒ न वेद॑॥"
        },
        {
          "id": "tb-2-8-9-51",
          "chunkNumber": 51,
          "sanskrit": "किꣴस्वि॒द्वनं॒ क उ॒ स वृ॒ख्ष आ॑सीत्।"
        },
        {
          "id": "tb-2-8-9-52",
          "chunkNumber": 52,
          "sanskrit": "यतो॒ द्यावा॑पृथि॒वी नि॑ष्टत॒ख्षुः।"
        },
        {
          "id": "tb-2-8-9-53",
          "chunkNumber": 53,
          "sanskrit": "मनी॑षिणो॒ मन॑सा पृ॒च्छतेदु॒ तत्।"
        },
        {
          "id": "tb-2-8-9-54",
          "chunkNumber": 54,
          "sanskrit": "यद॒द्ध्यति॑ष्ठ॒द्भुव॑नानि धा॒रय॑न्न्॥"
        },
        {
          "id": "tb-2-8-9-55",
          "chunkNumber": 55,
          "sanskrit": "ब्रह्म॒ वनं॒ ब्रह्म॒ स वृ॒ख्ष आ॑सीत् यतो॒ द्यावा॑पृथि॒वी नि॑ष्टत॒ख्षुः।"
        },
        {
          "id": "tb-2-8-9-56",
          "chunkNumber": 56,
          "sanskrit": "मनी॑षिणो॒ मन॑सा॒ विब्र॑वीमि वः।"
        },
        {
          "id": "tb-2-8-9-57",
          "chunkNumber": 57,
          "sanskrit": "ब्रह्मा॒द्ध्यति॑ष्ठ॒द् भुव॑नानि धा॒रय॑न्न्॥"
        },
        {
          "id": "tb-2-8-9-58",
          "chunkNumber": 58,
          "sanskrit": "प्रा॒तर॒ग्निं प्रा॒तरिन्द्र॑ꣳ हवामहे।"
        },
        {
          "id": "tb-2-8-9-59",
          "chunkNumber": 59,
          "sanskrit": "प्रा॒त र्मि॒त्रावरु॑णा प्रा॒तर॒श्विना᳚।"
        },
        {
          "id": "tb-2-8-9-60",
          "chunkNumber": 60,
          "sanskrit": "प्रा॒त र्भगं॑ पू॒षणं॒ ब्रह्म॑ण॒स्पति᳚म्।"
        },
        {
          "id": "tb-2-8-9-61",
          "chunkNumber": 61,
          "sanskrit": "प्रा॒तस्सोम॑मु॒त रु॒द्रꣳ हु॑वेम॥"
        },
        {
          "id": "tb-2-8-9-62",
          "chunkNumber": 62,
          "sanskrit": "प्रा॒त॒र्जितं॒ भग॑मु॒ग्रꣳ हु॑वेम।"
        },
        {
          "id": "tb-2-8-9-63",
          "chunkNumber": 63,
          "sanskrit": "व॒यं पु॒त्रमदि॑ते॒र्यो वि॑ध॒र्ता।"
        },
        {
          "id": "tb-2-8-9-64",
          "chunkNumber": 64,
          "sanskrit": "आ॒द्ध्रश्चि॒द्यं मन्य॑मानस्तु॒रश्चि॑त् राजा॑ चि॒द्यं भगं॑ भ॒ख्षीत्याह॑॥"
        },
        {
          "id": "tb-2-8-9-65",
          "chunkNumber": 65,
          "sanskrit": "भग॒ प्रणे॑त॒र्भग॒ सत्य॑राधः।"
        },
        {
          "id": "tb-2-8-9-66",
          "chunkNumber": 66,
          "sanskrit": "भगे॒मां धिय॒मुद॑व॒ दद॑न्नः।"
        },
        {
          "id": "tb-2-8-9-67",
          "chunkNumber": 67,
          "sanskrit": "भग॒ प्रणो॑ जनय॒ गोभि॒रश्वैः᳚।"
        },
        {
          "id": "tb-2-8-9-68",
          "chunkNumber": 68,
          "sanskrit": "भग॒ प्रनृभि॑र्नृ॒वन्तः॑ स्याम।"
        },
        {
          "id": "tb-2-8-9-69",
          "chunkNumber": 69,
          "sanskrit": "उ॒तेदानीं॒ भग॑वन्तः स्याम॥"
        },
        {
          "id": "tb-2-8-9-70",
          "chunkNumber": 70,
          "sanskrit": "उ॒त प्रपि॒त्व उ॒त मद्ध्ये॒ अह्ना᳚म्।"
        },
        {
          "id": "tb-2-8-9-71",
          "chunkNumber": 71,
          "sanskrit": "उ॒तोदि॑ता मघव॒न्थ्सूर्य॑स्य।"
        },
        {
          "id": "tb-2-8-9-72",
          "chunkNumber": 72,
          "sanskrit": "व॒यं दे॒वाना॑ꣳ सुम॒तौ स्या॑म॥"
        },
        {
          "id": "tb-2-8-9-73",
          "chunkNumber": 73,
          "sanskrit": "भग॑ ए॒व भग॑वाꣳ अस्तु देवाः तेन॑ व॒यं भग॑वन्तः स्याम।"
        },
        {
          "id": "tb-2-8-9-74",
          "chunkNumber": 74,
          "sanskrit": "तं त्वा॑ भग॒ सर्व॒ इज्जो॑हवीमि।"
        },
        {
          "id": "tb-2-8-9-75",
          "chunkNumber": 75,
          "sanskrit": "स नो॑ भग पुर ए॒ता भ॑वे॒ह॥"
        },
        {
          "id": "tb-2-8-9-76",
          "chunkNumber": 76,
          "sanskrit": "सम॑द्ध्व॒रायो॒षसो॑ नमन्त।"
        },
        {
          "id": "tb-2-8-9-77",
          "chunkNumber": 77,
          "sanskrit": "द॒धि॒क्रावे॑व॒ शुच॑ये प॒दाय॑।"
        },
        {
          "id": "tb-2-8-9-78",
          "chunkNumber": 78,
          "sanskrit": "अ॒र्वा॒ची॒नव्ँव॑सु॒विदं॒ भग॑न्नः।"
        },
        {
          "id": "tb-2-8-9-79",
          "chunkNumber": 79,
          "sanskrit": "रथ॑मि॒वाश्वा॑ वा॒जिन॒ आव॑हन्तु॥"
        },
        {
          "id": "tb-2-8-9-80",
          "chunkNumber": 80,
          "sanskrit": "अश्वा॑वती॒र् गोम॑तीर् न उ॒षासः॑।"
        },
        {
          "id": "tb-2-8-9-81",
          "chunkNumber": 81,
          "sanskrit": "वी॒रव॑तीः॒ सद॑मुच्छन्तु भ॒द्राः।"
        },
        {
          "id": "tb-2-8-9-82",
          "chunkNumber": 82,
          "sanskrit": "घृ॒तं दुहा॑ना वि॒श्वतः॒ प्रपी॑नाः।"
        },
        {
          "id": "tb-2-8-9-83",
          "chunkNumber": 83,
          "sanskrit": "यू॒यं पा॑त स्व॒स्तिभिः॒ सदा॑ नः"
        }
      ]
    }
  ]
}
