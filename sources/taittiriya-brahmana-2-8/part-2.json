{
  "sections": [
    {
      "id": "taittiriya-brahmana-2-8-8",
      "title": "Aṣṭaka 2 · Prapāṭhaka 8 · Anuvāka 8",
      "sectionNumber": 8,
      "chunks": [
        {
          "id": "tb-2-8-8-1",
          "chunkNumber": 1,
          "sanskrit": "a̠hama̍smi prathama̠jā ṛ̠tasya̍|",
          "section": 8
        },
        {
          "id": "tb-2-8-8-2",
          "chunkNumber": 2,
          "sanskrit": "pūrvaṃ̍ de̠vebhyo̍ a̠mṛta̍sya̠ nābhiḥ̍|"
        },
        {
          "id": "tb-2-8-8-3",
          "chunkNumber": 3,
          "sanskrit": "yo mā̠ dadā̍ti̠ sa ide̠va mā vāḥ̎|"
        },
        {
          "id": "tb-2-8-8-4",
          "chunkNumber": 4,
          "sanskrit": "a̠hamanna̠manna̍ma̠danta̍madmi||"
        },
        {
          "id": "tb-2-8-8-5",
          "chunkNumber": 5,
          "sanskrit": "pūrva̍ma̠gnerapi̍ daha̠tyannaṃ̎|"
        },
        {
          "id": "tb-2-8-8-6",
          "chunkNumber": 6,
          "sanskrit": "ya̠ttau hā̍''sāte ahamutta̠reṣu̍|"
        },
        {
          "id": "tb-2-8-8-7",
          "chunkNumber": 7,
          "sanskrit": "vyātta̍masya pa̠śavaḥ̍ su̠jaṃbha̎m|"
        },
        {
          "id": "tb-2-8-8-8",
          "chunkNumber": 8,
          "sanskrit": "paśya̍nti̠ dhīrāḥ̠ praca̍ranti̠ pākāḥ̎||"
        },
        {
          "id": "tb-2-8-8-9",
          "chunkNumber": 9,
          "sanskrit": "jahā̎mya̠nyaṃ na ja̍hāmya̠nyam|"
        },
        {
          "id": "tb-2-8-8-10",
          "chunkNumber": 10,
          "sanskrit": "a̠hamanna̠vm̐vaśa̠micca̍rāmi sa̠mā̠namarthaṃ̠ parye̍mi bhuṃ̠jat|"
        },
        {
          "id": "tb-2-8-8-11",
          "chunkNumber": 11,
          "sanskrit": "ko māmannaṃ̍ manu̠ṣyo̍ dayeta||"
        },
        {
          "id": "tb-2-8-8-12",
          "chunkNumber": 12,
          "sanskrit": "parā̍ke̠ annaṃ̠ nihi̍talm̐lo̠ka e̠tat|"
        },
        {
          "id": "tb-2-8-8-13",
          "chunkNumber": 13,
          "sanskrit": "viśvai̎rde̠vaiḥ pi̠tṛbhi̍rgu̠ptamanna̎m|"
        },
        {
          "id": "tb-2-8-8-14",
          "chunkNumber": 14,
          "sanskrit": "yada̠dyate̍ lu̠pyate̠ yat pa̍ro̠pyate̎|"
        },
        {
          "id": "tb-2-8-8-15",
          "chunkNumber": 15,
          "sanskrit": "śa̠ta̠ta̠mī sā ta̠nūrme̍ babhūva||"
        },
        {
          "id": "tb-2-8-8-16",
          "chunkNumber": 16,
          "sanskrit": "ma̠hāntau̍ ca̠rū sa̍kṛddu̠gdhena̍ paprau|"
        },
        {
          "id": "tb-2-8-8-17",
          "chunkNumber": 17,
          "sanskrit": "diva̍ñca̠ pṛśñi̍ pṛthi̠vīṃ ca̍ sā̠kam|"
        },
        {
          "id": "tb-2-8-8-18",
          "chunkNumber": 18,
          "sanskrit": "tath saṃ̠piba̍nto̠ na mi̍nanti ve̠dhasaḥ̍|"
        },
        {
          "id": "tb-2-8-8-19",
          "chunkNumber": 19,
          "sanskrit": "naitadbhūyo̠ bhava̍ti̠ no kanī̍yaḥ annaṃ̍ prā̠ṇamanna̍mapā̠namā̍huḥ|"
        },
        {
          "id": "tb-2-8-8-20",
          "chunkNumber": 20,
          "sanskrit": "annaṃ̍ mṛ̠tyuṃ tamu̍ jī̠vātu̍māhuḥ|"
        },
        {
          "id": "tb-2-8-8-21",
          "chunkNumber": 21,
          "sanskrit": "annaṃ̍ bra̠hmāṇo̍ ja̠rasa̍vm̐vadanti|"
        },
        {
          "id": "tb-2-8-8-22",
          "chunkNumber": 22,
          "sanskrit": "anna̍māhuḥ pra̠jana̍naṃ pra̠jānā̎m||"
        },
        {
          "id": "tb-2-8-8-23",
          "chunkNumber": 23,
          "sanskrit": "mogha̠mannaṃ̍ vindate̠ apra̍cetāḥ|"
        },
        {
          "id": "tb-2-8-8-24",
          "chunkNumber": 24,
          "sanskrit": "sa̠tyaṃ bra̍vīmi va̠dha ithsa tasya̍|"
        },
        {
          "id": "tb-2-8-8-25",
          "chunkNumber": 25,
          "sanskrit": "nārya̠maṇaṃ̠ puṣya̍ti̠ no sakhā̍yam|"
        },
        {
          "id": "tb-2-8-8-26",
          "chunkNumber": 26,
          "sanskrit": "keva̍lāgho bhavati kevalā̠dī||"
        },
        {
          "id": "tb-2-8-8-27",
          "chunkNumber": 27,
          "sanskrit": "a̠haṃ me̠ghaḥ sta̠naya̠nvarṣa̍nnasmi|"
        },
        {
          "id": "tb-2-8-8-28",
          "chunkNumber": 28,
          "sanskrit": "māma̍dantya̠hama̍dmya̠nyān a̠hagͫ sada̠mṛto̍ bhavāmi|"
        },
        {
          "id": "tb-2-8-8-29",
          "chunkNumber": 29,
          "sanskrit": "madā̍di̠tyā adhi̠ sarve̍ tapanti||"
        },
        {
          "id": "tb-2-8-8-30",
          "chunkNumber": 30,
          "sanskrit": "de̠vīvm̐vāca̍majanayanta de̠vāḥ|"
        },
        {
          "id": "tb-2-8-8-31",
          "chunkNumber": 31,
          "sanskrit": "tāvm̐vi̠śvarū̍pāḥ pa̠śavo̍ vadanti|"
        },
        {
          "id": "tb-2-8-8-32",
          "chunkNumber": 32,
          "sanskrit": "sā no̍ ma̠ndreṣa̠mūrjaṃ̠ duhā̍nā|"
        },
        {
          "id": "tb-2-8-8-33",
          "chunkNumber": 33,
          "sanskrit": "dhe̠nurvāga̠smānupa̠ suṣṭu̠taitu̍||"
        },
        {
          "id": "tb-2-8-8-34",
          "chunkNumber": 34,
          "sanskrit": "yad vāgvada̍ntyaviceta̠nāni̍|"
        },
        {
          "id": "tb-2-8-8-35",
          "chunkNumber": 35,
          "sanskrit": "rāṣṭrī̍ de̠vānāṃ̎ niṣa̠sāda̍ ma̠ndrā|"
        },
        {
          "id": "tb-2-8-8-36",
          "chunkNumber": 36,
          "sanskrit": "cata̍sra̠ ūrjaṃ̍ duduhe̠ payā̍gͫsi|"
        },
        {
          "id": "tb-2-8-8-37",
          "chunkNumber": 37,
          "sanskrit": "kva̍ svi dasyāḥ para̠maṃ ja̍gāma||"
        },
        {
          "id": "tb-2-8-8-38",
          "chunkNumber": 38,
          "sanskrit": ", yadvāgvada̍nti ||"
        },
        {
          "id": "tb-2-8-8-39",
          "chunkNumber": 39,
          "sanskrit": "a̠na̠ntāmantā̠dadhi̠ nirmi̍tāṃ ma̠hīm|"
        },
        {
          "id": "tb-2-8-8-40",
          "chunkNumber": 40,
          "sanskrit": "yasyāṃ̎ de̠vā a̍dadhu̠r bhoja̍nāni|"
        },
        {
          "id": "tb-2-8-8-41",
          "chunkNumber": 41,
          "sanskrit": "ekā̎khṣarāṃ dvi̠padā̠g̠ͫ ṣaṭpa̍dāñca|"
        },
        {
          "id": "tb-2-8-8-42",
          "chunkNumber": 42,
          "sanskrit": "vācaṃ̍ de̠vā upa̍jīvanti̠ viśve̎||"
        },
        {
          "id": "tb-2-8-8-43",
          "chunkNumber": 43,
          "sanskrit": "vācaṃ̍ de̠vā upa̍jīvanti̠ viśve̎|"
        },
        {
          "id": "tb-2-8-8-44",
          "chunkNumber": 44,
          "sanskrit": "vācaṃ̍ gandha̠rvāḥ pa̠śavo̍ manu̠ṣyāḥ̎|"
        },
        {
          "id": "tb-2-8-8-45",
          "chunkNumber": 45,
          "sanskrit": "vā̠cīmā viśvā̠ bhuva̍nā̠nyarpi̍tā sā no̠ havaṃ̍ juṣatā̠mindra̍patnī||"
        },
        {
          "id": "tb-2-8-8-46",
          "chunkNumber": 46,
          "sanskrit": "vāga̠khṣaraṃ̍ prathama̠jā ṛ̠tasya̍|"
        },
        {
          "id": "tb-2-8-8-47",
          "chunkNumber": 47,
          "sanskrit": "vedā̍nāṃ mā̠tā'mṛta̍sya̠ nābhiḥ̍|"
        },
        {
          "id": "tb-2-8-8-48",
          "chunkNumber": 48,
          "sanskrit": "sā no̍ juṣā̠ṇopa̍ ya̠jñamāgā̎t|"
        },
        {
          "id": "tb-2-8-8-49",
          "chunkNumber": 49,
          "sanskrit": "ava̍ntī de̠vī su̠havā̍ me astu||"
        },
        {
          "id": "tb-2-8-8-50",
          "chunkNumber": 50,
          "sanskrit": "yā mṛṣa̍yo mantra̠kṛto̍ manī̠ṣiṇaḥ̍|"
        },
        {
          "id": "tb-2-8-8-51",
          "chunkNumber": 51,
          "sanskrit": "a̠nvaiccha̍n de̠vāstapa̍sā̠ śrame̍ṇa|"
        },
        {
          "id": "tb-2-8-8-52",
          "chunkNumber": 52,
          "sanskrit": "tāṃ de̠vīvm̐vāca̍gͫ ha̠viṣā̍ yajāmahe|"
        },
        {
          "id": "tb-2-8-8-53",
          "chunkNumber": 53,
          "sanskrit": "sā no̍ dadhātu sukṛ̠tasya̍ lo̠ke||"
        },
        {
          "id": "tb-2-8-8-54",
          "chunkNumber": 54,
          "sanskrit": "ca̠tvāri̠ vāk pari̍mitā pa̠dāni̍ tāni̍ vidur brāhma̠ṇā ye ma̍nī̠ṣiṇaḥ̍|"
        },
        {
          "id": "tb-2-8-8-55",
          "chunkNumber": 55,
          "sanskrit": "guhā̠ trīṇi̠ nihi̍tā̠ neṅga̍yanti|"
        },
        {
          "id": "tb-2-8-8-56",
          "chunkNumber": 56,
          "sanskrit": "tu̠rīya̍vm̐vā̠co ma̍nu̠ṣyā̍ vadanti||"
        },
        {
          "id": "tb-2-8-8-57",
          "chunkNumber": 57,
          "sanskrit": "śra̠ddhayā̠'gniḥ sami̍ddhyate|"
        },
        {
          "id": "tb-2-8-8-58",
          "chunkNumber": 58,
          "sanskrit": "śra̠ddhayā̍ vindate ha̠viḥ|"
        },
        {
          "id": "tb-2-8-8-59",
          "chunkNumber": 59,
          "sanskrit": "śra̠ddhāṃ bhaga̍sya mū̠rddhani̍|"
        },
        {
          "id": "tb-2-8-8-60",
          "chunkNumber": 60,
          "sanskrit": "vaca̠sā''ve̍dayāmasi||"
        },
        {
          "id": "tb-2-8-8-61",
          "chunkNumber": 61,
          "sanskrit": "pri̠yagͫͫ śra̍ddhe̠ dada̍taḥ|"
        },
        {
          "id": "tb-2-8-8-62",
          "chunkNumber": 62,
          "sanskrit": "pri̠yagͫͫ śra̍ddhe̠ didā̍sataḥ|"
        },
        {
          "id": "tb-2-8-8-63",
          "chunkNumber": 63,
          "sanskrit": "pri̠yaṃ bho̠jeṣu̠ yajva̍su i̠daṃ ma̍ udi̠taṃ kṛ̍dhi||"
        },
        {
          "id": "tb-2-8-8-64",
          "chunkNumber": 64,
          "sanskrit": "yathā̍ de̠vā asu̍reṣu|"
        },
        {
          "id": "tb-2-8-8-65",
          "chunkNumber": 65,
          "sanskrit": "śra̠ddhāmu̠greṣu̍ cakri̠re|"
        },
        {
          "id": "tb-2-8-8-66",
          "chunkNumber": 66,
          "sanskrit": "e̠vaṃ bho̠jeṣu̠ yajva̍su|"
        },
        {
          "id": "tb-2-8-8-67",
          "chunkNumber": 67,
          "sanskrit": "a̠smāka̍mudi̠taṃ kṛ̍dhi||"
        },
        {
          "id": "tb-2-8-8-68",
          "chunkNumber": 68,
          "sanskrit": "śra̠ddhāṃ de̍vā̠ yaja̍mānāḥ|"
        },
        {
          "id": "tb-2-8-8-69",
          "chunkNumber": 69,
          "sanskrit": "vā̠yugo̍pā̠ upā̍sate|"
        },
        {
          "id": "tb-2-8-8-70",
          "chunkNumber": 70,
          "sanskrit": "śra̠ddhāgͫ hṛ̍da̠yya̍yā''kū̎tyā|"
        },
        {
          "id": "tb-2-8-8-71",
          "chunkNumber": 71,
          "sanskrit": "śra̠ddhayā̍ hūyate ha̠viḥ||"
        },
        {
          "id": "tb-2-8-8-72",
          "chunkNumber": 72,
          "sanskrit": "śra̠ddhāṃ prā̠tarha̍vāmahe śra̠ddhāṃ ma̠ddhyandi̍naṃ̠ pari̍|"
        },
        {
          "id": "tb-2-8-8-73",
          "chunkNumber": 73,
          "sanskrit": "śra̠ddhāgͫ sūrya̍sya ni̠mruci̍|"
        },
        {
          "id": "tb-2-8-8-74",
          "chunkNumber": 74,
          "sanskrit": "śraddhe̠ śraddhā̍paye̠ha mā̎||"
        },
        {
          "id": "tb-2-8-8-75",
          "chunkNumber": 75,
          "sanskrit": "śra̠ddhā de̠vānadhi̍vaste|"
        },
        {
          "id": "tb-2-8-8-76",
          "chunkNumber": 76,
          "sanskrit": "śra̠ddhā viśva̍mi̠daṃ jaga̍t|"
        },
        {
          "id": "tb-2-8-8-77",
          "chunkNumber": 77,
          "sanskrit": "śra̠ddhāṃ kāma̍sya mā̠tara̎m|"
        },
        {
          "id": "tb-2-8-8-78",
          "chunkNumber": 78,
          "sanskrit": "ha̠viṣā̍ varddhayāmasi||"
        },
        {
          "id": "tb-2-8-8-79",
          "chunkNumber": 79,
          "sanskrit": "brahma̍jajñā̠naṃ pra̍tha̠maṃ pu̠rastā̎t|"
        },
        {
          "id": "tb-2-8-8-80",
          "chunkNumber": 80,
          "sanskrit": "vi sī̍ma̠taḥ su̠ruco̍ ve̠na ā̍vaḥ|"
        },
        {
          "id": "tb-2-8-8-81",
          "chunkNumber": 81,
          "sanskrit": "sa bu̠ddhniyā̍ upa̠mā a̍sya vi̠ṣṭhāḥ sa̠taśca̠ yoni̠masa̍taśca̠ vivaḥ̍||"
        },
        {
          "id": "tb-2-8-8-82",
          "chunkNumber": 82,
          "sanskrit": "pi̠tā vi̠rājā̍mṛṣa̠bho ra̍yī̠ṇām|"
        },
        {
          "id": "tb-2-8-8-83",
          "chunkNumber": 83,
          "sanskrit": "a̠ntari̍khṣavm̐vi̠śvarū̍pa̠ āvi̍veśa|"
        },
        {
          "id": "tb-2-8-8-84",
          "chunkNumber": 84,
          "sanskrit": "tama̠rkaira̠bhya̍rcanti va̠thsam|"
        },
        {
          "id": "tb-2-8-8-85",
          "chunkNumber": 85,
          "sanskrit": "brahma̠ santaṃ̠ brahma̍ṇā va̠rddhaya̍ntaḥ||"
        },
        {
          "id": "tb-2-8-8-86",
          "chunkNumber": 86,
          "sanskrit": "brahma̍ de̠vāna̍janayat|"
        },
        {
          "id": "tb-2-8-8-87",
          "chunkNumber": 87,
          "sanskrit": "brahma̠ viśva̍mi̠daṃ jaga̍t|"
        },
        {
          "id": "tb-2-8-8-88",
          "chunkNumber": 88,
          "sanskrit": "brahma̍ṇaḥ khṣa̠traṃ nirmi̍tam|"
        },
        {
          "id": "tb-2-8-8-89",
          "chunkNumber": 89,
          "sanskrit": "brahma̍ brāhma̠ṇa ā̠tmanā̎||"
        },
        {
          "id": "tb-2-8-8-90",
          "chunkNumber": 90,
          "sanskrit": "a̠ntara̍sminni̠me lo̠kāḥ a̠ntar viśva̍mi̠daṃ jaga̍t|"
        },
        {
          "id": "tb-2-8-8-91",
          "chunkNumber": 91,
          "sanskrit": "brahmai̠va bhū̠tānāṃ̠ jyeṣṭha̎m|"
        },
        {
          "id": "tb-2-8-8-92",
          "chunkNumber": 92,
          "sanskrit": "tena̠ ko̍'rhati̠ sparddhi̍tum||"
        },
        {
          "id": "tb-2-8-8-93",
          "chunkNumber": 93,
          "sanskrit": "brahma̍n de̠vāstraya̍strigͫśat|"
        },
        {
          "id": "tb-2-8-8-94",
          "chunkNumber": 94,
          "sanskrit": "brahma̍nnindra prajāpa̠tī|"
        },
        {
          "id": "tb-2-8-8-95",
          "chunkNumber": 95,
          "sanskrit": "brahma̍nha̠ viśvā̍ bhū̠tāni̍|"
        },
        {
          "id": "tb-2-8-8-96",
          "chunkNumber": 96,
          "sanskrit": "nā̠vī vā̠ntaḥ sa̠māhi̍tā||"
        },
        {
          "id": "tb-2-8-8-97",
          "chunkNumber": 97,
          "sanskrit": "cata̍sra̠ āśāḥ̠ praca̍rantva̠gnayaḥ̍|"
        },
        {
          "id": "tb-2-8-8-98",
          "chunkNumber": 98,
          "sanskrit": "i̠manno̍ ya̠jñaṃ na̍yatu prajā̠nann|"
        },
        {
          "id": "tb-2-8-8-99",
          "chunkNumber": 99,
          "sanskrit": "ghṛ̠taṃ pinva̍nna̠jara̍gͫ su̠vīra̎m brahma̍ sa̠midbha̍va̠tyāhu̍tīnām||"
        },
        {
          "id": "tb-2-8-8-100",
          "chunkNumber": 100,
          "sanskrit": "ā gāvo̍ agmannu̠ta bha̠drama̍krann|"
        },
        {
          "id": "tb-2-8-8-101",
          "chunkNumber": 101,
          "sanskrit": "sīda̍ntu go̠ṣṭhe ra̠ṇaya̍ntva̠sme|"
        },
        {
          "id": "tb-2-8-8-102",
          "chunkNumber": 102,
          "sanskrit": "pra̠jāva̍tīḥ puru̠rūpā̍ i̠ha syuḥ|"
        },
        {
          "id": "tb-2-8-8-103",
          "chunkNumber": 103,
          "sanskrit": "indrā̍ya pū̠rvī ru̠ṣaso̠ duhā̍nāḥ||"
        },
        {
          "id": "tb-2-8-8-104",
          "chunkNumber": 104,
          "sanskrit": "indro̠ yajva̍ne pṛṇa̠te ca̍ śikhṣati|"
        },
        {
          "id": "tb-2-8-8-105",
          "chunkNumber": 105,
          "sanskrit": "upedda̍dāti̠ na svaṃ mu̍ṣāyati|"
        },
        {
          "id": "tb-2-8-8-106",
          "chunkNumber": 106,
          "sanskrit": "bhūyo̍ bhūyo ra̠yimida̍sya va̠rddhaya̍nn|"
        },
        {
          "id": "tb-2-8-8-107",
          "chunkNumber": 107,
          "sanskrit": "abhi̍nne khi̠lle nida̍dhāti deva̠yum||"
        },
        {
          "id": "tb-2-8-8-108",
          "chunkNumber": 108,
          "sanskrit": "na tā na̍śanti̠ na da̍bhāti̠ taska̍raḥ|"
        },
        {
          "id": "tb-2-8-8-109",
          "chunkNumber": 109,
          "sanskrit": "nainā̍ ami̠tro vyathi̠rāda̍dharṣati|"
        },
        {
          "id": "tb-2-8-8-110",
          "chunkNumber": 110,
          "sanskrit": "de̠vāgͫͫśca̠ yābhi̠r yaja̍te̠ dadā̍ti ca|"
        },
        {
          "id": "tb-2-8-8-111",
          "chunkNumber": 111,
          "sanskrit": "jyogittābhiḥ̍ sacate̠ gopa̍tiḥ sa̠ha||"
        },
        {
          "id": "tb-2-8-8-112",
          "chunkNumber": 112,
          "sanskrit": "na tā arvā̍ re̠ṇuka̍kāṭo aśnute|"
        },
        {
          "id": "tb-2-8-8-113",
          "chunkNumber": 113,
          "sanskrit": "na sa̍gͫͫ skṛta̠tramupa̍yanti̠ , gāvo̠ bhago̠ gāva̠ indro̍ me acchāt|"
        },
        {
          "id": "tb-2-8-8-114",
          "chunkNumber": 114,
          "sanskrit": "gāvaḥ̠ soma̍sya pratha̠masya̍ bha̠khṣaḥ|"
        },
        {
          "id": "tb-2-8-8-115",
          "chunkNumber": 115,
          "sanskrit": "i̠mā yā gāvaḥ̠ saja̍nāsa̠ indraḥ̍|"
        },
        {
          "id": "tb-2-8-8-116",
          "chunkNumber": 116,
          "sanskrit": "i̠cchāmīddhṛ̠dā mana̍sā ci̠dindra̎m||"
        },
        {
          "id": "tb-2-8-8-117",
          "chunkNumber": 117,
          "sanskrit": "yū̠yaṃ gā̍vo medayathā kṛ̠śaṃ ci̍t|"
        },
        {
          "id": "tb-2-8-8-118",
          "chunkNumber": 118,
          "sanskrit": "a̠ślī̠laṃ ci̍t kṛṇuthā su̠pratī̍kam|"
        },
        {
          "id": "tb-2-8-8-119",
          "chunkNumber": 119,
          "sanskrit": "bha̠draṃ gṛ̠haṃ kṛ̍ṇutha bhadravācaḥ|"
        },
        {
          "id": "tb-2-8-8-120",
          "chunkNumber": 120,
          "sanskrit": "bṛ̠hadvo̠ vaya̍ ucyate sa̠bhāsu̍||"
        },
        {
          "id": "tb-2-8-8-121",
          "chunkNumber": 121,
          "sanskrit": "pra̠jāva̍tīḥ sū̠yava̍sagͫ ri̠śantīḥ̎ (ru̠śantīḥ̎)|"
        },
        {
          "id": "tb-2-8-8-122",
          "chunkNumber": 122,
          "sanskrit": "śu̠ddhā a̠paḥ su̍prapā̠ṇe piba̍ntīḥ|"
        },
        {
          "id": "tb-2-8-8-123",
          "chunkNumber": 123,
          "sanskrit": "mā vaḥ̍ ste̠na ī̍śata̠ mā'ghaśa̍gͫsaḥ|"
        },
        {
          "id": "tb-2-8-8-124",
          "chunkNumber": 124,
          "sanskrit": "pari̍vo he̠tī ru̠drasya̍ vṛñjyāt||"
        },
        {
          "id": "tb-2-8-8-125",
          "chunkNumber": 125,
          "sanskrit": "upe̠damu̍pa̠parca̍nam|"
        },
        {
          "id": "tb-2-8-8-126",
          "chunkNumber": 126,
          "sanskrit": "ā̠su goṣūpa̍pṛcyatām|"
        },
        {
          "id": "tb-2-8-8-127",
          "chunkNumber": 127,
          "sanskrit": "upa̍rṣa̠bhasya̠ reta̍si|"
        },
        {
          "id": "tb-2-8-8-128",
          "chunkNumber": 128,
          "sanskrit": "upe̎ndra̠ tava̍ vī̠rye̎"
        }
      ]
    },
    {
      "id": "taittiriya-brahmana-2-8-9",
      "title": "Aṣṭaka 2 · Prapāṭhaka 8 · Anuvāka 9",
      "sectionNumber": 9,
      "chunks": [
        {
          "id": "tb-2-8-9-1",
          "chunkNumber": 1,
          "sanskrit": "tā sū̎ryā candra̠masā̍ viśva̠bhṛtta̍mā ma̠hat|",
          "section": 9
        },
        {
          "id": "tb-2-8-9-2",
          "chunkNumber": 2,
          "sanskrit": "tejo̠ vasu̍madrājato di̠vi|"
        },
        {
          "id": "tb-2-8-9-3",
          "chunkNumber": 3,
          "sanskrit": "sāmā̎tmānā carataḥ sāmacā̠riṇā̎|"
        },
        {
          "id": "tb-2-8-9-4",
          "chunkNumber": 4,
          "sanskrit": "yayo̎rvra̠taṃ na ma̠me jātu̍ de̠vayoḥ̎||"
        },
        {
          "id": "tb-2-8-9-5",
          "chunkNumber": 5,
          "sanskrit": "u̠bhāvantau̠ pari̍yāta̠ armyā̎|"
        },
        {
          "id": "tb-2-8-9-6",
          "chunkNumber": 6,
          "sanskrit": "di̠vo na ra̠śmīgͫͫ sta̍nu̠tovya̍rṇa̠ve|"
        },
        {
          "id": "tb-2-8-9-7",
          "chunkNumber": 7,
          "sanskrit": "u̠bhā bhu̍va̠ntī bhuva̍nā ka̠vikra̍tū|"
        },
        {
          "id": "tb-2-8-9-8",
          "chunkNumber": 8,
          "sanskrit": "sūryā̠ na ca̠ndrā ca̍rato ha̠tāma̍tī||"
        },
        {
          "id": "tb-2-8-9-9",
          "chunkNumber": 9,
          "sanskrit": "patī̎ dyu̠mad vi̍śva̠vidā̍ u̠bhā di̠vaḥ|"
        },
        {
          "id": "tb-2-8-9-10",
          "chunkNumber": 10,
          "sanskrit": "sūryā̍ u̠bhā ca̠ndrama̍sā vicakhṣa̠ṇā vi̠śvavā̍rā varivo̠bhā vare̎ṇyā|"
        },
        {
          "id": "tb-2-8-9-11",
          "chunkNumber": 11,
          "sanskrit": "tā no̍'vataṃ mati̠mantā̠ mahi̍vratā||"
        },
        {
          "id": "tb-2-8-9-12",
          "chunkNumber": 12,
          "sanskrit": "vi̠śva̠vapa̍rī pra̠tara̍ṇā tara̠ntā|"
        },
        {
          "id": "tb-2-8-9-13",
          "chunkNumber": 13,
          "sanskrit": "su̠va̠rvidā̍ dṛ̠śaye̠ bhūri̍raśmī|"
        },
        {
          "id": "tb-2-8-9-14",
          "chunkNumber": 14,
          "sanskrit": "sūryā̠ hi ca̠ndrā vasu̍tve̠ṣada̍rśatā|"
        },
        {
          "id": "tb-2-8-9-15",
          "chunkNumber": 15,
          "sanskrit": "ma̠na̠svino̠bhā'nu̍ cara̠to nu̠ saṃ diva̎m||"
        },
        {
          "id": "tb-2-8-9-16",
          "chunkNumber": 16,
          "sanskrit": "a̠sya śravo̍ na̠dyaḥ̍ sa̠pta bi̍bhrati|"
        },
        {
          "id": "tb-2-8-9-17",
          "chunkNumber": 17,
          "sanskrit": "dyāvā̠ khṣāmā̍ pṛthi̠vī da̍rśa̠tavm̐vapuḥ̍|"
        },
        {
          "id": "tb-2-8-9-18",
          "chunkNumber": 18,
          "sanskrit": "a̠sme sū̎ryā candra̠masā̍'bhi̠cakhṣe̎|"
        },
        {
          "id": "tb-2-8-9-19",
          "chunkNumber": 19,
          "sanskrit": "śra̠ddhe kami̍ndra carato vicartu̠ram pū̠rvā̠pa̠raṃ ca̍rato mā̠ya yai̠tau|"
        },
        {
          "id": "tb-2-8-9-20",
          "chunkNumber": 20,
          "sanskrit": "śiśū̠ krīḍa̍ntau̠ pari̍yāto addhva̠ram|"
        },
        {
          "id": "tb-2-8-9-21",
          "chunkNumber": 21,
          "sanskrit": "viśvā̎nya̠nyo bhuva̍nā'bhi̠caṣṭe̎|"
        },
        {
          "id": "tb-2-8-9-22",
          "chunkNumber": 22,
          "sanskrit": "ṛ̠tūna̠nyo vi̠dadha̍jjāyate̠ punaḥ̍||"
        },
        {
          "id": "tb-2-8-9-23",
          "chunkNumber": 23,
          "sanskrit": "hira̍ṇyavarṇāḥ̠ śuca̍yaḥ pāva̠kā , yāsā̠g̠ͫ rājā̎"
        },
        {
          "id": "tb-2-8-9-24",
          "chunkNumber": 24,
          "sanskrit": "yāsāṃ̎ de̠vā di̠vi kṛ̠ṇvanti̍ bha̠khṣaym̐yā a̠ntari̍khṣe bahu̠dhā bhava̍nti|"
        },
        {
          "id": "tb-2-8-9-25",
          "chunkNumber": 25,
          "sanskrit": "yāḥ pṛ̍thi̠vīṃ paya̍so̠ndanti̍śu̠krāstā na̠ āpaḥ̠ śagͫͫ syo̠nā bha̍vantu||"
        },
        {
          "id": "tb-2-8-9-26",
          "chunkNumber": 26,
          "sanskrit": "śi̠vena̍ mā̠ cakhṣu̍ṣā paśyatā''paḥ śi̠vayā̍ ta̠nuvopa̍ spṛśata̠ tvacaṃ̍ me|"
        },
        {
          "id": "tb-2-8-9-27",
          "chunkNumber": 27,
          "sanskrit": "sarvā̍gͫ a̠gnīgͫ ra̍phsu̠ṣado̍ huve vo̠ mayi̠ varco̠ bala̠mojo̠ ni dha̍tta||"
        },
        {
          "id": "tb-2-8-9-28",
          "chunkNumber": 28,
          "sanskrit": ","
        },
        {
          "id": "tb-2-8-9-29",
          "chunkNumber": 29,
          "sanskrit": "āpo̍ bha̠drā ghṛ̠tamidāpa̍ āsura̠gnīṣomau̍ bibhra̠tyāpa̠ it tāḥ|"
        },
        {
          "id": "tb-2-8-9-30",
          "chunkNumber": 30,
          "sanskrit": "tī̠vro raso̍ madhu̠pṛcā̍ maraṃga̠ma ā mā̎ prā̠ṇena̍ sa̠ha varca̍sā gan||"
        },
        {
          "id": "tb-2-8-9-31",
          "chunkNumber": 31,
          "sanskrit": "ādit pa̍śyāmyu̠ta vā̍ śṛṇo̠myā mā̠ ghoṣo̍ gacchati̠ vāṅna̍ āsām|"
        },
        {
          "id": "tb-2-8-9-32",
          "chunkNumber": 32,
          "sanskrit": "manye̍ bhejā̠no a̠mṛta̍sya̠ tarhi̠ hira̍ṇyavarṇā̠ atṛ̍paym̐ya̠dā vaḥ̍||"
        },
        {
          "id": "tb-2-8-9-33",
          "chunkNumber": 33,
          "sanskrit": ", āditpa̍śyāmi ||"
        },
        {
          "id": "tb-2-8-9-34",
          "chunkNumber": 34,
          "sanskrit": "nāsa̍dāsī̠nno sadā̍sīt ta̠dānī̎m|"
        },
        {
          "id": "tb-2-8-9-35",
          "chunkNumber": 35,
          "sanskrit": "nāsī̠drajo̠ no vyo̍māpa̠ro yat|"
        },
        {
          "id": "tb-2-8-9-36",
          "chunkNumber": 36,
          "sanskrit": "kimāva̍rīvaḥ̠ kuha̠ kasya̠ śarma̍nn ambhaḥ̠ kimā̍sī̠d gaha̍naṃ gabhī̠ram||"
        },
        {
          "id": "tb-2-8-9-37",
          "chunkNumber": 37,
          "sanskrit": "na mṛ̠tyura̠mṛtaṃ̠ tarhi̠ na|"
        },
        {
          "id": "tb-2-8-9-38",
          "chunkNumber": 38,
          "sanskrit": "rātri̍yā̠ ahna̍ āsīt prake̠taḥ|"
        },
        {
          "id": "tb-2-8-9-39",
          "chunkNumber": 39,
          "sanskrit": "ānī̍davā̠tagͫͫ sva̠dhayā̠ tadeka̎m|"
        },
        {
          "id": "tb-2-8-9-40",
          "chunkNumber": 40,
          "sanskrit": "tasmā̎ddhā̠nyaṃ na pa̠raḥ (pa̠raṃ) kiṃca̠ nāsa̍||"
        },
        {
          "id": "tb-2-8-9-41",
          "chunkNumber": 41,
          "sanskrit": "tama̍ āsī̠t tama̍sā gū̠ḍhamagre̎ prake̠tam|"
        },
        {
          "id": "tb-2-8-9-42",
          "chunkNumber": 42,
          "sanskrit": "sa̠li̠lagͫ sarva̍mā i̠dam|"
        },
        {
          "id": "tb-2-8-9-43",
          "chunkNumber": 43,
          "sanskrit": "tu̠cche nā̠bhvapi̍hita̠ym̐yadāsī̎t|"
        },
        {
          "id": "tb-2-8-9-44",
          "chunkNumber": 44,
          "sanskrit": "tama̍sa̠ stanma̍hi̠nā jā̍ya̠taika̎m||"
        },
        {
          "id": "tb-2-8-9-45",
          "chunkNumber": 45,
          "sanskrit": "kāma̠stadagre̠ sama̍vartta̠tādhi̍ mana̍so̠ retaḥ̍ pratha̠maym̐yadāsī̎t|"
        },
        {
          "id": "tb-2-8-9-46",
          "chunkNumber": 46,
          "sanskrit": "sa̠ to bandhu̠masa̍ti̠ nira̍vindann (nira̍vidann)|"
        },
        {
          "id": "tb-2-8-9-47",
          "chunkNumber": 47,
          "sanskrit": "hṛ̠di pra̠tīṣyā̍ ka̠vayo̍ manī̠ṣā||"
        },
        {
          "id": "tb-2-8-9-48",
          "chunkNumber": 48,
          "sanskrit": "ti̠ra̠ścīno̠ vita̍to ra̠śmire̍ṣām|"
        },
        {
          "id": "tb-2-8-9-49",
          "chunkNumber": 49,
          "sanskrit": "a̠dhaḥ svi̍dā̠sī(3) du̠pari̍ svidāsī(3)t|"
        },
        {
          "id": "tb-2-8-9-50",
          "chunkNumber": 50,
          "sanskrit": "re̠to̠dhā ā̍san mahi̠māna̍ āsann|"
        },
        {
          "id": "tb-2-8-9-51",
          "chunkNumber": 51,
          "sanskrit": "sva̠dhā a̠vastā̠t praya̍tiḥ pa̠rastā̎t||"
        },
        {
          "id": "tb-2-8-9-52",
          "chunkNumber": 52,
          "sanskrit": "ko a̠ddhā ve̍da̠ ka i̠ha pravo̍cat|"
        },
        {
          "id": "tb-2-8-9-53",
          "chunkNumber": 53,
          "sanskrit": "kuta̠ ājā̍tā̠ kuta̍ i̠yavm̐visṛ̍ṣṭiḥ|"
        },
        {
          "id": "tb-2-8-9-54",
          "chunkNumber": 54,
          "sanskrit": "a̠rvāgde̠vā a̠sya vi̠sarja̍nāya athā̠ ko ve̍da̠ yata̍ āba̠bhūva̍||"
        },
        {
          "id": "tb-2-8-9-55",
          "chunkNumber": 55,
          "sanskrit": "i̠yavm̐visṛ̍ṣṭi̠r yata̍ āba̠bhūva̍|"
        },
        {
          "id": "tb-2-8-9-56",
          "chunkNumber": 56,
          "sanskrit": "yadi̍ vā da̠dhe yadi̍ vā̠ na|"
        },
        {
          "id": "tb-2-8-9-57",
          "chunkNumber": 57,
          "sanskrit": "yo a̠syāddhya̍khṣaḥ para̠me vyo̍mann|"
        },
        {
          "id": "tb-2-8-9-58",
          "chunkNumber": 58,
          "sanskrit": "so a̠ṅga ve̍da̠ yadi̍ vā̠ na veda̍||"
        },
        {
          "id": "tb-2-8-9-59",
          "chunkNumber": 59,
          "sanskrit": "kigͫͫsvi̠dvanaṃ̠ ka u̠ sa vṛ̠khṣa ā̍sīt|"
        },
        {
          "id": "tb-2-8-9-60",
          "chunkNumber": 60,
          "sanskrit": "yato̠ dyāvā̍pṛthi̠vī ni̍ṣṭata̠khṣuḥ|"
        },
        {
          "id": "tb-2-8-9-61",
          "chunkNumber": 61,
          "sanskrit": "manī̍ṣiṇo̠ mana̍sā pṛ̠cchatedu̠ tat|"
        },
        {
          "id": "tb-2-8-9-62",
          "chunkNumber": 62,
          "sanskrit": "yada̠ddhyati̍ṣṭha̠dbhuva̍nāni dhā̠raya̍nn||"
        },
        {
          "id": "tb-2-8-9-63",
          "chunkNumber": 63,
          "sanskrit": "brahma̠ vanaṃ̠ brahma̠ sa vṛ̠khṣa ā̍sīt yato̠ dyāvā̍pṛthi̠vī ni̍ṣṭata̠khṣuḥ|"
        },
        {
          "id": "tb-2-8-9-64",
          "chunkNumber": 64,
          "sanskrit": "manī̍ṣiṇo̠ mana̍sā̠ vibra̍vīmi vaḥ|"
        },
        {
          "id": "tb-2-8-9-65",
          "chunkNumber": 65,
          "sanskrit": "brahmā̠ddhyati̍ṣṭha̠d bhuva̍nāni dhā̠raya̍nn||"
        },
        {
          "id": "tb-2-8-9-66",
          "chunkNumber": 66,
          "sanskrit": "prā̠tara̠gniṃ prā̠tarindra̍gͫ havāmahe|"
        },
        {
          "id": "tb-2-8-9-67",
          "chunkNumber": 67,
          "sanskrit": "prā̠ta rmi̠trāvaru̍ṇā prā̠tara̠śvinā̎|"
        },
        {
          "id": "tb-2-8-9-68",
          "chunkNumber": 68,
          "sanskrit": "prā̠ta rbhagaṃ̍ pū̠ṣaṇaṃ̠ brahma̍ṇa̠spati̎m|"
        },
        {
          "id": "tb-2-8-9-69",
          "chunkNumber": 69,
          "sanskrit": "prā̠tassoma̍mu̠ta ru̠dragͫ hu̍vema||"
        },
        {
          "id": "tb-2-8-9-70",
          "chunkNumber": 70,
          "sanskrit": "prā̠ta̠rjitaṃ̠ bhaga̍mu̠gragͫ hu̍vema|"
        },
        {
          "id": "tb-2-8-9-71",
          "chunkNumber": 71,
          "sanskrit": "va̠yaṃ pu̠tramadi̍te̠ryo vi̍dha̠rtā|"
        },
        {
          "id": "tb-2-8-9-72",
          "chunkNumber": 72,
          "sanskrit": "ā̠ddhraści̠dyaṃ manya̍mānastu̠raści̍t rājā̍ ci̠dyaṃ bhagaṃ̍ bha̠khṣītyāha̍||"
        },
        {
          "id": "tb-2-8-9-73",
          "chunkNumber": 73,
          "sanskrit": "bhaga̠ praṇe̍ta̠rbhaga̠ satya̍rādhaḥ|"
        },
        {
          "id": "tb-2-8-9-74",
          "chunkNumber": 74,
          "sanskrit": "bhage̠māṃ dhiya̠muda̍va̠ dada̍nnaḥ|"
        },
        {
          "id": "tb-2-8-9-75",
          "chunkNumber": 75,
          "sanskrit": "bhaga̠ praṇo̍ janaya̠ gobhi̠raśvaiḥ̎|"
        },
        {
          "id": "tb-2-8-9-76",
          "chunkNumber": 76,
          "sanskrit": "bhaga̠ pranṛbhi̍rnṛ̠vantaḥ̍ syāma|"
        },
        {
          "id": "tb-2-8-9-77",
          "chunkNumber": 77,
          "sanskrit": "u̠tedānīṃ̠ bhaga̍vantaḥ syāma||"
        },
        {
          "id": "tb-2-8-9-78",
          "chunkNumber": 78,
          "sanskrit": "u̠ta prapi̠tva u̠ta maddhye̠ ahnā̎m|"
        },
        {
          "id": "tb-2-8-9-79",
          "chunkNumber": 79,
          "sanskrit": "u̠todi̍tā maghava̠nthsūrya̍sya|"
        },
        {
          "id": "tb-2-8-9-80",
          "chunkNumber": 80,
          "sanskrit": "va̠yaṃ de̠vānā̍gͫ suma̠tau syā̍ma||"
        },
        {
          "id": "tb-2-8-9-81",
          "chunkNumber": 81,
          "sanskrit": "bhaga̍ e̠va bhaga̍vāgͫ astu devāḥ tena̍ va̠yaṃ bhaga̍vantaḥ syāma|"
        },
        {
          "id": "tb-2-8-9-82",
          "chunkNumber": 82,
          "sanskrit": "taṃ tvā̍ bhaga̠ sarva̠ ijjo̍havīmi|"
        },
        {
          "id": "tb-2-8-9-83",
          "chunkNumber": 83,
          "sanskrit": "sa no̍ bhaga pura e̠tā bha̍ve̠ha||"
        },
        {
          "id": "tb-2-8-9-84",
          "chunkNumber": 84,
          "sanskrit": "sama̍ddhva̠rāyo̠ṣaso̍ namanta|"
        },
        {
          "id": "tb-2-8-9-85",
          "chunkNumber": 85,
          "sanskrit": "da̠dhi̠krāve̍va̠ śuca̍ye pa̠dāya̍|"
        },
        {
          "id": "tb-2-8-9-86",
          "chunkNumber": 86,
          "sanskrit": "a̠rvā̠cī̠navm̐va̍su̠vidaṃ̠ bhaga̍nnaḥ|"
        },
        {
          "id": "tb-2-8-9-87",
          "chunkNumber": 87,
          "sanskrit": "ratha̍mi̠vāśvā̍ vā̠jina̠ āva̍hantu||"
        },
        {
          "id": "tb-2-8-9-88",
          "chunkNumber": 88,
          "sanskrit": "aśvā̍vatī̠r goma̍tīr na u̠ṣāsaḥ̍|"
        },
        {
