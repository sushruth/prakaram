{
  "sections": [
    {
      "id": "taittiriya-aranyaka-5-9",
      "title": "Prapāṭhaka 5 · Anuvāka 9",
      "sectionNumber": 9,
      "chunks": [
        {
          "id": "ta-5-9-1",
          "chunkNumber": 1,
          "sanskrit": "घर्म॒ या ते॑ दि॒वि शुगिति॑ ति॒स्र आहु॑तीर्जुहोति।",
          "section": 9
        },
        {
          "id": "ta-5-9-2",
          "chunkNumber": 2,
          "sanskrit": "छन्दो॑भिरे॒वास्यै॒भ्यो लो॒केभ्यः॒ शुच॒मव॑ यजते।"
        },
        {
          "id": "ta-5-9-3",
          "chunkNumber": 3,
          "sanskrit": "इय॒त्यग्रे॑ जुहोति।"
        },
        {
          "id": "ta-5-9-4",
          "chunkNumber": 4,
          "sanskrit": "अथेय॒त्यथेय॑ति।"
        },
        {
          "id": "ta-5-9-5",
          "chunkNumber": 5,
          "sanskrit": "त्रय॑ इ॒मे लो॒काः।"
        },
        {
          "id": "ta-5-9-6",
          "chunkNumber": 6,
          "sanskrit": "ए॒भ्य ए॒व लो॒केभ्यः॒ शुच॒मव॑ यजते।"
        },
        {
          "id": "ta-5-9-7",
          "chunkNumber": 7,
          "sanskrit": "अनु॑ नो॒ऽद्यानु॑मति॒रित्या॒हानु॑मत्यै।"
        },
        {
          "id": "ta-5-9-8",
          "chunkNumber": 8,
          "sanskrit": "दि॒वस्त्वा॑ पर॒स्पाया॒ इत्या॑ह।"
        },
        {
          "id": "ta-5-9-9",
          "chunkNumber": 9,
          "sanskrit": "दि॒व ए॒वेमाल्ँलो॒कान् दा॑धार।"
        },
        {
          "id": "ta-5-9-10",
          "chunkNumber": 10,
          "sanskrit": "ब्रह्म॑णस्त्वा पर॒स्पाया॒ इत्या॑ह ए॒ष्वे॑व लो॒केषु॑ प्र॒जा दा॑धार।"
        },
        {
          "id": "ta-5-9-11",
          "chunkNumber": 11,
          "sanskrit": "प्रा॒णस्य॑ त्वा पर॒स्पाया॒ इत्या॑ह।"
        },
        {
          "id": "ta-5-9-12",
          "chunkNumber": 12,
          "sanskrit": "प्र॒जास्वे॒व प्रा॒णान् दा॑धार।"
        },
        {
          "id": "ta-5-9-13",
          "chunkNumber": 13,
          "sanskrit": "शिरो॒ वा ए॒तद्य॒ज्ञस्य॑।"
        },
        {
          "id": "ta-5-9-14",
          "chunkNumber": 14,
          "sanskrit": "यत् प्र॑व॒र्ग्यः॑।"
        },
        {
          "id": "ta-5-9-15",
          "chunkNumber": 15,
          "sanskrit": "अ॒सौ खलु॒ वा आ॑दि॒त्यः प्र॑व॒र्ग्यः॑।"
        },
        {
          "id": "ta-5-9-16",
          "chunkNumber": 16,
          "sanskrit": "तय्ँयद्द॑ख्षि॒णा प्र॒त्यञ्च॒मुद॑ञ्चमुद्वा॒सये᳚त्।"
        },
        {
          "id": "ta-5-9-17",
          "chunkNumber": 17,
          "sanskrit": "जि॒ह्मय्ँय॒ज्ञस्य॒ शिरो॑ हरेत्।"
        },
        {
          "id": "ta-5-9-18",
          "chunkNumber": 18,
          "sanskrit": "प्राञ्च॒मुद्वा॑सयति।"
        },
        {
          "id": "ta-5-9-19",
          "chunkNumber": 19,
          "sanskrit": "पु॒रस्ता॑दे॒व य॒ज्ञस्य॒ शिरः॒ प्रति॑दधाति प्राञ्च॒मुद्वा॑सयति।"
        },
        {
          "id": "ta-5-9-20",
          "chunkNumber": 20,
          "sanskrit": "तस्मा॑द॒सावा॑दि॒त्यः पु॒रस्ता॒दुदे॑ति।"
        },
        {
          "id": "ta-5-9-21",
          "chunkNumber": 21,
          "sanskrit": "श॒फो॒प॒य॒मान्ध॒वित्रा॑णि॒ धृष्टी॒ इत्य॒न्वव॑हरन्ति।"
        },
        {
          "id": "ta-5-9-22",
          "chunkNumber": 22,
          "sanskrit": "सात्मा॑नमे॒वैन॒ꣳ॒ सत॑नुम् करोति।"
        },
        {
          "id": "ta-5-9-23",
          "chunkNumber": 23,
          "sanskrit": "सात्मा॒ऽमुष्मि॑ल्ँलो॒के भ॑वति।"
        },
        {
          "id": "ta-5-9-24",
          "chunkNumber": 24,
          "sanskrit": "य ए॒वव्ँवेद॑।"
        },
        {
          "id": "ta-5-9-25",
          "chunkNumber": 25,
          "sanskrit": "औदु॑म्बराणि भवन्ति।"
        },
        {
          "id": "ta-5-9-26",
          "chunkNumber": 26,
          "sanskrit": "ऊर्ग्वा उ॑दु॒म्बरः॑।"
        },
        {
          "id": "ta-5-9-27",
          "chunkNumber": 27,
          "sanskrit": "ऊर्ज॑मे॒वाव॑रुन्धे।"
        },
        {
          "id": "ta-5-9-28",
          "chunkNumber": 28,
          "sanskrit": "वर्त्म॑ना॒ वा अ॒न्वित्य॑ य॒ज्ञꣳ रख्षा॑ꣳसि जिघाꣳसन्ति।"
        },
        {
          "id": "ta-5-9-29",
          "chunkNumber": 29,
          "sanskrit": "साम्ना᳚ प्रस्तो॒ताऽन्ववै॑ति।"
        },
        {
          "id": "ta-5-9-30",
          "chunkNumber": 30,
          "sanskrit": "साम॒ वै र॑ख्षो॒हा।"
        },
        {
          "id": "ta-5-9-31",
          "chunkNumber": 31,
          "sanskrit": "रख्ष॑सा॒मप॑हत्यै।"
        },
        {
          "id": "ta-5-9-32",
          "chunkNumber": 32,
          "sanskrit": "त्रिर्नि॒धन॒मुपै॑ति।"
        },
        {
          "id": "ta-5-9-33",
          "chunkNumber": 33,
          "sanskrit": "त्रय॑ इ॒मे लो॒काः।"
        },
        {
          "id": "ta-5-9-34",
          "chunkNumber": 34,
          "sanskrit": "ए॒भ्य ए॒व लो॒केभ्यो॒ रख्षा॒ꣴ॒स्यप॑हन्ति।"
        },
        {
          "id": "ta-5-9-35",
          "chunkNumber": 35,
          "sanskrit": "पुरु॑षःपुरुषो नि॒धन॒मुपै॑ति।"
        },
        {
          "id": "ta-5-9-36",
          "chunkNumber": 36,
          "sanskrit": "पुरु॑षःपुरुषो॒ हि र॑ख्ष॒स्वी।"
        },
        {
          "id": "ta-5-9-37",
          "chunkNumber": 37,
          "sanskrit": "रख्ष॑सा॒मप॑हत्यै यत् पृ॑थि॒व्यामु॑द्वा॒सये᳚त्।"
        },
        {
          "id": "ta-5-9-38",
          "chunkNumber": 38,
          "sanskrit": "पृ॒थि॒वीꣳ शु॒चाऽर्प॑येत्।"
        },
        {
          "id": "ta-5-9-39",
          "chunkNumber": 39,
          "sanskrit": "यद॒फ्सु।"
        },
        {
          "id": "ta-5-9-40",
          "chunkNumber": 40,
          "sanskrit": "अ॒पः शु॒चार्प॑येत्।"
        },
        {
          "id": "ta-5-9-41",
          "chunkNumber": 41,
          "sanskrit": "यदोष॑धीषु।"
        },
        {
          "id": "ta-5-9-42",
          "chunkNumber": 42,
          "sanskrit": "ओष॑धीः शु॒चाऽर्प॑येत्।"
        },
        {
          "id": "ta-5-9-43",
          "chunkNumber": 43,
          "sanskrit": "यद्वन॒स्पति॑षु।"
        },
        {
          "id": "ta-5-9-44",
          "chunkNumber": 44,
          "sanskrit": "वन॒स्पती᳚ञ्छु॒चाऽर्प॑येत्।"
        },
        {
          "id": "ta-5-9-45",
          "chunkNumber": 45,
          "sanskrit": "हिर॑ण्यन्नि॒धायोद्वा॑सयति।"
        },
        {
          "id": "ta-5-9-46",
          "chunkNumber": 46,
          "sanskrit": "अ मृत॒व्ँवै हिर॑ण्यम् अ॒मृत॑ ए॒वैन॒म् प्रति॑ष्ठापयति।"
        },
        {
          "id": "ta-5-9-47",
          "chunkNumber": 47,
          "sanskrit": "व॒ल्गुर॑सि श॒य्ँयुधा॑या॒ इति॒ त्रिः प॑रिषि॒ञ्चन्पर्ये॑ति।"
        },
        {
          "id": "ta-5-9-48",
          "chunkNumber": 48,
          "sanskrit": "त्रि॒वृद्वा अ॒ग्निः।"
        },
        {
          "id": "ta-5-9-49",
          "chunkNumber": 49,
          "sanskrit": "यावा॑ने॒वाग्निः।"
        },
        {
          "id": "ta-5-9-50",
          "chunkNumber": 50,
          "sanskrit": "तस्य॒ शुच॑ꣳ शमयति।"
        },
        {
          "id": "ta-5-9-51",
          "chunkNumber": 51,
          "sanskrit": "त्रिः पुनः॒ पर्ये॑ति।"
        },
        {
          "id": "ta-5-9-52",
          "chunkNumber": 52,
          "sanskrit": "षट्थ् सम्प॑द्यन्ते।"
        },
        {
          "id": "ta-5-9-53",
          "chunkNumber": 53,
          "sanskrit": "षड्वा ऋ॒तवः॑।"
        },
        {
          "id": "ta-5-9-54",
          "chunkNumber": 54,
          "sanskrit": "ऋ॒तुभि॑रे॒वास्य॒ शुच॑ꣳ शमयति।"
        },
        {
          "id": "ta-5-9-55",
          "chunkNumber": 55,
          "sanskrit": "चतुः॑ स्रक्ति॒र्नाभि॑र्ऋ॒तस्येत्या॑ह इ॒यव्ँवा ऋ॒तम्।"
        },
        {
          "id": "ta-5-9-56",
          "chunkNumber": 56,
          "sanskrit": "तस्या॑ ए॒ष ए॒व नाभिः॑।"
        },
        {
          "id": "ta-5-9-57",
          "chunkNumber": 57,
          "sanskrit": "यत् प्र॑व॒र्ग्यः॑।"
        },
        {
          "id": "ta-5-9-58",
          "chunkNumber": 58,
          "sanskrit": "तस्मा॑दे॒वमा॑ह।"
        },
        {
          "id": "ta-5-9-59",
          "chunkNumber": 59,
          "sanskrit": "सदो॑ वि॒श्वायु॒रित्या॑ह।"
        },
        {
          "id": "ta-5-9-60",
          "chunkNumber": 60,
          "sanskrit": "सदो॒ हीयम्।"
        },
        {
          "id": "ta-5-9-61",
          "chunkNumber": 61,
          "sanskrit": "अप॒ द्वेषो॒ अप॒ ह्वर॒ इत्या॑ह॒ भ्रातृ॑व्यापनुत्त्यै।"
        },
        {
          "id": "ta-5-9-62",
          "chunkNumber": 62,
          "sanskrit": "घर्मै॒तत्तेऽन्न॑मे॒तत् पुरी॑ष॒मिति॑ द॒द्ध्ना म॑धुमि॒श्रेण॑ पूरयति।"
        },
        {
          "id": "ta-5-9-63",
          "chunkNumber": 63,
          "sanskrit": "ऊर्ग्वा अ॒न्नाद्य॒न्दधि॑।"
        },
        {
          "id": "ta-5-9-64",
          "chunkNumber": 64,
          "sanskrit": "ऊ॒र्जैवैन॑म॒न्नाद्ये॑न॒ सम॑र्द्धयति अन॑शनायुको भवति।"
        },
        {
          "id": "ta-5-9-65",
          "chunkNumber": 65,
          "sanskrit": "य ए॒वव्ँवेद॑।"
        },
        {
          "id": "ta-5-9-66",
          "chunkNumber": 66,
          "sanskrit": "रन्ति॒र्नामा॑सि दि॒व्यो ग॑न्ध॒र्व इत्या॑ह।"
        },
        {
          "id": "ta-5-9-67",
          "chunkNumber": 67,
          "sanskrit": "रू॒पमे॒वास्यै॒तन्म॑हि॒मान॒ꣳ॒ रन्ति॑म् ब॒न्धुता॒व्ँव्याच॑ष्टे।"
        },
        {
          "id": "ta-5-9-68",
          "chunkNumber": 68,
          "sanskrit": "सम॒हमायु॑षा॒ सम् प्रा॒णेनेत्या॑ह।"
        },
        {
          "id": "ta-5-9-69",
          "chunkNumber": 69,
          "sanskrit": "आ॒शिष॑मे॒वैतामाशा᳚स्ते।"
        },
        {
          "id": "ta-5-9-70",
          "chunkNumber": 70,
          "sanskrit": "व्य॑सौ यो᳚ऽस्मान् द्वेष्टि॒ यञ्च॑ व॒यम् द्वि॒ष्म इत्या॑ह।"
        },
        {
          "id": "ta-5-9-71",
          "chunkNumber": 71,
          "sanskrit": "अ॒भि॒चा॒र ए॒वास्यै॒षः।"
        },
        {
          "id": "ta-5-9-72",
          "chunkNumber": 72,
          "sanskrit": "अचि॑क्रद॒द्वृषा॒ हरि॒रित्या॑ह।"
        },
        {
          "id": "ta-5-9-73",
          "chunkNumber": 73,
          "sanskrit": "वृषा॒ ह्ये॑षः वृषा॒ हरिः॑।"
        },
        {
          "id": "ta-5-9-74",
          "chunkNumber": 74,
          "sanskrit": "म॒हान्मि॒त्रो न द॑र्श॒त इत्या॑ह।"
        },
        {
          "id": "ta-5-9-75",
          "chunkNumber": 75,
          "sanskrit": "स्तौत्ये॒वैन॑मे॒तत्।"
        },
        {
          "id": "ta-5-9-76",
          "chunkNumber": 76,
          "sanskrit": "चिद॑सि समु॒द्रयो॑नि॒रित्या॑ह।"
        },
        {
          "id": "ta-5-9-77",
          "chunkNumber": 77,
          "sanskrit": "स्वामे॒वैन॒य्ँयोनि॑ङ्गमयति।"
        },
        {
          "id": "ta-5-9-78",
          "chunkNumber": 78,
          "sanskrit": "नम॑स्ते अस्तु॒ मा मा॑ हिꣳसी॒रित्या॒हाहि॑ꣳसायै।"
        },
        {
          "id": "ta-5-9-79",
          "chunkNumber": 79,
          "sanskrit": "वि॒श्वाव॑सुꣳ सोमगन्ध॒र्वमित्या॑ह।"
        },
        {
          "id": "ta-5-9-80",
          "chunkNumber": 80,
          "sanskrit": "यदे॒वास्य॑ क्रि॒यमा॑णस्यान्त॒र्यन्ति॑।"
        },
        {
          "id": "ta-5-9-81",
          "chunkNumber": 81,
          "sanskrit": "तदे॒वास्यै॒तेना प्या॑ययति।"
        },
        {
          "id": "ta-5-9-82",
          "chunkNumber": 82,
          "sanskrit": "वि॒श्वाव॑सुर॒भि तन्नो॑ गृणा॒त्वित्या॑ह पूर्व॑मे॒वोदि॒तम्।"
        },
        {
          "id": "ta-5-9-83",
          "chunkNumber": 83,
          "sanskrit": "उत्त॑रेणा॒भिगृ॑णाति।"
        },
        {
          "id": "ta-5-9-84",
          "chunkNumber": 84,
          "sanskrit": "धियो॑ हिन्वा॒नो धिय॒ इन्नो॑ अव्या॒दित्या॑ह।"
        },
        {
          "id": "ta-5-9-85",
          "chunkNumber": 85,
          "sanskrit": "ऋ॒तूने॒वास्मै॑ कल्पयति।"
        },
        {
          "id": "ta-5-9-86",
          "chunkNumber": 86,
          "sanskrit": "प्रासा᳚म् गन्ध॒र्वो अ॒मृता॑नि वोच॒दित्या॑ह।"
        },
        {
          "id": "ta-5-9-87",
          "chunkNumber": 87,
          "sanskrit": "प्रा॒णा वा अ॒मृताः᳚।"
        },
        {
          "id": "ta-5-9-88",
          "chunkNumber": 88,
          "sanskrit": "प्रा॒णाने॒वास्मै॑ कल्पयति।"
        },
        {
          "id": "ta-5-9-89",
          "chunkNumber": 89,
          "sanskrit": "ए॒तत्त्वन्दे॑व घर्म दे॒वो दे॒वानुपा॑गा॒ इत्या॑ह।"
        },
        {
          "id": "ta-5-9-90",
          "chunkNumber": 90,
          "sanskrit": "दे॒वो ह्ये॑ष सन्दे॒वानु॒पैति॑।"
        },
        {
          "id": "ta-5-9-91",
          "chunkNumber": 91,
          "sanskrit": "इ॒दम॒हम् म॑नु॒ष्यो॑ मनु॒ष्या॑नित्या॑ह म॒नु॒ष्यो॑ हि।"
        },
        {
          "id": "ta-5-9-92",
          "chunkNumber": 92,
          "sanskrit": "ए॒ष सन्म॑नु॒ष्या॑नु॒पैति॑।"
        },
        {
          "id": "ta-5-9-93",
          "chunkNumber": 93,
          "sanskrit": "ई॒श्व॒रो वै प्र॑व॒र्ग्य॑मुद्वा॒सय॑न्न्।"
        },
        {
          "id": "ta-5-9-94",
          "chunkNumber": 94,
          "sanskrit": "प्र॒जाम् प॒शून्थ् सो॑मपी॒थम॑नू॒द्वासः॒ सोम॑पी॒थानु॒मेहि॑।"
        },
        {
          "id": "ta-5-9-95",
          "chunkNumber": 95,
          "sanskrit": "स॒ह प्र॒जया॑ स॒ह रा॒यस्पोषे॒णेत्या॑ह।"
        },
        {
          "id": "ta-5-9-96",
          "chunkNumber": 96,
          "sanskrit": "प्र॒जामे॒व प॒शून्थ् सो॑मपी॒थमा॒त्मन् ध॑त्ते।"
        },
        {
          "id": "ta-5-9-97",
          "chunkNumber": 97,
          "sanskrit": "सु॒मि॒त्रा न॒ आप॒ ओष॑धयः स॒न्त्वित्या॑ह।"
        },
        {
          "id": "ta-5-9-98",
          "chunkNumber": 98,
          "sanskrit": "आ॒शिष॑मे॒वैतामाशा᳚स्ते।"
        },
        {
          "id": "ta-5-9-99",
          "chunkNumber": 99,
          "sanskrit": "दु॒र्मि॒त्रास्तस्मै॑ भूयासु॒र्यो᳚ऽस्मान्द्वेष्टि॒ यञ्च॑ व॒यम् द्वि॒ष्म इत्या॑ह।"
        },
        {
          "id": "ta-5-9-100",
          "chunkNumber": 100,
          "sanskrit": "अ॒भि॒चा॒र ए॒वास्यै॒षः।"
        },
        {
          "id": "ta-5-9-101",
          "chunkNumber": 101,
          "sanskrit": "प्र वा ए॒षो᳚ऽस्माल् लो॒काच्च्य॑वते।"
        },
        {
          "id": "ta-5-9-102",
          "chunkNumber": 102,
          "sanskrit": "यः प्र॑व॒र्ग्य॑मुद्वा॒सय॑ति।"
        },
        {
          "id": "ta-5-9-103",
          "chunkNumber": 103,
          "sanskrit": "उदु॒ त्यम् चि॒त्रमिति॑ सौ॒रीभ्या॑मृ॒ग्भ्याम् पुन॒रेत्य॒ गार्ह॑पत्ये जुहोति।"
        },
        {
          "id": "ta-5-9-104",
          "chunkNumber": 104,
          "sanskrit": "अ॒यव्ँवै लो॒को गार्ह॑पत्यः।"
        },
        {
          "id": "ta-5-9-105",
          "chunkNumber": 105,
          "sanskrit": "अ॒स्मिन्ने॒व लो॒के प्रति॑तिष्ठति।"
        },
        {
          "id": "ta-5-9-106",
          "chunkNumber": 106,
          "sanskrit": "अ॒सौ खलु॒ वा आ॑दि॒त्यः सु॑व॒र्गो लो॒कः।"
        },
        {
          "id": "ta-5-9-107",
          "chunkNumber": 107,
          "sanskrit": "यथ् सौ॒री भव॑तः।"
        },
        {
          "id": "ta-5-9-108",
          "chunkNumber": 108,
          "sanskrit": "तेनै॒व सु॑व॒र्गाल् लो॒कान्नैति॑"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-5-10",
      "title": "Prapāṭhaka 5 · Anuvāka 10",
      "sectionNumber": 10,
      "chunks": [
        {
          "id": "ta-5-10-1",
          "chunkNumber": 1,
          "sanskrit": "प्र॒जाप॑ति॒व्ँवै दे॒वाः शु॒क्रम् पयो॑ऽदुह्रन्न्।",
          "section": 10
        },
        {
          "id": "ta-5-10-2",
          "chunkNumber": 2,
          "sanskrit": "तदे᳚भ्यो॒ न व्य॑भवत्।"
        },
        {
          "id": "ta-5-10-3",
          "chunkNumber": 3,
          "sanskrit": "तद॒ग्निर्व्य॑करोत्।"
        },
        {
          "id": "ta-5-10-4",
          "chunkNumber": 4,
          "sanskrit": "तानि॒ शुक्रि॑याणि॒ सामा᳚न्यभवन्न्।"
        },
        {
          "id": "ta-5-10-5",
          "chunkNumber": 5,
          "sanskrit": "तेषा॒य्ँयो रसो॒ऽत्यख्ष॑रत्।"
        },
        {
          "id": "ta-5-10-6",
          "chunkNumber": 6,
          "sanskrit": "तानि॑ शुक्रय॒जूꣴष्य॑भवन्न्।"
        },
        {
          "id": "ta-5-10-7",
          "chunkNumber": 7,
          "sanskrit": "शुक्रि॑याणा॒व्ँवा ए॒तानि॒ शुक्रि॑याणि।"
        },
        {
          "id": "ta-5-10-8",
          "chunkNumber": 8,
          "sanskrit": "सा॒म॒प॒य॒सव्ँवा ए॒तयो॑र॒न्यत्।"
        },
        {
          "id": "ta-5-10-9",
          "chunkNumber": 9,
          "sanskrit": "दे॒वाना॑म॒न्यत्पयः॑।"
        },
        {
          "id": "ta-5-10-10",
          "chunkNumber": 10,
          "sanskrit": "यद्गोः पयः॑ तथ् साम्नः॒ पयः॑।"
        },
        {
          "id": "ta-5-10-11",
          "chunkNumber": 11,
          "sanskrit": "यद॒जायै॒ पयः॑।"
        },
        {
          "id": "ta-5-10-12",
          "chunkNumber": 12,
          "sanskrit": "तद्दे॒वाना॒म् पयः॑।"
        },
        {
          "id": "ta-5-10-13",
          "chunkNumber": 13,
          "sanskrit": "तस्मा॒द्यत्रै॒तैर्यजु॑र्भि॒श्चर॑न्ति।"
        },
        {
          "id": "ta-5-10-14",
          "chunkNumber": 14,
          "sanskrit": "तत् पय॑सा चरन्ति।"
        },
        {
          "id": "ta-5-10-15",
          "chunkNumber": 15,
          "sanskrit": "प्र॒जाप॑तिमे॒व तद् दे॒वान्पय॑सा॒ऽन्नाद्ये॑न॒ सम॑र्द्धयन्ति।"
        },
        {
          "id": "ta-5-10-16",
          "chunkNumber": 16,
          "sanskrit": "ए॒ष ह॒ त्वै सा॒ख्षात् प्र॑व॒र्ग्य॑म् भख्षयति।"
        },
        {
          "id": "ta-5-10-17",
          "chunkNumber": 17,
          "sanskrit": "यस्यै॒वव्ँवि॒दुषः॑ प्रव॒र्ग्यः॑ प्रवृ॒ज्यते᳚।"
        },
        {
          "id": "ta-5-10-18",
          "chunkNumber": 18,
          "sanskrit": "उ॒त्त॒र॒वे॒द्यामुद्वा॑सये॒त्तेज॑स्कामस्य।"
        },
        {
          "id": "ta-5-10-19",
          "chunkNumber": 19,
          "sanskrit": "तेजो॒ वा उ॑त्तरवे॒दिः तेजः॑ प्रव॒र्ग्यः॑।"
        },
        {
          "id": "ta-5-10-20",
          "chunkNumber": 20,
          "sanskrit": "तेज॑सै॒व तेजः॒ सम॑र्द्धयति।"
        },
        {
          "id": "ta-5-10-21",
          "chunkNumber": 21,
          "sanskrit": "उ॒त्त॒र॒वे॒द्यामुद्वा॑सये॒दन्न॑कामस्य।"
        },
        {
          "id": "ta-5-10-22",
          "chunkNumber": 22,
          "sanskrit": "शिरो॒ वा ए॒तद्य॒ज्ञस्य॑।"
        },
        {
          "id": "ta-5-10-23",
          "chunkNumber": 23,
          "sanskrit": "यत् प्र॑व॒र्ग्यः॑।"
        },
        {
          "id": "ta-5-10-24",
          "chunkNumber": 24,
          "sanskrit": "मुख॑मुत्तरवे॒दिः।"
        },
        {
          "id": "ta-5-10-25",
          "chunkNumber": 25,
          "sanskrit": "शी॒र्ष्णैव मुख॒ꣳ॒ सन्द॑धात्य॒न्नाद्या॑य।"
        },
        {
          "id": "ta-5-10-26",
          "chunkNumber": 26,
          "sanskrit": "अ॒न्ना॒द ए॒व भ॑वति।"
        },
        {
          "id": "ta-5-10-27",
          "chunkNumber": 27,
          "sanskrit": "यत्र॒ खलु॒ वा ए॒तमुद्वा॑सित॒व्ँवया॑ꣳसि प॒र्यास॑ते।"
        },
        {
          "id": "ta-5-10-28",
          "chunkNumber": 28,
          "sanskrit": "परि॒ वै ताꣳ समा᳚म् प्र॒जा वया॑ꣴस्यासते तस्मा॑दुत्तरवे॒द्यामे॒वोद्वा॑सयेत्।"
        },
        {
          "id": "ta-5-10-29",
          "chunkNumber": 29,
          "sanskrit": "प्र॒जाना᳚म् गोपी॒थाय॑।"
        },
        {
          "id": "ta-5-10-30",
          "chunkNumber": 30,
          "sanskrit": "पु॒रो वा॑ प॒श्चाद्वोद्वा॑सयेत्।"
        },
        {
          "id": "ta-5-10-31",
          "chunkNumber": 31,
          "sanskrit": "पु॒रस्ता॒द्वा ए॒तज्ज्योति॒रुदे॑ति।"
        },
        {
          "id": "ta-5-10-32",
          "chunkNumber": 32,
          "sanskrit": "तत् प॒श्चान्निम्रो॑चति।"
        },
        {
          "id": "ta-5-10-33",
          "chunkNumber": 33,
          "sanskrit": "स्वामे॒वैन॒य्ँयोनि॒मनूद्वा॑सयति।"
        },
        {
          "id": "ta-5-10-34",
          "chunkNumber": 34,
          "sanskrit": "अ॒पाम् मद्ध्य॒ उद्वा॑सयेत्।"
        },
        {
          "id": "ta-5-10-35",
          "chunkNumber": 35,
          "sanskrit": "अ॒पाव्ँवा ए॒तन्मद्ध्या॒ज्ज्योति॑रजायत।"
        },
        {
          "id": "ta-5-10-36",
          "chunkNumber": 36,
          "sanskrit": "ज्योतिः॑ प्रव॒र्ग्यः॑।"
        },
        {
          "id": "ta-5-10-37",
          "chunkNumber": 37,
          "sanskrit": "स्व ए॒वैन॒य्ँयोनौ॒ प्रति॑ष्ठापयति यम् द्वि॒ष्यात्।"
        },
        {
          "id": "ta-5-10-38",
          "chunkNumber": 38,
          "sanskrit": "यत्र॒ स स्यात्।"
        },
        {
          "id": "ta-5-10-39",
          "chunkNumber": 39,
          "sanskrit": "तस्या᳚म् दि॒श्युद्वा॑सयेत्।"
        },
        {
          "id": "ta-5-10-40",
          "chunkNumber": 40,
          "sanskrit": "ए॒ष वा अ॒ग्निर्वै᳚श्वान॒रः।"
        },
        {
          "id": "ta-5-10-41",
          "chunkNumber": 41,
          "sanskrit": "यत्प्र॑व॒र्ग्यः॑।"
        },
        {
          "id": "ta-5-10-42",
          "chunkNumber": 42,
          "sanskrit": "अ॒ग्निनै॒वैन॑व्ँवैश्वान॒रेणा॒भि प्रव॑र्तयति।"
        },
        {
          "id": "ta-5-10-43",
          "chunkNumber": 43,
          "sanskrit": "औदु॑म्बर्या॒ꣳ॒ शाखा॑या॒मुद्वा॑सयेत्।"
        },
        {
          "id": "ta-5-10-44",
          "chunkNumber": 44,
          "sanskrit": "ऊर्ग्वा उ॑दु॒म्बरः॑।"
        },
        {
          "id": "ta-5-10-45",
          "chunkNumber": 45,
          "sanskrit": "अन्न॑म् प्रा॒णः।"
        },
        {
          "id": "ta-5-10-46",
          "chunkNumber": 46,
          "sanskrit": "शुग्घ॒र्मः इ॒दम॒हम॒मुष्या॑मुष्याय॒णस्य॑ शु॒चा प्रा॒णमपि॑ दहा॒मीत्या॑ह।"
        },
        {
          "id": "ta-5-10-47",
          "chunkNumber": 47,
          "sanskrit": "शु॒चैवास्य॑ प्रा॒णमपि॑ दहति।"
        },
        {
          "id": "ta-5-10-48",
          "chunkNumber": 48,
          "sanskrit": "ता॒जगार्ति॒मार्च्छ॑ति।"
        },
        {
          "id": "ta-5-10-49",
          "chunkNumber": 49,
          "sanskrit": "यत्र॑ द॒र्भा उ॑प॒दीक॑सन्तताः॒ स्युः।"
        },
        {
          "id": "ta-5-10-50",
          "chunkNumber": 50,
          "sanskrit": "तदुद्वा॑सये॒द्वृष्टि॑कामस्य।"
        },
        {
          "id": "ta-5-10-51",
          "chunkNumber": 51,
          "sanskrit": "ए॒ता वा अ॒पाम॑नू॒ज्झाव॑र्यो॒ नाम॑।"
        },
        {
          "id": "ta-5-10-52",
          "chunkNumber": 52,
          "sanskrit": "यद्द॒र्भाः।"
        },
        {
          "id": "ta-5-10-53",
          "chunkNumber": 53,
          "sanskrit": "अ॒सौ खलु॒ वा आ॑दि॒त्य इ॒तो वृष्टि॒मुदी॑रयति।"
        },
        {
          "id": "ta-5-10-54",
          "chunkNumber": 54,
          "sanskrit": "अ॒सावे॒वास्मा॑ आदि॒त्यो वृष्टि॒न्निय॑च्छति।"
        },
        {
          "id": "ta-5-10-55",
          "chunkNumber": 55,
          "sanskrit": "ता आपो॒ निय॑ता॒ धन्व॑ना यन्ति"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-5-11",
      "title": "Prapāṭhaka 5 · Anuvāka 11",
      "sectionNumber": 11,
      "chunks": [
        {
          "id": "ta-5-11-1",
          "chunkNumber": 1,
          "sanskrit": "प्र॒जाप॑तिः सम्भ्रि॒यमा॑णः।",
          "section": 11
        },
        {
          "id": "ta-5-11-2",
          "chunkNumber": 2,
          "sanskrit": "स॒म्राट्थ् सम्भृ॑तः।"
        },
        {
          "id": "ta-5-11-3",
          "chunkNumber": 3,
          "sanskrit": "घ॒र्मः प्रवृ॑क्तः।"
        },
        {
          "id": "ta-5-11-4",
          "chunkNumber": 4,
          "sanskrit": "म॒हा॒वी॒र उद्वा॑सितः।"
        },
        {
          "id": "ta-5-11-5",
          "chunkNumber": 5,
          "sanskrit": "अ॒सौ खलु॒ वावैष आ॑दि॒त्यः।"
        },
        {
          "id": "ta-5-11-6",
          "chunkNumber": 6,
          "sanskrit": "यत् प्र॑व॒र्ग्यः॑।"
        },
        {
          "id": "ta-5-11-7",
          "chunkNumber": 7,
          "sanskrit": "स ए॒तानि॒ नामा᳚न्यकुरुत।"
        },
        {
          "id": "ta-5-11-8",
          "chunkNumber": 8,
          "sanskrit": "य ए॒वव्ँवेद॑।"
        },
        {
          "id": "ta-5-11-9",
          "chunkNumber": 9,
          "sanskrit": "वि॒दुरे॑न॒न्नाम्ना᳚।"
        },
        {
          "id": "ta-5-11-10",
          "chunkNumber": 10,
          "sanskrit": "ब्र॒ह्म॒वा॒दिनो॑ वदन्ति यो वै वसी॑याꣳ सय्ँयथाना॒ममु॑प॒चर॑ति।"
        },
        {
          "id": "ta-5-11-11",
          "chunkNumber": 11,
          "sanskrit": "पुण्या᳚र्ति॒व्ँवै स तस्मै॑ कामयते।"
        },
        {
          "id": "ta-5-11-12",
          "chunkNumber": 12,
          "sanskrit": "पुण्या᳚र्तिमस्मै कामयन्ते।"
        },
        {
          "id": "ta-5-11-13",
          "chunkNumber": 13,
          "sanskrit": "य ए॒वव्ँवेद॑।"
        },
        {
          "id": "ta-5-11-14",
          "chunkNumber": 14,
          "sanskrit": "तस्मा॑दे॒वव्ँवि॒द्वान्।"
        },
        {
          "id": "ta-5-11-15",
          "chunkNumber": 15,
          "sanskrit": "घ॒र्म इति॒ दिवाऽऽच॑ख्षीत।"
        },
        {
          "id": "ta-5-11-16",
          "chunkNumber": 16,
          "sanskrit": "स॒म्राडिति॒ नक्त᳚म्।"
        },
        {
          "id": "ta-5-11-17",
          "chunkNumber": 17,
          "sanskrit": "ए॒ते वा ए॒तस्य॑ प्रि॒ये त॒नुवौ᳚।"
        },
        {
          "id": "ta-5-11-18",
          "chunkNumber": 18,
          "sanskrit": "ए॒ते अ॑स्य प्रि॒ये नाम॑नी।"
        },
        {
          "id": "ta-5-11-19",
          "chunkNumber": 19,
          "sanskrit": "प्रि॒ययै॒वैन॑म् त॒नुवा᳚ प्रि॒येण॒ नाम्ना॒ सम॑र्द्धयति।"
        },
        {
          "id": "ta-5-11-20",
          "chunkNumber": 20,
          "sanskrit": "की॒र्तिर॑स्य॒ पूर्वा ग॑च्छति ज॒नता॑माय॒तः।"
        },
        {
          "id": "ta-5-11-21",
          "chunkNumber": 21,
          "sanskrit": "गा॒य॒त्री दे॒वेभ्योऽपा᳚क्रामत्।"
        },
        {
          "id": "ta-5-11-22",
          "chunkNumber": 22,
          "sanskrit": "तान्दे॒वाः प्र॑व॒र्ग्ये॑णै॒वानु॒ व्य॑भवन्न्।"
        },
        {
          "id": "ta-5-11-23",
          "chunkNumber": 23,
          "sanskrit": "प्र॒व॒र्ग्ये॑णाप्नुवन्न्।"
        },
        {
          "id": "ta-5-11-24",
          "chunkNumber": 24,
          "sanskrit": "यच्च॑तुर्विꣳशतिः॒ कृत्वः॑ प्रव॒र्ग्य॑म् प्रवृ॒णक्ति॑।"
        },
        {
          "id": "ta-5-11-25",
          "chunkNumber": 25,
          "sanskrit": "गा॒य॒त्रीमे॒व तदनु॒ विभ॑वति।"
        },
        {
          "id": "ta-5-11-26",
          "chunkNumber": 26,
          "sanskrit": "गा॒य॒त्रीमा᳚प्नोति।"
        },
        {
          "id": "ta-5-11-27",
          "chunkNumber": 27,
          "sanskrit": "पूर्वा᳚ऽस्य॒ जन॑य्ँय॒तः की॒र्तिर्ग॑च्छति।"
        },
        {
          "id": "ta-5-11-28",
          "chunkNumber": 28,
          "sanskrit": "वै॒श्व॒दे॒वः सꣳस॑न्नः वस॑वः॒ प्रवृ॑क्तः।"
        },
        {
          "id": "ta-5-11-29",
          "chunkNumber": 29,
          "sanskrit": "सोमो॑ऽभिकी॒र्यमा॑णः।"
        },
        {
          "id": "ta-5-11-30",
          "chunkNumber": 30,
          "sanskrit": "आ॒श्वि॒नः पय॑स्यानी॒यमा॑ने।"
        },
        {
          "id": "ta-5-11-31",
          "chunkNumber": 31,
          "sanskrit": "मा॒रु॒तः क्वथ॑न्न्।"
        },
        {
          "id": "ta-5-11-32",
          "chunkNumber": 32,
          "sanskrit": "पौ॒ष्ण उद॑न्तः।"
        },
        {
          "id": "ta-5-11-33",
          "chunkNumber": 33,
          "sanskrit": "सा॒र॒स्व॒तो वि॒ष्यन्द॑मानः।"
        },
        {
          "id": "ta-5-11-34",
          "chunkNumber": 34,
          "sanskrit": "मै॒त्रः शरो॑ गृहीतः।"
        },
        {
          "id": "ta-5-11-35",
          "chunkNumber": 35,
          "sanskrit": "तेज॒ उद्य॑तो वा॒युः।"
        },
        {
          "id": "ta-5-11-36",
          "chunkNumber": 36,
          "sanskrit": "ह्रि॒यमा॑णः प्र॒जाप॑तिः।"
        },
        {
          "id": "ta-5-11-37",
          "chunkNumber": 37,
          "sanskrit": "हू॒यमा॑नो॒ वाग्घु॒तः अ॒सौ खलु॒ वावैष आ॑दि॒त्यः।"
        },
        {
          "id": "ta-5-11-38",
          "chunkNumber": 38,
          "sanskrit": "यत् प्र॑व॒र्ग्यः॑।"
        },
        {
          "id": "ta-5-11-39",
          "chunkNumber": 39,
          "sanskrit": "स ए॒तानि॒ नामा᳚न्यकुरुत।"
        },
        {
          "id": "ta-5-11-40",
          "chunkNumber": 40,
          "sanskrit": "य ए॒वव्ँवेद॑।"
        },
        {
          "id": "ta-5-11-41",
          "chunkNumber": 41,
          "sanskrit": "वि॒दुरे॑न॒न्नाम्ना᳚।"
        },
        {
          "id": "ta-5-11-42",
          "chunkNumber": 42,
          "sanskrit": "ब्र॒ह्म॒वा॒दिनो॑ वदन्ति।"
        },
        {
          "id": "ta-5-11-43",
          "chunkNumber": 43,
          "sanskrit": "यन्मृ॒न्मय॒माहु॑ति॒न्नाश्ञु॒तेऽथ॑।"
        },
        {
          "id": "ta-5-11-44",
          "chunkNumber": 44,
          "sanskrit": "कस्मा॑दे॒षो᳚ऽश्ञुत॒ इति॑।"
        },
        {
          "id": "ta-5-11-45",
          "chunkNumber": 45,
          "sanskrit": "वागे॒ष इति॑ ब्रूयात्।"
        },
        {
          "id": "ta-5-11-46",
          "chunkNumber": 46,
          "sanskrit": "वा॒च्ये॑व वाच॑म् दधाति तस्मा॑दश्ञुते।"
        },
        {
          "id": "ta-5-11-47",
          "chunkNumber": 47,
          "sanskrit": "प्र॒जाप॑ति॒र्वा ए॒ष द्वा॑दश॒धा विहि॑तः।"
        },
        {
          "id": "ta-5-11-48",
          "chunkNumber": 48,
          "sanskrit": "यत् प्र॑व॒र्ग्यः॑।"
        },
        {
          "id": "ta-5-11-49",
          "chunkNumber": 49,
          "sanskrit": "यत् प्राग॑वका॒शेभ्यः॑।"
        },
        {
          "id": "ta-5-11-50",
          "chunkNumber": 50,
          "sanskrit": "तेन॑ प्र॒जा अ॑सृजत।"
        },
        {
          "id": "ta-5-11-51",
          "chunkNumber": 51,
          "sanskrit": "अ॒व॒का॒शैर्दे॑वासु॒रान॑सृजत।"
        },
        {
          "id": "ta-5-11-52",
          "chunkNumber": 52,
          "sanskrit": "यदू॒द्र्ध्वम॑वका॒शेभ्यः॑।"
        },
        {
          "id": "ta-5-11-53",
          "chunkNumber": 53,
          "sanskrit": "तेनान्न॑मसृजत।"
        },
        {
          "id": "ta-5-11-54",
          "chunkNumber": 54,
          "sanskrit": "अन्न॑म् प्र॒जाप॑तिः।"
        },
        {
          "id": "ta-5-11-55",
          "chunkNumber": 55,
          "sanskrit": "प्र॒जाप॑ति॒र्वावैषः"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-5-12",
      "title": "Prapāṭhaka 5 · Anuvāka 12",
      "sectionNumber": 12,
      "chunks": [
        {
          "id": "ta-5-12-1",
          "chunkNumber": 1,
          "sanskrit": "स॒वि॒ता भू॒त्वा प्र॑थ॒मेऽह॒न् प्रवृ॑ज्यते।",
          "section": 12
        },
        {
          "id": "ta-5-12-2",
          "chunkNumber": 2,
          "sanskrit": "तेन॒ कामा॑ꣳ एति।"
        },
        {
          "id": "ta-5-12-3",
          "chunkNumber": 3,
          "sanskrit": "यद्द्वि॒तीयेऽह॑न्प्रवृ॒ज्यते᳚।"
        },
        {
          "id": "ta-5-12-4",
          "chunkNumber": 4,
          "sanskrit": "अ॒ग्निर्भू॒त्वा दे॒वाने॑ति।"
        },
        {
          "id": "ta-5-12-5",
          "chunkNumber": 5,
          "sanskrit": "यत्तृ॒तीयेऽह॑न्प्रवृ॒ज्यते᳚।"
        },
        {
          "id": "ta-5-12-6",
          "chunkNumber": 6,
          "sanskrit": "वा॒युर्भू॒त्वा प्रा॒णाने॑ति।"
        },
        {
          "id": "ta-5-12-7",
          "chunkNumber": 7,
          "sanskrit": "यच्च॑तु॒र्थेऽह॑न्प्रवृ॒ज्यते᳚।"
        },
        {
          "id": "ta-5-12-8",
          "chunkNumber": 8,
          "sanskrit": "आ॒दि॒त्यो भू॒त्वा र॒श्मीने॑ति।"
        },
        {
          "id": "ta-5-12-9",
          "chunkNumber": 9,
          "sanskrit": "यत् प॑ञ्च॒मेऽह॑न्प्रवृ॒ज्यते᳚।"
        },
        {
          "id": "ta-5-12-10",
          "chunkNumber": 10,
          "sanskrit": "च॒न्द्रमा॑ भू॒त्वा नख्ष॑त्राण्येति यथ्ष॒ष्ठेऽह॑न्प्रवृ॒ज्यते᳚।"
        },
        {
          "id": "ta-5-12-11",
          "chunkNumber": 11,
          "sanskrit": "ऋ॒तुर्भू॒त्वा स॑व्ँवथ्स॒रमे॑ति।"
        },
        {
          "id": "ta-5-12-12",
          "chunkNumber": 12,
          "sanskrit": "यथ्स॑प्त॒मेऽह॑न्प्रवृ॒ज्यते᳚।"
        },
        {
          "id": "ta-5-12-13",
          "chunkNumber": 13,
          "sanskrit": "धा॒ता भू॒त्वा शक्व॑रीमेति।"
        },
        {
          "id": "ta-5-12-14",
          "chunkNumber": 14,
          "sanskrit": "यद॑ष्ट॒मेऽह॑न्प्रवृ॒ज्यते᳚।"
        },
        {
          "id": "ta-5-12-15",
          "chunkNumber": 15,
          "sanskrit": "बृह॒स्पति॑र्भू॒त्वा गा॑य॒त्रीमे॑ति।"
        },
        {
          "id": "ta-5-12-16",
          "chunkNumber": 16,
          "sanskrit": "यन्न॑व॒मेऽह॑न्प्रवृ॒ज्यते᳚।"
        },
        {
          "id": "ta-5-12-17",
          "chunkNumber": 17,
          "sanskrit": "मि॒त्रो भू॒त्वा त्रि॒वृत॑ इ॒माल्ँलो॒काने॑ति।"
        },
        {
          "id": "ta-5-12-18",
          "chunkNumber": 18,
          "sanskrit": "यद्द॑श॒मेऽह॑न्प्रवृ॒ज्यते᳚।"
        },
        {
          "id": "ta-5-12-19",
          "chunkNumber": 19,
          "sanskrit": "वरु॑णो भू॒त्वा वि॒राज॑मेति यदे॑काद॒शेऽह॑न्प्रवृ॒ज्यते᳚।"
        },
        {
          "id": "ta-5-12-20",
          "chunkNumber": 20,
          "sanskrit": "इन्द्रो॑ भू॒त्वा त्रि॒ष्टुभ॑मेति।"
        },
        {
          "id": "ta-5-12-21",
          "chunkNumber": 21,
          "sanskrit": "यद्द्वा॑द॒शेऽह॑न्प्रवृ॒ज्यते᳚।"
        },
        {
          "id": "ta-5-12-22",
          "chunkNumber": 22,
          "sanskrit": "सोमो॑ भू॒त्वा सु॒त्यामे॑ति।"
        },
        {
          "id": "ta-5-12-23",
          "chunkNumber": 23,
          "sanskrit": "यत्पु॒रस्ता॑दुप॒सदा᳚म् प्रवृ॒ज्यते᳚।"
        },
        {
          "id": "ta-5-12-24",
          "chunkNumber": 24,
          "sanskrit": "तस्मा॑दि॒तः परा॑ङ॒मूल्ँलो॒काꣴस्तप॑न्नेति।"
        },
        {
          "id": "ta-5-12-25",
          "chunkNumber": 25,
          "sanskrit": "यदु॒परि॑ष्टादुप॒सदा᳚म् प्रवृ॒ज्यते᳚।"
        },
        {
          "id": "ta-5-12-26",
          "chunkNumber": 26,
          "sanskrit": "तस्मा॑द॒मुतो॒ऽर्वाङि॒माल्ँलो॒काꣴस्तप॑न्नेति।"
        },
        {
          "id": "ta-5-12-27",
          "chunkNumber": 27,
          "sanskrit": "य ए॒वव्ँवेद॑।"
        },
        {
          "id": "ta-5-12-28",
          "chunkNumber": 28,
          "sanskrit": "ऐव त॑पति"
        }
      ]
    }
  ]
}
