{
  "sections": [
    {
      "id": "taittiriya-aranyaka-5-12",
      "title": "Prapāṭhaka 5 · Anuvāka 12",
      "sectionNumber": 12,
      "chunks": [
        {
          "id": "ta-5-12-1",
          "chunkNumber": 1,
          "sanskrit": "sa̠vi̠tā bhū̠tvā pra̍tha̠me'ha̠n pravṛ̍jyate|",
          "section": 12
        },
        {
          "id": "ta-5-12-2",
          "chunkNumber": 2,
          "sanskrit": "tena̠ kāmā̍gͫ eti|"
        },
        {
          "id": "ta-5-12-3",
          "chunkNumber": 3,
          "sanskrit": "yaddvi̠tīye'ha̍npravṛ̠jyate̎|"
        },
        {
          "id": "ta-5-12-4",
          "chunkNumber": 4,
          "sanskrit": "a̠gnirbhū̠tvā de̠vāne̍ti|"
        },
        {
          "id": "ta-5-12-5",
          "chunkNumber": 5,
          "sanskrit": "yattṛ̠tīye'ha̍npravṛ̠jyate̎|"
        },
        {
          "id": "ta-5-12-6",
          "chunkNumber": 6,
          "sanskrit": "vā̠yurbhū̠tvā prā̠ṇāne̍ti|"
        },
        {
          "id": "ta-5-12-7",
          "chunkNumber": 7,
          "sanskrit": "yacca̍tu̠rthe'ha̍npravṛ̠jyate̎|"
        },
        {
          "id": "ta-5-12-8",
          "chunkNumber": 8,
          "sanskrit": "ā̠di̠tyo bhū̠tvā ra̠śmīne̍ti|"
        },
        {
          "id": "ta-5-12-9",
          "chunkNumber": 9,
          "sanskrit": "yat pa̍ñca̠me'ha̍npravṛ̠jyate̎|"
        },
        {
          "id": "ta-5-12-10",
          "chunkNumber": 10,
          "sanskrit": "ca̠ndramā̍ bhū̠tvā nakhṣa̍trāṇyeti yathṣa̠ṣṭhe'ha̍npravṛ̠jyate̎|"
        },
        {
          "id": "ta-5-12-11",
          "chunkNumber": 11,
          "sanskrit": "ṛ̠turbhū̠tvā sa̍vm̐vathsa̠rame̍ti|"
        },
        {
          "id": "ta-5-12-12",
          "chunkNumber": 12,
          "sanskrit": "yathsa̍pta̠me'ha̍npravṛ̠jyate̎|"
        },
        {
          "id": "ta-5-12-13",
          "chunkNumber": 13,
          "sanskrit": "dhā̠tā bhū̠tvā śakva̍rīmeti|"
        },
        {
          "id": "ta-5-12-14",
          "chunkNumber": 14,
          "sanskrit": "yada̍ṣṭa̠me'ha̍npravṛ̠jyate̎|"
        },
        {
          "id": "ta-5-12-15",
          "chunkNumber": 15,
          "sanskrit": "bṛha̠spati̍rbhū̠tvā gā̍ya̠trīme̍ti|"
        },
        {
          "id": "ta-5-12-16",
          "chunkNumber": 16,
          "sanskrit": "yanna̍va̠me'ha̍npravṛ̠jyate̎|"
        },
        {
          "id": "ta-5-12-17",
          "chunkNumber": 17,
          "sanskrit": "mi̠tro bhū̠tvā tri̠vṛta̍ i̠mālm̐lo̠kāne̍ti|"
        },
        {
          "id": "ta-5-12-18",
          "chunkNumber": 18,
          "sanskrit": "yadda̍śa̠me'ha̍npravṛ̠jyate̎|"
        },
        {
          "id": "ta-5-12-19",
          "chunkNumber": 19,
          "sanskrit": "varu̍ṇo bhū̠tvā vi̠rāja̍meti yade̍kāda̠śe'ha̍npravṛ̠jyate̎|"
        },
        {
          "id": "ta-5-12-20",
          "chunkNumber": 20,
          "sanskrit": "indro̍ bhū̠tvā tri̠ṣṭubha̍meti|"
        },
        {
          "id": "ta-5-12-21",
          "chunkNumber": 21,
          "sanskrit": "yaddvā̍da̠śe'ha̍npravṛ̠jyate̎|"
        },
        {
          "id": "ta-5-12-22",
          "chunkNumber": 22,
          "sanskrit": "somo̍ bhū̠tvā su̠tyāme̍ti|"
        },
        {
          "id": "ta-5-12-23",
          "chunkNumber": 23,
          "sanskrit": "yatpu̠rastā̍dupa̠sadā̎m pravṛ̠jyate̎|"
        },
        {
          "id": "ta-5-12-24",
          "chunkNumber": 24,
          "sanskrit": "tasmā̍di̠taḥ parā̍ṅa̠mūlm̐lo̠kāgͫͫstapa̍nneti|"
        },
        {
          "id": "ta-5-12-25",
          "chunkNumber": 25,
          "sanskrit": "yadu̠pari̍ṣṭādupa̠sadā̎m pravṛ̠jyate̎|"
        },
        {
          "id": "ta-5-12-26",
          "chunkNumber": 26,
          "sanskrit": "tasmā̍da̠muto̠'rvāṅi̠mālm̐lo̠kāgͫͫstapa̍nneti|"
        },
        {
          "id": "ta-5-12-27",
          "chunkNumber": 27,
          "sanskrit": "ya e̠vavm̐veda̍|"
        },
        {
          "id": "ta-5-12-28",
          "chunkNumber": 28,
          "sanskrit": "aiva ta̍pati"
        }
      ]
    }
  ]
}
