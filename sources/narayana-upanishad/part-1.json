{
  "sections": [
    {
      "id": "narayana-upanishad-1",
      "title": "Khaṇḍa 1",
      "sectionNumber": 1,
      "chunks": [
        {
          "id": "narayana-upanishad-1-1",
          "chunkNumber": 1,
          "sanskrit": "ōṃ saha nāvavatu saha nau bhunaktu |",
          "section": 1
        },
        {
          "id": "narayana-upanishad-1-2",
          "chunkNumber": 2,
          "sanskrit": "saha vīryaṃ karavāvahai |"
        },
        {
          "id": "narayana-upanishad-1-3",
          "chunkNumber": 3,
          "sanskrit": "tejasvināvadhītamastu |"
        },
        {
          "id": "narayana-upanishad-1-4",
          "chunkNumber": 4,
          "sanskrit": "mā vidviṣāvahai ||"
        },
        {
          "id": "narayana-upanishad-1-5",
          "chunkNumber": 5,
          "sanskrit": "ōṃ śāntiḥ śāntiḥ śāntiḥ ||"
        },
        {
          "id": "narayana-upanishad-1-6",
          "chunkNumber": 6,
          "sanskrit": "ōṃ atha puruṣo ha vai nārāyaṇo'kāmayata prajāḥ sṛjeyeti |"
        },
        {
          "id": "narayana-upanishad-1-7",
          "chunkNumber": 7,
          "sanskrit": "nārāyaṇātprāṇo jāyate |"
        },
        {
          "id": "narayana-upanishad-1-8",
          "chunkNumber": 8,
          "sanskrit": "manaḥ sarvendriyāṇi ca |"
        },
        {
          "id": "narayana-upanishad-1-9",
          "chunkNumber": 9,
          "sanskrit": "khaṃ vāyurjyotirāpaḥ pṛthivī viśvasya dhāriṇī |"
        },
        {
          "id": "narayana-upanishad-1-10",
          "chunkNumber": 10,
          "sanskrit": "nārāyaṇād brahmā jāyate |"
        },
        {
          "id": "narayana-upanishad-1-11",
          "chunkNumber": 11,
          "sanskrit": "nārāyaṇād rudro jāyate |"
        },
        {
          "id": "narayana-upanishad-1-12",
          "chunkNumber": 12,
          "sanskrit": "nārāyaṇādindro jāyate |"
        },
        {
          "id": "narayana-upanishad-1-13",
          "chunkNumber": 13,
          "sanskrit": "nārāyaṇātprajāpatayaḥ prajāyante |"
        },
        {
          "id": "narayana-upanishad-1-14",
          "chunkNumber": 14,
          "sanskrit": "nārāyaṇāddvādaśādityā rudrā vasavaḥ sarvāṇi ca chandāgͫsi |"
        },
        {
          "id": "narayana-upanishad-1-15",
          "chunkNumber": 15,
          "sanskrit": "nārāyaṇādeva samutpadyante |"
        },
        {
          "id": "narayana-upanishad-1-16",
          "chunkNumber": 16,
          "sanskrit": "nārāyaṇe pravartante |"
        },
        {
          "id": "narayana-upanishad-1-17",
          "chunkNumber": 17,
          "sanskrit": "nārāyaṇe pralīyante ||"
        }
      ]
    },
    {
      "id": "narayana-upanishad-2",
      "title": "Khaṇḍa 2",
      "sectionNumber": 2,
      "chunks": [
        {
          "id": "narayana-upanishad-2-1",
          "chunkNumber": 1,
          "sanskrit": "ōṃ |",
          "section": 2
        },
        {
          "id": "narayana-upanishad-2-2",
          "chunkNumber": 2,
          "sanskrit": "atha nityo nārāyaṇaḥ |"
        },
        {
          "id": "narayana-upanishad-2-3",
          "chunkNumber": 3,
          "sanskrit": "brahmā nārāyaṇaḥ |"
        },
        {
          "id": "narayana-upanishad-2-4",
          "chunkNumber": 4,
          "sanskrit": "śivaśca nārāyaṇaḥ |"
        },
        {
          "id": "narayana-upanishad-2-5",
          "chunkNumber": 5,
          "sanskrit": "śakraśca nārāyaṇaḥ |"
        },
        {
          "id": "narayana-upanishad-2-6",
          "chunkNumber": 6,
          "sanskrit": "dyāvāpṛthivyau ca nārāyaṇaḥ |"
        },
        {
          "id": "narayana-upanishad-2-7",
          "chunkNumber": 7,
          "sanskrit": "nārāyaṇaḥ |"
        },
        {
          "id": "narayana-upanishad-2-8",
          "chunkNumber": 8,
          "sanskrit": "diśaśca nārāyaṇaḥ |"
        },
        {
          "id": "narayana-upanishad-2-9",
          "chunkNumber": 9,
          "sanskrit": "ūrdhvaṃśca nārāyaṇaḥ |"
        },
        {
          "id": "narayana-upanishad-2-10",
          "chunkNumber": 10,
          "sanskrit": "adhaśca nārāyaṇaḥ |"
        },
        {
          "id": "narayana-upanishad-2-11",
          "chunkNumber": 11,
          "sanskrit": "antarbahiśca nārāyaṇaḥ |"
        },
        {
          "id": "narayana-upanishad-2-12",
          "chunkNumber": 12,
          "sanskrit": "nārāyaṇa evedagͫ sarvam |"
        },
        {
          "id": "narayana-upanishad-2-13",
          "chunkNumber": 13,
          "sanskrit": "yadbhūtaṃ yacca bhavyam |"
        },
        {
          "id": "narayana-upanishad-2-14",
          "chunkNumber": 14,
          "sanskrit": "niṣkalo nirañjano nirvikalpo nirākhyātaḥ śuddho deva eko nārāyaṇaḥ |"
        },
        {
          "id": "narayana-upanishad-2-15",
          "chunkNumber": 15,
          "sanskrit": "na dvitīyo'sti kaścit |"
        },
        {
          "id": "narayana-upanishad-2-16",
          "chunkNumber": 16,
          "sanskrit": "ya evaṃ veda |"
        },
        {
          "id": "narayana-upanishad-2-17",
          "chunkNumber": 17,
          "sanskrit": "sa viṣṇureva bhavati sa viṣṇureva bhavati ||"
        }
      ]
    },
    {
      "id": "narayana-upanishad-3",
      "title": "Khaṇḍa 3",
      "sectionNumber": 3,
      "chunks": [
        {
          "id": "narayana-upanishad-3-1",
          "chunkNumber": 1,
          "sanskrit": "omityagre vyāharet |",
          "section": 3
        },
        {
          "id": "narayana-upanishad-3-2",
          "chunkNumber": 2,
          "sanskrit": "namo iti paścāt |"
        },
        {
          "id": "narayana-upanishad-3-3",
          "chunkNumber": 3,
          "sanskrit": "nārāyaṇāyetyupariṣṭāt |"
        },
        {
          "id": "narayana-upanishad-3-4",
          "chunkNumber": 4,
          "sanskrit": "omityekākṣaram |"
        },
        {
          "id": "narayana-upanishad-3-5",
          "chunkNumber": 5,
          "sanskrit": "namo iti dve akṣare |"
        },
        {
          "id": "narayana-upanishad-3-6",
          "chunkNumber": 6,
          "sanskrit": "nārāyaṇāyeti pañcākṣarāṇi |"
        },
        {
          "id": "narayana-upanishad-3-7",
          "chunkNumber": 7,
          "sanskrit": "etadvai nārāyaṇasyāṣṭākṣaraṃ padam |"
        },
        {
          "id": "narayana-upanishad-3-8",
          "chunkNumber": 8,
          "sanskrit": "yo ha vai nārāyaṇasyāṣṭākṣaraṃ padamadhyeti |"
        },
        {
          "id": "narayana-upanishad-3-9",
          "chunkNumber": 9,
          "sanskrit": "anapabruvassarvamāyureti |"
        },
        {
          "id": "narayana-upanishad-3-10",
          "chunkNumber": 10,
          "sanskrit": "vindate prājāpatyagͫ rāyaspoṣaṃ gaupatyam |"
        },
        {
          "id": "narayana-upanishad-3-11",
          "chunkNumber": 11,
          "sanskrit": "tato'mṛtatvamaśnute tato'mṛtatvamaśnuta iti |"
        },
        {
          "id": "narayana-upanishad-3-12",
          "chunkNumber": 12,
          "sanskrit": "ya evaṃ veda ||"
        }
      ]
    },
    {
      "id": "narayana-upanishad-4",
      "title": "Khaṇḍa 4",
      "sectionNumber": 4,
      "chunks": [
        {
          "id": "narayana-upanishad-4-1",
          "chunkNumber": 1,
          "sanskrit": "pratyagānandaṃ brahmapuruṣaṃ praṇavasvarūpam |",
          "section": 4
        },
        {
          "id": "narayana-upanishad-4-2",
          "chunkNumber": 2,
          "sanskrit": "akāra ukāra makāra iti |"
        },
        {
          "id": "narayana-upanishad-4-3",
          "chunkNumber": 3,
          "sanskrit": "tānekadhā samabharattadetadomiti |"
        },
        {
          "id": "narayana-upanishad-4-4",
          "chunkNumber": 4,
          "sanskrit": "yamuktvā mucyate yogī janmasaṃsārabandhanāt |"
        },
        {
          "id": "narayana-upanishad-4-5",
          "chunkNumber": 5,
          "sanskrit": "ōṃ namo nārāyaṇāyeti mantropāsakaḥ |"
        },
        {
          "id": "narayana-upanishad-4-6",
          "chunkNumber": 6,
          "sanskrit": "vaikuṇṭhabhuvanalokaṃ gamiṣyati |"
        },
        {
          "id": "narayana-upanishad-4-7",
          "chunkNumber": 7,
          "sanskrit": "tadidaṃ paraṃ puṇḍarīkaṃ vijñānaghanam |"
        },
        {
          "id": "narayana-upanishad-4-8",
          "chunkNumber": 8,
          "sanskrit": "tasmāttaṭidābhamātram |"
        },
        {
          "id": "narayana-upanishad-4-9",
          "chunkNumber": 9,
          "sanskrit": "brahmaṇyo devakīputro brahmaṇyo madhusūdanaḥ |"
        },
        {
          "id": "narayana-upanishad-4-10",
          "chunkNumber": 10,
          "sanskrit": "brahmaṇyaḥ puṇḍarīkākṣo brahmaṇyo viṣṇuracyata iti |"
        },
        {
          "id": "narayana-upanishad-4-11",
          "chunkNumber": 11,
          "sanskrit": "sarvabhūtasthamekaṃ nārāyaṇam |"
        },
        {
          "id": "narayana-upanishad-4-12",
          "chunkNumber": 12,
          "sanskrit": "kāraṇarūpamakāra paraṃ brahma ōṃ |"
        },
        {
          "id": "narayana-upanishad-4-13",
          "chunkNumber": 13,
          "sanskrit": "etadatharvaśiroyo'dhīte ||"
        },
        {
          "id": "narayana-upanishad-4-14",
          "chunkNumber": 14,
          "sanskrit": "prātaradhīyāno rātrikṛtaṃ pāpaṃ nāśayati |"
        },
        {
          "id": "narayana-upanishad-4-15",
          "chunkNumber": 15,
          "sanskrit": "sāyamadhīyāno divasakṛtaṃ pāpaṃ nāśayati |"
        },
        {
          "id": "narayana-upanishad-4-16",
          "chunkNumber": 16,
          "sanskrit": "tatsāyaṃprātaradhīyāno'pāpo bhavati |"
        },
        {
          "id": "narayana-upanishad-4-17",
          "chunkNumber": 17,
          "sanskrit": "mādhyandinamādityābhimukho'dhīyānaḥ pañcamahāpātakopapātakāt pramucyate |"
        },
        {
          "id": "narayana-upanishad-4-18",
          "chunkNumber": 18,
          "sanskrit": "sarva veda pārāyaṇa puṇyaṃ labhate |"
        },
        {
          "id": "narayana-upanishad-4-19",
          "chunkNumber": 19,
          "sanskrit": "nārāyaṇasāyujyamavāpnoti nārāyaṇa sāyujyamavāpnoti |"
        },
        {
          "id": "narayana-upanishad-4-20",
          "chunkNumber": 20,
          "sanskrit": "ya evaṃ veda |"
        },
        {
          "id": "narayana-upanishad-4-21",
          "chunkNumber": 21,
          "sanskrit": "ityupaniṣat ||"
        },
        {
          "id": "narayana-upanishad-4-22",
          "chunkNumber": 22,
          "sanskrit": "ōṃ saha nāvavatu saha nau bhunaktu |"
        },
        {
          "id": "narayana-upanishad-4-23",
          "chunkNumber": 23,
          "sanskrit": "saha vīryaṃ karavāvahai |"
        },
        {
          "id": "narayana-upanishad-4-24",
          "chunkNumber": 24,
          "sanskrit": "tejasvināvadhītamastu |"
        },
        {
          "id": "narayana-upanishad-4-25",
          "chunkNumber": 25,
          "sanskrit": "mā vidviṣāvahai ||"
        },
        {
          "id": "narayana-upanishad-4-26",
          "chunkNumber": 26,
          "sanskrit": "ōṃ śāntiḥ śāntiḥ śāntiḥ ||"
        }
      ]
    }
  ]
}
