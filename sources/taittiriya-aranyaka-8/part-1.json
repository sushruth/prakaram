{
  "sections": [
    {
      "id": "taittiriya-aranyaka-8-1",
      "title": "Prapāṭhaka 8 · Anuvāka 1",
      "sectionNumber": 1,
      "chunks": [
        {
          "id": "ta-8-1-1",
          "chunkNumber": 1,
          "sanskrit": "स॒ह ना॑ ववतु।",
          "section": 1
        },
        {
          "id": "ta-8-1-2",
          "chunkNumber": 2,
          "sanskrit": "स॒ह नौ॑ भुनक्तु।"
        },
        {
          "id": "ta-8-1-3",
          "chunkNumber": 3,
          "sanskrit": "स॒ह वी॒र्यं॑ करवावहै।"
        },
        {
          "id": "ta-8-1-4",
          "chunkNumber": 4,
          "sanskrit": "ते॒ज॒स्विना॒ वधी॑तमस्तु॒ मा वि॑द्विषा॒वहै᳚॥"
        },
        {
          "id": "ta-8-1-5",
          "chunkNumber": 5,
          "sanskrit": "ओं शान्तिः॒ शान्तिः॒ शान्तिः॑"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-8-2",
      "title": "Prapāṭhaka 8 · Anuvāka 2",
      "sectionNumber": 2,
      "chunks": [
        {
          "id": "ta-8-2-1",
          "chunkNumber": 1,
          "sanskrit": "ब्र॒ह्म॒विदा᳚प्नोति॒ पर᳚म्॥",
          "section": 2
        },
        {
          "id": "ta-8-2-2",
          "chunkNumber": 2,
          "sanskrit": "तदे॒षाऽभ्यु॑क्ता।"
        },
        {
          "id": "ta-8-2-3",
          "chunkNumber": 3,
          "sanskrit": "स॒त्यं ज्ञा॒नम॑न॒न्तं ब्रह्म॑।"
        },
        {
          "id": "ta-8-2-4",
          "chunkNumber": 4,
          "sanskrit": "यो वेद॒ निहि॑तं॒ गुहा॑यां पर॒मे व्यो॑मन्न्।"
        },
        {
          "id": "ta-8-2-5",
          "chunkNumber": 5,
          "sanskrit": "सो᳚ऽश्ञुते॒ सर्वा॒न् कामा᳚न्थ् स॒ह।"
        },
        {
          "id": "ta-8-2-6",
          "chunkNumber": 6,
          "sanskrit": "ब्रह्म॑णा विप॒श्चितेति॑॥"
        },
        {
          "id": "ta-8-2-7",
          "chunkNumber": 7,
          "sanskrit": "तस्मा॒द्वा ए॒तस्मा॑दा॒त्मन॑ आका॒शः संभू॑तः।"
        },
        {
          "id": "ta-8-2-8",
          "chunkNumber": 8,
          "sanskrit": "आ॒का॒शाद् वा॒युः।"
        },
        {
          "id": "ta-8-2-9",
          "chunkNumber": 9,
          "sanskrit": "वा॒योर॒ग्निः।"
        },
        {
          "id": "ta-8-2-10",
          "chunkNumber": 10,
          "sanskrit": "अ॒ग्नेरापः॑।"
        },
        {
          "id": "ta-8-2-11",
          "chunkNumber": 11,
          "sanskrit": "अ॒द्भ्यः पृ॑थि॒वी।"
        },
        {
          "id": "ta-8-2-12",
          "chunkNumber": 12,
          "sanskrit": "पृ॒थि॒व्या ओष॑धयः।"
        },
        {
          "id": "ta-8-2-13",
          "chunkNumber": 13,
          "sanskrit": "ओष॑धी॒भ्योऽन्न᳚म्।"
        },
        {
          "id": "ta-8-2-14",
          "chunkNumber": 14,
          "sanskrit": "अन्ना॒त् पुरु॑षः॥"
        },
        {
          "id": "ta-8-2-15",
          "chunkNumber": 15,
          "sanskrit": "स वा एष पुरुषोऽन्न॑रस॒मयः॥"
        },
        {
          "id": "ta-8-2-16",
          "chunkNumber": 16,
          "sanskrit": "तस्येद॑मेव॒ शिरः।"
        },
        {
          "id": "ta-8-2-17",
          "chunkNumber": 17,
          "sanskrit": "अयं दख्षि॑णः प॒ख्षः।"
        },
        {
          "id": "ta-8-2-18",
          "chunkNumber": 18,
          "sanskrit": "अयमुत्त॑रः प॒ख्षः।"
        },
        {
          "id": "ta-8-2-19",
          "chunkNumber": 19,
          "sanskrit": "अयमात्मा᳚।"
        },
        {
          "id": "ta-8-2-20",
          "chunkNumber": 20,
          "sanskrit": "इदं पुच्छं॑ प्रति॒ष्ठा॥"
        },
        {
          "id": "ta-8-2-21",
          "chunkNumber": 21,
          "sanskrit": "तदप्येष श्लो॑को भ॒वति अन्ना॒द्वै प्र॒जाः प्र॒जाय॑न्ते।"
        },
        {
          "id": "ta-8-2-22",
          "chunkNumber": 22,
          "sanskrit": "याः काश्च॑ पृथि॒वीꣴ श्रि॒ताः।"
        },
        {
          "id": "ta-8-2-23",
          "chunkNumber": 23,
          "sanskrit": "अथो॒ अन्ने॑नै॒व जी॑वन्ति।"
        },
        {
          "id": "ta-8-2-24",
          "chunkNumber": 24,
          "sanskrit": "अथै॑न॒दपि॑यन्त्यन्त॒तः।"
        },
        {
          "id": "ta-8-2-25",
          "chunkNumber": 25,
          "sanskrit": "अन्न॒ꣳ॒ हि भू॒तानां॒ ज्येष्ठ᳚म्।"
        },
        {
          "id": "ta-8-2-26",
          "chunkNumber": 26,
          "sanskrit": "तस्मा᳚थ् सर्वौष॒ध मु॑च्यते।"
        },
        {
          "id": "ta-8-2-27",
          "chunkNumber": 27,
          "sanskrit": "सर्व॒व्ँवै तेऽन्न॑माप्नुवन्ति।"
        },
        {
          "id": "ta-8-2-28",
          "chunkNumber": 28,
          "sanskrit": "येऽन्नं॒ ब्रह्मो॒पास॑ते।"
        },
        {
          "id": "ta-8-2-29",
          "chunkNumber": 29,
          "sanskrit": "अन्न॒ꣳ॒ हि भू॒तानां॒ ज्येष्ठ᳚म्।"
        },
        {
          "id": "ta-8-2-30",
          "chunkNumber": 30,
          "sanskrit": "तस्मा᳚थ् सर्वौष॒ध मु॑च्यते।"
        },
        {
          "id": "ta-8-2-31",
          "chunkNumber": 31,
          "sanskrit": "अन्ना᳚द् भू॒तानि॒ जाय॑न्ते।"
        },
        {
          "id": "ta-8-2-32",
          "chunkNumber": 32,
          "sanskrit": "जाता॒न्यन्ने॑न वर्द्धन्ते।"
        },
        {
          "id": "ta-8-2-33",
          "chunkNumber": 33,
          "sanskrit": "अद्यतेऽत्ति च॑ भूता॒नि।"
        },
        {
          "id": "ta-8-2-34",
          "chunkNumber": 34,
          "sanskrit": "तस्मादन्नं तदुच्य॑त इ॒ति॥"
        },
        {
          "id": "ta-8-2-35",
          "chunkNumber": 35,
          "sanskrit": "तस्माद्वा एतस्मादन्न॑रस॒मयात्।"
        },
        {
          "id": "ta-8-2-36",
          "chunkNumber": 36,
          "sanskrit": "अन्योऽन्तर आत्मा᳚ प्राण॒ मयः।"
        },
        {
          "id": "ta-8-2-37",
          "chunkNumber": 37,
          "sanskrit": "तेनै॑ष पू॒र्णः॥"
        },
        {
          "id": "ta-8-2-38",
          "chunkNumber": 38,
          "sanskrit": "स वा एष पुरुषवि॑ध ए॒व।"
        },
        {
          "id": "ta-8-2-39",
          "chunkNumber": 39,
          "sanskrit": "तस्य पुरु॑ष वि॒धताम्।"
        },
        {
          "id": "ta-8-2-40",
          "chunkNumber": 40,
          "sanskrit": "अन्वयं॑ पुरुष॒ विधः।"
        },
        {
          "id": "ta-8-2-41",
          "chunkNumber": 41,
          "sanskrit": "तस्य प्राण॑ एव॒ शिरः॥"
        },
        {
          "id": "ta-8-2-42",
          "chunkNumber": 42,
          "sanskrit": "व्यानो दख्षि॑णः प॒ख्षः।"
        },
        {
          "id": "ta-8-2-43",
          "chunkNumber": 43,
          "sanskrit": "अपान उत्त॑रः प॒ख्षः।"
        },
        {
          "id": "ta-8-2-44",
          "chunkNumber": 44,
          "sanskrit": "आका॑श आ॒त्मा।"
        },
        {
          "id": "ta-8-2-45",
          "chunkNumber": 45,
          "sanskrit": "पृथिवी पुच्छं॑ प्रति॒ष्ठा॥"
        },
        {
          "id": "ta-8-2-46",
          "chunkNumber": 46,
          "sanskrit": "तदप्येष श्लो॑को भ॒वति प्रा॒णं दे॒वा अनु॒प्राण॑न्ति।"
        },
        {
          "id": "ta-8-2-47",
          "chunkNumber": 47,
          "sanskrit": "म॒नु॒ष्याः᳚ प॒शव॑श्च॒ ये।"
        },
        {
          "id": "ta-8-2-48",
          "chunkNumber": 48,
          "sanskrit": "प्रा॒णो हि भू॒ताना॒मायुः॑।"
        },
        {
          "id": "ta-8-2-49",
          "chunkNumber": 49,
          "sanskrit": "तस्मा᳚थ् सर्वायु॒ष मु॑च्यते।"
        },
        {
          "id": "ta-8-2-50",
          "chunkNumber": 50,
          "sanskrit": "सर्व॑मे॒व त॒ आयु॑र्यन्ति।"
        },
        {
          "id": "ta-8-2-51",
          "chunkNumber": 51,
          "sanskrit": "ये प्रा॒णं ब्रह्मो॒पास॑ते।"
        },
        {
          "id": "ta-8-2-52",
          "chunkNumber": 52,
          "sanskrit": "प्राणो हि भूता॑नामा॒युः।"
        },
        {
          "id": "ta-8-2-53",
          "chunkNumber": 53,
          "sanskrit": "तस्माथ् सर्वायुषमुच्य॑त इ॒ति॥"
        },
        {
          "id": "ta-8-2-54",
          "chunkNumber": 54,
          "sanskrit": "तस्यैष एव शारी॑र आ॒त्मा।"
        },
        {
          "id": "ta-8-2-55",
          "chunkNumber": 55,
          "sanskrit": "यः॑ पूर्व॒स्य॥"
        },
        {
          "id": "ta-8-2-56",
          "chunkNumber": 56,
          "sanskrit": "तस्माद्वा एतस्मा᳚त् प्राण॒मयात्।"
        },
        {
          "id": "ta-8-2-57",
          "chunkNumber": 57,
          "sanskrit": "अन्योऽन्तर आत्मा॑ मनो॒मयः।"
        },
        {
          "id": "ta-8-2-58",
          "chunkNumber": 58,
          "sanskrit": "तेनै॑ष पू॒र्णः॥"
        },
        {
          "id": "ta-8-2-59",
          "chunkNumber": 59,
          "sanskrit": "स वा एष पुरुषवि॑ध ए॒व।"
        },
        {
          "id": "ta-8-2-60",
          "chunkNumber": 60,
          "sanskrit": "तस्य पुरु॑षवि॒धताम्।"
        },
        {
          "id": "ta-8-2-61",
          "chunkNumber": 61,
          "sanskrit": "अन्वयं॑ पुरुष॒विधः।"
        },
        {
          "id": "ta-8-2-62",
          "chunkNumber": 62,
          "sanskrit": "तस्य यजु॑रेव॒ शिरः।"
        },
        {
          "id": "ta-8-2-63",
          "chunkNumber": 63,
          "sanskrit": "ऋग् दख्षि॑णः प॒ख्षः।"
        },
        {
          "id": "ta-8-2-64",
          "chunkNumber": 64,
          "sanskrit": "सामोत्त॑रः प॒ख्षः।"
        },
        {
          "id": "ta-8-2-65",
          "chunkNumber": 65,
          "sanskrit": "आदे॑श आ॒त्मा।"
        },
        {
          "id": "ta-8-2-66",
          "chunkNumber": 66,
          "sanskrit": "अथर्वाङ्गिरसः पुच्छं॑ प्रति॒ष्ठा॥"
        },
        {
          "id": "ta-8-2-67",
          "chunkNumber": 67,
          "sanskrit": "तदप्येष श्लो॑को भ॒वति यतो॒ वाचो॒ निव॑००६९;॑र्न्ते।"
        },
        {
          "id": "ta-8-2-68",
          "chunkNumber": 68,
          "sanskrit": "अप्रा᳚प्य॒ मन॑सा स॒ह।"
        },
        {
          "id": "ta-8-2-69",
          "chunkNumber": 69,
          "sanskrit": "आनन्दं ब्रह्म॑णो वि॒द्वान्।"
        },
        {
          "id": "ta-8-2-70",
          "chunkNumber": 70,
          "sanskrit": "न बिभेति कदा॑चने॒ति॥"
        },
        {
          "id": "ta-8-2-71",
          "chunkNumber": 71,
          "sanskrit": "तस्यैष एव शारी॑र आ॒त्मा।"
        },
        {
          "id": "ta-8-2-72",
          "chunkNumber": 72,
          "sanskrit": "यः॑ पूर्व॒स्य॥"
        },
        {
          "id": "ta-8-2-73",
          "chunkNumber": 73,
          "sanskrit": "तस्माद्वा एतस्मा᳚न् मनो॒मयात्।"
        },
        {
          "id": "ta-8-2-74",
          "chunkNumber": 74,
          "sanskrit": "अन्योऽन्तर आत्मा वि॑ज्ञान॒मयः।"
        },
        {
          "id": "ta-8-2-75",
          "chunkNumber": 75,
          "sanskrit": "तेनै॑ष पू॒र्णः॥"
        },
        {
          "id": "ta-8-2-76",
          "chunkNumber": 76,
          "sanskrit": "स वा एष पुरुषवि॑ध ए॒व।"
        },
        {
          "id": "ta-8-2-77",
          "chunkNumber": 77,
          "sanskrit": "तस्य पुरु॑ष वि॒धताम्।"
        },
        {
          "id": "ta-8-2-78",
          "chunkNumber": 78,
          "sanskrit": "अन्वयं॑ पुरुष॒ विधः।"
        },
        {
          "id": "ta-8-2-79",
          "chunkNumber": 79,
          "sanskrit": "तस्य श्र॑द्धैव॒ शिरः।"
        },
        {
          "id": "ta-8-2-80",
          "chunkNumber": 80,
          "sanskrit": "ऋतं दख्षि॑णः प॒ख्षः।"
        },
        {
          "id": "ta-8-2-81",
          "chunkNumber": 81,
          "sanskrit": "सत्यमुत्त॑रः प॒ख्षः।"
        },
        {
          "id": "ta-8-2-82",
          "chunkNumber": 82,
          "sanskrit": "यो॑ग आ॒त्मा।"
        },
        {
          "id": "ta-8-2-83",
          "chunkNumber": 83,
          "sanskrit": "महः पुच्छं॑ प्रति॒ष्ठा॥"
        },
        {
          "id": "ta-8-2-84",
          "chunkNumber": 84,
          "sanskrit": "तदप्येष श्लो॑को भ॒वति वि॒ज्ञान॑य्ँय॒ज्ञं त॑नुते।"
        },
        {
          "id": "ta-8-2-85",
          "chunkNumber": 85,
          "sanskrit": "कर्मा॑णि तनु॒तेऽपि॑ च।"
        },
        {
          "id": "ta-8-2-86",
          "chunkNumber": 86,
          "sanskrit": "वि॒ज्ञानं॑ दे॒वाः सर्वे᳚।"
        },
        {
          "id": "ta-8-2-87",
          "chunkNumber": 87,
          "sanskrit": "ब्रह्म॒ ज्येष्ठ॒मुपा॑सते।"
        },
        {
          "id": "ta-8-2-88",
          "chunkNumber": 88,
          "sanskrit": "वि॒ज्ञानं॒ ब्रह्म॒ चेद् वेद॑।"
        },
        {
          "id": "ta-8-2-89",
          "chunkNumber": 89,
          "sanskrit": "तस्मा॒च्चेन्न प्र॒माद्य॑ति।"
        },
        {
          "id": "ta-8-2-90",
          "chunkNumber": 90,
          "sanskrit": "श॒रीरे॑ पाप्म॑नो हि॒त्वा।"
        },
        {
          "id": "ta-8-2-91",
          "chunkNumber": 91,
          "sanskrit": "सर्वान्कामान्थ्समश्ञु॑त इ॒ति॥"
        },
        {
          "id": "ta-8-2-92",
          "chunkNumber": 92,
          "sanskrit": "तस्यैष एव शारी॑र आ॒त्मा।"
        },
        {
          "id": "ta-8-2-93",
          "chunkNumber": 93,
          "sanskrit": "यः॑ पूर्व॒स्य॥"
        },
        {
          "id": "ta-8-2-94",
          "chunkNumber": 94,
          "sanskrit": "तस्माद्वा एतस्माद्वि॑ज्ञान॒मयात्।"
        },
        {
          "id": "ta-8-2-95",
          "chunkNumber": 95,
          "sanskrit": "अन्योऽन्तर आत्मा॑ऽऽनन्द॒मयः।"
        },
        {
          "id": "ta-8-2-96",
          "chunkNumber": 96,
          "sanskrit": "तेनै॑ष पू॒र्णः॥"
        },
        {
          "id": "ta-8-2-97",
          "chunkNumber": 97,
          "sanskrit": "स वा एष पुरुषवि॑ध ए॒व।"
        },
        {
          "id": "ta-8-2-98",
          "chunkNumber": 98,
          "sanskrit": "तस्य पुरु॑षवि॒धताम्।"
        },
        {
          "id": "ta-8-2-99",
          "chunkNumber": 99,
          "sanskrit": "अन्वयं॑ पुरुष॒विधः।"
        },
        {
          "id": "ta-8-2-100",
          "chunkNumber": 100,
          "sanskrit": "तस्य प्रिय॑मेव॒ शिरः।"
        },
        {
          "id": "ta-8-2-101",
          "chunkNumber": 101,
          "sanskrit": "मोदो दख्षि॑णः प॒ख्षः।"
        },
        {
          "id": "ta-8-2-102",
          "chunkNumber": 102,
          "sanskrit": "प्रमोद उत्त॑रः प॒ख्षः।"
        },
        {
          "id": "ta-8-2-103",
          "chunkNumber": 103,
          "sanskrit": "आन॑न्द आ॒त्मा।"
        },
        {
          "id": "ta-8-2-104",
          "chunkNumber": 104,
          "sanskrit": "ब्रह्म पुच्छं॑ प्रति॒ष्ठा॥"
        },
        {
          "id": "ta-8-2-105",
          "chunkNumber": 105,
          "sanskrit": "तदप्येष श्लो॑को भ॒वति अस॑न्ने॒व स॑ भवति।"
        },
        {
          "id": "ta-8-2-106",
          "chunkNumber": 106,
          "sanskrit": "अस॒द् ब्रह्मेति॒ वेद॒ चेत्।"
        },
        {
          "id": "ta-8-2-107",
          "chunkNumber": 107,
          "sanskrit": "अस्ति ब्रह्मेति॑ चेद् वे॒द।"
        },
        {
          "id": "ta-8-2-108",
          "chunkNumber": 108,
          "sanskrit": "सन्तमेनं ततो वि॑दुरि॒ति॥"
        },
        {
          "id": "ta-8-2-109",
          "chunkNumber": 109,
          "sanskrit": "तस्यैष एव शारी॑र आ॒त्मा।"
        },
        {
          "id": "ta-8-2-110",
          "chunkNumber": 110,
          "sanskrit": "यः॑ पूर्व॒स्य॥"
        },
        {
          "id": "ta-8-2-111",
          "chunkNumber": 111,
          "sanskrit": "अथातो॑ऽनु प्र॒श्ञाः॥"
        },
        {
          "id": "ta-8-2-112",
          "chunkNumber": 112,
          "sanskrit": "उ॒ता वि॒द्वा न॒मुल्ँलो॒कं प्रेत्य॑।"
        },
        {
          "id": "ta-8-2-113",
          "chunkNumber": 113,
          "sanskrit": "कश्च॒न ग॑च्छ॒ती(३)।"
        },
        {
          "id": "ta-8-2-114",
          "chunkNumber": 114,
          "sanskrit": "आहो॑ वि॒द्वान॒मुल्ँलो॒कं प्रेत्य॑।"
        },
        {
          "id": "ta-8-2-115",
          "chunkNumber": 115,
          "sanskrit": "कश्चि॒त् सम॑श्ञु॒ता(३) उ॒॥"
        },
        {
          "id": "ta-8-2-116",
          "chunkNumber": 116,
          "sanskrit": "सो॑ऽकामयत।"
        },
        {
          "id": "ta-8-2-117",
          "chunkNumber": 117,
          "sanskrit": "ब॒हुस्यां॒ प्रजा॑ये॒येति॑।"
        },
        {
          "id": "ta-8-2-118",
          "chunkNumber": 118,
          "sanskrit": "स तपो॑ऽतप्यत।"
        },
        {
          "id": "ta-8-2-119",
          "chunkNumber": 119,
          "sanskrit": "स तप॑स्त॒प्त्वा।"
        },
        {
          "id": "ta-8-2-120",
          "chunkNumber": 120,
          "sanskrit": "इ॒दꣳ सर्व॑मसृजत॥"
        },
        {
          "id": "ta-8-2-121",
          "chunkNumber": 121,
          "sanskrit": "यदि॒दं किञ्च॑।"
        },
        {
          "id": "ta-8-2-122",
          "chunkNumber": 122,
          "sanskrit": "तथ्सृ॒ष्ट्वा।"
        },
        {
          "id": "ta-8-2-123",
          "chunkNumber": 123,
          "sanskrit": "तदे॒वानु॒ प्रावि॑शत्॥"
        },
        {
          "id": "ta-8-2-124",
          "chunkNumber": 124,
          "sanskrit": "तद॑नुप्र॒विश्य॑।"
        },
        {
          "id": "ta-8-2-125",
          "chunkNumber": 125,
          "sanskrit": "सच्च॒ त्यच्चा॑भवत्।"
        },
        {
          "id": "ta-8-2-126",
          "chunkNumber": 126,
          "sanskrit": "नि॒रुक्तं॒ चा नि॑रुक्तं च।"
        },
        {
          "id": "ta-8-2-127",
          "chunkNumber": 127,
          "sanskrit": "नि॒लय॑नं॒ चा नि॑लयनं च।"
        },
        {
          "id": "ta-8-2-128",
          "chunkNumber": 128,
          "sanskrit": "वि॒ज्ञानं॒ चा वि॑ज्ञानं च।"
        },
        {
          "id": "ta-8-2-129",
          "chunkNumber": 129,
          "sanskrit": "सत्यं चानृतं च स॑त्यम॒भवत्॥"
        },
        {
          "id": "ta-8-2-130",
          "chunkNumber": 130,
          "sanskrit": "यदि॑दं कि॒ञ्च।"
        },
        {
          "id": "ta-8-2-131",
          "chunkNumber": 131,
          "sanskrit": "तथ्सत्यमि॑त्या च॒ख्षते॥"
        },
        {
          "id": "ta-8-2-132",
          "chunkNumber": 132,
          "sanskrit": "तदप्येष श्लो॑को भ॒वति अस॒द्वा इ॒दमग्र॑ आसीत्।"
        },
        {
          "id": "ta-8-2-133",
          "chunkNumber": 133,
          "sanskrit": "ततो॒ वै सद॑जायत।"
        },
        {
          "id": "ta-8-2-134",
          "chunkNumber": 134,
          "sanskrit": "तदात्मानꣴ स्वय॑मकु॒रुत।"
        },
        {
          "id": "ta-8-2-135",
          "chunkNumber": 135,
          "sanskrit": "तस्मात् तथ् सुकृतमुच्य॑त इ॒ति॥"
        },
        {
          "id": "ta-8-2-136",
          "chunkNumber": 136,
          "sanskrit": "यद्वै॑ तथ् सु॒कृतम्।"
        },
        {
          "id": "ta-8-2-137",
          "chunkNumber": 137,
          "sanskrit": "र॑सो वै॒ सः।"
        },
        {
          "id": "ta-8-2-138",
          "chunkNumber": 138,
          "sanskrit": "रसꣴ ह्येवायल्ँलब्ध्वाऽऽन॑न्दी भ॒वति॥"
        },
        {
          "id": "ta-8-2-139",
          "chunkNumber": 139,
          "sanskrit": "को ह्येवान्या᳚त् कः प्रा॒ण्यात्।"
        },
        {
          "id": "ta-8-2-140",
          "chunkNumber": 140,
          "sanskrit": "यदेष आकाश आन॑न्दो न॒ स्यात्।"
        },
        {
          "id": "ta-8-2-141",
          "chunkNumber": 141,
          "sanskrit": "एष ह्येवान॑न्दया॒ति॥"
        },
        {
          "id": "ta-8-2-142",
          "chunkNumber": 142,
          "sanskrit": "य॒दा ह्ये॑वैष॒ एतस्मिन्नदृश्ये ऽनात्म्ये ऽनिरुक्ते ऽनिलयने ऽभयं प्रति॑ष्ठाव्ँवि॒न्दते।"
        },
        {
          "id": "ta-8-2-143",
          "chunkNumber": 143,
          "sanskrit": "अथ सोऽभयं ग॑तो भ॒वति॥"
        },
        {
          "id": "ta-8-2-144",
          "chunkNumber": 144,
          "sanskrit": "य॒दा ह्ये॑वैष॒ एतस्मिन्नुदरमन्त॑रं कु॒रुते।"
        },
        {
          "id": "ta-8-2-145",
          "chunkNumber": 145,
          "sanskrit": "अथ तस्य भ॑यं भ॒वति॥"
        },
        {
          "id": "ta-8-2-146",
          "chunkNumber": 146,
          "sanskrit": "तत्त्वेव भयव्ँविदुषोऽम॑न्वान॒स्य॥"
        },
        {
          "id": "ta-8-2-147",
          "chunkNumber": 147,
          "sanskrit": "तदप्येष श्लो॑को भ॒वति भी॒षाऽस्मा॒द्वातः॑ पवते।"
        },
        {
          "id": "ta-8-2-148",
          "chunkNumber": 148,
          "sanskrit": "भी॒षोदे॑ति॒ सूर्यः॑।"
        },
        {
          "id": "ta-8-2-149",
          "chunkNumber": 149,
          "sanskrit": "भीषाऽस्मादग्नि॑श्चेन्द्र॒श्च।"
        },
        {
          "id": "ta-8-2-150",
          "chunkNumber": 150,
          "sanskrit": "मृत्युर् धावति पञ्च॑म इ॒ति॥"
        },
        {
          "id": "ta-8-2-151",
          "chunkNumber": 151,
          "sanskrit": "सैषाऽऽनन्दस्य मीमा॑ꣳसा भ॒वति॥"
        },
        {
          "id": "ta-8-2-152",
          "chunkNumber": 152,
          "sanskrit": "युवा स्याथ् साधु यु॑वाऽद्ध्या॒यकः।"
        },
        {
          "id": "ta-8-2-153",
          "chunkNumber": 153,
          "sanskrit": "आशिष्ठो दृढिष्ठो॑ बलि॒ष्ठः।"
        },
        {
          "id": "ta-8-2-154",
          "chunkNumber": 154,
          "sanskrit": "तस्येयं पृथिवी सर्वा वित्तस्य॑ पूर्णा॒ स्यात्।"
        },
        {
          "id": "ta-8-2-155",
          "chunkNumber": 155,
          "sanskrit": "स एको मानुष॑ आन॒न्दः॥"
        },
        {
          "id": "ta-8-2-156",
          "chunkNumber": 156,
          "sanskrit": "ते ये शतं मानुषा॑ आन॒न्दाः।"
        },
        {
          "id": "ta-8-2-157",
          "chunkNumber": 157,
          "sanskrit": "स एको मनुष्यगन्धर्वाणा॑मान॒न्दः।"
        },
        {
          "id": "ta-8-2-158",
          "chunkNumber": 158,
          "sanskrit": "श्रोत्रियस्य चाकाम॑हत॒स्य॥"
        },
        {
          "id": "ta-8-2-159",
          "chunkNumber": 159,
          "sanskrit": "ते ये शतं मनुष्यगन्धर्वाणा॑मान॒न्दाः।"
        },
        {
          "id": "ta-8-2-160",
          "chunkNumber": 160,
          "sanskrit": "स एको देवगन्धर्वाणा॑मान॒न्दः।"
        },
        {
          "id": "ta-8-2-161",
          "chunkNumber": 161,
          "sanskrit": "श्रोत्रियस्य चाकाम॑हत॒स्य॥"
        },
        {
          "id": "ta-8-2-162",
          "chunkNumber": 162,
          "sanskrit": "ते ये शतं देवगन्धर्वाणा॑मान॒न्दाः।"
        },
        {
          "id": "ta-8-2-163",
          "chunkNumber": 163,
          "sanskrit": "स एकः पितृणां चिरलोकलोकाना॑मान॒न्दः।"
        },
        {
          "id": "ta-8-2-164",
          "chunkNumber": 164,
          "sanskrit": "श्रोत्रियस्य चाकाम॑हत॒स्य॥"
        },
        {
          "id": "ta-8-2-165",
          "chunkNumber": 165,
          "sanskrit": "ते ये शतं पितृणां चिरलोकलोकाना॑मान॒न्दाः।"
        },
        {
          "id": "ta-8-2-166",
          "chunkNumber": 166,
          "sanskrit": "स एक आजानजानां देवाना॑मान॒न्दः।"
        },
        {
          "id": "ta-8-2-167",
          "chunkNumber": 167,
          "sanskrit": "श्रोत्रियस्य चाकाम॑हत॒स्य॥"
        },
        {
          "id": "ta-8-2-168",
          "chunkNumber": 168,
          "sanskrit": "ते ये शतमाजानजानां देवाना॑ मान॒न्दाः।"
        },
        {
          "id": "ta-8-2-169",
          "chunkNumber": 169,
          "sanskrit": "स एकः कर्मदेवानां देवाना॑मान॒न्दः।"
        },
        {
          "id": "ta-8-2-170",
          "chunkNumber": 170,
          "sanskrit": "ये कर्मणा देवान॑पि य॒न्ति।"
        },
        {
          "id": "ta-8-2-171",
          "chunkNumber": 171,
          "sanskrit": "श्रोत्रियस्य चाकाम॑हत॒स्य॥"
        },
        {
          "id": "ta-8-2-172",
          "chunkNumber": 172,
          "sanskrit": "ते ये शतं कर्मदेवानां देवाना॑मान॒न्दाः।"
        },
        {
          "id": "ta-8-2-173",
          "chunkNumber": 173,
          "sanskrit": "स एको देवाना॑मान॒न्दः।"
        },
        {
          "id": "ta-8-2-174",
          "chunkNumber": 174,
          "sanskrit": "श्रोत्रियस्य चाकाम॑हत॒स्य॥"
        },
        {
          "id": "ta-8-2-175",
          "chunkNumber": 175,
          "sanskrit": "ते ये शतं देवाना॑मान॒न्दाः।"
        },
        {
          "id": "ta-8-2-176",
          "chunkNumber": 176,
          "sanskrit": "स एक इन्द्र॑स्यान॒न्दः।"
        },
        {
          "id": "ta-8-2-177",
          "chunkNumber": 177,
          "sanskrit": "श्रोत्रियस्य चाकाम॑हत॒स्य॥"
        },
        {
          "id": "ta-8-2-178",
          "chunkNumber": 178,
          "sanskrit": "ते ये शतमिन्द्र॑स्याऽऽन॒न्दाः।"
        },
        {
          "id": "ta-8-2-179",
          "chunkNumber": 179,
          "sanskrit": "स एको बृहस्पते॑रान॒न्दः।"
        },
        {
          "id": "ta-8-2-180",
          "chunkNumber": 180,
          "sanskrit": "श्रोत्रियस्य चाकाम॑हत॒स्य॥"
        },
        {
          "id": "ta-8-2-181",
          "chunkNumber": 181,
          "sanskrit": "ते ये शतं बृहस्पते॑ रान॒न्दाः।"
        },
        {
          "id": "ta-8-2-182",
          "chunkNumber": 182,
          "sanskrit": "स एकः प्रजापते॑रान॒न्दः।"
        },
        {
          "id": "ta-8-2-183",
          "chunkNumber": 183,
          "sanskrit": "श्रोत्रियस्य चाकाम॑हत॒स्य॥"
        },
        {
          "id": "ta-8-2-184",
          "chunkNumber": 184,
          "sanskrit": "ते ये शतं प्रजापते॑रान॒न्दाः।"
        },
        {
          "id": "ta-8-2-185",
          "chunkNumber": 185,
          "sanskrit": "स एको ब्रह्मण॑ आन॒न्दः।"
        },
        {
          "id": "ta-8-2-186",
          "chunkNumber": 186,
          "sanskrit": "श्रोत्रियस्य चाकाम॑हत॒स्य॥"
        },
        {
          "id": "ta-8-2-187",
          "chunkNumber": 187,
          "sanskrit": "स यश्चा॑यं पु॒रुषे।"
        },
        {
          "id": "ta-8-2-188",
          "chunkNumber": 188,
          "sanskrit": "यश्चासा॑वादि॒त्ये।"
        },
        {
          "id": "ta-8-2-189",
          "chunkNumber": 189,
          "sanskrit": "स एकः॑॥"
        },
        {
          "id": "ta-8-2-190",
          "chunkNumber": 190,
          "sanskrit": "स य॑ एव॒व्ँवित्।"
        },
        {
          "id": "ta-8-2-191",
          "chunkNumber": 191,
          "sanskrit": "अस्माल्लो॑कात् प्रे॒त्य।"
        },
        {
          "id": "ta-8-2-192",
          "chunkNumber": 192,
          "sanskrit": "एतमन्नमयमात्मानमुप॑सङ्क्रा॒मति।"
        },
        {
          "id": "ta-8-2-193",
          "chunkNumber": 193,
          "sanskrit": "एतं प्राणमयमात्मानमुप॑सङ्क्रा॒मति।"
        },
        {
          "id": "ta-8-2-194",
          "chunkNumber": 194,
          "sanskrit": "एतं मनोमयमात्मानमुप॑सङ्क्रा॒मति।"
        },
        {
          "id": "ta-8-2-195",
          "chunkNumber": 195,
          "sanskrit": "एतव्ँविज्ञानमयमात्मानमुप॑सङ्क्रा॒मति।"
        },
        {
          "id": "ta-8-2-196",
          "chunkNumber": 196,
          "sanskrit": "एतमानन्दमयमात्मानमुप॑सङ्क्रा॒मति॥"
        },
        {
          "id": "ta-8-2-197",
          "chunkNumber": 197,
          "sanskrit": "तदप्येष श्लो॑को भ॒वति॥"
        },
        {
          "id": "ta-8-2-198",
          "chunkNumber": 198,
          "sanskrit": "यतो॒ वाचो॒ निव॑र्तन्ते।"
        },
        {
          "id": "ta-8-2-199",
          "chunkNumber": 199,
          "sanskrit": "अप्रा᳚प्य॒ मन॑सा स॒ह।"
        },
        {
          "id": "ta-8-2-200",
          "chunkNumber": 200,
          "sanskrit": "आनन्दं ब्रह्म॑णो वि॒द्वान्।"
        },
        {
          "id": "ta-8-2-201",
          "chunkNumber": 201,
          "sanskrit": "न बिभेति कुत॑श्चने॒ति॥"
        },
        {
          "id": "ta-8-2-202",
          "chunkNumber": 202,
          "sanskrit": "एतꣳ ह वा व॑ न त॒पति।"
        },
        {
          "id": "ta-8-2-203",
          "chunkNumber": 203,
          "sanskrit": "किमहꣳ साधु॑ नाक॒रवम्।"
        },
        {
          "id": "ta-8-2-204",
          "chunkNumber": 204,
          "sanskrit": "किमहं पापमकर॑वमि॒ति॥"
        },
        {
          "id": "ta-8-2-205",
          "chunkNumber": 205,
          "sanskrit": "स य एवव्ँविद्वानेते आत्मा॑नꣴ स्पृ॒णुते॥"
        },
        {
          "id": "ta-8-2-206",
          "chunkNumber": 206,
          "sanskrit": "उ॒भे ह्ये॑वैष॒ एते आत्मा॑नꣴ स्पृ॒णुते।"
        },
        {
          "id": "ta-8-2-207",
          "chunkNumber": 207,
          "sanskrit": "य ए॒वव्ँवेद॑॥"
        },
        {
          "id": "ta-8-2-208",
          "chunkNumber": 208,
          "sanskrit": "इत्यु॑प॒निष॑त्"
        }
      ]
    }
  ]
}
