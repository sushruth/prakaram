{
  "sections": [
    {
      "id": "rigveda-2-41",
      "title": "Maṇḍala 2 · Sūkta 41",
      "sectionNumber": 41,
      "chunks": [
        {
          "id": "rv-2-41-1",
          "chunkNumber": 1,
          "sanskrit": "वायो॒ ये ते॑ सह॒स्रिणो॒ रथा॑स॒स्तेभि॒रा ग॑हि ।",
          "section": 41,
          "padya": 1
        },
        {
          "id": "rv-2-41-2",
          "chunkNumber": 2,
          "sanskrit": "नि॒युत्वा॒न्त्सोम॑पीतये ॥ १ ॥"
        },
        {
          "id": "rv-2-41-3",
          "chunkNumber": 3,
          "sanskrit": "नि॒युत्वा॑न् वाय॒वा ग॑ह्य॒यं शु॒क्रो अ॑यामि ते ।",
          "padya": 2
        },
        {
          "id": "rv-2-41-4",
          "chunkNumber": 4,
          "sanskrit": "गन्ता॑सि सुन्व॒तो गृ॒हम् ॥ २ ॥"
        },
        {
          "id": "rv-2-41-5",
          "chunkNumber": 5,
          "sanskrit": "शु॒क्रस्या॒द्य गवा॑शिर॒ इन्द्र॑वायू नि॒युत्व॑तः ।",
          "padya": 3
        },
        {
          "id": "rv-2-41-6",
          "chunkNumber": 6,
          "sanskrit": "आ या॑तं॒ पिब॑तं नरा ॥ ३ ॥"
        },
        {
          "id": "rv-2-41-7",
          "chunkNumber": 7,
          "sanskrit": "अ॒यं वां॑ मित्रावरुणा सु॒तः सोम॑ ऋतावृधा ।",
          "padya": 4
        },
        {
          "id": "rv-2-41-8",
          "chunkNumber": 8,
          "sanskrit": "ममेदि॒ह श्रु॑तं॒ हव॑म् ॥ ४ ॥"
        },
        {
          "id": "rv-2-41-9",
          "chunkNumber": 9,
          "sanskrit": "राजा॑ना॒वन॑भिद्रुहा ध्रु॒वे सद॑स्युत्त॒मे ।",
          "padya": 5
        },
        {
          "id": "rv-2-41-10",
          "chunkNumber": 10,
          "sanskrit": "स॒हस्र॑स्थूण आसाते ॥ ५ ॥"
        },
        {
          "id": "rv-2-41-11",
          "chunkNumber": 11,
          "sanskrit": "ता स॒म्राजा॑ घृ॒तासु॑ती आदि॒त्या दानु॑न॒स्पती॑ ।",
          "padya": 6
        },
        {
          "id": "rv-2-41-12",
          "chunkNumber": 12,
          "sanskrit": "सचे॑ते॒ अन॑वह्वरम् ॥ ६ ॥"
        },
        {
          "id": "rv-2-41-13",
          "chunkNumber": 13,
          "sanskrit": "गोम॑दू॒ षु ना॑स॒त्याश्वा॑वद्यातमश्विना ।",
          "padya": 7
        },
        {
          "id": "rv-2-41-14",
          "chunkNumber": 14,
          "sanskrit": "व॒र्ती रु॑द्रा नृ॒पाय्य॑म् ॥ ७ ॥"
        },
        {
          "id": "rv-2-41-15",
          "chunkNumber": 15,
          "sanskrit": "न यत् परो॒ नान्त॑र आद॒धर्ष॑द् वृषण्वसू ।",
          "padya": 8
        },
        {
          "id": "rv-2-41-16",
          "chunkNumber": 16,
          "sanskrit": "दु॒:शंसो॒ मर्त्यो॑ रि॒पुः ॥ ८ ॥"
        },
        {
          "id": "rv-2-41-17",
          "chunkNumber": 17,
          "sanskrit": "ता न॒ आ वो॑ळहमश्विना र॒यिं पि॒शङ्ग॑संदृशम् ।",
          "padya": 9
        },
        {
          "id": "rv-2-41-18",
          "chunkNumber": 18,
          "sanskrit": "धिष्ण्या॑ वरिवो॒विद॑म् ॥ ९ ॥"
        },
        {
          "id": "rv-2-41-19",
          "chunkNumber": 19,
          "sanskrit": "इन्द्रो॑ अ॒ङ्ग म॒हद् भ॒यम॒भी षदप॑ चुच्यवत् ।",
          "padya": 10
        },
        {
          "id": "rv-2-41-20",
          "chunkNumber": 20,
          "sanskrit": "स हि स्थि॒रो विच॑र्षणिः ॥ १० ॥"
        },
        {
          "id": "rv-2-41-21",
          "chunkNumber": 21,
          "sanskrit": "इन्द्र॑श्च मृ॒ळया॑ति नो॒ न न॑: प॒श्चाद॒घं न॑शत् ।",
          "padya": 11
        },
        {
          "id": "rv-2-41-22",
          "chunkNumber": 22,
          "sanskrit": "भ॒द्रं भ॑वाति नः पु॒रः ॥ ११ ॥"
        },
        {
          "id": "rv-2-41-23",
          "chunkNumber": 23,
          "sanskrit": "इन्द्र॒ आशा॑भ्य॒स्परि॒ सर्वा॑भ्यो॒ अभ॑यं करत् ।",
          "padya": 12
        },
        {
          "id": "rv-2-41-24",
          "chunkNumber": 24,
          "sanskrit": "जेता॒ शत्रू॒न् विच॑र्षणिः ॥ १२ ॥"
        },
        {
          "id": "rv-2-41-25",
          "chunkNumber": 25,
          "sanskrit": "विश्वे॑ देवास॒ आ ग॑त शृणु॒ता म॑ इ॒मं हव॑म् ।",
          "padya": 13
        },
        {
          "id": "rv-2-41-26",
          "chunkNumber": 26,
          "sanskrit": "एदं ब॒र्हिर्नि षी॑दत ॥ १३ ॥"
        },
        {
          "id": "rv-2-41-27",
          "chunkNumber": 27,
          "sanskrit": "ती॒व्रो वो॒ मधु॑माँ अ॒यं शु॒नहो॑त्रेषु मत्स॒रः ।",
          "padya": 14
        },
        {
          "id": "rv-2-41-28",
          "chunkNumber": 28,
          "sanskrit": "ए॒तं पि॑बत॒ काम्य॑म् ॥ १४ ॥"
        },
        {
          "id": "rv-2-41-29",
          "chunkNumber": 29,
          "sanskrit": "इन्द्र॑ज्येष्ठा॒ मरु॑द्गणा॒ देवा॑स॒: पूष॑रातयः ।",
          "padya": 15
        },
        {
          "id": "rv-2-41-30",
          "chunkNumber": 30,
          "sanskrit": "विश्वे॒ मम॑ श्रुता॒ हव॑म् ॥ १५ ॥"
        },
        {
          "id": "rv-2-41-31",
          "chunkNumber": 31,
          "sanskrit": "अम्बि॑तमे॒ नदी॑तमे॒ देवि॑तमे॒ सर॑स्वति ।",
          "padya": 16
        },
        {
          "id": "rv-2-41-32",
          "chunkNumber": 32,
          "sanskrit": "अ॒प्र॒श॒स्ता इ॑व स्मसि॒ प्रश॑स्तिमम्ब नस्कृधि ॥ १६ ॥"
        },
        {
          "id": "rv-2-41-33",
          "chunkNumber": 33,
          "sanskrit": "त्वे विश्वा॑ सरस्वति श्रि॒तायूं॑षि दे॒व्याम् ।",
          "padya": 17
        },
        {
          "id": "rv-2-41-34",
          "chunkNumber": 34,
          "sanskrit": "शु॒नहो॑त्रेषु मत्स्व प्र॒जां दे॑वि दिदिड्ढि नः॥ १७ ॥"
        },
        {
          "id": "rv-2-41-35",
          "chunkNumber": 35,
          "sanskrit": "इ॒मा ब्रह्म॑ सरस्वति जु॒षस्व॑ वाजिनीवति ।",
          "padya": 18
        },
        {
          "id": "rv-2-41-36",
          "chunkNumber": 36,
          "sanskrit": "या ते॒ मन्म॑ गृत्सम॒दा ऋ॑तावरि प्रि॒या दे॒वेषु॒ जुह्व॑ति ॥ १८ ॥"
        },
        {
          "id": "rv-2-41-37",
          "chunkNumber": 37,
          "sanskrit": "प्रेतां॑ य॒ज्ञस्य॑ श॒म्भुवा॑ यु॒वामिदा वृ॑णीमहे ।",
          "padya": 19
        },
        {
          "id": "rv-2-41-38",
          "chunkNumber": 38,
          "sanskrit": "अ॒ग्निं च॑ हव्य॒वाह॑नम् ॥ १९ ॥"
        },
        {
          "id": "rv-2-41-39",
          "chunkNumber": 39,
          "sanskrit": "द्यावा॑ नः पृथि॒वी इ॒मं सि॒ध्रम॒द्य दि॑वि॒स्पृश॑म् ।",
          "padya": 20
        },
        {
          "id": "rv-2-41-40",
          "chunkNumber": 40,
          "sanskrit": "य॒ज्ञं दे॒वेषु॑ यच्छताम् ॥ २० ॥"
        },
        {
          "id": "rv-2-41-41",
          "chunkNumber": 41,
          "sanskrit": "आ वा॑मु॒पस्थ॑मद्रुहा दे॒वाः सी॑दन्तु य॒ज्ञिया॑: ।",
          "padya": 21
        },
        {
          "id": "rv-2-41-42",
          "chunkNumber": 42,
          "sanskrit": "इ॒हाद्य सोम॑पीतये ॥ २१ ॥"
        }
      ]
    },
    {
      "id": "rigveda-2-42",
      "title": "Maṇḍala 2 · Sūkta 42",
      "sectionNumber": 42,
      "chunks": [
        {
          "id": "rv-2-42-1",
          "chunkNumber": 1,
          "sanskrit": "कनि॑क्रदज्ज॒नुषं॑ प्रब्रुवा॒ण इय॑र्ति॒ वाच॑मरि॒तेव॒ नाव॑म् ।",
          "section": 42,
          "padya": 1
        },
        {
          "id": "rv-2-42-2",
          "chunkNumber": 2,
          "sanskrit": "सु॒म॒ङ्गल॑श्च शकुने॒ भवा॑सि॒ मा त्वा॒ का चि॑दभि॒भा विश्व्या॑ विदत् ॥ १ ॥"
        },
        {
          "id": "rv-2-42-3",
          "chunkNumber": 3,
          "sanskrit": "मा त्वा॑ श्ये॒न उद् व॑धी॒न्मा सु॑प॒र्णो मा त्वा॑ विद॒दिषु॑मान् वी॒रो अस्ता॑ ।",
          "padya": 2
        },
        {
          "id": "rv-2-42-4",
          "chunkNumber": 4,
          "sanskrit": "पित्र्या॒मनु॑ प्र॒दिशं॒ कनि॑क्रदत् सुम॒ङ्गलो॑ भद्रवा॒दी व॑दे॒ह ॥ २ ॥"
        },
        {
          "id": "rv-2-42-5",
          "chunkNumber": 5,
          "sanskrit": "अव॑ क्रन्द दक्षिण॒तो गृ॒हाणां॑ सुम॒ङ्गलो॑ भद्रवा॒दी श॑कुन्ते ।",
          "padya": 3
        },
        {
          "id": "rv-2-42-6",
          "chunkNumber": 6,
          "sanskrit": "मा न॑: स्ते॒न ई॑शत॒ माघशं॑सो बृ॒हद् व॑देम वि॒दथे॑ सु॒वीरा॑: ॥ ३ ॥"
        }
      ]
    },
    {
      "id": "rigveda-2-43",
      "title": "Maṇḍala 2 · Sūkta 43",
      "sectionNumber": 43,
      "chunks": [
        {
          "id": "rv-2-43-1",
          "chunkNumber": 1,
          "sanskrit": "प्र॒द॒क्षि॒णिद॒भि गृ॑णन्ति का॒रवो॒ वयो॒ वद॑न्त ऋतु॒था श॒कुन्त॑यः ।",
          "section": 43,
          "padya": 1
        },
        {
          "id": "rv-2-43-2",
          "chunkNumber": 2,
          "sanskrit": "उ॒भे वाचौ॑ वदति साम॒गा इ॑व गाय॒त्रं च॒ त्रैष्टु॑भं॒ चानु॑ राजति ॥ १ ॥"
        },
        {
          "id": "rv-2-43-3",
          "chunkNumber": 3,
          "sanskrit": "उ॒द्गा॒तेव॑ शकुने॒ साम॑ गायसि ब्रह्मपु॒त्र इ॑व॒ सव॑नेषु शंससि ।",
          "padya": 2
        },
        {
          "id": "rv-2-43-4",
          "chunkNumber": 4,
          "sanskrit": "वृषे॑व वा॒जी शिशु॑मतीर॒पीत्या॑ स॒र्वतो॑ नः शकुने भ॒द्रमा व॑द\n\nवि॒श्वतो॑ नः शकुने॒ पुण्य॒मा व॑द ॥ २ ॥"
        },
        {
          "id": "rv-2-43-5",
          "chunkNumber": 5,
          "sanskrit": "आ॒वदं॒स्त्वं श॑कुने भ॒द्रमा व॑द तू॒ष्णीमासी॑नः सुम॒तिं चि॑किद्धि नः ।",
          "padya": 3
        },
        {
          "id": "rv-2-43-6",
          "chunkNumber": 6,
          "sanskrit": "यदु॒त्पत॒न् वद॑सि कर्क॒रिर्य॑था बृ॒हद् व॑देम वि॒दथे॑ सु॒वीरा॑: ॥ ३ ॥"
        }
      ]
    }
  ]
}
