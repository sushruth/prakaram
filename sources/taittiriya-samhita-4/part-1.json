          "id": "ts-4-1-8-7",
          "chunkNumber": 7,
          "sanskrit": "अच्छा॒यमे॑ति॒ शव॑सा घृ॒तेने॑डा॒नो वह्नि॒र् नम॑सा।"
        },
        {
          "id": "ts-4-1-8-8",
          "chunkNumber": 8,
          "sanskrit": "अ॒ग्निꣴ स्रुचो॑ अद्ध्व॒रेषु॑ प्र॒यथ्सु॑॥"
        },
        {
          "id": "ts-4-1-8-9",
          "chunkNumber": 9,
          "sanskrit": "स य॑ख्षदस्य महि॒मान॑म॒ग्नेः स भार॑ती।"
        },
        {
          "id": "ts-4-1-8-10",
          "chunkNumber": 10,
          "sanskrit": "म॒ही गृ॑णा॒ना॥"
        },
        {
          "id": "ts-4-1-8-11",
          "chunkNumber": 11,
          "sanskrit": "तन्न॑स्तु॒रीप॒मद्भु॑तम्पुरु॒ख्षु त्वष्टा॑ सु॒वीर᳚म्।"
        },
        {
          "id": "ts-4-1-8-12",
          "chunkNumber": 12,
          "sanskrit": "रा॒यस्पोष॒व्ँवि ष्य॑तु॒ नाभि॑म॒स्मे॥"
        },
        {
          "id": "ts-4-1-8-13",
          "chunkNumber": 13,
          "sanskrit": "वन॑स्प॒तेऽव॑ सृजा॒ ररा॑ण॒स्त्मना॑ दे॒वेषु॑।"
        },
        {
          "id": "ts-4-1-8-14",
          "chunkNumber": 14,
          "sanskrit": "अ॒ग्निर्ह॒व्यꣳ श॑मि॒ता सू॑दयाति॥"
        },
        {
          "id": "ts-4-1-8-15",
          "chunkNumber": 15,
          "sanskrit": "अग्ने॒ स्वाहा॑ कृणुहि जातवेद॒ इन्द्रा॑य ह॒व्यम्।"
        },
        {
          "id": "ts-4-1-8-16",
          "chunkNumber": 16,
          "sanskrit": "विश्वे॑ दे॒वा ह॒विरि॒दञ्जु॑षन्ताम्॥"
        },
        {
          "id": "ts-4-1-8-17",
          "chunkNumber": 17,
          "sanskrit": "हि॒र॒ण्य॒ग॒र्भः सम॑वर्त॒ताग्रे॑ भू॒तस्य॑ जा॒तः पति॒रेक॑ आसीत्।"
        },
        {
          "id": "ts-4-1-8-18",
          "chunkNumber": 18,
          "sanskrit": "स दा॑धार पृथि॒वीन्द्या"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-1-9",
      "title": "Kāṇḍa 4 · Prapāṭhaka 1 · Anuvāka 9",
      "sectionNumber": 9,
      "chunks": [
        {
          "id": "ts-4-1-9-1",
          "chunkNumber": 1,
          "sanskrit": "आकू॑तिम॒ग्निम्प्र॒युज॒ꣴ॒ स्वाहा॒ मनो॑ मे॒धाम॒ग्निम्प्र॒युज॒ꣴ॒ स्वाहा॑ चि॒त्तव्ँविज्ञा॑तम॒ग्निम्प्र॒युज॒ꣴ॒ स्वाहा॑ वा॒चो विधृ॑तिम॒ग्निम्प्र॒युज॒ꣴ॒ स्वाहा᳚ प्र॒जाप॑तये॒ मन॑वे॒ स्वाहा॒ऽग्नये॑ वैश्वान॒राय॒ स्वाहा॒ विश्वे॑ दे॒वस्य॑ ने॒तुर् मर्तो॑ वृणीत स॒ख्यव्ँविश्वे॑ रा॒य इ॑षुद्ध्यसि द्यु॒म्नव्ँवृ॑णीत पु॒ष्यसे॒ स्वाहा॒ मा सु भि॑त्था॒ मा सु रि॑षो॒ दृꣳह॑स्व वी॒डय॑स्व॒ सु।",
          "section": 9
        },
        {
          "id": "ts-4-1-9-2",
          "chunkNumber": 2,
          "sanskrit": "अंब॑ धृष्णु वी॒रय॑स्वा॒"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-1-10",
      "title": "Kāṇḍa 4 · Prapāṭhaka 1 · Anuvāka 10",
      "sectionNumber": 10,
      "chunks": [
        {
          "id": "ts-4-1-10-1",
          "chunkNumber": 1,
          "sanskrit": "यद॑ग्ने॒ यानि॒ कानि॒ चाऽऽते॒ दारू॑णि द॒ध्मसि॑।",
          "section": 10
        },
        {
          "id": "ts-4-1-10-2",
          "chunkNumber": 2,
          "sanskrit": "तद॑स्तु॒ तुभ्य॒मिद् घृ॒तन्तज्जु॑षस्व यविष्ठ्य॥"
        },
        {
          "id": "ts-4-1-10-3",
          "chunkNumber": 3,
          "sanskrit": "यदत्त्यु॑प॒जिह्वि॑का॒ यद् व॒म्रो अ॑ति॒सर्प॑ति।"
        },
        {
          "id": "ts-4-1-10-4",
          "chunkNumber": 4,
          "sanskrit": "सर्व॒न्तद॑स्तु ते घृ॒तन्तज्जु॑षस्व यविष्ठ्य॥"
        },
        {
          "id": "ts-4-1-10-5",
          "chunkNumber": 5,
          "sanskrit": "रात्रि॑ꣳरात्रि॒मप्र॑याव॒म्भर॒न्तोऽश्वा॑येव॒ तिष्ठ॑ते घा॒सम॑स्मै।"
        },
        {
          "id": "ts-4-1-10-6",
          "chunkNumber": 6,
          "sanskrit": "रा॒यस्पोषे॑ण॒ समि॒षा मद॒न्तोऽग्ने॒ मा ते॒ प्रति॑वेशा रिषाम॥"
        },
        {
          "id": "ts-4-1-10-7",
          "chunkNumber": 7,
          "sanskrit": "नाभा॑ स्वाꣳ अ॒हम्॥"
        },
        {
          "id": "ts-4-1-10-8",
          "chunkNumber": 8,
          "sanskrit": "दृ॒शा॒नो रु॒क्म उ॒र्व्या व्य॑द्यौद्दु॒र्मर्ष॒मायुः॑ श्रि॒ये रु॑चा॒नः।"
        },
        {
          "id": "ts-4-1-10-9",
          "chunkNumber": 9,
          "sanskrit": "अ॒ग्निर॒मृतो॑ अभव॒द्वयो॑भि॒र् यदे॑न॒न्द्यौरज॑नयथ् सु॒रेताः᳚॥"
        },
        {
          "id": "ts-4-1-10-10",
          "chunkNumber": 10,
          "sanskrit": "विश्वा॑ रू॒पाणि॒ प्रति॑ मुञ्चते क॒विः प्राऽसा॑वीद्भ॒द्रन्द्वि॒पदे॒ चतु॑ष्पदे।"
        },
        {
          "id": "ts-4-1-10-11",
          "chunkNumber": 11,
          "sanskrit": "वि नाक॑मख्यथ् सवि॒ता वरे॒ण्योऽनु॑ प्र॒याण॑मु॒षसो॒ वि रा॑जति॥"
        },
        {
          "id": "ts-4-1-10-12",
          "chunkNumber": 12,
          "sanskrit": "नक्तो॒षासा॒ सम॑नसा॒ विरू॑पे धा॒पये॑ते॒ शिशु॒मेक॑ꣳ समी॒ची।"
        },
        {
          "id": "ts-4-1-10-13",
          "chunkNumber": 13,
          "sanskrit": "द्यावा॒ ख्षामा॑ रु॒क्मो अ॒न्तर् वि भा॑ति दे॒वा अ॒ग्निन्धा॑रयन् द्रविणो॒दाः॥"
        },
        {
          "id": "ts-4-1-10-14",
          "chunkNumber": 14,
          "sanskrit": "सु॒प॒र्णो॑ऽसि ग॒रुत्मा᳚न् त्रि॒वृत् ते॒ शिरो॑ गाय॒त्रञ्चख्षुः॒ स्तोम॑ आ॒त्मा साम॑ ते त॒नूर्वा॑मदे॒व्यं बृ॑हद्रथन्त॒रे प॒ख्षौ य॑ज्ञाय॒ज्ञिय॒म्पुच्छ॒ञ्छन्दा॒ꣴ॒स्यङ्गा॑नि॒ धिष्णि॑याः श॒फा यजू॑ꣳषि॒ नाम॑॥"
        },
        {
          "id": "ts-4-1-10-15",
          "chunkNumber": 15,
          "sanskrit": "सु॒प॒र्णो॑ऽसि ग॒रुत्मा॒न् दिव॑ङ्गच्छ॒ सुवः॑ पत"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-1-11",
      "title": "Kāṇḍa 4 · Prapāṭhaka 1 · Anuvāka 11",
      "sectionNumber": 11,
      "chunks": [
        {
          "id": "ts-4-1-11-1",
          "chunkNumber": 1,
          "sanskrit": "अग्ने॒ यय्ँय॒ज्ञम॑द्ध्व॒रव्ँवि॒श्वतः॑ परि॒भूरसि॑।",
          "section": 11
        },
        {
          "id": "ts-4-1-11-2",
          "chunkNumber": 2,
          "sanskrit": "स इद्दे॒वेषु॑ गच्छति॥"
        },
        {
          "id": "ts-4-1-11-3",
          "chunkNumber": 3,
          "sanskrit": "सोम॒ यास्ते॑ मयो॒भुव॑ ऊ॒तयः॒ सन्ति॑ दा॒शुषे᳚।"
        },
        {
          "id": "ts-4-1-11-4",
          "chunkNumber": 4,
          "sanskrit": "ताभि॑र् नोऽवि॒ता भ॑व॥"
        },
        {
          "id": "ts-4-1-11-5",
          "chunkNumber": 5,
          "sanskrit": "अ॒ग्निर् मू॒र्द्धा >१ , भुवः॑ > २॥"
        },
        {
          "id": "ts-4-1-11-6",
          "chunkNumber": 6,
          "sanskrit": "त्वन्नः॑ सोम॒ >३, या ते॒ धामा॑नि >४॥"
        },
        {
          "id": "ts-4-1-11-7",
          "chunkNumber": 7,
          "sanskrit": "तथ् स॑वि॒तुर् वरे᳚ण्य॒म्भर्गो॑ दे॒वस्य॑ धीमहि।"
        },
        {
          "id": "ts-4-1-11-8",
          "chunkNumber": 8,
          "sanskrit": "धियो॒ यो नः॑ प्रचो॒दया᳚त्॥"
        },
        {
          "id": "ts-4-1-11-9",
          "chunkNumber": 9,
          "sanskrit": "अचि॑त्ती॒ यच्च॑कृ॒मा दैव्ये॒ जने॑ दी॒नैर् दख्षैः॒ प्रभू॑ती पूरुष॒त्वता᳚ दे॒वेषु॑ च सवित॒र् मानु॑षेषु च॒ त्वन्नो॒ अत्र॑ सुवता॒दना॑गसः॥"
        },
        {
          "id": "ts-4-1-11-10",
          "chunkNumber": 10,
          "sanskrit": "चो॒द॒यि॒त्री सू॒नृता॑ना॒ञ्चेत॑न्ती सुमती॒नाम्।"
        },
        {
          "id": "ts-4-1-11-11",
          "chunkNumber": 11,
          "sanskrit": "य॒ज्ञन्द॑धे॒ सर॑स्वती॥"
        },
        {
          "id": "ts-4-1-11-12",
          "chunkNumber": 12,
          "sanskrit": "पावी॑रवी क॒न्या॑ चि॒त्रायुः॒ सर॑स्वती वी॒रप॑त्नी॒ धिय॑न्धात्।"
        },
        {
          "id": "ts-4-1-11-13",
          "chunkNumber": 13,
          "sanskrit": "ग्नाभि॒रच्छि॑द्रꣳ शर॒णꣳ स॒जोषा॑ दुरा॒धर्ष॑ङ्गृण॒ते शर्म॑ यꣳसत्॥"
        },
        {
          "id": "ts-4-1-11-14",
          "chunkNumber": 14,
          "sanskrit": "पू॒षा गा अन्वे॑तु नः पू॒षा र॑ख्ष॒त्वर्व॑तः।"
        },
        {
          "id": "ts-4-1-11-15",
          "chunkNumber": 15,
          "sanskrit": "पू॒षा वाज॑ꣳ सनोतु नः॥"
        },
        {
          "id": "ts-4-1-11-16",
          "chunkNumber": 16,
          "sanskrit": "शु॒क्रन्ते॑ अ॒न्यद्य॑ज॒तन्ते॑ अ॒न्य रेज॑ते अग्ने पृथि॒वी म॒खेभ्यः॑॥"
        },
        {
          "id": "ts-4-1-11-17",
          "chunkNumber": 17,
          "sanskrit": "विश्वे॑ दे॒वा >५, विश्वे॑ देवाः >६॥"
        },
        {
          "id": "ts-4-1-11-18",
          "chunkNumber": 18,
          "sanskrit": "द्यावा॑ नः पृथि॒वी इ॒मꣳ सि॒द्ध्रम॒द्य दि॑वि॒स्पृश᳚म्।"
        },
        {
          "id": "ts-4-1-11-19",
          "chunkNumber": 19,
          "sanskrit": "य॒ज्ञन्दे॒वेषु॑ यच्छताम्॥"
        },
        {
          "id": "ts-4-1-11-20",
          "chunkNumber": 20,
          "sanskrit": "प्र पू᳚र्व॒जे पि॒तरा॒ नव्य॑सीभिर् गी॒र्भिः कृ॑णुद्ध्व॒ꣳ॒ सद॑ने ऋ॒तस्य॑।"
        },
        {
          "id": "ts-4-1-11-21",
          "chunkNumber": 21,
          "sanskrit": "आ नो᳚ द्यावापृथिवी॒ दैव्ये॑न॒ जने॑न यात॒म्महि॑ वा॒व्ँवरू॑थम्॥"
        },
        {
          "id": "ts-4-1-11-22",
          "chunkNumber": 22,
          "sanskrit": "अ॒ग्निꣴ स्तोमे॑न बोधय समिधा॒नो अम॑र्त्यम्।"
        },
        {
          "id": "ts-4-1-11-23",
          "chunkNumber": 23,
          "sanskrit": "ह॒व्या दे॒वेषु॑ नो दधत्॥"
        },
        {
          "id": "ts-4-1-11-24",
          "chunkNumber": 24,
          "sanskrit": "स ह॑व्य॒वाडम॑र्त्य उ॒शिग् दू॒तश्चनो॑हितः।"
        },
        {
          "id": "ts-4-1-11-25",
          "chunkNumber": 25,
          "sanskrit": "अ॒ग्निर् धि॒या समृ॑ण्वति॥"
        },
        {
          "id": "ts-4-1-11-26",
          "chunkNumber": 26,
          "sanskrit": "शन्नो॑ भवन्तु॒>७ , वाजे॑वाजे> ८"
        }
      ]
    }
  ]
}
