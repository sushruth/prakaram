    {
      "id": "taittiriya-samhita-4-1-5",
      "title": "Kāṇḍa 4 · Prapāṭhaka 1 · Anuvāka 5",
      "sectionNumber": 5,
      "chunks": [
        {
          "id": "ts-4-1-5-1",
          "chunkNumber": 1,
          "sanskrit": "वि पाज॑सा पृ॒थुना॒ शोशु॑चानो॒ बाध॑स्व द्वि॒षो र॒ख्षसो॒ अमी॑वाः।",
          "section": 5
