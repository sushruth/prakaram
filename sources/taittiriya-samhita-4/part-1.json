          "chunkNumber": 3,
          "sanskrit": "ए॒तान्ते॒ परि॑ ददा॒म्यभि॑त्त्यै॥"
        },
        {
          "id": "ts-4-1-6-4",
          "chunkNumber": 4,
          "sanskrit": "अ॒भीमां"
        }
