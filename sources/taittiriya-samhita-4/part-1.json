    {
      "id": "taittiriya-samhita-4-1-7",
      "title": "Kāṇḍa 4 · Prapāṭhaka 1 · Anuvāka 7",
      "sectionNumber": 7,
      "chunks": [
        {
          "id": "ts-4-1-7-1",
          "chunkNumber": 1,
          "sanskrit": "समा᳚स्त्वाऽग्न ऋ॒तवो॑ वर्द्धयन्तु सव्ँवथ्स॒रा ऋष॑यो॒ यानि॑ स॒त्या।",
          "section": 7
        },
        {
          "id": "ts-4-1-7-2",
          "chunkNumber": 2,
          "sanskrit": "सन्दि॒व्येन॑ दीदिहि रोच॒नेन॒ विश्वा॒ आ भा॑हि प्र॒दिशः॑ पृथि॒व्याः॥"
        },
        {
          "id": "ts-4-1-7-3",
          "chunkNumber": 3,
          "sanskrit": "सञ्चे॒द्ध्यस्वा᳚ऽग्ने॒ प्र च॑ बोधयैन॒मुच्च॑ तिष्ठ मह॒ते सौभ॑गाय।"
        },
        {
          "id": "ts-4-1-7-4",
          "chunkNumber": 4,
          "sanskrit": "मा च॑ रिषदुपस॒त्ता ते॑ अग्ने ब्र॒ह्माण॑स्ते य॒शसः॑ सन्तु॒ माऽन्ये॥"
        },
        {
          "id": "ts-4-1-7-5",
          "chunkNumber": 5,
          "sanskrit": "त्वाम॑ग्ने वृणते ब्राह्म॒णा इ॒मे शि॒वो अ॑ग्ने स॒व्ँवर॑णे भवा नः।"
        },
        {
          "id": "ts-4-1-7-6",
          "chunkNumber": 6,
          "sanskrit": "स॒प॒त्न॒हा नो॑ अभिमाति॒जिच्च॒ स्वे गये॑ जागृ॒ह्यप्र॑युच्छन्न्॥"
        },
        {
          "id": "ts-4-1-7-7",
          "chunkNumber": 7,
          "sanskrit": "इ॒हैवाग्ने॒ अधि॑ धारया र॒यिम्मा त्वा॒ नि क्र॑न् पूर्व॒चितो॑ निका॒रिणः॑।"
        },
        {
          "id": "ts-4-1-7-8",
          "chunkNumber": 8,
          "sanskrit": "ख्ष॒त्रम॑ग्ने सु॒यम॑मस्तु॒ तुभ्य॑मुपस॒त्ता व॑र्द्धतान्ते॒ अनि॑ष्टृतः॥"
        },
        {
          "id": "ts-4-1-7-9",
          "chunkNumber": 9,
          "sanskrit": "ख्ष॒त्रेणा᳚ऽग्ने॒ स्वायुः॒ सꣳ र॑भस्व मि॒त्रेणा᳚ऽग्ने मित्र॒धेये॑ यतस्व।"
        },
        {
          "id": "ts-4-1-7-10",
          "chunkNumber": 10,
          "sanskrit": "स॒जा॒ताना᳚म्मद्ध्यम॒स्था ए॑धि॒ राज्ञा॑मग्ने विह॒व्यो॑ दीदिही॒ह॥"
        },
        {
          "id": "ts-4-1-7-11",
          "chunkNumber": 11,
          "sanskrit": "अति॒ निहो॒ अति॒ स्रिधोऽत्यचि॑त्ति॒मत्यरा॑तिमग्ने।"
        },
        {
          "id": "ts-4-1-7-12",
          "chunkNumber": 12,
          "sanskrit": "विश्वा॒ ह्य॑ग्ने दुरि॒ता सह॒स्वाथा॒स्मभ्य॑ꣳ स॒हवी॑राꣳ र॒यिन्दाः᳚॥"
        },
        {
          "id": "ts-4-1-7-13",
          "chunkNumber": 13,
          "sanskrit": "अ॒ना॒धृ॒ष्यो जा॒तवे॑दा॒ अनि॑ष्टृतो वि॒राड॑ग्ने ख्षत्र॒भृद् दी॑दिही॒ह।"
        },
        {
          "id": "ts-4-1-7-14",
          "chunkNumber": 14,
          "sanskrit": "विश्वा॒ आशाः᳚ प्रमु॒ञ्चन् मानु॑षीर्भि॒यः शि॒वाभि॑र॒द्य परि॑ पाहि नो वृ॒धे॥"
        },
        {
          "id": "ts-4-1-7-15",
          "chunkNumber": 15,
          "sanskrit": "बृह॑स्पते सवितर् बो॒धयै॑न॒ꣳ॒ सꣳशि॑तञ्चिथ् सन्त॒राꣳ सꣳ शि॑शाधि।"
        },
        {
          "id": "ts-4-1-7-16",
          "chunkNumber": 16,
          "sanskrit": "व॒र्द्धयै॑नम्मह॒ते सौभ॑गाय॒ विश्व॑ एन॒मनु॑ मदन्तु दे॒वाः॥"
        },
        {
          "id": "ts-4-1-7-17",
          "chunkNumber": 17,
          "sanskrit": "अ॒मु॒त्र॒भूया॒दध॒ यद् य॒मस्य॒ बृह॑स्पते अ॒भिश॑स्ते॒रमु॑ञ्चः।"
        },
        {
          "id": "ts-4-1-7-18",
          "chunkNumber": 18,
          "sanskrit": "प्रत्यौ॑हताम॒श्विना॑ मृ॒त्युम॑स्माद् दे॒वाना॑मग्ने भि॒षजा॒ शची॑भिः॥"
        },
        {
          "id": "ts-4-1-7-19",
          "chunkNumber": 19,
          "sanskrit": "उद् व॒यन्तम॑स॒स्परि॒ पश्य॑न्तो॒ ज्योति॒रुत्त॑रम्।"
        },
        {
          "id": "ts-4-1-7-20",
          "chunkNumber": 20,
          "sanskrit": "दे॒वन्दे॑व॒त्रा सूर्य॒मग॑न्म॒ ज्योति॑रुत्त॒मम्"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-1-8",
