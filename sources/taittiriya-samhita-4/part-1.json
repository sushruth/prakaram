        },
        {
          "id": "ts-4-1-5-8",
          "chunkNumber": 8,
          "sanskrit": "आपो॑ ज॒नय॑था च नः॥"
        },
        {
          "id": "ts-4-1-5-9",
          "chunkNumber": 9,
          "sanskrit": "मि॒त्रः स॒ꣳ॒सृज्य॑ पृथि॒वीम्भूमि॑ञ्च॒ ज्योति॑षा स॒ह।"
        },
        {
          "id": "ts-4-1-5-10",
          "chunkNumber": 10,
          "sanskrit": "सुजा॑तञ्जा॒तवे॑दसम॒ग्निव्ँवै᳚श्वान॒रव्ँवि॒भुम्॥"
        },
        {
          "id": "ts-4-1-5-11",
          "chunkNumber": 11,
          "sanskrit": "अ॒य॒ख्ष्माय॑ त्वा॒ सꣳ सृ॑जामि प्र॒जाभ्यः॑।"
        },
        {
          "id": "ts-4-1-5-12",
          "chunkNumber": 12,
          "sanskrit": "विश्वे᳚ त्वा दे॒वा वै᳚श्वान॒राः सꣳ सृ॑ज॒न्त्वानु॑ष्टुभेन॒ छन्द॑साऽङ्गिर॒स्वत्॥"
        },
        {
          "id": "ts-4-1-5-13",
          "chunkNumber": 13,
          "sanskrit": "रु॒द्राः सं॒भृत्य॑ पृथि॒वीम्बृ॒हज्ज्योतिः॒ समी॑धिरे।"
        },
        {
          "id": "ts-4-1-5-14",
          "chunkNumber": 14,
          "sanskrit": "तेषा᳚म्भा॒नुरज॑स्र॒ इच्छु॒क्रो दे॒वेषु॑ रोचते॥"
        },
        {
          "id": "ts-4-1-5-15",
          "chunkNumber": 15,
          "sanskrit": "सꣳ सृ॑ष्टा॒व्ँवसु॑भी रु॒द्रैर् धीरैः᳚ कर्म॒ण्या᳚म्मृद᳚म्।"
        },
        {
          "id": "ts-4-1-5-16",
          "chunkNumber": 16,
          "sanskrit": "हस्ता᳚भ्याम्मृ॒द्वीङ्कृ॒त्वा सि॑नीवा॒ली क॑रोतु॒ ताम्॥"
