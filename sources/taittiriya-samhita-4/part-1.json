{
  "sections": [
    {
      "id": "taittiriya-samhita-4-1-1",
      "title": "Kāṇḍa 4 · Prapāṭhaka 1 · Anuvāka 1",
      "sectionNumber": 1,
      "chunks": [
        {
          "id": "ts-4-1-1-1",
          "chunkNumber": 1,
          "sanskrit": "yu̠ñjā̠naḥ pra̍tha̠mammana̍sta̠tvāya̍ savi̠tā dhiyaḥ̍|",
          "section": 1
        },
        {
          "id": "ts-4-1-1-2",
          "chunkNumber": 2,
          "sanskrit": "a̠gniñjyoti̍rni̠cāyya̍ pṛthi̠vyā addhyā'bha̍rat||"
        },
        {
          "id": "ts-4-1-1-3",
          "chunkNumber": 3,
          "sanskrit": "yu̠ktvāya̠ mana̍sā de̠vānth suva̍rya̠to dhi̠yā diva̎m|"
        },
        {
          "id": "ts-4-1-1-4",
          "chunkNumber": 4,
          "sanskrit": "bṛ̠hajjyotiḥ̍ kariṣya̠taḥ sa̍vi̠tā pra su̍vāti̠ tān||"
        },
        {
          "id": "ts-4-1-1-5",
          "chunkNumber": 5,
          "sanskrit": "yu̠ktena̠ mana̍sā va̠yande̠vasya̍ savi̠tuḥ sa̠ve|"
        },
        {
          "id": "ts-4-1-1-6",
          "chunkNumber": 6,
          "sanskrit": "su̠va̠rgeyā̍ya̠ śaktyai̎||"
        },
        {
          "id": "ts-4-1-1-7",
          "chunkNumber": 7,
          "sanskrit": "yu̠ñjate̠ mana̍ u̠ta yu̍ñjate̠ dhiyo̠ viprā̠ vipra̍sya bṛha̠to vi̍pa̠ścitaḥ̍|"
        },
        {
          "id": "ts-4-1-1-8",
          "chunkNumber": 8,
          "sanskrit": "vi hotrā̍ dadhe vayunā̠videka̠ in ma̠hī de̠vasya̍ savi̠tuḥ pari̍ṣṭutiḥ||"
        },
        {
          "id": "ts-4-1-1-9",
          "chunkNumber": 9,
          "sanskrit": "yu̠je vā̠mbrahma̍ pū̠rvyannamo̍bhi̠r vi ślokā̍ yanti pa̠thye̍va̠ sūrāḥ̎|"
        },
        {
          "id": "ts-4-1-1-10",
          "chunkNumber": 10,
          "sanskrit": "śṛ̠ṇvanti̠ viśve̍ a̠mṛta̍sya pu̠trā ā ye dhāmā̍ni di̠vyāni̍ ta̠sthuḥ||"
        },
        {
          "id": "ts-4-1-1-11",
          "chunkNumber": 11,
          "sanskrit": "yasya̍ pra̠yāṇa̠manvava̠nya idya̠yur de̠vā de̠vasya̍ mahi̠māna̠marca̍taḥ|"
        },
        {
          "id": "ts-4-1-1-12",
          "chunkNumber": 12,
          "sanskrit": "yaḥ pārtthi̍vāni vima̠me sa eta̍śo̠ rajā̍gͫsi de̠vaḥ sa̍vi̠tā ma̍hitva̠nā||"
        },
        {
          "id": "ts-4-1-1-13",
          "chunkNumber": 13,
          "sanskrit": "deva̍ savitaḥ̠ pra su̍va ya̠jñampra su̍va ya̠jñapa̍ti̠mbhagā̍ya di̠vyo ga̍ndha̠rvaḥ|"
        },
        {
          "id": "ts-4-1-1-14",
          "chunkNumber": 14,
          "sanskrit": "ke̠ta̠pūḥ keta̍nnaḥ punātu vā̠caspati̠r vāca̍ma̠dya sva̍dāti naḥ||"
        },
        {
          "id": "ts-4-1-1-15",
          "chunkNumber": 15,
          "sanskrit": "i̠manno̍ deva savitar ya̠jñampra su̍va devā̠yuva̍gͫ sakhi̠vida̍gͫ satrā̠jita̍ndhana̠jita̍gͫ suva̠rjita̎m||"
        },
        {
          "id": "ts-4-1-1-16",
          "chunkNumber": 16,
          "sanskrit": "ṛ̠cā stoma̠g̠ͫ sama̍rddhaya gāya̠treṇa̍ rathanta̠ram|"
        },
        {
          "id": "ts-4-1-1-17",
          "chunkNumber": 17,
          "sanskrit": "bṛ̠hadgā̍ya̠trava̍rtani||"
        },
        {
          "id": "ts-4-1-1-18",
          "chunkNumber": 18,
          "sanskrit": "de̠vasya̍ tvā savi̠tuḥ pra̍sa̠ve̎'śvino̎r bā̠hubhyāṃ̎ pū̠ṣṇo hastā̎bhyāṅgāya̠treṇa̠ chanda̠sā''da̍de'ṅgira̠svadabhri̍rasi̠ nāri̍"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-1-2",
      "title": "Kāṇḍa 4 · Prapāṭhaka 1 · Anuvāka 2",
      "sectionNumber": 2,
      "chunks": [
        {
          "id": "ts-4-1-2-1",
          "chunkNumber": 1,
          "sanskrit": "i̠māma̍gṛbhṇan raśa̠nāmṛ̠tasya̠ pūrva̠ āyu̍ṣi vi̠dathe̍ṣu ka̠vyā|",
          "section": 2
        },
        {
          "id": "ts-4-1-2-2",
          "chunkNumber": 2,
          "sanskrit": "tayā̍ de̠vāḥ su̠tamā ba̍bhūvur·ṛ̠tasya̠ sāma̎nth sa̠ramā̠rapa̍ntī||"
        },
        {
          "id": "ts-4-1-2-3",
          "chunkNumber": 3,
          "sanskrit": "pratū̎rtavm̐vāji̠nnā dra̍va̠ vari̍ṣṭhā̠manu̍ sa̠vm̐vata̎m|"
        },
        {
          "id": "ts-4-1-2-4",
          "chunkNumber": 4,
          "sanskrit": "di̠vi te̠ janma̍ para̠mama̠ntari̍khṣe̠ nābhiḥ̍ pṛthi̠vyāmadhi̠ yoniḥ̍||"
        },
        {
          "id": "ts-4-1-2-5",
          "chunkNumber": 5,
          "sanskrit": "yu̠ñjāthā̠g̠ͫ rāsa̍bhaym̐yu̠vama̠sminyāme̍ vṛṣaṇvasū|"
        },
        {
          "id": "ts-4-1-2-6",
          "chunkNumber": 6,
          "sanskrit": "a̠gnimbhara̍ntamasma̠yum||"
        },
        {
          "id": "ts-4-1-2-7",
          "chunkNumber": 7,
          "sanskrit": "yoge̍yoge ta̠vasta̍ra̠vm̐vāje̍vāje havāmahe|"
        },
        {
          "id": "ts-4-1-2-8",
          "chunkNumber": 8,
          "sanskrit": "sakhā̍ya̠ indra̍mū̠taye̎||"
        },
        {
          "id": "ts-4-1-2-9",
          "chunkNumber": 9,
          "sanskrit": "pra̠tūrva̠ nnehya̍va̠krāma̠nnaśa̍stī ru̠drasya̠ gāṇa̍patyān mayo̠bhūrehi̍|"
        },
        {
          "id": "ts-4-1-2-10",
          "chunkNumber": 10,
          "sanskrit": "u̠rva̍ntari̍khṣa̠manvi̍hi sva̠stiga̍vyūti̠rabha̍yāni kṛ̠ṇvann||"
        },
        {
          "id": "ts-4-1-2-11",
          "chunkNumber": 11,
          "sanskrit": "pū̠ṣṇā sa̠yujā̍ sa̠ha|"
        },
        {
          "id": "ts-4-1-2-12",
          "chunkNumber": 12,
          "sanskrit": "pṛ̠thi̠vyāḥ sa̠dhasthā̍da̠gnimpu̍rī̠ṣya̍maṅgira̠svadacche̎hya̠gnimpu̍rī̠ṣya̍maṅgira̠svadacche̍mo̠'gniṃ pu̍rī̠ṣya̍maṅgira̠svadbha̍riṣyāmo̠'gnimpu̍rī̠ṣya̍maṅgira̠svadbha̍rāmaḥ||"
        },
        {
          "id": "ts-4-1-2-13",
          "chunkNumber": 13,
          "sanskrit": "anva̠gniru̠ṣasā̠magra̍makhya̠danvahā̍ni pratha̠mo jā̠tave̍dāḥ|"
        },
        {
          "id": "ts-4-1-2-14",
          "chunkNumber": 14,
          "sanskrit": "anu̠ sūrya̍sya"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-1-3",
      "title": "Kāṇḍa 4 · Prapāṭhaka 1 · Anuvāka 3",
      "sectionNumber": 3,
      "chunks": [
        {
          "id": "ts-4-1-3-1",
          "chunkNumber": 1,
          "sanskrit": "de̠vasya̍ tvā savi̠tuḥ pra̍sa̠ve̎'śvino̎r bā̠hubhyā̎mpū̠ṣṇo hastā̎bhyāmpṛthi̠vyāḥ sa̠dhasthe̠'gniṃ pu̍rī̠ṣya̍maṅgira̠svat kha̍nāmi||",
          "section": 3
        },
        {
          "id": "ts-4-1-3-2",
          "chunkNumber": 2,
          "sanskrit": "jyoti̍ṣmantantvā'gne su̠pratī̍ka̠maja̍sreṇa bhā̠nunā̠ dīdyā̍nam|"
        },
        {
          "id": "ts-4-1-3-3",
          "chunkNumber": 3,
          "sanskrit": "śi̠vampra̠jābhyo'hi̍gͫsantampṛthi̠vyāḥ sa̠dhasthe̠'gnimpu̍rī̠ṣya̍maṅgira̠svat kha̍nāmi||"
        },
        {
          "id": "ts-4-1-3-4",
          "chunkNumber": 4,
          "sanskrit": "a̠pāmpṛ̠ṣṭhama̍si sa̠prathā̍ u̠rva̍gnimbha̍ri̠ṣyadapa̍rāvapiṣṭham|"
        },
        {
          "id": "ts-4-1-3-5",
          "chunkNumber": 5,
          "sanskrit": "varddha̍mānamma̠ha ā ca̠ puṣka̍randi̠vo mātra̍yā vari̠ṇā pra̍thasva||"
        },
        {
          "id": "ts-4-1-3-6",
          "chunkNumber": 6,
          "sanskrit": "śarma̍ ca stho̠ varma̍ ca stho̠ acchi̍dre bahu̠le u̠bhe|"
        },
        {
          "id": "ts-4-1-3-7",
          "chunkNumber": 7,
          "sanskrit": "vyaca̍svatī̠ savm̐va̍sāthāmbha̠rtama̠gnimpu̍rī̠ṣya̎m||"
        },
        {
          "id": "ts-4-1-3-8",
          "chunkNumber": 8,
          "sanskrit": "savm̐va̍sāthāgͫ suva̠rvidā̍ sa̠mīcī̠ ura̍sā̠ tmanā̎|"
        },
        {
          "id": "ts-4-1-3-9",
          "chunkNumber": 9,
          "sanskrit": "a̠gnima̠ntar bha̍ri̠ṣyantī̠ jyoti̍ṣmanta̠maja̍sra̠mit||"
        },
        {
          "id": "ts-4-1-3-10",
          "chunkNumber": 10,
          "sanskrit": "pu̠rī̠ṣyo̍'si vi̠śvabha̍rāḥ|"
        },
        {
          "id": "ts-4-1-3-11",
          "chunkNumber": 11,
          "sanskrit": "atha̍rvā tvā pratha̠mo nira̍manthadagne||"
        },
        {
          "id": "ts-4-1-3-12",
          "chunkNumber": 12,
          "sanskrit": "tvāma̍gne̠ puṣka̍rā̠daddhyatha̍rvā̠ nira̍manthata|"
        },
        {
          "id": "ts-4-1-3-13",
          "chunkNumber": 13,
          "sanskrit": "mū̠rddhno viśva̍sya vā̠ghataḥ̍||"
        },
        {
          "id": "ts-4-1-3-14",
          "chunkNumber": 14,
          "sanskrit": "tamu̍ tvā da̠ddhyaṅ ṛṣiḥ̍ pu̠tra ī̍dhe̠ atha̍rvaṇaḥ|"
        },
        {
          "id": "ts-4-1-3-15",
          "chunkNumber": 15,
          "sanskrit": "vṛ̠tra̠haṇa̍mpuranda̠ram||"
        },
        {
          "id": "ts-4-1-3-16",
          "chunkNumber": 16,
          "sanskrit": "tamu̍ tvā pā̠thyo vṛṣā̠ samī̍dhe dasyu̠hanta̍mam|"
        },
        {
          "id": "ts-4-1-3-17",
          "chunkNumber": 17,
          "sanskrit": "dha̠na̠ñja̠yagͫ raṇe̍raṇe||"
        },
        {
          "id": "ts-4-1-3-18",
          "chunkNumber": 18,
          "sanskrit": "sīda̍ hotaḥ̠ sva u̍ lo̠ke ci̍ki̠tvānth sā̠dayā̍ ya̠jñagͫ su̍kṛ̠tasya̠ yonau̎|"
        },
        {
          "id": "ts-4-1-3-19",
          "chunkNumber": 19,
          "sanskrit": "de̠vā̠vīr de̠vānha̠viṣā̍ yajā̠syagne̍ bṛ̠hadyaja̍māne̠ vayo̍ dhāḥ||"
        },
        {
          "id": "ts-4-1-3-20",
          "chunkNumber": 20,
          "sanskrit": "ni hotā̍ hotṛ̠ṣada̍ne̠ vidā̍nastve̠ṣo dī̍di̠vāgͫ a̍sadath su̠dakhṣaḥ̍|"
        },
        {
          "id": "ts-4-1-3-21",
          "chunkNumber": 21,
          "sanskrit": "ada̍bdhavratapramati̠r vasi̍ṣṭhaḥ sahasraṃbha̠raḥ śuci̍jihvo a̠gniḥ||"
        },
        {
          "id": "ts-4-1-3-22",
          "chunkNumber": 22,
          "sanskrit": "sagͫ sī̍dasva ma̠hāgͫ a̍si̠ śoca̍sva"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-1-4",
      "title": "Kāṇḍa 4 · Prapāṭhaka 1 · Anuvāka 4",
      "sectionNumber": 4,
      "chunks": [
        {
          "id": "ts-4-1-4-1",
          "chunkNumber": 1,
          "sanskrit": "sante̍ vā̠yur mā̍ta̠riśvā̍ dadhātūttā̠nāyai̠ hṛda̍ya̠ym̐yadvili̍ṣṭam|",
          "section": 4
        },
        {
          "id": "ts-4-1-4-2",
          "chunkNumber": 2,
          "sanskrit": "de̠vānā̠ym̐yaścara̍ti prā̠ṇathe̍na̠ tasmai̍ ca devi̠ vaṣa̍ḍastu̠ tubhya̎m||"
        },
        {
          "id": "ts-4-1-4-3",
          "chunkNumber": 3,
          "sanskrit": "sujā̍to̠ jyoti̍ṣā sa̠ha śarma̠ varū̍tha̠mā'sa̍daḥ̠ suvaḥ̍|"
        },
        {
          "id": "ts-4-1-4-4",
          "chunkNumber": 4,
          "sanskrit": "vāso̍ agne vi̠śvarū̍pa̠g̠ͫ savm̐vya̍yasva vibhāvaso||"
        },
        {
          "id": "ts-4-1-4-5",
          "chunkNumber": 5,
          "sanskrit": "udu̍ tiṣṭha svaddhva̠rāvā̍ no de̠vyā kṛ̠pā|"
        },
        {
          "id": "ts-4-1-4-6",
          "chunkNumber": 6,
          "sanskrit": "dṛ̠śe ca̍ bhā̠sā bṛ̍ha̠tā su̍śu̠kvani̠rā'gne̍ yāhi suśa̠stibhiḥ̍ ū̠rddhva ū̠ ṣu ṇa̍ ū̠taye̠ tiṣṭhā̍ de̠vo na sa̍vi̠tā|"
        },
        {
          "id": "ts-4-1-4-7",
          "chunkNumber": 7,
          "sanskrit": "ū̠rddhvo vāja̍sya̠ sani̍tā̠ yada̠ñjibhi̍r vā̠ghadbhi̍r vi̠hvayā̍mahe||"
        },
        {
          "id": "ts-4-1-4-8",
          "chunkNumber": 8,
          "sanskrit": "sa jā̠to garbho̍ asi̠ roda̍syo̠ragne̠ cāru̠r vibhṛ̍ta̠ oṣa̍dhīṣu|"
        },
        {
          "id": "ts-4-1-4-9",
          "chunkNumber": 9,
          "sanskrit": "ci̠traḥ śiśuḥ̠ pari̠ tamā̍gͫͫsya̠ktaḥ pra mā̠tṛbhyo̠ adhi̠ kani̍kradad gāḥ||"
        },
        {
          "id": "ts-4-1-4-10",
          "chunkNumber": 10,
          "sanskrit": "sthi̠ro bha̍va vī̠ḍva̍ṅga ā̠śur bha̍va vā̠jya̍rvann|"
        },
        {
          "id": "ts-4-1-4-11",
          "chunkNumber": 11,
          "sanskrit": "pṛ̠thur bha̍va su̠ṣada̠stvama̠gneḥ pu̍rīṣa̠vāha̍naḥ||"
        },
        {
          "id": "ts-4-1-4-12",
          "chunkNumber": 12,
          "sanskrit": "śi̠vo bha̍va pra̠jābhyo̠ mānu̍ṣībhya̠stvama̍ṅgiraḥ|"
        },
        {
          "id": "ts-4-1-4-13",
          "chunkNumber": 13,
          "sanskrit": "mā dyāvā̍pṛthi̠vī a̠bhi śū̍śuco̠ mā'ntari̍khṣa̠mmā vana̠spatī̍n||"
        },
        {
          "id": "ts-4-1-4-14",
          "chunkNumber": 14,
          "sanskrit": "praitu̍ vā̠jī kani̍krada̠nnāna̍da̠drāsa̍bhaḥ̠ patvā̎|"
        },
        {
          "id": "ts-4-1-4-15",
          "chunkNumber": 15,
          "sanskrit": "bhara̍nna̠gnimpu̍rī̠ṣya̍mmā pā̠dyāyu̍ṣaḥ pu̠rā||"
        },
        {
          "id": "ts-4-1-4-16",
          "chunkNumber": 16,
          "sanskrit": "rāsa̍bho vā̠ṅkani̍krada̠th suyu̍kto vṛṣaṇā̠ rathe̎|"
        },
        {
          "id": "ts-4-1-4-17",
          "chunkNumber": 17,
          "sanskrit": "sa vā̍ma̠gnimpu̍rī̠ṣya̍mā̠śur dū̠to va̍hādi̠taḥ||"
        },
        {
          "id": "ts-4-1-4-18",
          "chunkNumber": 18,
          "sanskrit": "vṛṣā̠'gnivm̐vṛṣa̍ṇa̠mbhara̍nna̠pāṅgarbha̍gͫ samu̠driya̎m|"
        },
        {
          "id": "ts-4-1-4-19",
          "chunkNumber": 19,
          "sanskrit": "agna̠ ā yā̍hi vī̠taya̍ ṛ̠tagͫ sa̠tyam||"
        },
        {
          "id": "ts-4-1-4-20",
          "chunkNumber": 20,
          "sanskrit": "oṣa̍dhayaḥ̠ prati̍ gṛhṇītā̠'gnime̠tagͫ śi̠vamā̠yanta̍ma̠bhyatra̍ yu̠ṣmān|"
        },
        {
          "id": "ts-4-1-4-21",
          "chunkNumber": 21,
          "sanskrit": "vyasya̠n viśvā̠ ama̍tī̠rarā̍tīr ni̠ṣīda̍nno̠ apa̍ durma̠tigͫ ha̍nat||"
        },
        {
          "id": "ts-4-1-4-22",
          "chunkNumber": 22,
          "sanskrit": "oṣa̍dhayaḥ̠ prati̍ modaddhvamena̠mpuṣpā̍vatīḥ supippa̠lāḥ|"
        },
        {
          "id": "ts-4-1-4-23",
          "chunkNumber": 23,
          "sanskrit": "a̠yavm̐vo̠ garbha̍ ṛ̠tviyaḥ̍ pra̠tnagͫ sa̠dhastha̠mā'sa̍dat"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-1-5",
      "title": "Kāṇḍa 4 · Prapāṭhaka 1 · Anuvāka 5",
      "sectionNumber": 5,
      "chunks": [
        {
          "id": "ts-4-1-5-1",
          "chunkNumber": 1,
          "sanskrit": "vi pāja̍sā pṛ̠thunā̠ śośu̍cāno̠ bādha̍sva dvi̠ṣo ra̠khṣaso̠ amī̍vāḥ|",
          "section": 5
        },
        {
          "id": "ts-4-1-5-2",
          "chunkNumber": 2,
          "sanskrit": "su̠śarma̍ṇo bṛha̠taḥ śarma̍ṇi syāma̠gnera̠hagͫ su̠hava̍sya̠ praṇī̍tau||"
        },
        {
          "id": "ts-4-1-5-3",
          "chunkNumber": 3,
          "sanskrit": "āpo̠ hi ṣṭhā ma̍yo̠bhuva̠stā na̍ ū̠rje da̍dhātana|"
        },
        {
          "id": "ts-4-1-5-4",
          "chunkNumber": 4,
          "sanskrit": "ma̠he raṇā̍ya̠ cakhṣa̍se||"
        },
        {
          "id": "ts-4-1-5-5",
          "chunkNumber": 5,
          "sanskrit": "yo vaḥ̍ śi̠vata̍mo̠ rasa̠stasya̍ bhājayate̠ha naḥ̍|"
        },
        {
          "id": "ts-4-1-5-6",
          "chunkNumber": 6,
          "sanskrit": "u̠śa̠tīri̍va mā̠taraḥ̍||"
        },
        {
          "id": "ts-4-1-5-7",
          "chunkNumber": 7,
          "sanskrit": "tasmā̠ ara̍ṅgamāma vo̠ yasya̠ khṣayā̍ya̠ jinva̍tha|"
        },
        {
          "id": "ts-4-1-5-8",
          "chunkNumber": 8,
          "sanskrit": "āpo̍ ja̠naya̍thā ca naḥ||"
        },
        {
          "id": "ts-4-1-5-9",
          "chunkNumber": 9,
          "sanskrit": "mi̠traḥ sa̠g̠ͫsṛjya̍ pṛthi̠vīmbhūmi̍ñca̠ jyoti̍ṣā sa̠ha|"
        },
        {
          "id": "ts-4-1-5-10",
          "chunkNumber": 10,
          "sanskrit": "sujā̍tañjā̠tave̍dasama̠gnivm̐vai̎śvāna̠ravm̐vi̠bhum||"
        },
        {
          "id": "ts-4-1-5-11",
          "chunkNumber": 11,
          "sanskrit": "a̠ya̠khṣmāya̍ tvā̠ sagͫ sṛ̍jāmi pra̠jābhyaḥ̍|"
        },
        {
          "id": "ts-4-1-5-12",
          "chunkNumber": 12,
          "sanskrit": "viśve̎ tvā de̠vā vai̎śvāna̠rāḥ sagͫ sṛ̍ja̠ntvānu̍ṣṭubhena̠ chanda̍sā'ṅgira̠svat||"
        },
        {
          "id": "ts-4-1-5-13",
          "chunkNumber": 13,
          "sanskrit": "ru̠drāḥ saṃ̠bhṛtya̍ pṛthi̠vīmbṛ̠hajjyotiḥ̠ samī̍dhire|"
        },
        {
          "id": "ts-4-1-5-14",
          "chunkNumber": 14,
          "sanskrit": "teṣā̎mbhā̠nuraja̍sra̠ icchu̠kro de̠veṣu̍ rocate||"
        },
        {
          "id": "ts-4-1-5-15",
          "chunkNumber": 15,
          "sanskrit": "sagͫ sṛ̍ṣṭā̠vm̐vasu̍bhī ru̠drair dhīraiḥ̎ karma̠ṇyā̎mmṛda̎m|"
        },
        {
          "id": "ts-4-1-5-16",
          "chunkNumber": 16,
          "sanskrit": "hastā̎bhyāmmṛ̠dvīṅkṛ̠tvā si̍nīvā̠lī ka̍rotu̠ tām||"
        },
        {
          "id": "ts-4-1-5-17",
          "chunkNumber": 17,
          "sanskrit": "si̠nī̠vā̠lī su̍kapa̠rdā su̍kurī̠rā svau̍pa̠śā|"
        },
        {
          "id": "ts-4-1-5-18",
          "chunkNumber": 18,
          "sanskrit": "sā tubhya̍madite maha̠ okhānda̍dhātu̠ hasta̍yoḥ||"
        },
        {
          "id": "ts-4-1-5-19",
          "chunkNumber": 19,
          "sanskrit": "u̠khāṅka̍rotu̠ śaktyā̍ bā̠hubhyā̠madi̍tir dhi̠yā|"
        },
        {
          "id": "ts-4-1-5-20",
          "chunkNumber": 20,
          "sanskrit": "mā̠tā pu̠traym̐yatho̠pasthe̠ sā'gnimbi̍bhartu̠ garbha̠ ā||"
        },
        {
          "id": "ts-4-1-5-21",
          "chunkNumber": 21,
          "sanskrit": "ma̠khasya̠ śiro̍'si ya̠jñasya̍ pa̠de sthaḥ̍|"
        },
        {
          "id": "ts-4-1-5-22",
          "chunkNumber": 22,
          "sanskrit": "vasa̍vastvā kṛṇvantu gāya̠treṇa̠ chanda̍sā'ṅgira̠svat pṛ̍thi̠vya̍si ru̠drāstvā̍ kṛṇvantu̠ traiṣṭu̍bhena̠ chanda̍sā'ṅgira̠svada̠ntari̍khṣamasyā"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-1-6",
      "title": "Kāṇḍa 4 · Prapāṭhaka 1 · Anuvāka 6",
      "sectionNumber": 6,
      "chunks": [
        {
          "id": "ts-4-1-6-1",
          "chunkNumber": 1,
          "sanskrit": "vasa̍vastvā dhūpayantu gāya̠treṇa̠ chanda̍sā'ṅgira̠svadru̠drāstvā̍ dhūpayantu̠ traiṣṭu̍bhena̠ chanda̍sā'ṅgira̠svadā̍di̠tyāstvā̍ dhūpayantu̠ jāga̍tena̠ chanda̍sā'ṅgira̠svadviśve̎ tvā de̠vā vai̎śvāna̠rā dhū̍paya̠ntvānu̍ṣṭubhena̠ chanda̍sā'ṅgira̠svadindra̍stvā dhūpayatvaṅgira̠svadviṣṇu̍stvā dhūpayatvaṅgira̠svad varu̍ṇastvā dhūpayatvaṅgira̠svadadi̍tistvā de̠vī vi̠śvade̎vyāvatī pṛthi̠vyāḥ sa̠dhasthe̎'ṅgira̠svat kha̍natvavaṭa de̠vānā̎ntvā̠ patnī̎r de̠vīr vi̠śvade̎vyāvatīḥ pṛthi̠vyāḥ sa̠dhasthe̎'ṅgira̠svadda̍dhatūkhe dhi̠ṣaṇā̎stvā de̠vīr vi̠śvade̎vyāvatīḥ pṛthi̠vyāḥ sa̠dhasthe̎'ṅgira̠svada̠bhīndha̍tāmukhe̠ gnā stvā̍ de̠vīr vi̠śvade̎vyāvatīḥ pṛthi̠vyāḥ sa̠dhasthe̎'ṅgira̠svacchra̍payantūkhe̠ varū̎trayo̠ jana̍yastvā de̠vīr vi̠śvade̎vyāvatīḥ pṛthi̠vyāḥ sa̠dhasthe̎'ṅgira̠svat pa̍cantūkhe||",
          "section": 6
        },
        {
          "id": "ts-4-1-6-2",
          "chunkNumber": 2,
          "sanskrit": "mitrai̠tāmu̠khāmpa̍cai̠ṣā mā bhe̍di|"
        },
        {
          "id": "ts-4-1-6-3",
          "chunkNumber": 3,
          "sanskrit": "e̠tānte̠ pari̍ dadā̠myabhi̍ttyai||"
        },
        {
          "id": "ts-4-1-6-4",
          "chunkNumber": 4,
          "sanskrit": "a̠bhīmāṃ"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-1-7",
      "title": "Kāṇḍa 4 · Prapāṭhaka 1 · Anuvāka 7",
      "sectionNumber": 7,
      "chunks": [
        {
          "id": "ts-4-1-7-1",
          "chunkNumber": 1,
          "sanskrit": "samā̎stvā'gna ṛ̠tavo̍ varddhayantu savm̐vathsa̠rā ṛṣa̍yo̠ yāni̍ sa̠tyā|",
          "section": 7
        },
        {
          "id": "ts-4-1-7-2",
          "chunkNumber": 2,
          "sanskrit": "sandi̠vyena̍ dīdihi roca̠nena̠ viśvā̠ ā bhā̍hi pra̠diśaḥ̍ pṛthi̠vyāḥ||"
        },
        {
          "id": "ts-4-1-7-3",
          "chunkNumber": 3,
          "sanskrit": "sañce̠ddhyasvā̎'gne̠ pra ca̍ bodhayaina̠mucca̍ tiṣṭha maha̠te saubha̍gāya|"
        },
        {
          "id": "ts-4-1-7-4",
          "chunkNumber": 4,
          "sanskrit": "mā ca̍ riṣadupasa̠ttā te̍ agne bra̠hmāṇa̍ste ya̠śasaḥ̍ santu̠ mā'nye||"
        },
        {
          "id": "ts-4-1-7-5",
          "chunkNumber": 5,
          "sanskrit": "tvāma̍gne vṛṇate brāhma̠ṇā i̠me śi̠vo a̍gne sa̠vm̐vara̍ṇe bhavā naḥ|"
        },
        {
          "id": "ts-4-1-7-6",
          "chunkNumber": 6,
          "sanskrit": "sa̠pa̠tna̠hā no̍ abhimāti̠jicca̠ sve gaye̍ jāgṛ̠hyapra̍yucchann||"
        },
        {
          "id": "ts-4-1-7-7",
          "chunkNumber": 7,
          "sanskrit": "i̠haivāgne̠ adhi̍ dhārayā ra̠yimmā tvā̠ ni kra̍n pūrva̠cito̍ nikā̠riṇaḥ̍|"
        },
        {
          "id": "ts-4-1-7-8",
          "chunkNumber": 8,
          "sanskrit": "khṣa̠trama̍gne su̠yama̍mastu̠ tubhya̍mupasa̠ttā va̍rddhatānte̠ ani̍ṣṭṛtaḥ||"
        },
        {
          "id": "ts-4-1-7-9",
          "chunkNumber": 9,
          "sanskrit": "khṣa̠treṇā̎'gne̠ svāyuḥ̠ sagͫ ra̍bhasva mi̠treṇā̎'gne mitra̠dheye̍ yatasva|"
        },
        {
          "id": "ts-4-1-7-10",
          "chunkNumber": 10,
          "sanskrit": "sa̠jā̠tānā̎mmaddhyama̠sthā e̍dhi̠ rājñā̍magne viha̠vyo̍ dīdihī̠ha||"
        },
        {
          "id": "ts-4-1-7-11",
          "chunkNumber": 11,
          "sanskrit": "ati̠ niho̠ ati̠ sridho'tyaci̍tti̠matyarā̍timagne|"
        },
        {
          "id": "ts-4-1-7-12",
          "chunkNumber": 12,
          "sanskrit": "viśvā̠ hya̍gne duri̠tā saha̠svāthā̠smabhya̍gͫ sa̠havī̍rāgͫ ra̠yindāḥ̎||"
        },
        {
          "id": "ts-4-1-7-13",
          "chunkNumber": 13,
          "sanskrit": "a̠nā̠dhṛ̠ṣyo jā̠tave̍dā̠ ani̍ṣṭṛto vi̠rāḍa̍gne khṣatra̠bhṛd dī̍dihī̠ha|"
        },
        {
          "id": "ts-4-1-7-14",
          "chunkNumber": 14,
          "sanskrit": "viśvā̠ āśāḥ̎ pramu̠ñcan mānu̍ṣīrbhi̠yaḥ śi̠vābhi̍ra̠dya pari̍ pāhi no vṛ̠dhe||"
        },
        {
          "id": "ts-4-1-7-15",
          "chunkNumber": 15,
          "sanskrit": "bṛha̍spate savitar bo̠dhayai̍na̠g̠ͫ sagͫśi̍tañcith santa̠rāgͫ sagͫ śi̍śādhi|"
        },
        {
          "id": "ts-4-1-7-16",
          "chunkNumber": 16,
          "sanskrit": "va̠rddhayai̍nammaha̠te saubha̍gāya̠ viśva̍ ena̠manu̍ madantu de̠vāḥ||"
        },
        {
          "id": "ts-4-1-7-17",
          "chunkNumber": 17,
          "sanskrit": "a̠mu̠tra̠bhūyā̠dadha̠ yad ya̠masya̠ bṛha̍spate a̠bhiśa̍ste̠ramu̍ñcaḥ|"
        },
        {
          "id": "ts-4-1-7-18",
          "chunkNumber": 18,
          "sanskrit": "pratyau̍hatāma̠śvinā̍ mṛ̠tyuma̍smād de̠vānā̍magne bhi̠ṣajā̠ śacī̍bhiḥ||"
        },
        {
          "id": "ts-4-1-7-19",
          "chunkNumber": 19,
          "sanskrit": "ud va̠yantama̍sa̠spari̠ paśya̍nto̠ jyoti̠rutta̍ram|"
        },
        {
          "id": "ts-4-1-7-20",
          "chunkNumber": 20,
          "sanskrit": "de̠vande̍va̠trā sūrya̠maga̍nma̠ jyoti̍rutta̠mam"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-1-8",
      "title": "Kāṇḍa 4 · Prapāṭhaka 1 · Anuvāka 8",
      "sectionNumber": 8,
      "chunks": [
        {
          "id": "ts-4-1-8-1",
          "chunkNumber": 1,
          "sanskrit": "ū̠rddhvā a̍sya sa̠midho̍ bhavantyū̠rddhvā śu̠krā śo̠cīgͫͫṣya̠gneḥ|",
          "section": 8
        },
        {
          "id": "ts-4-1-8-2",
          "chunkNumber": 2,
          "sanskrit": "dyu̠matta̍mā su̠pratī̍kasya sū̠noḥ||"
        },
        {
          "id": "ts-4-1-8-3",
          "chunkNumber": 3,
          "sanskrit": "tanū̠napā̠dasu̍ro vi̠śvave̍dā de̠vo de̠veṣu̍ de̠vaḥ|"
        },
        {
          "id": "ts-4-1-8-4",
          "chunkNumber": 4,
          "sanskrit": "pa̠tha ā'na̍kti̠ maddhvā̍ ghṛ̠tena̍||"
        },
        {
          "id": "ts-4-1-8-5",
          "chunkNumber": 5,
          "sanskrit": "maddhvā̍ ya̠jñanna̍khṣase prīṇā̠no narā̠śagͫso̍ agne|"
        },
        {
          "id": "ts-4-1-8-6",
          "chunkNumber": 6,
          "sanskrit": "su̠kṛd de̠vaḥ sa̍vi̠tā vi̠śvavā̍raḥ||"
        },
        {
          "id": "ts-4-1-8-7",
          "chunkNumber": 7,
          "sanskrit": "acchā̠yame̍ti̠ śava̍sā ghṛ̠tene̍ḍā̠no vahni̠r nama̍sā|"
        },
        {
          "id": "ts-4-1-8-8",
          "chunkNumber": 8,
          "sanskrit": "a̠gnigͫͫ sruco̍ addhva̠reṣu̍ pra̠yathsu̍||"
        },
        {
          "id": "ts-4-1-8-9",
          "chunkNumber": 9,
          "sanskrit": "sa ya̍khṣadasya mahi̠māna̍ma̠gneḥ sa bhāra̍tī|"
        },
        {
          "id": "ts-4-1-8-10",
          "chunkNumber": 10,
          "sanskrit": "ma̠hī gṛ̍ṇā̠nā||"
        },
        {
          "id": "ts-4-1-8-11",
          "chunkNumber": 11,
          "sanskrit": "tanna̍stu̠rīpa̠madbhu̍tampuru̠khṣu tvaṣṭā̍ su̠vīra̎m|"
        },
        {
          "id": "ts-4-1-8-12",
          "chunkNumber": 12,
          "sanskrit": "rā̠yaspoṣa̠vm̐vi ṣya̍tu̠ nābhi̍ma̠sme||"
        },
        {
          "id": "ts-4-1-8-13",
          "chunkNumber": 13,
          "sanskrit": "vana̍spa̠te'va̍ sṛjā̠ rarā̍ṇa̠stmanā̍ de̠veṣu̍|"
        },
        {
          "id": "ts-4-1-8-14",
          "chunkNumber": 14,
          "sanskrit": "a̠gnirha̠vyagͫ śa̍mi̠tā sū̍dayāti||"
        },
        {
          "id": "ts-4-1-8-15",
          "chunkNumber": 15,
          "sanskrit": "agne̠ svāhā̍ kṛṇuhi jātaveda̠ indrā̍ya ha̠vyam|"
        },
        {
          "id": "ts-4-1-8-16",
          "chunkNumber": 16,
          "sanskrit": "viśve̍ de̠vā ha̠viri̠dañju̍ṣantām||"
        },
        {
          "id": "ts-4-1-8-17",
          "chunkNumber": 17,
          "sanskrit": "hi̠ra̠ṇya̠ga̠rbhaḥ sama̍varta̠tāgre̍ bhū̠tasya̍ jā̠taḥ pati̠reka̍ āsīt|"
        },
        {
          "id": "ts-4-1-8-18",
          "chunkNumber": 18,
          "sanskrit": "sa dā̍dhāra pṛthi̠vīndyā"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-1-9",
      "title": "Kāṇḍa 4 · Prapāṭhaka 1 · Anuvāka 9",
      "sectionNumber": 9,
      "chunks": [
        {
          "id": "ts-4-1-9-1",
          "chunkNumber": 1,
          "sanskrit": "ākū̍tima̠gnimpra̠yuja̠g̠ͫͫ svāhā̠ mano̍ me̠dhāma̠gnimpra̠yuja̠g̠ͫͫ svāhā̍ ci̠ttavm̐vijñā̍tama̠gnimpra̠yuja̠g̠ͫͫ svāhā̍ vā̠co vidhṛ̍tima̠gnimpra̠yuja̠g̠ͫͫ svāhā̎ pra̠jāpa̍taye̠ mana̍ve̠ svāhā̠'gnaye̍ vaiśvāna̠rāya̠ svāhā̠ viśve̍ de̠vasya̍ ne̠tur marto̍ vṛṇīta sa̠khyavm̐viśve̍ rā̠ya i̍ṣuddhyasi dyu̠mnavm̐vṛ̍ṇīta pu̠ṣyase̠ svāhā̠ mā su bhi̍tthā̠ mā su ri̍ṣo̠ dṛgͫha̍sva vī̠ḍaya̍sva̠ su|",
          "section": 9
        },
        {
          "id": "ts-4-1-9-2",
          "chunkNumber": 2,
          "sanskrit": "aṃba̍ dhṛṣṇu vī̠raya̍svā̠"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-1-10",
      "title": "Kāṇḍa 4 · Prapāṭhaka 1 · Anuvāka 10",
      "sectionNumber": 10,
      "chunks": [
        {
          "id": "ts-4-1-10-1",
          "chunkNumber": 1,
          "sanskrit": "yada̍gne̠ yāni̠ kāni̠ cā''te̠ dārū̍ṇi da̠dhmasi̍|",
          "section": 10
        },
        {
          "id": "ts-4-1-10-2",
          "chunkNumber": 2,
          "sanskrit": "tada̍stu̠ tubhya̠mid ghṛ̠tantajju̍ṣasva yaviṣṭhya||"
        },
        {
          "id": "ts-4-1-10-3",
          "chunkNumber": 3,
          "sanskrit": "yadattyu̍pa̠jihvi̍kā̠ yad va̠mro a̍ti̠sarpa̍ti|"
        },
        {
          "id": "ts-4-1-10-4",
          "chunkNumber": 4,
          "sanskrit": "sarva̠ntada̍stu te ghṛ̠tantajju̍ṣasva yaviṣṭhya||"
        },
        {
          "id": "ts-4-1-10-5",
          "chunkNumber": 5,
          "sanskrit": "rātri̍gͫrātri̠mapra̍yāva̠mbhara̠nto'śvā̍yeva̠ tiṣṭha̍te ghā̠sama̍smai|"
        },
        {
          "id": "ts-4-1-10-6",
          "chunkNumber": 6,
          "sanskrit": "rā̠yaspoṣe̍ṇa̠ sami̠ṣā mada̠nto'gne̠ mā te̠ prati̍veśā riṣāma||"
        },
        {
          "id": "ts-4-1-10-7",
          "chunkNumber": 7,
          "sanskrit": "nābhā̍ svāgͫ a̠ham||"
        },
        {
          "id": "ts-4-1-10-8",
          "chunkNumber": 8,
          "sanskrit": "dṛ̠śā̠no ru̠kma u̠rvyā vya̍dyauddu̠rmarṣa̠māyuḥ̍ śri̠ye ru̍cā̠naḥ|"
        },
        {
          "id": "ts-4-1-10-9",
          "chunkNumber": 9,
          "sanskrit": "a̠gnira̠mṛto̍ abhava̠dvayo̍bhi̠r yade̍na̠ndyauraja̍nayath su̠retāḥ̎||"
        },
        {
          "id": "ts-4-1-10-10",
          "chunkNumber": 10,
          "sanskrit": "viśvā̍ rū̠pāṇi̠ prati̍ muñcate ka̠viḥ prā'sā̍vīdbha̠drandvi̠pade̠ catu̍ṣpade|"
        },
        {
          "id": "ts-4-1-10-11",
          "chunkNumber": 11,
          "sanskrit": "vi nāka̍makhyath savi̠tā vare̠ṇyo'nu̍ pra̠yāṇa̍mu̠ṣaso̠ vi rā̍jati||"
        },
        {
          "id": "ts-4-1-10-12",
          "chunkNumber": 12,
          "sanskrit": "nakto̠ṣāsā̠ sama̍nasā̠ virū̍pe dhā̠paye̍te̠ śiśu̠meka̍gͫ samī̠cī|"
        },
        {
          "id": "ts-4-1-10-13",
          "chunkNumber": 13,
          "sanskrit": "dyāvā̠ khṣāmā̍ ru̠kmo a̠ntar vi bhā̍ti de̠vā a̠gnindhā̍rayan draviṇo̠dāḥ||"
        },
        {
          "id": "ts-4-1-10-14",
          "chunkNumber": 14,
          "sanskrit": "su̠pa̠rṇo̍'si ga̠rutmā̎n tri̠vṛt te̠ śiro̍ gāya̠trañcakhṣuḥ̠ stoma̍ ā̠tmā sāma̍ te ta̠nūrvā̍made̠vyaṃ bṛ̍hadrathanta̠re pa̠khṣau ya̍jñāya̠jñiya̠mpuccha̠ñchandā̠g̠ͫͫsyaṅgā̍ni̠ dhiṣṇi̍yāḥ śa̠phā yajū̍gͫṣi̠ nāma̍||"
        },
        {
          "id": "ts-4-1-10-15",
          "chunkNumber": 15,
          "sanskrit": "su̠pa̠rṇo̍'si ga̠rutmā̠n diva̍ṅgaccha̠ suvaḥ̍ pata"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-1-11",
      "title": "Kāṇḍa 4 · Prapāṭhaka 1 · Anuvāka 11",
      "sectionNumber": 11,
      "chunks": [
        {
          "id": "ts-4-1-11-1",
          "chunkNumber": 1,
          "sanskrit": "agne̠ yaym̐ya̠jñama̍ddhva̠ravm̐vi̠śvataḥ̍ pari̠bhūrasi̍|",
          "section": 11
        },
        {
          "id": "ts-4-1-11-2",
          "chunkNumber": 2,
          "sanskrit": "sa idde̠veṣu̍ gacchati||"
        },
        {
          "id": "ts-4-1-11-3",
          "chunkNumber": 3,
          "sanskrit": "soma̠ yāste̍ mayo̠bhuva̍ ū̠tayaḥ̠ santi̍ dā̠śuṣe̎|"
        },
        {
          "id": "ts-4-1-11-4",
          "chunkNumber": 4,
          "sanskrit": "tābhi̍r no'vi̠tā bha̍va||"
        },
        {
          "id": "ts-4-1-11-5",
          "chunkNumber": 5,
          "sanskrit": "a̠gnir mū̠rddhā >1 , bhuvaḥ̍ > 2||"
        },
        {
          "id": "ts-4-1-11-6",
          "chunkNumber": 6,
          "sanskrit": "tvannaḥ̍ soma̠ >3, yā te̠ dhāmā̍ni >4||"
        },
        {
          "id": "ts-4-1-11-7",
          "chunkNumber": 7,
          "sanskrit": "tath sa̍vi̠tur vare̎ṇya̠mbhargo̍ de̠vasya̍ dhīmahi|"
        },
        {
          "id": "ts-4-1-11-8",
          "chunkNumber": 8,
          "sanskrit": "dhiyo̠ yo naḥ̍ praco̠dayā̎t||"
        },
        {
          "id": "ts-4-1-11-9",
          "chunkNumber": 9,
          "sanskrit": "aci̍ttī̠ yacca̍kṛ̠mā daivye̠ jane̍ dī̠nair dakhṣaiḥ̠ prabhū̍tī pūruṣa̠tvatā̎ de̠veṣu̍ ca savita̠r mānu̍ṣeṣu ca̠ tvanno̠ atra̍ suvatā̠danā̍gasaḥ||"
        },
        {
          "id": "ts-4-1-11-10",
          "chunkNumber": 10,
          "sanskrit": "co̠da̠yi̠trī sū̠nṛtā̍nā̠ñceta̍ntī sumatī̠nām|"
        },
        {
          "id": "ts-4-1-11-11",
          "chunkNumber": 11,
          "sanskrit": "ya̠jñanda̍dhe̠ sara̍svatī||"
        },
        {
          "id": "ts-4-1-11-12",
          "chunkNumber": 12,
          "sanskrit": "pāvī̍ravī ka̠nyā̍ ci̠trāyuḥ̠ sara̍svatī vī̠rapa̍tnī̠ dhiya̍ndhāt|"
        },
        {
          "id": "ts-4-1-11-13",
          "chunkNumber": 13,
          "sanskrit": "gnābhi̠racchi̍dragͫ śara̠ṇagͫ sa̠joṣā̍ durā̠dharṣa̍ṅgṛṇa̠te śarma̍ yagͫsat||"
        },
        {
          "id": "ts-4-1-11-14",
          "chunkNumber": 14,
          "sanskrit": "pū̠ṣā gā anve̍tu naḥ pū̠ṣā ra̍khṣa̠tvarva̍taḥ|"
        },
        {
          "id": "ts-4-1-11-15",
          "chunkNumber": 15,
          "sanskrit": "pū̠ṣā vāja̍gͫ sanotu naḥ||"
        },
        {
          "id": "ts-4-1-11-16",
          "chunkNumber": 16,
          "sanskrit": "śu̠krante̍ a̠nyadya̍ja̠tante̍ a̠nya reja̍te agne pṛthi̠vī ma̠khebhyaḥ̍||"
        },
        {
          "id": "ts-4-1-11-17",
          "chunkNumber": 17,
          "sanskrit": "viśve̍ de̠vā >5, viśve̍ devāḥ >6||"
        },
        {
          "id": "ts-4-1-11-18",
          "chunkNumber": 18,
          "sanskrit": "dyāvā̍ naḥ pṛthi̠vī i̠magͫ si̠ddhrama̠dya di̍vi̠spṛśa̎m|"
        },
        {
          "id": "ts-4-1-11-19",
          "chunkNumber": 19,
          "sanskrit": "ya̠jñande̠veṣu̍ yacchatām||"
        },
        {
          "id": "ts-4-1-11-20",
          "chunkNumber": 20,
          "sanskrit": "pra pū̎rva̠je pi̠tarā̠ navya̍sībhir gī̠rbhiḥ kṛ̍ṇuddhva̠g̠ͫ sada̍ne ṛ̠tasya̍|"
        },
        {
          "id": "ts-4-1-11-21",
          "chunkNumber": 21,
          "sanskrit": "ā no̎ dyāvāpṛthivī̠ daivye̍na̠ jane̍na yāta̠mmahi̍ vā̠vm̐varū̍tham||"
        },
        {
          "id": "ts-4-1-11-22",
          "chunkNumber": 22,
          "sanskrit": "a̠gnigͫͫ stome̍na bodhaya samidhā̠no ama̍rtyam|"
        },
        {
          "id": "ts-4-1-11-23",
          "chunkNumber": 23,
          "sanskrit": "ha̠vyā de̠veṣu̍ no dadhat||"
        },
        {
          "id": "ts-4-1-11-24",
          "chunkNumber": 24,
          "sanskrit": "sa ha̍vya̠vāḍama̍rtya u̠śig dū̠taścano̍hitaḥ|"
        },
        {
          "id": "ts-4-1-11-25",
          "chunkNumber": 25,
          "sanskrit": "a̠gnir dhi̠yā samṛ̍ṇvati||"
        },
        {
          "id": "ts-4-1-11-26",
          "chunkNumber": 26,
          "sanskrit": "śanno̍ bhavantu̠>7 , vāje̍vāje> 8"
        }
      ]
    }
  ]
}
