{
  "sections": [
    {
      "id": "taittiriya-samhita-4-1-1",
      "title": "Kāṇḍa 4 · Prapāṭhaka 1 · Anuvāka 1",
      "sectionNumber": 1,
      "chunks": [
        {
          "id": "ts-4-1-1-1",
          "chunkNumber": 1,
          "sanskrit": "यु॒ञ्जा॒नः प्र॑थ॒मम्मन॑स्त॒त्वाय॑ सवि॒ता धियः॑।",
          "section": 1
        },
        {
          "id": "ts-4-1-1-2",
          "chunkNumber": 2,
          "sanskrit": "अ॒ग्निञ्ज्योति॑र्नि॒चाय्य॑ पृथि॒व्या अद्ध्याऽभ॑रत्॥"
        },
        {
          "id": "ts-4-1-1-3",
          "chunkNumber": 3,
          "sanskrit": "यु॒क्त्वाय॒ मन॑सा दे॒वान्थ् सुव॑र्य॒तो धि॒या दिव᳚म्।"
        },
        {
          "id": "ts-4-1-1-4",
          "chunkNumber": 4,
          "sanskrit": "बृ॒हज्ज्योतिः॑ करिष्य॒तः स॑वि॒ता प्र सु॑वाति॒ तान्॥"
        },
        {
          "id": "ts-4-1-1-5",
          "chunkNumber": 5,
          "sanskrit": "यु॒क्तेन॒ मन॑सा व॒यन्दे॒वस्य॑ सवि॒तुः स॒वे।"
        },
        {
          "id": "ts-4-1-1-6",
          "chunkNumber": 6,
          "sanskrit": "सु॒व॒र्गेया॑य॒ शक्त्यै᳚॥"
        },
        {
          "id": "ts-4-1-1-7",
          "chunkNumber": 7,
          "sanskrit": "यु॒ञ्जते॒ मन॑ उ॒त यु॑ञ्जते॒ धियो॒ विप्रा॒ विप्र॑स्य बृह॒तो वि॑प॒श्चितः॑।"
        },
        {
          "id": "ts-4-1-1-8",
          "chunkNumber": 8,
          "sanskrit": "वि होत्रा॑ दधे वयुना॒विदेक॒ इन् म॒ही दे॒वस्य॑ सवि॒तुः परि॑ष्टुतिः॥"
        },
        {
          "id": "ts-4-1-1-9",
          "chunkNumber": 9,
          "sanskrit": "यु॒जे वा॒म्ब्रह्म॑ पू॒र्व्यन्नमो॑भि॒र् वि श्लोका॑ यन्ति प॒थ्ये॑व॒ सूराः᳚।"
        },
        {
          "id": "ts-4-1-1-10",
          "chunkNumber": 10,
          "sanskrit": "शृ॒ण्वन्ति॒ विश्वे॑ अ॒मृत॑स्य पु॒त्रा आ ये धामा॑नि दि॒व्यानि॑ त॒स्थुः॥"
        },
        {
          "id": "ts-4-1-1-11",
          "chunkNumber": 11,
          "sanskrit": "यस्य॑ प्र॒याण॒मन्वव॒न्य इद्य॒युर् दे॒वा दे॒वस्य॑ महि॒मान॒मर्च॑तः।"
        },
        {
          "id": "ts-4-1-1-12",
          "chunkNumber": 12,
          "sanskrit": "यः पार्त्थि॑वानि विम॒मे स एत॑शो॒ रजा॑ꣳसि दे॒वः स॑वि॒ता म॑हित्व॒ना॥"
        },
        {
          "id": "ts-4-1-1-13",
          "chunkNumber": 13,
          "sanskrit": "देव॑ सवितः॒ प्र सु॑व य॒ज्ञम्प्र सु॑व य॒ज्ञप॑ति॒म्भगा॑य दि॒व्यो ग॑न्ध॒र्वः।"
        },
        {
          "id": "ts-4-1-1-14",
          "chunkNumber": 14,
          "sanskrit": "के॒त॒पूः केत॑न्नः पुनातु वा॒चस्पति॒र् वाच॑म॒द्य स्व॑दाति नः॥"
        },
        {
          "id": "ts-4-1-1-15",
          "chunkNumber": 15,
          "sanskrit": "इ॒मन्नो॑ देव सवितर् य॒ज्ञम्प्र सु॑व देवा॒युव॑ꣳ सखि॒विद॑ꣳ सत्रा॒जित॑न्धन॒जित॑ꣳ सुव॒र्जित᳚म्॥"
        },
        {
          "id": "ts-4-1-1-16",
          "chunkNumber": 16,
          "sanskrit": "ऋ॒चा स्तोम॒ꣳ॒ सम॑र्द्धय गाय॒त्रेण॑ रथन्त॒रम्।"
        },
        {
          "id": "ts-4-1-1-17",
          "chunkNumber": 17,
          "sanskrit": "बृ॒हद्गा॑य॒त्रव॑र्तनि॥"
        },
        {
          "id": "ts-4-1-1-18",
          "chunkNumber": 18,
          "sanskrit": "दे॒वस्य॑ त्वा सवि॒तुः प्र॑स॒वे᳚ऽश्विनो᳚र् बा॒हुभ्यां᳚ पू॒ष्णो हस्ता᳚भ्याङ्गाय॒त्रेण॒ छन्द॒साऽऽद॑देऽङ्गिर॒स्वदभ्रि॑रसि॒ नारि॑"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-1-2",
      "title": "Kāṇḍa 4 · Prapāṭhaka 1 · Anuvāka 2",
      "sectionNumber": 2,
      "chunks": [
        {
          "id": "ts-4-1-2-1",
          "chunkNumber": 1,
          "sanskrit": "इ॒माम॑गृभ्णन् रश॒नामृ॒तस्य॒ पूर्व॒ आयु॑षि वि॒दथे॑षु क॒व्या।",
          "section": 2
        },
        {
          "id": "ts-4-1-2-2",
          "chunkNumber": 2,
          "sanskrit": "तया॑ दे॒वाः सु॒तमा ब॑भूवुर्ऋ॒तस्य॒ साम᳚न्थ् स॒रमा॒रप॑न्ती॥"
        },
        {
          "id": "ts-4-1-2-3",
          "chunkNumber": 3,
          "sanskrit": "प्रतू᳚र्तव्ँवाजि॒न्ना द्र॑व॒ वरि॑ष्ठा॒मनु॑ स॒व्ँवत᳚म्।"
        },
        {
          "id": "ts-4-1-2-4",
          "chunkNumber": 4,
          "sanskrit": "दि॒वि ते॒ जन्म॑ पर॒मम॒न्तरि॑ख्षे॒ नाभिः॑ पृथि॒व्यामधि॒ योनिः॑॥"
        },
        {
          "id": "ts-4-1-2-5",
          "chunkNumber": 5,
          "sanskrit": "यु॒ञ्जाथा॒ꣳ॒ रास॑भय्ँयु॒वम॒स्मिन्यामे॑ वृषण्वसू।"
        },
        {
          "id": "ts-4-1-2-6",
          "chunkNumber": 6,
          "sanskrit": "अ॒ग्निम्भर॑न्तमस्म॒युम्॥"
        },
        {
          "id": "ts-4-1-2-7",
          "chunkNumber": 7,
          "sanskrit": "योगे॑योगे त॒वस्त॑र॒व्ँवाजे॑वाजे हवामहे।"
        },
        {
          "id": "ts-4-1-2-8",
          "chunkNumber": 8,
          "sanskrit": "सखा॑य॒ इन्द्र॑मू॒तये᳚॥"
        },
        {
          "id": "ts-4-1-2-9",
          "chunkNumber": 9,
          "sanskrit": "प्र॒तूर्व॒ न्नेह्य॑व॒क्राम॒न्नश॑स्ती रु॒द्रस्य॒ गाण॑पत्यान् मयो॒भूरेहि॑।"
        },
        {
          "id": "ts-4-1-2-10",
          "chunkNumber": 10,
          "sanskrit": "उ॒र्व॑न्तरि॑ख्ष॒मन्वि॑हि स्व॒स्तिग॑व्यूति॒रभ॑यानि कृ॒ण्वन्न्॥"
        },
        {
          "id": "ts-4-1-2-11",
          "chunkNumber": 11,
          "sanskrit": "पू॒ष्णा स॒युजा॑ स॒ह।"
        },
        {
          "id": "ts-4-1-2-12",
          "chunkNumber": 12,
          "sanskrit": "पृ॒थि॒व्याः स॒धस्था॑द॒ग्निम्पु॑री॒ष्य॑मङ्गिर॒स्वदच्छे᳚ह्य॒ग्निम्पु॑री॒ष्य॑मङ्गिर॒स्वदच्छे॑मो॒ऽग्निं पु॑री॒ष्य॑मङ्गिर॒स्वद्भ॑रिष्यामो॒ऽग्निम्पु॑री॒ष्य॑मङ्गिर॒स्वद्भ॑रामः॥"
        },
        {
          "id": "ts-4-1-2-13",
          "chunkNumber": 13,
          "sanskrit": "अन्व॒ग्निरु॒षसा॒मग्र॑मख्य॒दन्वहा॑नि प्रथ॒मो जा॒तवे॑दाः।"
        },
        {
          "id": "ts-4-1-2-14",
          "chunkNumber": 14,
          "sanskrit": "अनु॒ सूर्य॑स्य"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-1-3",
      "title": "Kāṇḍa 4 · Prapāṭhaka 1 · Anuvāka 3",
      "sectionNumber": 3,
      "chunks": [
        {
          "id": "ts-4-1-3-1",
          "chunkNumber": 1,
          "sanskrit": "दे॒वस्य॑ त्वा सवि॒तुः प्र॑स॒वे᳚ऽश्विनो᳚र् बा॒हुभ्या᳚म्पू॒ष्णो हस्ता᳚भ्याम्पृथि॒व्याः स॒धस्थे॒ऽग्निं पु॑री॒ष्य॑मङ्गिर॒स्वत् ख॑नामि॥",
          "section": 3
        },
        {
          "id": "ts-4-1-3-2",
          "chunkNumber": 2,
          "sanskrit": "ज्योति॑ष्मन्तन्त्वाऽग्ने सु॒प्रती॑क॒मज॑स्रेण भा॒नुना॒ दीद्या॑नम्।"
        },
        {
          "id": "ts-4-1-3-3",
          "chunkNumber": 3,
          "sanskrit": "शि॒वम्प्र॒जाभ्योऽहि॑ꣳसन्तम्पृथि॒व्याः स॒धस्थे॒ऽग्निम्पु॑री॒ष्य॑मङ्गिर॒स्वत् ख॑नामि॥"
        },
        {
          "id": "ts-4-1-3-4",
          "chunkNumber": 4,
          "sanskrit": "अ॒पाम्पृ॒ष्ठम॑सि स॒प्रथा॑ उ॒र्व॑ग्निम्भ॑रि॒ष्यदप॑रावपिष्ठम्।"
        },
        {
          "id": "ts-4-1-3-5",
          "chunkNumber": 5,
          "sanskrit": "वर्द्ध॑मानम्म॒ह आ च॒ पुष्क॑रन्दि॒वो मात्र॑या वरि॒णा प्र॑थस्व॥"
        },
        {
          "id": "ts-4-1-3-6",
          "chunkNumber": 6,
          "sanskrit": "शर्म॑ च स्थो॒ वर्म॑ च स्थो॒ अच्छि॑द्रे बहु॒ले उ॒भे।"
        },
        {
          "id": "ts-4-1-3-7",
          "chunkNumber": 7,
          "sanskrit": "व्यच॑स्वती॒ सव्ँव॑साथाम्भ॒र्तम॒ग्निम्पु॑री॒ष्य᳚म्॥"
        },
        {
          "id": "ts-4-1-3-8",
          "chunkNumber": 8,
          "sanskrit": "सव्ँव॑साथाꣳ सुव॒र्विदा॑ स॒मीची॒ उर॑सा॒ त्मना᳚।"
        },
        {
          "id": "ts-4-1-3-9",
          "chunkNumber": 9,
          "sanskrit": "अ॒ग्निम॒न्तर् भ॑रि॒ष्यन्ती॒ ज्योति॑ष्मन्त॒मज॑स्र॒मित्॥"
        },
        {
          "id": "ts-4-1-3-10",
          "chunkNumber": 10,
          "sanskrit": "पु॒री॒ष्यो॑ऽसि वि॒श्वभ॑राः।"
        },
        {
          "id": "ts-4-1-3-11",
          "chunkNumber": 11,
          "sanskrit": "अथ॑र्वा त्वा प्रथ॒मो निर॑मन्थदग्ने॥"
        },
        {
          "id": "ts-4-1-3-12",
          "chunkNumber": 12,
          "sanskrit": "त्वाम॑ग्ने॒ पुष्क॑रा॒दद्ध्यथ॑र्वा॒ निर॑मन्थत।"
        },
        {
          "id": "ts-4-1-3-13",
          "chunkNumber": 13,
          "sanskrit": "मू॒र्द्ध्नो विश्व॑स्य वा॒घतः॑॥"
        },
        {
          "id": "ts-4-1-3-14",
          "chunkNumber": 14,
          "sanskrit": "तमु॑ त्वा द॒द्ध्यङ् ऋषिः॑ पु॒त्र ई॑धे॒ अथ॑र्वणः।"
        },
        {
          "id": "ts-4-1-3-15",
          "chunkNumber": 15,
          "sanskrit": "वृ॒त्र॒हण॑म्पुरन्द॒रम्॥"
        },
        {
          "id": "ts-4-1-3-16",
          "chunkNumber": 16,
          "sanskrit": "तमु॑ त्वा पा॒थ्यो वृषा॒ समी॑धे दस्यु॒हन्त॑मम्।"
        },
        {
          "id": "ts-4-1-3-17",
          "chunkNumber": 17,
          "sanskrit": "ध॒न॒ञ्ज॒यꣳ रणे॑रणे॥"
        },
        {
          "id": "ts-4-1-3-18",
          "chunkNumber": 18,
          "sanskrit": "सीद॑ होतः॒ स्व उ॑ लो॒के चि॑कि॒त्वान्थ् सा॒दया॑ य॒ज्ञꣳ सु॑कृ॒तस्य॒ योनौ᳚।"
        },
        {
          "id": "ts-4-1-3-19",
          "chunkNumber": 19,
          "sanskrit": "दे॒वा॒वीर् दे॒वान्ह॒विषा॑ यजा॒स्यग्ने॑ बृ॒हद्यज॑माने॒ वयो॑ धाः॥"
        },
        {
          "id": "ts-4-1-3-20",
          "chunkNumber": 20,
          "sanskrit": "नि होता॑ होतृ॒षद॑ने॒ विदा॑नस्त्वे॒षो दी॑दि॒वाꣳ अ॑सदथ् सु॒दख्षः॑।"
        },
        {
          "id": "ts-4-1-3-21",
          "chunkNumber": 21,
          "sanskrit": "अद॑ब्धव्रतप्रमति॒र् वसि॑ष्ठः सहस्रंभ॒रः शुचि॑जिह्वो अ॒ग्निः॥"
        },
        {
          "id": "ts-4-1-3-22",
          "chunkNumber": 22,
          "sanskrit": "सꣳ सी॑दस्व म॒हाꣳ अ॑सि॒ शोच॑स्व"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-1-4",
      "title": "Kāṇḍa 4 · Prapāṭhaka 1 · Anuvāka 4",
      "sectionNumber": 4,
      "chunks": [
        {
          "id": "ts-4-1-4-1",
          "chunkNumber": 1,
          "sanskrit": "सन्ते॑ वा॒युर् मा॑त॒रिश्वा॑ दधातूत्ता॒नायै॒ हृद॑य॒य्ँयद्विलि॑ष्टम्।",
          "section": 4
        },
        {
          "id": "ts-4-1-4-2",
          "chunkNumber": 2,
          "sanskrit": "दे॒वाना॒य्ँयश्चर॑ति प्रा॒णथे॑न॒ तस्मै॑ च देवि॒ वष॑डस्तु॒ तुभ्य᳚म्॥"
        },
        {
          "id": "ts-4-1-4-3",
          "chunkNumber": 3,
          "sanskrit": "सुजा॑तो॒ ज्योति॑षा स॒ह शर्म॒ वरू॑थ॒माऽस॑दः॒ सुवः॑।"
        },
        {
          "id": "ts-4-1-4-4",
          "chunkNumber": 4,
          "sanskrit": "वासो॑ अग्ने वि॒श्वरू॑प॒ꣳ॒ सव्ँव्य॑यस्व विभावसो॥"
        },
        {
          "id": "ts-4-1-4-5",
          "chunkNumber": 5,
          "sanskrit": "उदु॑ तिष्ठ स्वद्ध्व॒रावा॑ नो दे॒व्या कृ॒पा।"
        },
        {
          "id": "ts-4-1-4-6",
          "chunkNumber": 6,
          "sanskrit": "दृ॒शे च॑ भा॒सा बृ॑ह॒ता सु॑शु॒क्वनि॒राऽग्ने॑ याहि सुश॒स्तिभिः॑ ऊ॒र्द्ध्व ऊ॒ षु ण॑ ऊ॒तये॒ तिष्ठा॑ दे॒वो न स॑वि॒ता।"
        },
        {
          "id": "ts-4-1-4-7",
          "chunkNumber": 7,
          "sanskrit": "ऊ॒र्द्ध्वो वाज॑स्य॒ सनि॑ता॒ यद॒ञ्जिभि॑र् वा॒घद्भि॑र् वि॒ह्वया॑महे॥"
        },
        {
          "id": "ts-4-1-4-8",
          "chunkNumber": 8,
          "sanskrit": "स जा॒तो गर्भो॑ असि॒ रोद॑स्यो॒रग्ने॒ चारु॒र् विभृ॑त॒ ओष॑धीषु।"
        },
        {
          "id": "ts-4-1-4-9",
          "chunkNumber": 9,
          "sanskrit": "चि॒त्रः शिशुः॒ परि॒ तमा॑ꣴस्य॒क्तः प्र मा॒तृभ्यो॒ अधि॒ कनि॑क्रदद् गाः॥"
        },
        {
          "id": "ts-4-1-4-10",
          "chunkNumber": 10,
          "sanskrit": "स्थि॒रो भ॑व वी॒ड्व॑ङ्ग आ॒शुर् भ॑व वा॒ज्य॑र्वन्न्।"
        },
        {
          "id": "ts-4-1-4-11",
          "chunkNumber": 11,
          "sanskrit": "पृ॒थुर् भ॑व सु॒षद॒स्त्वम॒ग्नेः पु॑रीष॒वाह॑नः॥"
        },
        {
          "id": "ts-4-1-4-12",
          "chunkNumber": 12,
          "sanskrit": "शि॒वो भ॑व प्र॒जाभ्यो॒ मानु॑षीभ्य॒स्त्वम॑ङ्गिरः।"
        },
        {
          "id": "ts-4-1-4-13",
          "chunkNumber": 13,
          "sanskrit": "मा द्यावा॑पृथि॒वी अ॒भि शू॑शुचो॒ माऽन्तरि॑ख्ष॒म्मा वन॒स्पती॑न्॥"
        },
        {
          "id": "ts-4-1-4-14",
          "chunkNumber": 14,
          "sanskrit": "प्रैतु॑ वा॒जी कनि॑क्रद॒न्नान॑द॒द्रास॑भः॒ पत्वा᳚।"
        },
        {
          "id": "ts-4-1-4-15",
          "chunkNumber": 15,
          "sanskrit": "भर॑न्न॒ग्निम्पु॑री॒ष्य॑म्मा पा॒द्यायु॑षः पु॒रा॥"
        },
        {
          "id": "ts-4-1-4-16",
          "chunkNumber": 16,
          "sanskrit": "रास॑भो वा॒ङ्कनि॑क्रद॒थ् सुयु॑क्तो वृषणा॒ रथे᳚।"
        },
        {
          "id": "ts-4-1-4-17",
          "chunkNumber": 17,
          "sanskrit": "स वा॑म॒ग्निम्पु॑री॒ष्य॑मा॒शुर् दू॒तो व॑हादि॒तः॥"
        },
        {
          "id": "ts-4-1-4-18",
          "chunkNumber": 18,
          "sanskrit": "वृषा॒ऽग्निव्ँवृष॑ण॒म्भर॑न्न॒पाङ्गर्भ॑ꣳ समु॒द्रिय᳚म्।"
        },
        {
          "id": "ts-4-1-4-19",
          "chunkNumber": 19,
          "sanskrit": "अग्न॒ आ या॑हि वी॒तय॑ ऋ॒तꣳ स॒त्यम्॥"
        },
        {
          "id": "ts-4-1-4-20",
          "chunkNumber": 20,
          "sanskrit": "ओष॑धयः॒ प्रति॑ गृह्णीता॒ऽग्निमे॒तꣳ शि॒वमा॒यन्त॑म॒भ्यत्र॑ यु॒ष्मान्।"
        },
        {
          "id": "ts-4-1-4-21",
          "chunkNumber": 21,
          "sanskrit": "व्यस्य॒न् विश्वा॒ अम॑ती॒ररा॑तीर् नि॒षीद॑न्नो॒ अप॑ दुर्म॒तिꣳ ह॑नत्॥"
        },
        {
          "id": "ts-4-1-4-22",
          "chunkNumber": 22,
          "sanskrit": "ओष॑धयः॒ प्रति॑ मोदद्ध्वमेन॒म्पुष्पा॑वतीः सुपिप्प॒लाः।"
        },
        {
          "id": "ts-4-1-4-23",
          "chunkNumber": 23,
          "sanskrit": "अ॒यव्ँवो॒ गर्भ॑ ऋ॒त्वियः॑ प्र॒त्नꣳ स॒धस्थ॒माऽस॑दत्"
        }
      ]
