        {
          "id": "ts-4-1-5-2",
          "chunkNumber": 2,
          "sanskrit": "सु॒शर्म॑णो बृह॒तः शर्म॑णि स्याम॒ग्नेर॒हꣳ सु॒हव॑स्य॒ प्रणी॑तौ॥"
        },
        {
