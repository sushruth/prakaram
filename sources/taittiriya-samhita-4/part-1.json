        },
        {
          "id": "ts-4-1-5-20",
          "chunkNumber": 20,
          "sanskrit": "मा॒ता पु॒त्रय्ँयथो॒पस्थे॒ साऽग्निम्बि॑भर्तु॒ गर्भ॒ आ॥"
        },
        {
          "id": "ts-4-1-5-21",
          "chunkNumber": 21,
          "sanskrit": "म॒खस्य॒ शिरो॑ऽसि य॒ज्ञस्य॑ प॒दे स्थः॑।"
        },
        {
          "id": "ts-4-1-5-22",
          "chunkNumber": 22,
          "sanskrit": "वस॑वस्त्वा कृण्वन्तु गाय॒त्रेण॒ छन्द॑साऽङ्गिर॒स्वत् पृ॑थि॒व्य॑सि रु॒द्रास्त्वा॑ कृण्वन्तु॒ त्रैष्टु॑भेन॒ छन्द॑साऽङ्गिर॒स्वद॒न्तरि॑ख्षमस्या"
        }
      ]
