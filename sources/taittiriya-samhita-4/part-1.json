      "chunks": [
        {
          "id": "ts-4-1-8-1",
          "chunkNumber": 1,
          "sanskrit": "ऊ॒र्द्ध्वा अ॑स्य स॒मिधो॑ भवन्त्यू॒र्द्ध्वा शु॒क्रा शो॒चीꣴष्य॒ग्नेः।",
          "section": 8
        },
        {
          "id": "ts-4-1-8-2",
