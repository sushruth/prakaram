        {
          "id": "ts-4-2-5-5",
          "chunkNumber": 5,
          "sanskrit": "पु॒री॒ष्य॑स्त्वम॑ग्ने रयि॒मान् पु॑ष्टि॒माꣳ अ॑सि।"
        },
        {
          "id": "ts-4-2-5-6",
          "chunkNumber": 6,
          "sanskrit": "शि॒वाः कृ॒त्वा दिशः॒ सर्वाः॒ स्वाय्ँयोनि॑मि॒हाऽस॑दः॥"
        },
        {
          "id": "ts-4-2-5-7",
          "chunkNumber": 7,
