      "sectionNumber": 19,
      "chunks": [
        {
          "id": "ts-4-2-8-1",
          "chunkNumber": 1,
          "sanskrit": "अ॒भ्य॑स्था॒द्विश्वाः॒ पृत॑ना॒ अरा॑ती॒स्तद॒ग्निरा॑ह॒ तदु॒ सोम॑ आह।",
          "section": 8
        },
        {
          "id": "ts-4-2-8-2",
          "chunkNumber": 2,
          "sanskrit": "बृह॒स्पतिः॑ सवि॒ता तन्म॑ आह पू॒षा मा॑ऽधाथ् सुकृ॒तस्य॑ लो॒के॥"
        },
        {
          "id": "ts-4-2-8-3",
          "chunkNumber": 3,
          "sanskrit": "यदक्र॑न्दः प्रथ॒मञ्जाय॑मान उ॒द्यन्थ् स॑मु॒द्रादु॒त वा॒ पुरी॑षात्।"
        },
        {
          "id": "ts-4-2-8-4",
          "chunkNumber": 4,
          "sanskrit": "श्ये॒नस्य॑ प॒ख्षा ह॑रि॒णस्य॑ बा॒हू उप॑स्तुत॒ञ्जनि॑म॒ तत् ते॑ अर्वन्न्॥"
        },
        {
          "id": "ts-4-2-8-5",
          "chunkNumber": 5,
          "sanskrit": "अ॒पाम्पृ॒ष्ठम॑सि॒ योनि॑र॒ग्नेः स॑मु॒द्रम॒भितः॒ पिन्व॑मानम्।"
