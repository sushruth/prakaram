        {
          "id": "ts-4-2-6-7",
          "chunkNumber": 7,
          "sanskrit": "ओष॑धी॒रिति॑ मातर॒स्तद् वो॑ देवी॒रुप॑ ब्रुवे।"
        },
        {
          "id": "ts-4-2-6-8",
          "chunkNumber": 8,
          "sanskrit": "रपा॑ꣳसि विघ्न॒तीरि॑त॒ रप॑ ओष॑धयः॒ सोम॑राज्ञीः॒ प्रवि॑ष्टाः पृथि॒वीमनु॑।"
        },
        {
          "id": "ts-4-2-6-9",
          "chunkNumber": 9,
          "sanskrit": "तासा॒न्त्वम॑स्युत्त॒मा प्र णो॑ जी॒वात॑वे सुव॥"
