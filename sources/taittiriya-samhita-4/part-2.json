          "sanskrit": "प्र॒स्थाव॑द्रथ॒वाह॑नम्॥"
        },
        {
          "id": "ts-4-2-5-20",
          "chunkNumber": 20,
          "sanskrit": "शु॒नन्नः॒ फाला॒ वि तु॑दन्तु॒ भूमि॑ꣳ शु॒नङ्की॒नाशा॑ अ॒भि य॑न्तु वा॒हान्।"
        },
        {
          "id": "ts-4-2-5-21",
          "chunkNumber": 21,
          "sanskrit": "शु॒नम्प॒र्जन्यो॒ मधु॑ना॒ पयो॑भिः॒ शुना॑सीरा शु॒नम॒स्मासु॑ धत्तम्॥"
        },
        {
          "id": "ts-4-2-5-22",
          "chunkNumber": 22,
          "sanskrit": "काम॑ङ्कामदुघे धुख्ष्व मि॒त्राय॒ वरु॑णाय च।"
        },
        {
          "id": "ts-4-2-5-23",
          "chunkNumber": 23,
          "sanskrit": "इन्द्रा॑या॒ग्नये॑ पू॒ष्ण ओष॑धीभ्यः प्र॒जाभ्यः॑॥"
        },
        {
          "id": "ts-4-2-5-24",
          "chunkNumber": 24,
          "sanskrit": "घृ॒तेन॒ सीता॒ मधु॑ना॒ सम॑क्ता॒ विश्वै᳚र् दे॒वैरनु॑मता म॒रुद्भिः॑।"
        },
        {
          "id": "ts-4-2-5-25",
          "chunkNumber": 25,
          "sanskrit": "ऊर्ज॑स्वती॒ पय॑सा॒ पिन्व॑माना॒ऽस्मान्थ् सी॑ते॒ पय॑सा॒ऽ भ्याव॑वृथ्स्व"
        }
      ]
    },
    {
