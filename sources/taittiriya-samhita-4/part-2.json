{
  "sections": [
    {
      "id": "taittiriya-samhita-4-2-1",
      "title": "Kāṇḍa 4 · Prapāṭhaka 2 · Anuvāka 1",
      "sectionNumber": 12,
      "chunks": [
        {
          "id": "ts-4-2-1-1",
          "chunkNumber": 1,
          "sanskrit": "viṣṇoḥ̠ kramo̎'syabhimāti̠hā gā̍ya̠trañchanda̠ ā ro̍ha pṛthi̠vīmanu̠ vi kra̍masva̠ nirbha̍ktaḥ̠ sa yandvi̠ṣmo viṣṇoḥ̠ kramo̎'syabhiśasti̠hā traiṣṭu̍bha̠ñchanda̠ ā ro̍hā̠ntari̍khṣa̠manu̠ vi kra̍masva̠ nirbha̍ktaḥ̠ sa yaṃ dvi̠ṣmo viṣṇoḥ̠ kramo̎'syarātīya̠to ha̠ntā jāga̍ta̠ñchanda̠ ā ro̍ha̠ diva̠manu̠ vi kra̍masva̠ nirbha̍ktaḥ̠ sa yaṃ dvi̠ṣmo viṣṇoḥ̠ kramo̍'si śatrūya̠to ha̠ntā''nu̍ṣṭubha̠ñchanda̠ ā ro̍ha̠ diśo'nu̠ vi kra̍masva̠ nirbha̍ktaḥ̠ sa yandvi̠ṣmaḥ||",
          "section": 1
        },
        {
          "id": "ts-4-2-1-2",
          "chunkNumber": 2,
          "sanskrit": "akra̍ndada̠gniḥ sta̠naya̍nniva̠ dyauḥ khṣāmā̠ reri̍hadvī̠rudhaḥ̍ sama̠ñjann|"
        },
        {
          "id": "ts-4-2-1-3",
          "chunkNumber": 3,
          "sanskrit": "sa̠dyo ja̍jñā̠no vi hīmi̠ddho akhya̠dā roda̍sī bhā̠nunā̍ bhātya̠ntaḥ||"
        },
        {
          "id": "ts-4-2-1-4",
          "chunkNumber": 4,
          "sanskrit": "agne̎'bhyāvartinna̠bhi na̠ ā va̍rta̠svā''yu̍ṣā̠ varca̍sā sa̠nyā me̠dhayā̎ pra̠jayā̠ dhane̍na||"
        },
        {
          "id": "ts-4-2-1-5",
          "chunkNumber": 5,
          "sanskrit": "agne̍ vm̐vi ma̍ddhya̠magͫͫ śra̍thāya|"
        },
        {
          "id": "ts-4-2-1-6",
          "chunkNumber": 6,
          "sanskrit": "athā̍ va̠yamā̍ditya vra̠te tavānā̍gaso̠ adi̍taye syāma||"
        },
        {
          "id": "ts-4-2-1-7",
          "chunkNumber": 7,
          "sanskrit": "ā tvā̍' hārṣama̠ntara̍bhūr dhru̠vasti̠ṣṭhā'vi̍cācaliḥ|"
        },
        {
          "id": "ts-4-2-1-8",
          "chunkNumber": 8,
          "sanskrit": "viśa̍stvā̠ sarvā̍ vāñchantva̠smin rā̠ṣṭramadhi̍ śraya||"
        },
        {
          "id": "ts-4-2-1-9",
          "chunkNumber": 9,
          "sanskrit": "agre̍ bṛ̠hannu̠ṣasā̍mū̠rddhvo a̍sthānnirjagmi̠vāntama̍so̠ jyoti̠ṣā''*gā̎t|"
        },
        {
          "id": "ts-4-2-1-10",
          "chunkNumber": 10,
          "sanskrit": "a̠gnir bhā̠nunā̠ ruśa̍tā̠ svaṅga̠ ā jā̠to viśvā̠ sadmā̎nyaprāḥ||"
        },
        {
          "id": "ts-4-2-1-11",
          "chunkNumber": 11,
          "sanskrit": "sīda̠ tvammā̠tura̠syā u̠pasthe̠ viśvā̎nyagne va̠yunā̍ni vi̠dvān|"
        },
        {
          "id": "ts-4-2-1-12",
          "chunkNumber": 12,
          "sanskrit": "mainā̍ma̠rciṣā̠ mā tapa̍sā̠'bhi śū̍śuco̠'ntara̍syāgͫ śu̠krajyo̍ti̠r vi bhā̍hi||"
        },
        {
          "id": "ts-4-2-1-13",
          "chunkNumber": 13,
          "sanskrit": "a̠ntara̍gne ru̠cā tvamu̠khāyai̠ sada̍ne̠ sve|"
        },
        {
          "id": "ts-4-2-1-14",
          "chunkNumber": 14,
          "sanskrit": "tasyā̠stvagͫ hara̍sā̠ tapa̠ñjāta̍vedaḥ śi̠vo bha̍va||"
        },
        {
          "id": "ts-4-2-1-15",
          "chunkNumber": 15,
          "sanskrit": "śi̠vo bhū̠tvā mahya̍ma̠gne'tho̍ sīda śi̠vastvam|"
        },
        {
          "id": "ts-4-2-1-16",
          "chunkNumber": 16,
          "sanskrit": "śi̠vāḥ kṛ̠tvā diśaḥ̠ sarvāḥ̠ svāym̐yoni̍mi̠hā''sa̍daḥ||"
        },
        {
          "id": "ts-4-2-1-17",
          "chunkNumber": 17,
          "sanskrit": "ha̠g̠ͫsaḥ śu̍ci̠ṣad vasu̍rantarikhṣa̠saddhotā̍ vedi̠ṣadati̍thir duroṇa̠sat|"
        },
        {
          "id": "ts-4-2-1-18",
          "chunkNumber": 18,
          "sanskrit": "nṛ̠ṣadva̍ra̠sad ṛ̍ta̠sad vyo̍ma̠sada̠bjā go̠jā ṛ̍ta̠jā a̍dri̠jā ṛ̠tambṛ̠hat"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-2-2",
      "title": "Kāṇḍa 4 · Prapāṭhaka 2 · Anuvāka 2",
      "sectionNumber": 13,
      "chunks": [
        {
          "id": "ts-4-2-2-1",
          "chunkNumber": 1,
          "sanskrit": "di̠vaspari̍ pratha̠mañja̍jñe a̠gnira̠smad dvi̠tīya̠mpari̍ jā̠tave̍dāḥ|",
          "section": 2
        },
        {
          "id": "ts-4-2-2-2",
          "chunkNumber": 2,
          "sanskrit": "tṛ̠tīya̍ma̠phsu nṛ̠maṇā̠ aja̍sra̠mindhā̍na enañjarate svā̠dhīḥ||"
        },
        {
          "id": "ts-4-2-2-3",
          "chunkNumber": 3,
          "sanskrit": "vi̠dmā te̍ agne tre̠dhā tra̠yāṇi̍ vi̠dmā te̠ sadma̠ vibhṛ̍tampuru̠trā|"
        },
        {
          "id": "ts-4-2-2-4",
          "chunkNumber": 4,
          "sanskrit": "vi̠dmā te̠ nāma̍ para̠maṅguhā̠ yadvi̠dmā tamuthsa̠ym̐yata̍ āja̠gantha̍||"
        },
        {
          "id": "ts-4-2-2-5",
          "chunkNumber": 5,
          "sanskrit": "sa̠mu̠dre tvā̍ nṛ̠maṇā̍ a̠phsva̍ntar nṛ̠cakhṣā̍ īdhe di̠vo a̍gna̠ ūdha̍n|"
        },
        {
          "id": "ts-4-2-2-6",
          "chunkNumber": 6,
          "sanskrit": "tṛ̠tīye̎ tvā̠ raja̍si tasthi̠vāgͫsa̍mṛ̠tasya̠ yonau̍ mahi̠ṣā a̍hinvann||"
        },
        {
          "id": "ts-4-2-2-7",
          "chunkNumber": 7,
          "sanskrit": "akra̍ndada̠gniḥ sta̠naya̍nniva̠ dyauḥ khṣāmā̠ reri̍hadvī̠rudhaḥ̍ sama̠ñjann|"
        },
        {
          "id": "ts-4-2-2-8",
          "chunkNumber": 8,
          "sanskrit": "sa̠dyo ja̍jñā̠no vi hīmi̠ddho akhya̠dā roda̍sī bhā̠nunā̍ bhātya̠ntaḥ||"
        },
        {
          "id": "ts-4-2-2-9",
          "chunkNumber": 9,
          "sanskrit": "u̠śik pā̍va̠ko a̍ra̠tiḥ su̍me̠dhā marte̎ṣva̠gnira̠mṛto̠ ni dhā̍yi|"
        },
        {
          "id": "ts-4-2-2-10",
          "chunkNumber": 10,
          "sanskrit": "iya̍rti dhū̠mama̍ru̠ṣambhari̍bhra̠ducchu̠kreṇa̍ śo̠ciṣā̠ dyāmina̍khṣat||"
        },
        {
          "id": "ts-4-2-2-11",
          "chunkNumber": 11,
          "sanskrit": "viśva̍sya ke̠tur bhuva̍nasya̠ garbha̠ ā roda̍sī apṛṇā̠jjāya̍mānaḥ|"
        },
        {
          "id": "ts-4-2-2-12",
          "chunkNumber": 12,
          "sanskrit": "vī̠ḍuñci̠dadri̍mabhinat parā̠yan janā̠ yada̠gnimaya̍janta̠ pañca̍||"
        },
        {
          "id": "ts-4-2-2-13",
          "chunkNumber": 13,
          "sanskrit": "śrī̠ṇāmu̍dā̠ro dha̠ruṇo̍ rayī̠ṇāmma̍nī̠ṣāṇā̠mprārpa̍ṇaḥ̠ soma̍gopāḥ|"
        },
        {
          "id": "ts-4-2-2-14",
          "chunkNumber": 14,
          "sanskrit": "vasoḥ̎ sū̠nuḥ saha̍so a̠phsu rājā̠ vi bhā̠tyagra̍ u̠ṣasā̍midhā̠naḥ||"
        },
        {
          "id": "ts-4-2-2-15",
          "chunkNumber": 15,
          "sanskrit": "yaste̍ a̠dya kṛ̠ṇava̍dbhadraśoce'pū̠pande̍va ghṛ̠tava̍ntamagne|"
        },
        {
          "id": "ts-4-2-2-16",
          "chunkNumber": 16,
          "sanskrit": "pra tanna̍ya prata̠rāvm̐vasyo̠ acchā̠bhi dyu̠mnande̠vabha̍ktaym̐yaviṣṭha||"
        },
        {
          "id": "ts-4-2-2-17",
          "chunkNumber": 17,
          "sanskrit": "ā"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-2-3",
      "title": "Kāṇḍa 4 · Prapāṭhaka 2 · Anuvāka 3",
      "sectionNumber": 14,
      "chunks": [
        {
          "id": "ts-4-2-3-1",
          "chunkNumber": 1,
          "sanskrit": "anna̍pa̠te'nna̍sya no dehyanamī̠vasya̍ śu̠ṣmiṇaḥ̍|",
          "section": 3
        },
        {
          "id": "ts-4-2-3-2",
          "chunkNumber": 2,
          "sanskrit": "pra pra̍dā̠tāra̍ntāriṣa̠ ūrja̍nno dhehi dvi̠pade̠ catu̍ṣpade||"
        },
        {
          "id": "ts-4-2-3-3",
          "chunkNumber": 3,
          "sanskrit": "udu̍ tvā̠ viśve̍ de̠vā agne̠ bhara̍ntu̠ citti̍bhiḥ|"
        },
        {
          "id": "ts-4-2-3-4",
          "chunkNumber": 4,
          "sanskrit": "sa no̍ bhava śi̠vata̍maḥ su̠pratī̍ko vi̠bhāva̍suḥ||"
        },
        {
          "id": "ts-4-2-3-5",
          "chunkNumber": 5,
          "sanskrit": "preda̍gne̠ jyoti̍ṣmānyāhi śi̠vebhi̍ra̠rcibhi̠stvam|"
        },
        {
          "id": "ts-4-2-3-6",
          "chunkNumber": 6,
          "sanskrit": "bṛ̠hadbhi̍rbhā̠nubhi̠rbhāsa̠n mā hi̍gͫsī sta̠nuvā̎ pra̠jāḥ||"
        },
        {
          "id": "ts-4-2-3-7",
          "chunkNumber": 7,
          "sanskrit": "sa̠midhā̠'gnindu̍vasyata ghṛ̠tair bo̍dhaya̠tāti̍thim|"
        },
        {
          "id": "ts-4-2-3-8",
          "chunkNumber": 8,
          "sanskrit": "ā sauṣa̍dhī̠ranu̍ ruddhyase|"
        },
        {
          "id": "ts-4-2-3-9",
          "chunkNumber": 9,
          "sanskrit": "garbhe̠ sañjā̍yase̠ punaḥ̍||"
        },
        {
          "id": "ts-4-2-3-10",
          "chunkNumber": 10,
          "sanskrit": "garbho̍ a̠syoṣa̍dhīnā̠ṅgarbho̠ vana̠spatī̍nām|"
        },
        {
          "id": "ts-4-2-3-11",
          "chunkNumber": 11,
          "sanskrit": "garbho̠ viśva̍sya bhū̠tasyāgne̠ garbho̍ a̠pāma̍si||"
        },
        {
          "id": "ts-4-2-3-12",
          "chunkNumber": 12,
          "sanskrit": "pra̠sadya̠ bhasma̍nā̠ yoni̍ma̠paśca̍ pṛthi̠vīma̍gne|"
        },
        {
          "id": "ts-4-2-3-13",
          "chunkNumber": 13,
          "sanskrit": "sa̠g̠ͫsṛjya̍ mā̠tṛbhi̠stvañjyoti̍ṣmā̠n puna̠rā'sa̍daḥ||"
        },
        {
          "id": "ts-4-2-3-14",
          "chunkNumber": 14,
          "sanskrit": "puna̍rā̠sadya̠ sada̍nama̠paśca̍ pṛthi̠vīma̍gne|"
        },
        {
          "id": "ts-4-2-3-15",
          "chunkNumber": 15,
          "sanskrit": "śeṣe̍ mā̠tur yatho̠pasthe̠'ntara̠syāgͫ śi̠vata̍maḥ||"
        },
        {
          "id": "ts-4-2-3-16",
          "chunkNumber": 16,
          "sanskrit": "puna̍rū̠rjā ni va̍rtasva̠ puna̍ragna i̠ṣā''yu̍ṣā|"
        },
        {
          "id": "ts-4-2-3-17",
          "chunkNumber": 17,
          "sanskrit": "puna̍r naḥ pāhi vi̠śvataḥ̍||"
        },
        {
          "id": "ts-4-2-3-18",
          "chunkNumber": 18,
          "sanskrit": "sa̠ha ra̠yyā ni va̍rta̠svāgne̠ pinva̍sva̠ dhāra̍yā|"
        },
        {
          "id": "ts-4-2-3-19",
          "chunkNumber": 19,
          "sanskrit": "vi̠śvaphsni̍yā vi̠śvata̠spari̍||"
        },
        {
          "id": "ts-4-2-3-20",
          "chunkNumber": 20,
          "sanskrit": "puna̍stvā''di̠tyā ru̠drā vasa̍vaḥ̠ sami̍ndhatāṃ̠ puna̍r bra̠hmāṇo̍ vasunītha ya̠jñaiḥ|"
        },
        {
          "id": "ts-4-2-3-21",
          "chunkNumber": 21,
          "sanskrit": "ghṛ̠tena̠ tvanta̠nuvo̍ varddhayasva sa̠tyāḥ sa̍ntu̠ yaja̍mānasya̠ kāmāḥ̎||"
        },
        {
          "id": "ts-4-2-3-22",
          "chunkNumber": 22,
          "sanskrit": "bodhā̍ no a̠sya vaca̍so yaviṣṭha̠ magͫhi̍ṣṭhasya̠ prabhṛ̍tasya svadhāvaḥ|"
        },
        {
          "id": "ts-4-2-3-23",
          "chunkNumber": 23,
          "sanskrit": "pīya̍ti tvo̠ anu̍ tvo gṛṇāti va̠ndāru̍ste ta̠nuva̍vm̐vande agne||"
        },
        {
          "id": "ts-4-2-3-24",
          "chunkNumber": 24,
          "sanskrit": "sa bo̍dhi sū̠rir ma̠ghavā̍ vasu̠dāvā̠ vasu̍patiḥ|"
        },
        {
          "id": "ts-4-2-3-25",
          "chunkNumber": 25,
          "sanskrit": "yu̠yo̠ddhya̍smad dveṣā̍gͫsi"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-2-4",
      "title": "Kāṇḍa 4 · Prapāṭhaka 2 · Anuvāka 4",
      "sectionNumber": 15,
      "chunks": [
        {
          "id": "ts-4-2-4-1",
          "chunkNumber": 1,
          "sanskrit": "ape̍ta̠ vīta̠ vi ca̍ sarpa̠tāto̠ ye'tra̠ stha pu̍rā̠ṇā ye ca̠ nūta̍nāḥ|",
          "section": 4
        },
        {
          "id": "ts-4-2-4-2",
          "chunkNumber": 2,
          "sanskrit": "adā̍di̠daym̐ya̠mo̍'va̠sāna̍mpṛthi̠vyā akra̍nni̠mampi̠taro̍ lo̠kama̍smai||"
        },
        {
          "id": "ts-4-2-4-3",
          "chunkNumber": 3,
          "sanskrit": "a̠gner bhasmā̎sya̠gneḥ purī̍ṣamasi saṃ̠jñāna̍masi kāma̠dhara̍ṇa̠mmayi̍ te kāma̠dhara̍ṇambhūyāt||"
        },
        {
          "id": "ts-4-2-4-4",
          "chunkNumber": 4,
          "sanskrit": "saym̐yā vaḥ̍ pri̠yāsta̠nuvaḥ̠ sampri̠yā hṛda̍yāni vaḥ|"
        },
        {
          "id": "ts-4-2-4-5",
          "chunkNumber": 5,
          "sanskrit": "ā̠tmā vo̍ astu̠ saṃpri̍yaḥ̠ saṃpri̍yāsta̠nuvo̠ mama̍||"
        },
        {
          "id": "ts-4-2-4-6",
          "chunkNumber": 6,
          "sanskrit": "a̠yagͫ so a̠gnir yasmi̠nthsoma̠mindraḥ̍ su̠tanda̠dhe ja̠ṭhare̍ vāvaśā̠naḥ|"
        },
        {
          "id": "ts-4-2-4-7",
          "chunkNumber": 7,
          "sanskrit": "sa̠ha̠sriya̠vm̐vāja̠matya̠nna sapti̍gͫ sasa̠vānth santh stū̍yase jātavedaḥ||"
        },
        {
          "id": "ts-4-2-4-8",
          "chunkNumber": 8,
          "sanskrit": "agne̍ di̠vo arṇa̠macchā̍ jigā̠syacchā̍ de̠vāgͫ ū̍ciṣe̠ dhiṣṇi̍yā̠ ye|"
        },
        {
          "id": "ts-4-2-4-9",
          "chunkNumber": 9,
          "sanskrit": "yāḥ pa̠rastā̎droca̠ne sūrya̍sya̠ yāścā̠ vastā̍dupa̠tiṣṭha̍nta̠ āpaḥ̍||"
        },
        {
          "id": "ts-4-2-4-10",
          "chunkNumber": 10,
          "sanskrit": "agne̠ yat te̍ di̠vi varcaḥ̍ pṛthi̠vyāym̐yadoṣa̍dhīṣva̠"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-2-5",
      "title": "Kāṇḍa 4 · Prapāṭhaka 2 · Anuvāka 5",
      "sectionNumber": 16,
      "chunks": [
        {
          "id": "ts-4-2-5-1",
          "chunkNumber": 1,
          "sanskrit": "sami̍ta̠g̠ͫ saṅka̍lpethā̠g̠ͫ saṃpri̍yau roci̠ṣṇū su̍mana̠syamā̍nau|",
          "section": 5
        },
        {
          "id": "ts-4-2-5-2",
          "chunkNumber": 2,
          "sanskrit": "iṣa̠mūrja̍ma̠bhi sa̠vm̐vasā̍nau̠ savm̐vā̠mmanā̍gͫsi̠ savm̐vra̠tā samu̍ ci̠ttānyā'ka̍ram||"
        },
        {
          "id": "ts-4-2-5-3",
          "chunkNumber": 3,
          "sanskrit": "agne̍ purīṣyādhi̠pā bha̍vā̠ tvannaḥ̍|"
        },
        {
          "id": "ts-4-2-5-4",
          "chunkNumber": 4,
          "sanskrit": "iṣa̠mūrja̠ym̐yaja̍mānāya dhehi||"
        },
        {
          "id": "ts-4-2-5-5",
          "chunkNumber": 5,
          "sanskrit": "pu̠rī̠ṣya̍stvama̍gne rayi̠mān pu̍ṣṭi̠māgͫ a̍si|"
        },
        {
          "id": "ts-4-2-5-6",
          "chunkNumber": 6,
          "sanskrit": "śi̠vāḥ kṛ̠tvā diśaḥ̠ sarvāḥ̠ svāym̐yoni̍mi̠hā'sa̍daḥ||"
        },
        {
          "id": "ts-4-2-5-7",
          "chunkNumber": 7,
          "sanskrit": "bhava̍tannaḥ̠ sama̍nasau̠ samo̍kasā śacī̍bhiḥ|"
        },
        {
          "id": "ts-4-2-5-8",
          "chunkNumber": 8,
          "sanskrit": "de̠va i̍va savi̠tā sa̠tyadha̠rmendro̠ na ta̍sthau sama̠re pa̍thī̠nām||"
        },
        {
          "id": "ts-4-2-5-9",
          "chunkNumber": 9,
          "sanskrit": "savm̐va̍ra̠trā da̍dhātana̠ nirā̍hā̠vān kṛ̍ṇotana|"
        },
        {
          "id": "ts-4-2-5-10",
          "chunkNumber": 10,
          "sanskrit": "si̠ñcāma̍hā ava̠ṭamu̠driṇa̍vm̐va̠yavm̐viśvā'hā'da̍sta̠makhṣi̍tam||"
        },
        {
          "id": "ts-4-2-5-11",
          "chunkNumber": 11,
          "sanskrit": "niṣkṛ̍tāhāvamava̠ṭagͫ su̍vara̠tragͫ su̍ṣeca̠nam|"
        },
        {
          "id": "ts-4-2-5-12",
          "chunkNumber": 12,
          "sanskrit": "u̠driṇa̍gͫ siñce̠ akhṣi̍tam||"
        },
        {
          "id": "ts-4-2-5-13",
          "chunkNumber": 13,
          "sanskrit": "sīrā̍ yuñjanti ka̠vayo̍ yu̠gā vi ta̍nvate̠ pṛtha̍k|"
        },
        {
          "id": "ts-4-2-5-14",
          "chunkNumber": 14,
          "sanskrit": "dhīrā̍ de̠veṣu̍ sumna̠yā||"
        },
        {
          "id": "ts-4-2-5-15",
          "chunkNumber": 15,
          "sanskrit": "yu̠nakta̠ sīrā̠ vi yu̠gā ta̍nota kṛ̠te yonau̍ vapate̠ha bīja̎m|"
        },
        {
          "id": "ts-4-2-5-16",
          "chunkNumber": 16,
          "sanskrit": "gi̠rā ca̍ śru̠ṣṭiḥ sabha̍rā̠ asa̍nno̠ nedī̍ya̠ ith sṛ̠ṇyā̍ pa̠kvamā'ya̍t||"
        },
        {
          "id": "ts-4-2-5-17",
          "chunkNumber": 17,
          "sanskrit": "lāṅga̍la̠mpavī̍ravagͫ su̠śeva̍gͫ suma̠tithsa̍ru|"
        },
        {
          "id": "ts-4-2-5-18",
          "chunkNumber": 18,
          "sanskrit": "udit kṛ̍ṣati̠ gāmavi̍mprapha̠rvya̍ñca̠ pīva̍rīm|"
        },
        {
          "id": "ts-4-2-5-19",
          "chunkNumber": 19,
          "sanskrit": "pra̠sthāva̍dratha̠vāha̍nam||"
        },
        {
          "id": "ts-4-2-5-20",
          "chunkNumber": 20,
          "sanskrit": "śu̠nannaḥ̠ phālā̠ vi tu̍dantu̠ bhūmi̍gͫ śu̠naṅkī̠nāśā̍ a̠bhi ya̍ntu vā̠hān|"
        },
        {
          "id": "ts-4-2-5-21",
          "chunkNumber": 21,
          "sanskrit": "śu̠nampa̠rjanyo̠ madhu̍nā̠ payo̍bhiḥ̠ śunā̍sīrā śu̠nama̠smāsu̍ dhattam||"
        },
        {
          "id": "ts-4-2-5-22",
          "chunkNumber": 22,
          "sanskrit": "kāma̍ṅkāmadughe dhukhṣva mi̠trāya̠ varu̍ṇāya ca|"
        },
        {
          "id": "ts-4-2-5-23",
          "chunkNumber": 23,
          "sanskrit": "indrā̍yā̠gnaye̍ pū̠ṣṇa oṣa̍dhībhyaḥ pra̠jābhyaḥ̍||"
        },
        {
          "id": "ts-4-2-5-24",
          "chunkNumber": 24,
          "sanskrit": "ghṛ̠tena̠ sītā̠ madhu̍nā̠ sama̍ktā̠ viśvai̎r de̠vairanu̍matā ma̠rudbhiḥ̍|"
        },
        {
          "id": "ts-4-2-5-25",
          "chunkNumber": 25,
          "sanskrit": "ūrja̍svatī̠ paya̍sā̠ pinva̍mānā̠'smānth sī̍te̠ paya̍sā̠' bhyāva̍vṛthsva"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-2-6",
      "title": "Kāṇḍa 4 · Prapāṭhaka 2 · Anuvāka 6",
      "sectionNumber": 17,
      "chunks": [
        {
          "id": "ts-4-2-6-1",
          "chunkNumber": 1,
          "sanskrit": "yā jā̠tā oṣa̍dhayo de̠vebhya̍striyu̠gampu̠rā|",
          "section": 6
        },
        {
          "id": "ts-4-2-6-2",
          "chunkNumber": 2,
          "sanskrit": "mandā̍mi ba̠bhrūṇā̍ma̠hagͫ śa̠tandhāmā̍ni sa̠pta ca̍||"
        },
        {
          "id": "ts-4-2-6-3",
          "chunkNumber": 3,
          "sanskrit": "śa̠tavm̐vo̍ aṃba̠ dhāmā̍ni sa̠hasra̍mu̠ta vo̠ ruhaḥ̍|"
        },
        {
          "id": "ts-4-2-6-4",
          "chunkNumber": 4,
          "sanskrit": "athā̍ śatakratvo yū̠yami̠mamme̍ aga̠daṅkṛ̍ta||"
        },
        {
          "id": "ts-4-2-6-5",
          "chunkNumber": 5,
          "sanskrit": "puṣpā̍vatīḥ pra̠sūva̍tīḥ pha̠linī̍rapha̠lā u̠ta|"
        },
        {
          "id": "ts-4-2-6-6",
          "chunkNumber": 6,
          "sanskrit": "aśvā̍ iva sa̠jitva̍rīr vī̠rudhaḥ̍ pārayi̠ṣṇavaḥ̍||"
        },
        {
          "id": "ts-4-2-6-7",
          "chunkNumber": 7,
          "sanskrit": "oṣa̍dhī̠riti̍ mātara̠stad vo̍ devī̠rupa̍ bruve|"
        },
        {
          "id": "ts-4-2-6-8",
          "chunkNumber": 8,
          "sanskrit": "rapā̍gͫsi vighna̠tīri̍ta̠ rapa̍ oṣa̍dhayaḥ̠ soma̍rājñīḥ̠ pravi̍ṣṭāḥ pṛthi̠vīmanu̍|"
        },
        {
          "id": "ts-4-2-6-9",
          "chunkNumber": 9,
          "sanskrit": "tāsā̠ntvama̍syutta̠mā pra ṇo̍ jī̠vāta̍ve suva||"
        },
        {
          "id": "ts-4-2-6-10",
          "chunkNumber": 10,
          "sanskrit": "a̠va̠pata̍ntīravadan di̠va oṣa̍dayaḥ̠ pari̍|"
        },
        {
          "id": "ts-4-2-6-11",
          "chunkNumber": 11,
          "sanskrit": "yañjī̠vama̠śñavā̍mahai̠ na sa ri̍ṣyāti̠ pūru̍ṣaḥ||"
        },
        {
          "id": "ts-4-2-6-12",
          "chunkNumber": 12,
          "sanskrit": "yāśce̠damu̍paśṛ̠ṇvanti̠ yāśca̍ dū̠ramparā̍gatāḥ|"
        },
        {
          "id": "ts-4-2-6-13",
          "chunkNumber": 13,
          "sanskrit": "i̠ha sa̠ṅgatya̠ tāḥ sarvā̍ a̠smai sanda̍tta bheṣa̠jam||"
        },
        {
          "id": "ts-4-2-6-14",
          "chunkNumber": 14,
          "sanskrit": "mā vo̍ riṣat khani̠tā yasmai̍ cā̠haṅkhanā̍mi vaḥ|"
        },
        {
          "id": "ts-4-2-6-15",
          "chunkNumber": 15,
          "sanskrit": "dvi̠paccatu̍ṣpada̠smāka̠g̠ͫ sarva̍ma̠stvanā̍turam||"
        },
        {
          "id": "ts-4-2-6-16",
          "chunkNumber": 16,
          "sanskrit": "oṣa̍dhayaḥ̠ savm̐va̍dante̠ some̍na sa̠ha rājñā̎|"
        },
        {
          "id": "ts-4-2-6-17",
          "chunkNumber": 17,
          "sanskrit": "yasmai̍ ka̠roti̍ brāhma̠ṇastagͫ rā̍jan pārayāmasi"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-2-7",
      "title": "Kāṇḍa 4 · Prapāṭhaka 2 · Anuvāka 7",
      "sectionNumber": 18,
      "chunks": [
        {
          "id": "ts-4-2-7-1",
          "chunkNumber": 1,
          "sanskrit": "mā no̍ higͫsījjani̠tā yaḥ pṛ̍thi̠vyā yo vā̠ diva̍gͫ sa̠tyadha̍rmā ja̠jāna̍|",
          "section": 7
        },
        {
          "id": "ts-4-2-7-2",
          "chunkNumber": 2,
          "sanskrit": "yaścā̠paśca̠ndrā bṛ̍ha̠tīrja̠jāna̠ kasmai̍ de̠vāya̍ ha̠viṣā̍ vidhema||"
        },
        {
          "id": "ts-4-2-7-3",
          "chunkNumber": 3,
          "sanskrit": "a̠bhyāva̍rtasva pṛthivi ya̠jñena̠ paya̍sā sa̠ha|"
        },
        {
          "id": "ts-4-2-7-4",
          "chunkNumber": 4,
          "sanskrit": "va̠pānte̍ a̠gniri̍ṣi̠to'va̍ sarpatu||"
        },
        {
          "id": "ts-4-2-7-5",
          "chunkNumber": 5,
          "sanskrit": "agne̠ yat te̍ śu̠kraym̐yacca̠ndraym̐yat pū̠taym̐yadya̠jñiya̎m|"
        },
        {
          "id": "ts-4-2-7-6",
          "chunkNumber": 6,
          "sanskrit": "tadde̠vebhyo̍ bharāmasi||"
        },
        {
          "id": "ts-4-2-7-7",
          "chunkNumber": 7,
          "sanskrit": "iṣa̠mūrja̍ma̠hami̠ta ā dhī̠tibhi̍r hi̠taḥ|"
        },
        {
          "id": "ts-4-2-7-8",
          "chunkNumber": 8,
          "sanskrit": "tve iṣaḥ̠ sanda̍dhu̠r bhūri̍retasaści̠trota̍yo vā̠majā̍tāḥ||"
        },
        {
          "id": "ts-4-2-7-9",
          "chunkNumber": 9,
          "sanskrit": "pā̠va̠kava̍rcāḥ śu̠krava̍rcā̠ anū̍navarcā̠ udi̍yarṣi bhā̠nunā̎|"
        },
        {
          "id": "ts-4-2-7-10",
          "chunkNumber": 10,
          "sanskrit": "pu̠traḥ pi̠tarā̍ vi̠cara̠nnupā̍vasyu̠bhe pṛ̍ṇakhṣi̠ roda̍sī||"
        },
        {
          "id": "ts-4-2-7-11",
          "chunkNumber": 11,
          "sanskrit": "ṛ̠tāvā̍nammahi̠ṣavm̐vi̠śvaca̍rṣaṇima̠gnigͫ su̠mnāya̍ dadhire pu̠ro janāḥ̎|"
        },
        {
          "id": "ts-4-2-7-12",
          "chunkNumber": 12,
          "sanskrit": "śrutka̍rṇagͫ sa̠pratha̍stamantvā gi̠rā daivya̠mmānu̍ṣā yu̠gā||"
        },
        {
          "id": "ts-4-2-7-13",
          "chunkNumber": 13,
          "sanskrit": "ni̠ṣka̠rtāra̍maddhva̠rasya̠ prace̍tasa̠ṅkhṣaya̍nta̠g̠ͫ rādha̍se ma̠he|"
        },
        {
          "id": "ts-4-2-7-14",
          "chunkNumber": 14,
          "sanskrit": "rā̠timbhṛgū̍ṇāmu̠śija̍ṅka̠vikra̍tumpṛ̠ṇakhṣi̍ sāna̠sigͫ ra̠yim||"
        },
        {
          "id": "ts-4-2-7-15",
          "chunkNumber": 15,
          "sanskrit": "citaḥ̍ stha pari̠cita̍ ūrddhva̠citaḥ̍ śrayaddhva̠ntayā̍ de̠vata̍yā'ṅgira̠svad dhru̠vāḥ sī̍data||"
        },
        {
          "id": "ts-4-2-7-16",
          "chunkNumber": 16,
          "sanskrit": "ā pyā̍yasva̠ same̍tu te vi̠śvataḥ̍ soma̠ vṛṣṇi̍yam|"
        },
        {
          "id": "ts-4-2-7-17",
          "chunkNumber": 17,
          "sanskrit": "bhavā̠ vāja̍sya saṅga̠the||"
        },
        {
          "id": "ts-4-2-7-18",
          "chunkNumber": 18,
          "sanskrit": "sante̠ payā̍gͫsi̠ samu̍ yantu̠ vājāḥ̠ savm̐vṛṣṇi̍yānyabhimāti̠ṣāhaḥ̍|"
        },
        {
          "id": "ts-4-2-7-19",
          "chunkNumber": 19,
          "sanskrit": "ā̠pyāya̍māno a̠mṛtā̍ya soma di̠vi śravā̍gͫͫsyutta̠māni̍ dhiṣva"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-2-8",
      "title": "Kāṇḍa 4 · Prapāṭhaka 2 · Anuvāka 8",
      "sectionNumber": 19,
      "chunks": [
        {
          "id": "ts-4-2-8-1",
          "chunkNumber": 1,
          "sanskrit": "a̠bhya̍sthā̠dviśvāḥ̠ pṛta̍nā̠ arā̍tī̠stada̠gnirā̍ha̠ tadu̠ soma̍ āha|",
          "section": 8
        },
        {
          "id": "ts-4-2-8-2",
          "chunkNumber": 2,
          "sanskrit": "bṛha̠spatiḥ̍ savi̠tā tanma̍ āha pū̠ṣā mā̍'dhāth sukṛ̠tasya̍ lo̠ke||"
        },
        {
          "id": "ts-4-2-8-3",
          "chunkNumber": 3,
          "sanskrit": "yadakra̍ndaḥ pratha̠mañjāya̍māna u̠dyanth sa̍mu̠drādu̠ta vā̠ purī̍ṣāt|"
        },
        {
          "id": "ts-4-2-8-4",
          "chunkNumber": 4,
          "sanskrit": "śye̠nasya̍ pa̠khṣā ha̍ri̠ṇasya̍ bā̠hū upa̍stuta̠ñjani̍ma̠ tat te̍ arvann||"
        },
        {
          "id": "ts-4-2-8-5",
          "chunkNumber": 5,
          "sanskrit": "a̠pāmpṛ̠ṣṭhama̍si̠ yoni̍ra̠gneḥ sa̍mu̠drama̠bhitaḥ̠ pinva̍mānam|"
        },
        {
          "id": "ts-4-2-8-6",
          "chunkNumber": 6,
          "sanskrit": "varddha̍mānamma̠ha ā ca̠ puṣka̍randi̠vo mātra̍yā vari̠ṇā pra̍thasva||"
        },
        {
          "id": "ts-4-2-8-7",
          "chunkNumber": 7,
          "sanskrit": "brahma̍ jajñā̠nampra̍tha̠mampu̠rastā̠d vi sī̍ma̠taḥ su̠ruco̍ ve̠na ā̍vaḥ|"
        },
        {
          "id": "ts-4-2-8-8",
          "chunkNumber": 8,
          "sanskrit": "sa bu̠ddhniyā̍ upa̠mā a̍sya vi̠ṣṭhāḥ sa̠taśca̠ yoni̠masa̍taśca̠ vivaḥ̍||"
        },
        {
          "id": "ts-4-2-8-9",
          "chunkNumber": 9,
          "sanskrit": "hi̠ra̠ṇya̠ga̠rbhaḥ sama̍varta̠tāgre̍ bhū̠tasya̍ jā̠taḥ pati̠reka̍ āsīt|"
        },
        {
          "id": "ts-4-2-8-10",
          "chunkNumber": 10,
          "sanskrit": "sa dā̍dhāra pṛthi̠vīndyāmu̠temāṅkasmai̍ de̠vāya̍ ha̠viṣā̍ vidhema||"
        },
        {
          "id": "ts-4-2-8-11",
          "chunkNumber": 11,
          "sanskrit": "dra̠phssaśca̍skanda pṛthi̠vīmanu̠ dyāmi̠mañca̠ yoni̠manu̠ yaśca̠ pūrvaḥ̍|"
        },
        {
          "id": "ts-4-2-8-12",
          "chunkNumber": 12,
          "sanskrit": "tṛ̠tīya̠ym̐yoni̠manu̍ sa̠ñcara̍ntandra̠phssañju̍ho̠myanu̍ sa̠pta hotrāḥ̎||"
        },
        {
          "id": "ts-4-2-8-13",
          "chunkNumber": 13,
          "sanskrit": "namo̍ astu sa̠rpebhyo̠ ye ke ca̍ pṛthi̠vīmanu̍|"
        },
        {
          "id": "ts-4-2-8-14",
          "chunkNumber": 14,
          "sanskrit": "ye a̠ntari̍khṣe̠ ye di̠vi tebhyaḥ̍ sa̠rpebhyo̠ namaḥ̍||"
        },
        {
          "id": "ts-4-2-8-15",
          "chunkNumber": 15,
          "sanskrit": "ye̍'do ro̍ca̠ne di̠vo ye vā̠ sūrya̍sya ra̠śmiṣu̍|"
        },
        {
          "id": "ts-4-2-8-16",
          "chunkNumber": 16,
          "sanskrit": "yeṣā̍ma̠phsu sadaḥ̍ kṛ̠tantebhyaḥ̍ sa̠rpebhyo̠ namaḥ̍||"
        },
        {
          "id": "ts-4-2-8-17",
          "chunkNumber": 17,
          "sanskrit": "yā iṣa̍vo yātu̠dhānā̍nā̠ym̐ye vā̠ vana̠spatī̠g̠ͫranu̍|"
        },
        {
          "id": "ts-4-2-8-18",
          "chunkNumber": 18,
          "sanskrit": "ye vā̍'va̠ṭeṣu̠ śera̍te̠ tebhyaḥ̍ sa̠rpebhyo̠ namaḥ̍"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-2-9",
      "title": "Kāṇḍa 4 · Prapāṭhaka 2 · Anuvāka 9",
      "sectionNumber": 20,
      "chunks": [
        {
          "id": "ts-4-2-9-1",
          "chunkNumber": 1,
          "sanskrit": "dhru̠vā'si̍ dha̠ruṇā'stṛ̍tā vi̠śvaka̍rmaṇā̠ sukṛ̍tā|",
          "section": 9
        },
        {
          "id": "ts-4-2-9-2",
          "chunkNumber": 2,
          "sanskrit": "mā tvā̍ samu̠dra udva̍dhī̠nmā su̍pa̠rṇo'vya̍thamānā pṛthi̠vīndṛ̍gͫha||"
        },
        {
          "id": "ts-4-2-9-3",
          "chunkNumber": 3,
          "sanskrit": "pra̠jāpa̍tistvā sādayatu pṛthi̠vyāḥ pṛ̠ṣṭhe vyaca̍svatī̠mpratha̍svatī̠mpratho̍'si pṛthi̠vya̍si̠ bhūra̍si̠ bhūmi̍ra̠syadi̍tirasi vi̠śvadhā̍yā̠ viśva̍sya̠ bhuva̍nasya dha̠rtrī pṛ̍thi̠vīym̐ya̍ccha pṛthi̠vīndṛ̍gͫha pṛthi̠vīmmā hi̍gͫsī̠r viśva̍smai prā̠ṇāyā̍pā̠nāya̍ vyā̠nāyo̍dā̠nāya̍ prati̠ṣṭhāyai̍ ca̠ritrā̍yā̠gnistvā̠'bhi pā̍tu ma̠hyā sva̠styā cha̠rdiṣā̠ śanta̍mena̠ tayā̍ de̠vata̍yā'ṅgira̠svaddhru̠vā sī̍da||"
        },
        {
          "id": "ts-4-2-9-4",
          "chunkNumber": 4,
          "sanskrit": "kāṇḍā̎tkāṇḍāt pra̠roha̍ntī̠ paru̍ṣaḥparuṣaḥ̠ pari̍|"
        },
        {
          "id": "ts-4-2-9-5",
          "chunkNumber": 5,
          "sanskrit": "e̠vā no̍ dūrve̠ pra ta̍nu sa̠hasre̍ṇa śa̠tena̍ ca||"
        },
        {
          "id": "ts-4-2-9-6",
          "chunkNumber": 6,
          "sanskrit": "yā śa̠tena̍ prata̠noṣi̍ sa̠hasre̍ṇa vi̠roha̍si|"
        },
        {
          "id": "ts-4-2-9-7",
          "chunkNumber": 7,
          "sanskrit": "tasyā̎ste devīṣṭake vi̠dhema̍ ha̠viṣā̍ va̠yam||"
        },
        {
          "id": "ts-4-2-9-8",
          "chunkNumber": 8,
          "sanskrit": "aṣā̍ḍhā'si̠ saha̍mānā̠ saha̠svārā̍tīḥ̠ saha̍svārātīya̠taḥ saha̍sva̠ pṛta̍nāḥ̠ saha̍sva pṛtanya̠taḥ|"
        },
        {
          "id": "ts-4-2-9-9",
          "chunkNumber": 9,
          "sanskrit": "sa̠hasra̍vīryā pa̠dagͫ sadā̍ paśyanti sū̠rayaḥ̍|"
        },
        {
          "id": "ts-4-2-9-10",
          "chunkNumber": 10,
          "sanskrit": "di̠vīva̠ cakhṣu̠rāta̍tam||"
        },
        {
          "id": "ts-4-2-9-11",
          "chunkNumber": 11,
          "sanskrit": "dhru̠vā'si̍ pṛthivi̠ saha̍sva pṛtanya̠taḥ|"
        },
        {
          "id": "ts-4-2-9-12",
          "chunkNumber": 12,
          "sanskrit": "syū̠tā de̠vebhi̍ra̠mṛte̠nā''*gāḥ̎||"
        },
        {
          "id": "ts-4-2-9-13",
          "chunkNumber": 13,
          "sanskrit": "yāste̍ agne̠ sūrye̠ ruca̍ udya̠to diva̍māta̠nvanti̍ ra̠śmibhiḥ̍|"
        },
        {
          "id": "ts-4-2-9-14",
          "chunkNumber": 14,
          "sanskrit": "tābhiḥ̠ sarvā̍bhī ru̠ce janā̍ya na skṛdhi||"
        },
        {
          "id": "ts-4-2-9-15",
          "chunkNumber": 15,
          "sanskrit": "yā vo̍ devāḥ̠ sūrye̠ ruco̠ goṣvaśve̍ṣu̠ yā rucaḥ̍|"
        },
        {
          "id": "ts-4-2-9-16",
          "chunkNumber": 16,
          "sanskrit": "indrā̎gnī̠ tābhiḥ̠ sarvā̍bhī̠ ruca̍nno dhatta bṛhaspate||"
        },
        {
          "id": "ts-4-2-9-17",
          "chunkNumber": 17,
          "sanskrit": "vi̠rāḍ jyoti̍radhārayath sa̠mrāḍ jyoti̍radhārayath sva̠rāḍ jyoti̍radhārayat||"
        },
        {
          "id": "ts-4-2-9-18",
          "chunkNumber": 18,
          "sanskrit": "agne̍ yu̠khṣvā hi ye tavāśvā̍so deva sā̠dhavaḥ̍|"
        },
        {
          "id": "ts-4-2-9-19",
          "chunkNumber": 19,
          "sanskrit": "ara̠vm̐vaha̍ntyā̠śavaḥ̍||"
        },
        {
          "id": "ts-4-2-9-20",
          "chunkNumber": 20,
          "sanskrit": "yu̠khṣvā hi de̍va̠hūta̍mā̠g̠ͫ aśvā̍gͫ agne ra̠thīri̍va|"
        },
        {
          "id": "ts-4-2-9-21",
          "chunkNumber": 21,
          "sanskrit": "ni hotā̍ pū̠rvyaḥ sa̍daḥ||"
        },
        {
          "id": "ts-4-2-9-22",
          "chunkNumber": 22,
          "sanskrit": "dra̠phssaśca̍skanda pṛthi̠vīmanu̠ dyāmi̠mañca̠ yoni̠manu̠ yaśca̠ pūrvaḥ̍|"
        },
        {
          "id": "ts-4-2-9-23",
          "chunkNumber": 23,
          "sanskrit": "tṛ̠tīya̠ym̐yoni̠manu̍ sa̠ñcara̍ntandra̠phssañju̍ho̠myanu̍ sa̠pta hotrāḥ̎||"
        },
        {
          "id": "ts-4-2-9-24",
          "chunkNumber": 24,
          "sanskrit": "abhū̍di̠davm̐viśva̍sya̠ bhuva̍nasya̠ vāji̍nama̠gner vai̎śvāna̠rasya̍ ca|"
        },
        {
          "id": "ts-4-2-9-25",
          "chunkNumber": 25,
          "sanskrit": "a̠gnir jyoti̍ṣā̠ jyoti̍ṣmān ru̠kmo varca̍sā̠ varca̍svān||"
        },
        {
          "id": "ts-4-2-9-26",
          "chunkNumber": 26,
          "sanskrit": "ṛ̠ce tvā̍ ru̠ce tvā̠ samith sra̍vanti sa̠rito̠ na dhenāḥ̎|"
        },
        {
          "id": "ts-4-2-9-27",
          "chunkNumber": 27,
          "sanskrit": "a̠ntarhṛ̠dā mana̍sā pū̠yamā̍nāḥ||"
        },
        {
          "id": "ts-4-2-9-28",
          "chunkNumber": 28,
          "sanskrit": "ghṛ̠tasya̠ dhārā̍ a̠bhi cā̍kaśīmi|"
        },
        {
          "id": "ts-4-2-9-29",
          "chunkNumber": 29,
          "sanskrit": "hi̠ra̠ṇyayo̍ veta̠so maddhya̍ āsām||"
        },
        {
          "id": "ts-4-2-9-30",
          "chunkNumber": 30,
          "sanskrit": "tasmi̎nth supa̠rṇo ma̍dhu̠kṛt ku̍lā̠yī bhaja̍nnāste̠ madhu̍ de̠vatā̎bhyaḥ|"
        },
        {
          "id": "ts-4-2-9-31",
          "chunkNumber": 31,
          "sanskrit": "tasyā̍sate̠ hara̍yaḥ sa̠pta tīre̎ sva̠dhānduhā̍nā a̠mṛta̍sya̠ dhārā̎m"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-2-10",
      "title": "Kāṇḍa 4 · Prapāṭhaka 2 · Anuvāka 10",
      "sectionNumber": 21,
      "chunks": [
        {
          "id": "ts-4-2-10-1",
          "chunkNumber": 1,
          "sanskrit": "ā̠di̠tyaṅgarbha̠mpaya̍sā sama̠ñjanth sa̠hasra̍sya prati̠māvm̐vi̠śvarū̍pam|",
          "section": 10
        },
        {
          "id": "ts-4-2-10-2",
          "chunkNumber": 2,
          "sanskrit": "pari̍ vṛṅgdhi̠ hara̍sā̠ mā'bhi mṛ̍khṣaḥ śa̠tāyu̍ṣaṅkṛṇuhi cī̠yamā̍naḥ||"
        },
        {
          "id": "ts-4-2-10-3",
          "chunkNumber": 3,
          "sanskrit": "i̠mammā hi̍gͫsīr dvi̠pāda̍mpaśū̠nāgͫ saha̍srākhṣa̠ medha̠ ā cī̠yamā̍naḥ|"
        },
        {
          "id": "ts-4-2-10-4",
          "chunkNumber": 4,
          "sanskrit": "ma̠yumā̍ra̠ṇyamanu̍ te diśāmi̠ tena̍ cinvā̠nasta̠nuvo̠ ni ṣī̍da||"
        },
        {
          "id": "ts-4-2-10-5",
          "chunkNumber": 5,
          "sanskrit": "vāta̍sya̠ dhrāji̠vm̐varu̍ṇasya̠ nābhi̠maśva̍ñjajñā̠nagͫ sa̍ri̠rasya̠ maddhye̎|"
        },
        {
          "id": "ts-4-2-10-6",
          "chunkNumber": 6,
          "sanskrit": "śiśu̍nna̠dīnā̠g̠ͫ hari̠madri̍buddha̠magne̠ mā hi̍gͫsīḥ"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-2-11",
      "title": "Kāṇḍa 4 · Prapāṭhaka 2 · Anuvāka 11",
      "sectionNumber": 22,
      "chunks": [
        {
          "id": "ts-4-2-11-1",
          "chunkNumber": 1,
          "sanskrit": "indrā̎gnī roca̠nā di̠vaḥ pari̠ vāje̍ṣu bhūṣathaḥ|",
          "section": 11
        },
        {
          "id": "ts-4-2-11-2",
          "chunkNumber": 2,
          "sanskrit": "tad vā̎ñceti̠ pra vī̠rya̎m||"
        },
        {
          "id": "ts-4-2-11-3",
          "chunkNumber": 3,
          "sanskrit": "śñatha̍dvṛ̠tramu̠ta sa̍noti̠ vāja̠mindrā̠ yo a̠gnī sahu̍rī sapa̠ryāt|"
        },
        {
          "id": "ts-4-2-11-4",
          "chunkNumber": 4,
          "sanskrit": "i̠ra̠jyantā̍ vasa̠vya̍sya̠ bhūreḥ̠ saha̍stamā̠ saha̍sā vāja̠yantā̎||"
        },
        {
          "id": "ts-4-2-11-5",
          "chunkNumber": 5,
          "sanskrit": "pra ca̍rṣa̠ṇibhyaḥ̍ pṛtanā̠ have̍ṣu̠ pra pṛ̍thi̠vyā ri̍ricāthe di̠vaśca̍|"
        },
        {
          "id": "ts-4-2-11-6",
          "chunkNumber": 6,
          "sanskrit": "pra sindhu̍bhyaḥ̠ pra gi̠ribhyo̍ mahi̠tvā prendrā̎gnī̠ viśvā̠ bhuva̠nā'tya̠nyā||"
        },
        {
          "id": "ts-4-2-11-7",
          "chunkNumber": 7,
          "sanskrit": "maru̍to̠ yasya̠ hi khṣaye̍ pā̠thā di̠vo vi̍mahasaḥ|"
        },
        {
          "id": "ts-4-2-11-8",
          "chunkNumber": 8,
          "sanskrit": "sa su̍go̠pāta̍mo̠ janaḥ̍||"
        },
        {
          "id": "ts-4-2-11-9",
          "chunkNumber": 9,
          "sanskrit": "ya̠jñair vā̍ yajñavāhaso̠ vipra̍sya vā matī̠nām|"
        },
        {
          "id": "ts-4-2-11-10",
          "chunkNumber": 10,
          "sanskrit": "maru̍taḥ śṛṇu̠tā hava̎m||"
        },
        {
          "id": "ts-4-2-11-11",
          "chunkNumber": 11,
          "sanskrit": "śri̠yase̠ kambhā̠nubhiḥ̠ sammi̍mikhṣire̠ te ra̠śmibhi̠sta ṛkva̍bhiḥ sukhā̠dayaḥ̍|"
        },
        {
          "id": "ts-4-2-11-12",
          "chunkNumber": 12,
          "sanskrit": "te vāśī̍manta i̠ṣmiṇo̠ abhī̍ravo vi̠dre pri̠yasya̠ māru̍tasya̠ dhāmnaḥ̍||"
        },
        {
          "id": "ts-4-2-11-13",
          "chunkNumber": 13,
          "sanskrit": "ava̍ te̠ heḍa̠> 1, udu̍tta̠maṃ >2||"
        },
        {
          "id": "ts-4-2-11-14",
          "chunkNumber": 14,
          "sanskrit": "kayā̍ naści̠tra ā bhu̍vadū̠tī sa̠dāvṛ̍dhaḥ̠ sakhā̎|"
        },
        {
          "id": "ts-4-2-11-15",
          "chunkNumber": 15,
          "sanskrit": "kayā̠ śaci̍ṣṭhayā vṛ̠tā ko a̠dya yu̍ṅkte dhu̠ri gā ṛ̠tasya̠ śimī̍vato bhā̠mino̍ durhṛṇā̠yūn|"
        },
        {
          "id": "ts-4-2-11-16",
          "chunkNumber": 16,
          "sanskrit": "ā̠sanni̍ṣūn hṛ̠thsvaso̍ mayo̠bhūnya e̍ṣāmbhṛ̠tyāmṛ̠ṇadha̠th sa jī̍vāt||"
        },
        {
          "id": "ts-4-2-11-17",
          "chunkNumber": 17,
          "sanskrit": "agne̠ nayā''> 3, de̠vānā̠g̠ͫ >4, śanno̍ bhavantu̠ > 5, vāje̍vāje>6||"
        },
        {
          "id": "ts-4-2-11-18",
          "chunkNumber": 18,
          "sanskrit": "a̠phsva̍gne̠ sadhi̠ṣṭava̠ sauṣa̍dhī̠ranu̍ ruddhyase|"
        },
        {
          "id": "ts-4-2-11-19",
          "chunkNumber": 19,
          "sanskrit": "garbhe̠ sañjā̍yase̠ punaḥ̍||"
        },
        {
          "id": "ts-4-2-11-20",
          "chunkNumber": 20,
          "sanskrit": "vṛṣā̍ soma dyu̠māgͫ a̍si̠ vṛṣā̍ deva̠ vṛṣa̍vrataḥ|"
        },
        {
          "id": "ts-4-2-11-21",
          "chunkNumber": 21,
          "sanskrit": "vṛṣā̠ dharmā̍ṇi dadhiṣe||"
        },
        {
          "id": "ts-4-2-11-22",
          "chunkNumber": 22,
          "sanskrit": "i̠mamme̍ varuṇa̠ > 7, tattvā̍ yāmi̠>8, tvanno̍ agne̠>9, sa tvanno̍ agne> 10"
        }
      ]
    }
  ]
