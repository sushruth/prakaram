        {
          "id": "ts-4-2-5-8",
          "chunkNumber": 8,
          "sanskrit": "दे॒व इ॑व सवि॒ता स॒त्यध॒र्मेन्द्रो॒ न त॑स्थौ सम॒रे प॑थी॒नाम्॥"
        },
        {
          "id": "ts-4-2-5-9",
          "chunkNumber": 9,
