      "sectionNumber": 17,
      "chunks": [
        {
          "id": "ts-4-2-6-1",
          "chunkNumber": 1,
          "sanskrit": "या जा॒ता ओष॑धयो दे॒वेभ्य॑स्त्रियु॒गम्पु॒रा।",
          "section": 6
        },
        {
          "id": "ts-4-2-6-2",
          "chunkNumber": 2,
          "sanskrit": "मन्दा॑मि ब॒भ्रूणा॑म॒हꣳ श॒तन्धामा॑नि स॒प्त च॑॥"
