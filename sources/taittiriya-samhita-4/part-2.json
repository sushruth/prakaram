{
  "sections": [
    {
      "id": "taittiriya-samhita-4-2-1",
      "title": "Kāṇḍa 4 · Prapāṭhaka 2 · Anuvāka 1",
      "sectionNumber": 12,
      "chunks": [
        {
          "id": "ts-4-2-1-1",
          "chunkNumber": 1,
          "sanskrit": "विष्णोः॒ क्रमो᳚ऽस्यभिमाति॒हा गा॑य॒त्रञ्छन्द॒ आ रो॑ह पृथि॒वीमनु॒ वि क्र॑मस्व॒ निर्भ॑क्तः॒ स यन्द्वि॒ष्मो विष्णोः॒ क्रमो᳚ऽस्यभिशस्ति॒हा त्रैष्टु॑भ॒ञ्छन्द॒ आ रो॑हा॒न्तरि॑ख्ष॒मनु॒ वि क्र॑मस्व॒ निर्भ॑क्तः॒ स यं द्वि॒ष्मो विष्णोः॒ क्रमो᳚ऽस्यरातीय॒तो ह॒न्ता जाग॑त॒ञ्छन्द॒ आ रो॑ह॒ दिव॒मनु॒ वि क्र॑मस्व॒ निर्भ॑क्तः॒ स यं द्वि॒ष्मो विष्णोः॒ क्रमो॑ऽसि शत्रूय॒तो ह॒न्ताऽऽनु॑ष्टुभ॒ञ्छन्द॒ आ रो॑ह॒ दिशोऽनु॒ वि क्र॑मस्व॒ निर्भ॑क्तः॒ स यन्द्वि॒ष्मः॥",
          "section": 1
        },
        {
          "id": "ts-4-2-1-2",
          "chunkNumber": 2,
          "sanskrit": "अक्र॑न्दद॒ग्निः स्त॒नय॑न्निव॒ द्यौः ख्षामा॒ रेरि॑हद्वी॒रुधः॑ सम॒ञ्जन्न्।"
        },
        {
          "id": "ts-4-2-1-3",
          "chunkNumber": 3,
          "sanskrit": "स॒द्यो ज॑ज्ञा॒नो वि हीमि॒द्धो अख्य॒दा रोद॑सी भा॒नुना॑ भात्य॒न्तः॥"
        },
        {
          "id": "ts-4-2-1-4",
          "chunkNumber": 4,
          "sanskrit": "अग्ने᳚ऽभ्यावर्तिन्न॒भि न॒ आ व॑र्त॒स्वाऽऽयु॑षा॒ वर्च॑सा स॒न्या मे॒धया᳚ प्र॒जया॒ धने॑न॥"
        },
        {
          "id": "ts-4-2-1-5",
          "chunkNumber": 5,
          "sanskrit": "अग्ने॑ व्ँवि म॑द्ध्य॒मꣴ श्र॑थाय।"
        },
        {
          "id": "ts-4-2-1-6",
          "chunkNumber": 6,
          "sanskrit": "अथा॑ व॒यमा॑दित्य व्र॒ते तवाना॑गसो॒ अदि॑तये स्याम॥"
        },
        {
          "id": "ts-4-2-1-7",
          "chunkNumber": 7,
          "sanskrit": "आ त्वा॑ऽ हार्षम॒न्तर॑भूर् ध्रु॒वस्ति॒ष्ठाऽवि॑चाचलिः।"
        },
        {
          "id": "ts-4-2-1-8",
          "chunkNumber": 8,
          "sanskrit": "विश॑स्त्वा॒ सर्वा॑ वाञ्छन्त्व॒स्मिन् रा॒ष्ट्रमधि॑ श्रय॥"
        },
        {
          "id": "ts-4-2-1-9",
          "chunkNumber": 9,
          "sanskrit": "अग्रे॑ बृ॒हन्नु॒षसा॑मू॒र्द्ध्वो अ॑स्थान्निर्जग्मि॒वान्तम॑सो॒ ज्योति॒षाऽऽ*गा᳚त्।"
        },
        {
          "id": "ts-4-2-1-10",
          "chunkNumber": 10,
          "sanskrit": "अ॒ग्निर् भा॒नुना॒ रुश॑ता॒ स्वङ्ग॒ आ जा॒तो विश्वा॒ सद्मा᳚न्यप्राः॥"
        },
        {
          "id": "ts-4-2-1-11",
          "chunkNumber": 11,
          "sanskrit": "सीद॒ त्वम्मा॒तुर॒स्या उ॒पस्थे॒ विश्वा᳚न्यग्ने व॒युना॑नि वि॒द्वान्।"
        },
        {
          "id": "ts-4-2-1-12",
          "chunkNumber": 12,
          "sanskrit": "मैना॑म॒र्चिषा॒ मा तप॑सा॒ऽभि शू॑शुचो॒ऽन्तर॑स्याꣳ शु॒क्रज्यो॑ति॒र् वि भा॑हि॥"
        },
        {
          "id": "ts-4-2-1-13",
          "chunkNumber": 13,
          "sanskrit": "अ॒न्तर॑ग्ने रु॒चा त्वमु॒खायै॒ सद॑ने॒ स्वे।"
        },
        {
          "id": "ts-4-2-1-14",
          "chunkNumber": 14,
          "sanskrit": "तस्या॒स्त्वꣳ हर॑सा॒ तप॒ञ्जात॑वेदः शि॒वो भ॑व॥"
        },
        {
          "id": "ts-4-2-1-15",
          "chunkNumber": 15,
          "sanskrit": "शि॒वो भू॒त्वा मह्य॑म॒ग्नेऽथो॑ सीद शि॒वस्त्वम्।"
        },
        {
          "id": "ts-4-2-1-16",
          "chunkNumber": 16,
          "sanskrit": "शि॒वाः कृ॒त्वा दिशः॒ सर्वाः॒ स्वाय्ँयोनि॑मि॒हाऽऽस॑दः॥"
        },
        {
          "id": "ts-4-2-1-17",
          "chunkNumber": 17,
          "sanskrit": "ह॒ꣳ॒सः शु॑चि॒षद् वसु॑रन्तरिख्ष॒सद्धोता॑ वेदि॒षदति॑थिर् दुरोण॒सत्।"
        },
        {
          "id": "ts-4-2-1-18",
          "chunkNumber": 18,
          "sanskrit": "नृ॒षद्व॑र॒सद् ऋ॑त॒सद् व्यो॑म॒सद॒ब्जा गो॒जा ऋ॑त॒जा अ॑द्रि॒जा ऋ॒तम्बृ॒हत्"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-2-2",
      "title": "Kāṇḍa 4 · Prapāṭhaka 2 · Anuvāka 2",
      "sectionNumber": 13,
      "chunks": [
        {
          "id": "ts-4-2-2-1",
          "chunkNumber": 1,
          "sanskrit": "दि॒वस्परि॑ प्रथ॒मञ्ज॑ज्ञे अ॒ग्निर॒स्मद् द्वि॒तीय॒म्परि॑ जा॒तवे॑दाः।",
          "section": 2
        },
        {
          "id": "ts-4-2-2-2",
          "chunkNumber": 2,
          "sanskrit": "तृ॒तीय॑म॒फ्सु नृ॒मणा॒ अज॑स्र॒मिन्धा॑न एनञ्जरते स्वा॒धीः॥"
        },
        {
          "id": "ts-4-2-2-3",
          "chunkNumber": 3,
          "sanskrit": "वि॒द्मा ते॑ अग्ने त्रे॒धा त्र॒याणि॑ वि॒द्मा ते॒ सद्म॒ विभृ॑तम्पुरु॒त्रा।"
        },
        {
          "id": "ts-4-2-2-4",
          "chunkNumber": 4,
          "sanskrit": "वि॒द्मा ते॒ नाम॑ पर॒मङ्गुहा॒ यद्वि॒द्मा तमुथ्स॒य्ँयत॑ आज॒गन्थ॑॥"
        },
        {
          "id": "ts-4-2-2-5",
          "chunkNumber": 5,
          "sanskrit": "स॒मु॒द्रे त्वा॑ नृ॒मणा॑ अ॒फ्स्व॑न्तर् नृ॒चख्षा॑ ईधे दि॒वो अ॑ग्न॒ ऊध॑न्।"
        },
        {
          "id": "ts-4-2-2-6",
          "chunkNumber": 6,
          "sanskrit": "तृ॒तीये᳚ त्वा॒ रज॑सि तस्थि॒वाꣳस॑मृ॒तस्य॒ योनौ॑ महि॒षा अ॑हिन्वन्न्॥"
        },
        {
          "id": "ts-4-2-2-7",
          "chunkNumber": 7,
          "sanskrit": "अक्र॑न्दद॒ग्निः स्त॒नय॑न्निव॒ द्यौः ख्षामा॒ रेरि॑हद्वी॒रुधः॑ सम॒ञ्जन्न्।"
        },
        {
          "id": "ts-4-2-2-8",
          "chunkNumber": 8,
          "sanskrit": "स॒द्यो ज॑ज्ञा॒नो वि हीमि॒द्धो अख्य॒दा रोद॑सी भा॒नुना॑ भात्य॒न्तः॥"
        },
        {
          "id": "ts-4-2-2-9",
          "chunkNumber": 9,
          "sanskrit": "उ॒शिक् पा॑व॒को अ॑र॒तिः सु॑मे॒धा मर्ते᳚ष्व॒ग्निर॒मृतो॒ नि धा॑यि।"
        },
        {
          "id": "ts-4-2-2-10",
          "chunkNumber": 10,
          "sanskrit": "इय॑र्ति धू॒मम॑रु॒षम्भरि॑भ्र॒दुच्छु॒क्रेण॑ शो॒चिषा॒ द्यामिन॑ख्षत्॥"
        },
        {
          "id": "ts-4-2-2-11",
          "chunkNumber": 11,
          "sanskrit": "विश्व॑स्य के॒तुर् भुव॑नस्य॒ गर्भ॒ आ रोद॑सी अपृणा॒ज्जाय॑मानः।"
        },
        {
          "id": "ts-4-2-2-12",
          "chunkNumber": 12,
          "sanskrit": "वी॒डुञ्चि॒दद्रि॑मभिनत् परा॒यन् जना॒ यद॒ग्निमय॑जन्त॒ पञ्च॑॥"
        },
        {
          "id": "ts-4-2-2-13",
          "chunkNumber": 13,
          "sanskrit": "श्री॒णामु॑दा॒रो ध॒रुणो॑ रयी॒णाम्म॑नी॒षाणा॒म्प्रार्प॑णः॒ सोम॑गोपाः।"
        },
        {
          "id": "ts-4-2-2-14",
          "chunkNumber": 14,
          "sanskrit": "वसोः᳚ सू॒नुः सह॑सो अ॒फ्सु राजा॒ वि भा॒त्यग्र॑ उ॒षसा॑मिधा॒नः॥"
        },
        {
          "id": "ts-4-2-2-15",
          "chunkNumber": 15,
          "sanskrit": "यस्ते॑ अ॒द्य कृ॒णव॑द्भद्रशोचेऽपू॒पन्दे॑व घृ॒तव॑न्तमग्ने।"
        },
        {
          "id": "ts-4-2-2-16",
          "chunkNumber": 16,
          "sanskrit": "प्र तन्न॑य प्रत॒राव्ँवस्यो॒ अच्छा॒भि द्यु॒म्नन्दे॒वभ॑क्तय्ँयविष्ठ॥"
        },
        {
          "id": "ts-4-2-2-17",
          "chunkNumber": 17,
          "sanskrit": "आ"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-2-3",
      "title": "Kāṇḍa 4 · Prapāṭhaka 2 · Anuvāka 3",
      "sectionNumber": 14,
      "chunks": [
        {
          "id": "ts-4-2-3-1",
          "chunkNumber": 1,
          "sanskrit": "अन्न॑प॒तेऽन्न॑स्य नो देह्यनमी॒वस्य॑ शु॒ष्मिणः॑।",
          "section": 3
        },
        {
          "id": "ts-4-2-3-2",
          "chunkNumber": 2,
          "sanskrit": "प्र प्र॑दा॒तार॑न्तारिष॒ ऊर्ज॑न्नो धेहि द्वि॒पदे॒ चतु॑ष्पदे॥"
        },
        {
          "id": "ts-4-2-3-3",
          "chunkNumber": 3,
          "sanskrit": "उदु॑ त्वा॒ विश्वे॑ दे॒वा अग्ने॒ भर॑न्तु॒ चित्ति॑भिः।"
        },
        {
          "id": "ts-4-2-3-4",
          "chunkNumber": 4,
          "sanskrit": "स नो॑ भव शि॒वत॑मः सु॒प्रती॑को वि॒भाव॑सुः॥"
        },
        {
          "id": "ts-4-2-3-5",
          "chunkNumber": 5,
          "sanskrit": "प्रेद॑ग्ने॒ ज्योति॑ष्मान्याहि शि॒वेभि॑र॒र्चिभि॒स्त्वम्।"
        },
        {
          "id": "ts-4-2-3-6",
          "chunkNumber": 6,
          "sanskrit": "बृ॒हद्भि॑र्भा॒नुभि॒र्भास॒न् मा हि॑ꣳसी स्त॒नुवा᳚ प्र॒जाः॥"
        },
        {
          "id": "ts-4-2-3-7",
          "chunkNumber": 7,
          "sanskrit": "स॒मिधा॒ऽग्निन्दु॑वस्यत घृ॒तैर् बो॑धय॒ताति॑थिम्।"
        },
        {
          "id": "ts-4-2-3-8",
          "chunkNumber": 8,
          "sanskrit": "आ सौष॑धी॒रनु॑ रुद्ध्यसे।"
        },
        {
          "id": "ts-4-2-3-9",
          "chunkNumber": 9,
          "sanskrit": "गर्भे॒ सञ्जा॑यसे॒ पुनः॑॥"
        },
        {
          "id": "ts-4-2-3-10",
          "chunkNumber": 10,
          "sanskrit": "गर्भो॑ अ॒स्योष॑धीना॒ङ्गर्भो॒ वन॒स्पती॑नाम्।"
        },
        {
          "id": "ts-4-2-3-11",
          "chunkNumber": 11,
          "sanskrit": "गर्भो॒ विश्व॑स्य भू॒तस्याग्ने॒ गर्भो॑ अ॒पाम॑सि॥"
        },
        {
          "id": "ts-4-2-3-12",
          "chunkNumber": 12,
          "sanskrit": "प्र॒सद्य॒ भस्म॑ना॒ योनि॑म॒पश्च॑ पृथि॒वीम॑ग्ने।"
        },
        {
          "id": "ts-4-2-3-13",
          "chunkNumber": 13,
          "sanskrit": "स॒ꣳ॒सृज्य॑ मा॒तृभि॒स्त्वञ्ज्योति॑ष्मा॒न् पुन॒राऽस॑दः॥"
        },
        {
          "id": "ts-4-2-3-14",
          "chunkNumber": 14,
          "sanskrit": "पुन॑रा॒सद्य॒ सद॑नम॒पश्च॑ पृथि॒वीम॑ग्ने।"
        },
        {
          "id": "ts-4-2-3-15",
          "chunkNumber": 15,
          "sanskrit": "शेषे॑ मा॒तुर् यथो॒पस्थे॒ऽन्तर॒स्याꣳ शि॒वत॑मः॥"
        },
        {
          "id": "ts-4-2-3-16",
          "chunkNumber": 16,
          "sanskrit": "पुन॑रू॒र्जा नि व॑र्तस्व॒ पुन॑रग्न इ॒षाऽऽयु॑षा।"
        },
        {
          "id": "ts-4-2-3-17",
          "chunkNumber": 17,
          "sanskrit": "पुन॑र् नः पाहि वि॒श्वतः॑॥"
        },
        {
          "id": "ts-4-2-3-18",
          "chunkNumber": 18,
          "sanskrit": "स॒ह र॒य्या नि व॑र्त॒स्वाग्ने॒ पिन्व॑स्व॒ धार॑या।"
        },
        {
          "id": "ts-4-2-3-19",
          "chunkNumber": 19,
          "sanskrit": "वि॒श्वफ्स्नि॑या वि॒श्वत॒स्परि॑॥"
        },
        {
          "id": "ts-4-2-3-20",
          "chunkNumber": 20,
          "sanskrit": "पुन॑स्त्वाऽऽदि॒त्या रु॒द्रा वस॑वः॒ समि॑न्धतां॒ पुन॑र् ब्र॒ह्माणो॑ वसुनीथ य॒ज्ञैः।"
        },
        {
          "id": "ts-4-2-3-21",
          "chunkNumber": 21,
          "sanskrit": "घृ॒तेन॒ त्वन्त॒नुवो॑ वर्द्धयस्व स॒त्याः स॑न्तु॒ यज॑मानस्य॒ कामाः᳚॥"
        },
        {
          "id": "ts-4-2-3-22",
          "chunkNumber": 22,
          "sanskrit": "बोधा॑ नो अ॒स्य वच॑सो यविष्ठ॒ मꣳहि॑ष्ठस्य॒ प्रभृ॑तस्य स्वधावः।"
        },
        {
          "id": "ts-4-2-3-23",
          "chunkNumber": 23,
          "sanskrit": "पीय॑ति त्वो॒ अनु॑ त्वो गृणाति व॒न्दारु॑स्ते त॒नुव॑व्ँवन्दे अग्ने॥"
        },
        {
          "id": "ts-4-2-3-24",
          "chunkNumber": 24,
          "sanskrit": "स बो॑धि सू॒रिर् म॒घवा॑ वसु॒दावा॒ वसु॑पतिः।"
        },
        {
          "id": "ts-4-2-3-25",
          "chunkNumber": 25,
          "sanskrit": "यु॒यो॒द्ध्य॑स्मद् द्वेषा॑ꣳसि"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-2-4",
      "title": "Kāṇḍa 4 · Prapāṭhaka 2 · Anuvāka 4",
      "sectionNumber": 15,
      "chunks": [
        {
          "id": "ts-4-2-4-1",
          "chunkNumber": 1,
          "sanskrit": "अपे॑त॒ वीत॒ वि च॑ सर्प॒तातो॒ येऽत्र॒ स्थ पु॑रा॒णा ये च॒ नूत॑नाः।",
          "section": 4
        },
        {
          "id": "ts-4-2-4-2",
          "chunkNumber": 2,
          "sanskrit": "अदा॑दि॒दय्ँय॒मो॑ऽव॒सान॑म्पृथि॒व्या अक्र॑न्नि॒मम्पि॒तरो॑ लो॒कम॑स्मै॥"
        },
        {
          "id": "ts-4-2-4-3",
          "chunkNumber": 3,
          "sanskrit": "अ॒ग्नेर् भस्मा᳚स्य॒ग्नेः पुरी॑षमसि सं॒ज्ञान॑मसि काम॒धर॑ण॒म्मयि॑ ते काम॒धर॑णम्भूयात्॥"
        },
        {
          "id": "ts-4-2-4-4",
          "chunkNumber": 4,
          "sanskrit": "सय्ँया वः॑ प्रि॒यास्त॒नुवः॒ सम्प्रि॒या हृद॑यानि वः।"
        },
        {
          "id": "ts-4-2-4-5",
          "chunkNumber": 5,
          "sanskrit": "आ॒त्मा वो॑ अस्तु॒ संप्रि॑यः॒ संप्रि॑यास्त॒नुवो॒ मम॑॥"
        },
        {
          "id": "ts-4-2-4-6",
          "chunkNumber": 6,
          "sanskrit": "अ॒यꣳ सो अ॒ग्निर् यस्मि॒न्थ्सोम॒मिन्द्रः॑ सु॒तन्द॒धे ज॒ठरे॑ वावशा॒नः।"
        },
        {
          "id": "ts-4-2-4-7",
          "chunkNumber": 7,
          "sanskrit": "स॒ह॒स्रिय॒व्ँवाज॒मत्य॒न्न सप्ति॑ꣳ सस॒वान्थ् सन्थ् स्तू॑यसे जातवेदः॥"
        },
        {
          "id": "ts-4-2-4-8",
          "chunkNumber": 8,
          "sanskrit": "अग्ने॑ दि॒वो अर्ण॒मच्छा॑ जिगा॒स्यच्छा॑ दे॒वाꣳ ऊ॑चिषे॒ धिष्णि॑या॒ ये।"
        },
        {
          "id": "ts-4-2-4-9",
          "chunkNumber": 9,
          "sanskrit": "याः प॒रस्ता᳚द्रोच॒ने सूर्य॑स्य॒ याश्चा॒ वस्ता॑दुप॒तिष्ठ॑न्त॒ आपः॑॥"
        },
        {
          "id": "ts-4-2-4-10",
          "chunkNumber": 10,
          "sanskrit": "अग्ने॒ यत् ते॑ दि॒वि वर्चः॑ पृथि॒व्याय्ँयदोष॑धीष्व॒"
        }
      ]
    },
    {
      "id": "taittiriya-samhita-4-2-5",
      "title": "Kāṇḍa 4 · Prapāṭhaka 2 · Anuvāka 5",
      "sectionNumber": 16,
      "chunks": [
        {
          "id": "ts-4-2-5-1",
          "chunkNumber": 1,
          "sanskrit": "समि॑त॒ꣳ॒ सङ्क॑ल्पेथा॒ꣳ॒ संप्रि॑यौ रोचि॒ष्णू सु॑मन॒स्यमा॑नौ।",
          "section": 5
        },
        {
          "id": "ts-4-2-5-2",
          "chunkNumber": 2,
          "sanskrit": "इष॒मूर्ज॑म॒भि स॒व्ँवसा॑नौ॒ सव्ँवा॒म्मना॑ꣳसि॒ सव्ँव्र॒ता समु॑ चि॒त्तान्याऽक॑रम्॥"
        },
        {
          "id": "ts-4-2-5-3",
          "chunkNumber": 3,
          "sanskrit": "अग्ने॑ पुरीष्याधि॒पा भ॑वा॒ त्वन्नः॑।"
        },
        {
          "id": "ts-4-2-5-4",
          "chunkNumber": 4,
          "sanskrit": "इष॒मूर्ज॒य्ँयज॑मानाय धेहि॥"
