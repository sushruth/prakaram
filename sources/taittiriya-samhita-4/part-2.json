        },
        {
          "id": "ts-4-2-5-10",
          "chunkNumber": 10,
          "sanskrit": "सि॒ञ्चाम॑हा अव॒टमु॒द्रिण॑व्ँव॒यव्ँविश्वाऽहाऽद॑स्त॒मख्षि॑तम्॥"
        },
        {
          "id": "ts-4-2-5-11",
          "chunkNumber": 11,
          "sanskrit": "निष्कृ॑ताहावमव॒टꣳ सु॑वर॒त्रꣳ सु॑षेच॒नम्।"
        },
        {
          "id": "ts-4-2-5-12",
          "chunkNumber": 12,
          "sanskrit": "उ॒द्रिण॑ꣳ सिञ्चे॒ अख्षि॑तम्॥"
        },
        {
          "id": "ts-4-2-5-13",
          "chunkNumber": 13,
          "sanskrit": "सीरा॑ युञ्जन्ति क॒वयो॑ यु॒गा वि त॑न्वते॒ पृथ॑क्।"
        },
        {
          "id": "ts-4-2-5-14",
          "chunkNumber": 14,
          "sanskrit": "धीरा॑ दे॒वेषु॑ सुम्न॒या॥"
        },
        {
          "id": "ts-4-2-5-15",
          "chunkNumber": 15,
          "sanskrit": "यु॒नक्त॒ सीरा॒ वि यु॒गा त॑नोत कृ॒ते योनौ॑ वपते॒ह बीज᳚म्।"
        },
        {
          "id": "ts-4-2-5-16",
          "chunkNumber": 16,
          "sanskrit": "गि॒रा च॑ श्रु॒ष्टिः सभ॑रा॒ अस॑न्नो॒ नेदी॑य॒ इथ् सृ॒ण्या॑ प॒क्वमाऽय॑त्॥"
        },
        {
          "id": "ts-4-2-5-17",
          "chunkNumber": 17,
          "sanskrit": "लाङ्ग॑ल॒म्पवी॑रवꣳ सु॒शेव॑ꣳ सुम॒तिथ्स॑रु।"
        },
        {
          "id": "ts-4-2-5-18",
          "chunkNumber": 18,
          "sanskrit": "उदित् कृ॑षति॒ गामवि॑म्प्रफ॒र्व्य॑ञ्च॒ पीव॑रीम्।"
        },
        {
          "id": "ts-4-2-5-19",
