    },
    {
      "id": "taittiriya-aranyaka-10-71",
      "title": "Prapāṭhaka 10 · Anuvāka 71",
      "sectionNumber": 71,
      "chunks": [
        {
          "id": "ta-10-71-1",
          "chunkNumber": 1,
          "sanskrit": "अङ्गुष्ठमात्रः पुरुषोऽङ्गुष्ठञ्च॑ समा॒श्रितः।",
          "section": 71
        },
        {
          "id": "ta-10-71-2",
          "chunkNumber": 2,
          "sanskrit": "ईशः सर्वस्य जगतः प्रभुः प्रीणाति॑ विश्व॒भुक्"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-10-72",
      "title": "Prapāṭhaka 10 · Anuvāka 72",
      "sectionNumber": 72,
      "chunks": [
        {
          "id": "ta-10-72-1",
          "chunkNumber": 1,
          "sanskrit": "वाङ्म॑ आ॒सन्न्।",
          "section": 72
        },
        {
          "id": "ta-10-72-2",
          "chunkNumber": 2,
          "sanskrit": "न॒सोः प्रा॒णः।"
        },
        {
          "id": "ta-10-72-3",
          "chunkNumber": 3,
          "sanskrit": "अ॒ख्ष्योश्चख्षुः॑।"
        },
        {
          "id": "ta-10-72-4",
          "chunkNumber": 4,
          "sanskrit": "कर्ण॑योः॒ श्रोत्र᳚म्।"
        },
        {
          "id": "ta-10-72-5",
          "chunkNumber": 5,
          "sanskrit": "बा॒हु॒वोर् बल᳚म्।"
        },
        {
          "id": "ta-10-72-6",
          "chunkNumber": 6,
          "sanskrit": "ऊ॒रु॒वो रोजः॑।"
        },
        {
          "id": "ta-10-72-7",
          "chunkNumber": 7,
          "sanskrit": "अरि॑ष्टा॒ विश्वा॒न्यङ्गा॑नि त॒नूः।"
        },
        {
          "id": "ta-10-72-8",
          "chunkNumber": 8,
          "sanskrit": "त॒नुवा॑ मे स॒ह नम॑स्ते अस्तु॒ मा मा॑ हिꣳसीः"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-10-73",
      "title": "Prapāṭhaka 10 · Anuvāka 73",
      "sectionNumber": 73,
      "chunks": [
        {
          "id": "ta-10-73-1",
          "chunkNumber": 1,
          "sanskrit": "वयः॑ सुप॒र्णा उप॑सेदु॒रिन्द्रं॑ प्रि॒य मे॑धा॒ ऋष॑यो॒ नाध॑मानाः।",
          "section": 73
        },
        {
          "id": "ta-10-73-2",
          "chunkNumber": 2,
          "sanskrit": "अप॑द्ध्वा॒न्त मू᳚र्णु॒हि पू॒र्धि चख्षु॑र्मुमु॒ग्ध्य॑स्मान् नि॒धये॑ ऽवब॒द्धान्"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-10-74",
      "title": "Prapāṭhaka 10 · Anuvāka 74",
      "sectionNumber": 74,
      "chunks": [
        {
          "id": "ta-10-74-1",
          "chunkNumber": 1,
          "sanskrit": "प्राणानां ग्रन्थिरसि रुद्रो मा॑ विशा॒न्तकः।",
          "section": 74
        },
        {
          "id": "ta-10-74-2",
          "chunkNumber": 2,
          "sanskrit": "तेनान्नेना᳚प्याय॒स्व"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-10-75",
      "title": "Prapāṭhaka 10 · Anuvāka 75",
      "sectionNumber": 75,
      "chunks": [
        {
          "id": "ta-10-75-1",
          "chunkNumber": 1,
          "sanskrit": "नमो रुद्राय विष्णवे मृत्यु॑र्मे पा॒हि",
          "section": 75
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-10-76",
      "title": "Prapāṭhaka 10 · Anuvāka 76",
      "sectionNumber": 76,
      "chunks": [
        {
          "id": "ta-10-76-1",
          "chunkNumber": 1,
          "sanskrit": "त्वम॑ग्ने॒ द्युभि॒स्त्वमा॑शुशु॒ख्षणि॒स्त्वम॒द्भ्यस्त्वमश्म॑न॒स्परि॑।",
          "section": 76
        },
        {
          "id": "ta-10-76-2",
          "chunkNumber": 2,
          "sanskrit": "त्वव्ँवने᳚भ्य॒स्त्वमोष॑धीभ्य॒स्त्वं नृ॒णां नृ॑पते जायसे॒ शुचिः॑"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-10-77",
      "title": "Prapāṭhaka 10 · Anuvāka 77",
      "sectionNumber": 77,
      "chunks": [
        {
          "id": "ta-10-77-1",
          "chunkNumber": 1,
          "sanskrit": "शि॒वेन॑ मे॒ सन्ति॑ष्ठस्व स्यो॒नेन॑ मे॒ सन्ति॑ष्ठस्व सुभू॒तेन॑ मे॒ सन्ति॑ष्ठस्व ब्रह्मवर्च॒सेन॑ मे॒ सन्ति॑ष्ठस्व य॒ज्ञस्यर्द्धि॒ मनु॒ सन्ति॑ष्ठ॒ स्वोप॑ ते यज्ञ॒ नम॒ उप॑ ते॒ नम॒ उप॑ ते॒ नमः॑",
          "section": 77
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-10-78",
      "title": "Prapāṭhaka 10 · Anuvāka 78",
      "sectionNumber": 78,
      "chunks": [
        {
          "id": "ta-10-78-1",
          "chunkNumber": 1,
          "sanskrit": "स॒त्यं परं॒ पर॑ꣳ स॒त्यꣳ स॒त्येन॒ न सु॑व॒र्गाल्लो॒काच्च्य॑वन्ते क॒दाच॒न स॒ताꣳ हि स॒त्यं तस्मा᳚थ् स॒त्ये र॑मन्ते॒, (१) तप॒ इति॒ तपो॒ नानश॑ना॒त् पर॒य्ँयद्धि परं॒ तप॒स्तद् दुध॑र्र्षं॒ तद् दुरा॑धर्षं॒ तस्मा॒त् तप॑सि रमन्ते॒, (२) दम॒ इति॒ निय॑तं ब्रह्मचा॒रिण॒स्तस्मा॒द् दमे॑ रमन्ते॒, (३) शम॒ इत्यर॑ण्ये मु॒नय॒स्तस्मा॒च्छमे॑ रमन्ते, (४) दा॒नमिति॒ सर्वा॑णि भू॒तानि॑ प्र॒शꣳस॑न्ति दा॒नान्नाति॑ दु॒श्चरं॒ तस्मा᳚द् दा॒ने र॑मन्ते, (५) ध॒र्म इति॒ धर्मे॑ण॒ सर्व॑मि॒दं परि॑गृहीतं ध॒र्मान्नाति॑दु॒ष्करं॒ तस्मा᳚द् ध॒र्मे र॑मन्ते, (६) प्र॒जन॒ इति॒ भूया॑ꣳस॒स्तस्मा॒द् भूयि॑ष्ठाः॒ प्रजा॑यन्ते॒ तस्मा॒द् भूयि॑ष्ठाः प्र॒जन॑ने रमन्ते॒, (७) ऽग्नय॒ इत्या॑ह॒ तस्मा॑द॒ग्नय॒ आधा॑तव्या अग्निहो॒त्रमित्या॑ह॒ तस्मा॑दग्निहो॒त्रे र॑मन्ते, (८) य॒ज्ञ इति॑ य॒ज्ञो हि दे॒वा स्तस्मा᳚द् य॒ज्ञे र॑मन्ते, (९) मान॒समिति॑ वि॒द्वाꣳस॒स्तस्मा᳚द् वि॒द्वाꣳस॑ ए॒व मा॑न॒से र॑मन्ते, (१०) न्या॒स इति॑ ब्र॒ह्मा ब्र॒ह्मा हि परः॒ परो॑ हि ब्र॒ह्मा तानि॒ वा ए॒तान्यव॑राणि॒ परा॑ꣳसि न्या॒स ए॒वात्य॑रेचय॒द् य ए॒वव्ँवेदे᳚त्युप॒निषत्॥",
          "section": 78
        },
        {
          "id": "ta-10-78-2",
          "chunkNumber": 2,
          "sanskrit": "(११) /"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-10-79",
      "title": "Prapāṭhaka 10 · Anuvāka 79",
      "sectionNumber": 79,
      "chunks": [
        {
          "id": "ta-10-79-1",
