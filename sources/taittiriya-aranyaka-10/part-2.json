    },
    {
      "id": "taittiriya-aranyaka-10-70",
      "title": "Prapāṭhaka 10 · Anuvāka 70",
      "sectionNumber": 70,
      "chunks": [
        {
          "id": "ta-10-70-1",
          "chunkNumber": 1,
          "sanskrit": "श्र॒द्धायां᳚ प्रा॒णे निवि॑श्या॒ऽमृत॑ꣳ हु॒तम्।",
          "section": 70
        },
        {
          "id": "ta-10-70-2",
          "chunkNumber": 2,
          "sanskrit": "प्रा॒ण मन्ने॑नाप्यायस्व।"
        },
        {
