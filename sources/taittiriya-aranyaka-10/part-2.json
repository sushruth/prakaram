{
  "sections": [
    {
      "id": "taittiriya-aranyaka-10-63",
      "title": "Prapāṭhaka 10 · Anuvāka 63",
      "sectionNumber": 63,
      "chunks": [
        {
          "id": "ta-10-63-1",
          "chunkNumber": 1,
          "sanskrit": "तिलाञ्जुहोमि सरसाꣳ सपिष्टान् गन्धार मम चित्ते रम॑न्तु स्वा॒हा॥",
          "section": 63
        },
        {
          "id": "ta-10-63-2",
          "chunkNumber": 2,
          "sanskrit": "गावो हिरण्यं धनमन्नपानꣳ सर्वेषाꣴ श्रि॑यै स्वा॒हा॥"
        },
        {
          "id": "ta-10-63-3",
          "chunkNumber": 3,
          "sanskrit": "श्रियञ्च लख्ष्मिञ्च पुष्टिञ्च कीर्त्तिं॑ चा नृ॒ण्यताम्।"
        },
        {
          "id": "ta-10-63-4",
          "chunkNumber": 4,
          "sanskrit": "ब्रह्मण्यं ब॑हुपु॒त्रताम्।"
        },
        {
          "id": "ta-10-63-5",
          "chunkNumber": 5,
          "sanskrit": "श्रद्धामेधे प्रजाः सन्ददा॑तु स्वा॒हा"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-10-64",
      "title": "Prapāṭhaka 10 · Anuvāka 64",
      "sectionNumber": 64,
      "chunks": [
        {
          "id": "ta-10-64-1",
          "chunkNumber": 1,
          "sanskrit": "तिलाः कृष्णास्ति॑लाः श्वे॒ता॒स्तिलाः सौम्या व॑शानु॒गाः।",
          "section": 64
        },
        {
          "id": "ta-10-64-2",
          "chunkNumber": 2,
          "sanskrit": "तिलाः पुनन्तु॑ मे पा॒प॒य्ँयत्किञ्चिद् दुरितं म॑यि स्वा॒हा॥"
        },
        {
          "id": "ta-10-64-3",
          "chunkNumber": 3,
          "sanskrit": "चोर॒स्यान्नं न॑वश्रा॒द्धं॒ ब्र॒ह्म॒हा गु॑रुत॒ल्पगः।"
        },
        {
          "id": "ta-10-64-4",
          "chunkNumber": 4,
          "sanskrit": "गोस्तेयꣳ स॑रापा॒नं॒ भ्रूणहत्या तिला शान्तिꣳ शमय॑न्तु स्वा॒हा॥"
        },
        {
          "id": "ta-10-64-5",
          "chunkNumber": 5,
          "sanskrit": "श्रीश्च लख्ष्मीश्च पुष्टीश्च कीर्त्तिं॑ चा नृ॒ण्यताम्।"
        },
        {
          "id": "ta-10-64-6",
          "chunkNumber": 6,
          "sanskrit": "ब्रह्मण्यं ब॑हुपु॒त्रताम्।"
        },
        {
          "id": "ta-10-64-7",
          "chunkNumber": 7,
          "sanskrit": "श्रद्धामेधे प्रज्ञातु जातवेदः संददा॑तु स्वा॒हा"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-10-65",
      "title": "Prapāṭhaka 10 · Anuvāka 65",
      "sectionNumber": 65,
      "chunks": [
        {
          "id": "ta-10-65-1",
          "chunkNumber": 1,
          "sanskrit": "प्राणापानव्यानोदानसमाना मे॑ शुद्ध्य॒न्तां॒ ज्योति॑ र॒हव्ँवि॒रजा॑ विपा॒प्मा भू॑यास॒ꣴ॒ स्वाहा᳚॥",
          "section": 65
        },
        {
          "id": "ta-10-65-2",
          "chunkNumber": 2,
          "sanskrit": "वाङ्मनश्चख्षुःश्रोत्रजिह्वाघ्राणरेतोबुद्ध्याकूतिः सङ्कल्पा मे॑ शुद्ध्य॒न्तां॒ ज्योति॑ र॒हव्ँवि॒रजा॑ विपा॒प्मा भू॑यास॒ꣴ॒ स्वाहा᳚॥"
        },
        {
          "id": "ta-10-65-3",
          "chunkNumber": 3,
          "sanskrit": "त्वक्चर्ममाꣳसरुधिरमेदोमज्जास्नायवोऽस्थीनि मे॑ शुद्ध्य॒न्तां॒ ज्योति॑ र॒हव्ँवि॒रजा॑ विपा॒प्मा भू॑यास॒ꣴ॒ स्वाहा᳚॥"
        },
        {
          "id": "ta-10-65-4",
          "chunkNumber": 4,
          "sanskrit": "शिरः पाणि पाद पार्श्व पृष्ठोरूदरजङ्घशिश्ञोपस्थ पायवो मे॑ शुद्ध्य॒न्तां॒ ज्योति॑ र॒हव्ँवि॒रजा॑ विपा॒प्मा भू॑यास॒ꣴ॒ स्वाहा᳚॥"
        },
        {
          "id": "ta-10-65-5",
          "chunkNumber": 5,
          "sanskrit": "उत्तिष्ठ पुरुष हरितपिङ्गल लोहिताख्षि देहि देहि ददापयिता मे॑ शुद्ध्य॒न्तां॒ ज्योति॑ र॒हव्ँवि॒रजा॑ विपा॒प्मा भू॑यास॒ꣴ॒ स्वाहा᳚"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-10-66",
      "title": "Prapāṭhaka 10 · Anuvāka 66",
      "sectionNumber": 66,
      "chunks": [
        {
          "id": "ta-10-66-1",
          "chunkNumber": 1,
          "sanskrit": "पृथिव्याप स्तेजो वायुराकाशा मे॑ शुद्ध्य॒न्तां॒ ज्योति॑ र॒हव्ँवि॒रजा॑ विपा॒प्मा भू॑यास॒ꣴ॒ स्वाहा᳚॥",
          "section": 66
        },
        {
          "id": "ta-10-66-2",
          "chunkNumber": 2,
          "sanskrit": "शब्दस्पर्शरूपरसगन्धा मे॑ शुद्ध्य॒न्तां॒ ज्योति॑ र॒हव्ँवि॒रजा॑ विपा॒प्मा भू॑यास॒ꣴ॒ स्वाहा᳚॥"
        },
        {
          "id": "ta-10-66-3",
          "chunkNumber": 3,
          "sanskrit": "मनोवाक्कायकर्माणि मे॑ शुद्ध्य॒न्तां॒ ज्योति॑ र॒हव्ँवि॒रजा॑ विपा॒प्मा भू॑यास॒ꣴ॒ स्वाहा᳚॥"
        },
        {
          "id": "ta-10-66-4",
          "chunkNumber": 4,
          "sanskrit": "अव्यक्तभावैर॑हङ्का॒र॒र् ज्योति॑ र॒हव्ँवि॒रजा॑ विपा॒प्मा भू॑यास॒ꣴ॒ स्वाहा᳚॥"
        },
        {
          "id": "ta-10-66-5",
          "chunkNumber": 5,
          "sanskrit": "आत्मा मे॑ शुद्ध्य॒न्तां॒ ज्योति॑ र॒हव्ँवि॒रजा॑ विपा॒प्मा भू॑यास॒ꣴ॒ स्वाहा᳚॥"
        },
        {
          "id": "ta-10-66-6",
          "chunkNumber": 6,
          "sanskrit": "अन्तरात्मा मे॑ शुद्ध्य॒न्तां॒ ज्योति॑ र॒हव्ँवि॒रजा॑ विपा॒प्मा भू॑यास॒ꣴ॒ स्वाहा᳚॥"
        },
        {
          "id": "ta-10-66-7",
          "chunkNumber": 7,
          "sanskrit": "परमात्मा मे॑ शुद्ध्य॒न्तां॒ ज्योति॑ र॒हं वि॒रँजा॑ विपा॒प्मा भू॑यास॒ꣴ॒ स्वाहा᳚॥"
        },
        {
          "id": "ta-10-66-8",
          "chunkNumber": 8,
          "sanskrit": "ख्षु॒धे स्वाहा᳚॥"
        },
        {
          "id": "ta-10-66-9",
          "chunkNumber": 9,
          "sanskrit": "ख्षुत्पि॑पासाय॒ स्वाहा᳚॥"
        },
        {
          "id": "ta-10-66-10",
          "chunkNumber": 10,
          "sanskrit": "विवि॑ट्ट्यै॒ स्वाहा᳚॥"
        },
        {
          "id": "ta-10-66-11",
          "chunkNumber": 11,
          "sanskrit": "ऋग्वि॑धानाय॒ स्वाहा᳚॥"
        },
        {
          "id": "ta-10-66-12",
          "chunkNumber": 12,
          "sanskrit": "क॒षो᳚त्काय॒ स्वाहा᳚॥"
        },
        {
          "id": "ta-10-66-13",
          "chunkNumber": 13,
          "sanskrit": "ख्षु॒त्पि॒पा॒साम॑लं ज्ये॒ष्ठा॒म॒ल॒ख्ष्मीर् ना॑शया॒म्यहम्।"
        },
        {
          "id": "ta-10-66-14",
          "chunkNumber": 14,
          "sanskrit": "अभू॑ति॒मस॑मृद्धि॒ञ्च॒ सर्वां (सर्वा) निर्णुद मे पाप्मा॑नꣴ स्वा॒हा॥"
        },
        {
          "id": "ta-10-66-15",
          "chunkNumber": 15,
          "sanskrit": "अन्नमयप्राणमयमनोमयविज्ञानमयमानन्दमयमात्मा मे॑ शुद्ध्य॒न्तां॒ ज्योति॑ र॒हव्ँवि॒रजा॑ विपा॒प्मा भू॑यास॒ꣴ॒ स्वाहा᳚"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-10-67",
      "title": "Prapāṭhaka 10 · Anuvāka 67",
      "sectionNumber": 67,
      "chunks": [
        {
          "id": "ta-10-67-1",
          "chunkNumber": 1,
          "sanskrit": "अ॒ग्नये॒ स्वाहा᳚।",
          "section": 67
        },
        {
          "id": "ta-10-67-2",
          "chunkNumber": 2,
          "sanskrit": "विश्वे᳚भ्यो दे॒वेभ्यः॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-3",
          "chunkNumber": 3,
          "sanskrit": "ध्रु॒वाय॑ भू॒माय॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-4",
          "chunkNumber": 4,
          "sanskrit": "ध्रु॒व॒ख्षित॑ये॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-5",
          "chunkNumber": 5,
          "sanskrit": "अ॒च्यु॒त॒ख्षित॑ये॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-6",
          "chunkNumber": 6,
          "sanskrit": "अ॒ग्नये᳚ स्विष्ट॒कृते॒ स्वाहा᳚॥"
        },
        {
          "id": "ta-10-67-7",
          "chunkNumber": 7,
          "sanskrit": "धर्मा॑य॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-8",
          "chunkNumber": 8,
          "sanskrit": "अध॑र्माय॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-9",
          "chunkNumber": 9,
          "sanskrit": "अ॒द्भ्यः स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-10",
          "chunkNumber": 10,
          "sanskrit": "ओ॒ष॒धि॒व॒न॒स्प॒तिभ्यः॒ स्वाहा᳚ र॒ख्षो॒दे॒व॒ज॒नेभ्यः॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-11",
          "chunkNumber": 11,
          "sanskrit": "गृह्या᳚भ्यः॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-12",
          "chunkNumber": 12,
          "sanskrit": "अ॒व॒साने᳚भ्यः॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-13",
          "chunkNumber": 13,
          "sanskrit": "अ॒व॒सान॑पतिभ्यः॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-14",
          "chunkNumber": 14,
          "sanskrit": "स॒र्व॒भू॒तेभ्यः॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-15",
          "chunkNumber": 15,
          "sanskrit": "कामा॑य॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-16",
          "chunkNumber": 16,
          "sanskrit": "अ॒न्तरि॑ख्षाय॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-17",
          "chunkNumber": 17,
          "sanskrit": "यदेज॑ति॒ जग॑ति॒ यच्च॒ चेष्ट॑ति॒ नाम्नो॑ भा॒गोऽयं नाम्ने॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-18",
          "chunkNumber": 18,
          "sanskrit": "पृ॒थि॒व्यै स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-19",
          "chunkNumber": 19,
          "sanskrit": "अ॒न्तरि॑ख्षाय॒ स्वाहा᳚ दि॒वे स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-20",
          "chunkNumber": 20,
          "sanskrit": "सूर्या॑य॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-21",
          "chunkNumber": 21,
          "sanskrit": "च॒न्द्रम॑से॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-22",
          "chunkNumber": 22,
          "sanskrit": "नख्ष॑त्रेभ्यः॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-23",
          "chunkNumber": 23,
          "sanskrit": "इन्द्रा॑य॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-24",
          "chunkNumber": 24,
          "sanskrit": "बृह॒स्पत॑ये॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-25",
          "chunkNumber": 25,
          "sanskrit": "प्र॒जाप॑तये॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-26",
          "chunkNumber": 26,
          "sanskrit": "ब्रह्म॑णे॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-27",
          "chunkNumber": 27,
          "sanskrit": "स्व॒धा पि॒तृभ्यः॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-28",
          "chunkNumber": 28,
          "sanskrit": "नमो॑ रु॒द्राय॑ पशु॒पत॑ये॒ स्वाहा᳚ दे॒वेभ्यः॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-29",
          "chunkNumber": 29,
          "sanskrit": "पि॒तृभ्यः॑ स्व॒धाऽस्तु॑।"
        },
        {
          "id": "ta-10-67-30",
          "chunkNumber": 30,
          "sanskrit": "भू॒तेभ्यो॒ नमः॑।"
        },
        {
          "id": "ta-10-67-31",
          "chunkNumber": 31,
          "sanskrit": "म॒नु॒ष्ये᳚भ्यो॒ हन्ता᳚।"
        },
        {
          "id": "ta-10-67-32",
          "chunkNumber": 32,
          "sanskrit": "प्र॒जाप॑तये॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-67-33",
          "chunkNumber": 33,
          "sanskrit": "प॒र॒मे॒ष्ठिने॒ स्वाहा᳚॥"
        },
        {
          "id": "ta-10-67-34",
          "chunkNumber": 34,
          "sanskrit": "यथा कू॑पः श॒तधा॑रः स॒हस्र॑धारो॒ अख्षि॑तः।"
        },
        {
          "id": "ta-10-67-35",
          "chunkNumber": 35,
          "sanskrit": "ए॒वा मे॑ अस्तु धा॒न्यꣳ स॒हस्र॑धार॒मख्षि॑तम्।"
        },
        {
          "id": "ta-10-67-36",
          "chunkNumber": 36,
          "sanskrit": "धन॑धान्यै॒ स्वाहा᳚॥"
        },
        {
          "id": "ta-10-67-37",
          "chunkNumber": 37,
          "sanskrit": "ये भू॒ताः प्र॒चर॑न्ति॒ दिवा॒नक्तं॒ बलि॑मि॒च्छन्तो॑ वि॒तुद॑स्य॒ प्रेष्याः᳚।"
        },
        {
          "id": "ta-10-67-38",
          "chunkNumber": 38,
          "sanskrit": "तेभ्यो॑ ब॒लिं पु॑ष्टि॒कामो॑ हरामि॒ मयि॒ पुष्टिं॒ पुष्टि॑पतिर् दधातु॒ स्वाहा᳚"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-10-68",
      "title": "Prapāṭhaka 10 · Anuvāka 68",
      "sectionNumber": 68,
      "chunks": [
        {
          "id": "ta-10-68-1",
          "chunkNumber": 1,
          "sanskrit": "ओं᳚ तद् ब्र॒ह्म।",
          "section": 68
        },
        {
          "id": "ta-10-68-2",
          "chunkNumber": 2,
          "sanskrit": "ओं᳚ तद् वा॒युः।"
        },
        {
          "id": "ta-10-68-3",
          "chunkNumber": 3,
          "sanskrit": "ओं᳚ तदा॒त्मा।"
        },
        {
          "id": "ta-10-68-4",
          "chunkNumber": 4,
          "sanskrit": "ओं᳚ तथ् स॒त्यम्।"
        },
        {
          "id": "ta-10-68-5",
          "chunkNumber": 5,
          "sanskrit": "ओं᳚ तथ् सर्व᳚म्।"
        },
        {
          "id": "ta-10-68-6",
          "chunkNumber": 6,
          "sanskrit": "ओं᳚ तत् पुरो॒र् नमः।"
        },
        {
          "id": "ta-10-68-7",
          "chunkNumber": 7,
          "sanskrit": "अन्तश्चरति॑ भूते॒षु॒ गुहायां वि॑श्व मू॒र्त्तिषु।"
        },
        {
          "id": "ta-10-68-8",
          "chunkNumber": 8,
          "sanskrit": "त्वय्ँयज्ञस्त्वव्ँवषट्कारस्त्वमिद्रस्त्वꣳ रुद्रस्त्वंविष्णुस्त्वं ब्रह्मत्वं॑ प्रजा॒पतिः।"
        },
        {
          "id": "ta-10-68-9",
          "chunkNumber": 9,
          "sanskrit": "त्वं त॑दाप॒ आपो॒ ज्योती॒ रसो॒ऽमृतं॒ ब्रह्म॒ भूर्भुव॒स्सुव॒रों"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-10-69",
      "title": "Prapāṭhaka 10 · Anuvāka 69",
      "sectionNumber": 69,
      "chunks": [
        {
          "id": "ta-10-69-1",
          "chunkNumber": 1,
          "sanskrit": "श्र॒द्धायां᳚ प्रा॒णे निवि॑ष्टो॒ऽमृतं॑ जुहोमि।",
          "section": 69
        },
        {
          "id": "ta-10-69-2",
          "chunkNumber": 2,
          "sanskrit": "श्र॒द्धाया॑मपा॒ने निवि॑ष्टो॒ऽमृतं॑ जुहोमि।"
        },
        {
          "id": "ta-10-69-3",
          "chunkNumber": 3,
          "sanskrit": "श्र॒द्धाया᳚व्ँव्या॒ने निवि॑ष्टो॒ऽमृतं॑ जुहोमि।"
        },
        {
          "id": "ta-10-69-4",
          "chunkNumber": 4,
          "sanskrit": "श्र॒द्धाया॑मुदा॒ने निवि॑ष्टो॒ऽमृतं॑ जुहोमि।"
        },
        {
          "id": "ta-10-69-5",
          "chunkNumber": 5,
          "sanskrit": "श्र॒द्धाया॑ꣳ समा॒ने निवि॑ष्टो॒ऽमृतं॑ जुहोमि।"
        },
        {
          "id": "ta-10-69-6",
          "chunkNumber": 6,
          "sanskrit": "ब्रह्म॑णि म आ॒त्माऽमृ॑त॒त्वाय॑॥"
        },
        {
          "id": "ta-10-69-7",
          "chunkNumber": 7,
          "sanskrit": "अ॒मृ॒तो॒प॒स्तर॑णमसि॥"
        },
        {
          "id": "ta-10-69-8",
          "chunkNumber": 8,
          "sanskrit": "श्र॒द्धायां᳚ प्रा॒णे निवि॑ष्टो॒ऽमृतं॑ जुहोमि।"
        },
        {
          "id": "ta-10-69-9",
          "chunkNumber": 9,
          "sanskrit": "शि॒वो मा॑ वि॒शाप्र॑दाहाय।"
        },
        {
          "id": "ta-10-69-10",
          "chunkNumber": 10,
          "sanskrit": "प्रा॒णाय॒ स्वाहा᳚।"
        },
        {
          "id": "ta-10-69-11",
          "chunkNumber": 11,
          "sanskrit": "श्र॒द्धाया॑मपा॒ने निवि॑ष्टो॒ऽमृतं॑ जुहोमि।"
        },
        {
          "id": "ta-10-69-12",
          "chunkNumber": 12,
          "sanskrit": "शि॒वो मा॑ वि॒शाप्र॑दाहाय।"
        },
        {
          "id": "ta-10-69-13",
          "chunkNumber": 13,
          "sanskrit": "अ॒पा॒नाय॒ स्वाहा᳚।"
        },
        {
