  "sections": [
    {
      "id": "taittiriya-aranyaka-7-1",
      "title": "Prapāṭhaka 7 · Anuvāka 1",
      "sectionNumber": 1,
      "chunks": [
        {
          "id": "ta-7-1-1",
          "chunkNumber": 1,
          "sanskrit": "शन्नो॑ मि॒त्रः शव्ँवरु॑णः।",
          "section": 1
        },
        {
          "id": "ta-7-1-2",
          "chunkNumber": 2,
          "sanskrit": "शन्नो॑ भवत्वर्य॒मा।"
        },
        {
          "id": "ta-7-1-3",
          "chunkNumber": 3,
          "sanskrit": "शन्न॒ इन्द्रो॒ बृह॒स्पतिः॑।"
        },
        {
          "id": "ta-7-1-4",
          "chunkNumber": 4,
          "sanskrit": "शन्नो॒ विष्णु॑रुरुक्र॒मः।"
        },
        {
          "id": "ta-7-1-5",
          "chunkNumber": 5,
          "sanskrit": "नमो॒ ब्रह्म॑णे।"
        },
        {
          "id": "ta-7-1-6",
          "chunkNumber": 6,
          "sanskrit": "नम॑स्ते वायो।"
        },
        {
          "id": "ta-7-1-7",
          "chunkNumber": 7,
          "sanskrit": "त्वमे॒व प्र॒त्यख्षं॒ ब्रह्मा॑सि।"
        },
        {
          "id": "ta-7-1-8",
          "chunkNumber": 8,
          "sanskrit": "त्वमे॒व प्र॒त्यख्षं॒ ब्रह्म॑ वदिष्यामि।"
        },
        {
          "id": "ta-7-1-9",
          "chunkNumber": 9,
          "sanskrit": "ऋ॒तव्ँव॑दिष्यामि।"
        },
        {
          "id": "ta-7-1-10",
          "chunkNumber": 10,
          "sanskrit": "स॒त्यव्ँव॑दिष्यामि।"
        },
        {
          "id": "ta-7-1-11",
          "chunkNumber": 11,
          "sanskrit": "तन्माम॑वतु।"
        },
        {
          "id": "ta-7-1-12",
          "chunkNumber": 12,
          "sanskrit": "तद्व॒क्तार॑मवतु।"
        },
        {
          "id": "ta-7-1-13",
          "chunkNumber": 13,
          "sanskrit": "अव॑तु॒ माम्।"
        },
        {
          "id": "ta-7-1-14",
          "chunkNumber": 14,
          "sanskrit": "अव॑तु व॒क्तारं᳚॥"
        },
        {
          "id": "ta-7-1-15",
          "chunkNumber": 15,
          "sanskrit": "ओं शान्तिः॒ शान्तिः॒ शान्तिः॑"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-7-2",
      "title": "Prapāṭhaka 7 · Anuvāka 2",
      "sectionNumber": 2,
      "chunks": [
        {
          "id": "ta-7-2-1",
          "chunkNumber": 1,
          "sanskrit": "शीख्षाव्ँव्या᳚ख्यास्या॒मः।",
          "section": 2
        },
        {
          "id": "ta-7-2-2",
          "chunkNumber": 2,
          "sanskrit": "वर्णः॒ स्वरः।"
        },
        {
          "id": "ta-7-2-3",
          "chunkNumber": 3,
          "sanskrit": "मात्रा॒ बलम्।"
        },
        {
          "id": "ta-7-2-4",
          "chunkNumber": 4,
          "sanskrit": "साम॑ सन्ता॒नः।"
        },
        {
          "id": "ta-7-2-5",
          "chunkNumber": 5,
          "sanskrit": "इत्युक्तः शी᳚ख्षाद्ध्या॒यः"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-7-3",
      "title": "Prapāṭhaka 7 · Anuvāka 3",
      "sectionNumber": 3,
      "chunks": [
        {
          "id": "ta-7-3-1",
          "chunkNumber": 1,
          "sanskrit": "स॒ह नौ॒ यशः।",
          "section": 3
        },
        {
          "id": "ta-7-3-2",
          "chunkNumber": 2,
          "sanskrit": "स॒ह नौ ब्र॑ह्मव॒र्चसम्॥"
        },
        {
          "id": "ta-7-3-3",
          "chunkNumber": 3,
          "sanskrit": "अथातः सꣳहिताया उपनिषदव्ँव्या᳚ख्यास्या॒मः।"
        },
        {
          "id": "ta-7-3-4",
          "chunkNumber": 4,
          "sanskrit": "पञ्चस्वधिक॑रणे॒षु।"
        },
        {
          "id": "ta-7-3-5",
          "chunkNumber": 5,
          "sanskrit": "अधिलोकमधिज्यौतिषमधिविद्यमधिप्रज॑मद्ध्या॒त्मम्।"
        },
        {
          "id": "ta-7-3-6",
          "chunkNumber": 6,
          "sanskrit": "ता महासꣳहिता इ॑त्याच॒ख्षते॥"
        },
        {
          "id": "ta-7-3-7",
          "chunkNumber": 7,
          "sanskrit": "अथा॑धि लो॒कम्।"
        },
        {
          "id": "ta-7-3-8",
          "chunkNumber": 8,
          "sanskrit": "पृथिवी पू᳚र्वरू॒पम्।"
        },
        {
          "id": "ta-7-3-9",
          "chunkNumber": 9,
          "sanskrit": "द्यौरुत्त॑ररू॒पम्।"
        },
        {
          "id": "ta-7-3-10",
          "chunkNumber": 10,
          "sanskrit": "आका॑शः स॒न्धिः वायुः॑ सन्धा॒नम्।"
        },
        {
          "id": "ta-7-3-11",
          "chunkNumber": 11,
          "sanskrit": "इत्य॑धि लो॒कम्॥"
        },
        {
          "id": "ta-7-3-12",
          "chunkNumber": 12,
          "sanskrit": "अथा॑धि ज्यौ॒तिषम्।"
        },
        {
          "id": "ta-7-3-13",
          "chunkNumber": 13,
          "sanskrit": "अग्निः पू᳚र्व रू॒पम्।"
        },
        {
          "id": "ta-7-3-14",
          "chunkNumber": 14,
          "sanskrit": "आदित्य उत्त॑ररू॒पम्।"
        },
        {
          "id": "ta-7-3-15",
          "chunkNumber": 15,
          "sanskrit": "आ॑पः स॒न्धिः।"
        },
        {
          "id": "ta-7-3-16",
          "chunkNumber": 16,
          "sanskrit": "वैद्युतः॑ सन्धा॒नम्।"
        },
        {
          "id": "ta-7-3-17",
          "chunkNumber": 17,
          "sanskrit": "इत्य॑धि ज्यौ॒तिषम्॥"
        },
        {
          "id": "ta-7-3-18",
          "chunkNumber": 18,
          "sanskrit": "अथा॑धि वि॒द्यम्।"
        },
        {
          "id": "ta-7-3-19",
          "chunkNumber": 19,
          "sanskrit": "आचार्यः पू᳚र्व रू॒पम् अन्तेवास्युत्त॑ररू॒पम्।"
        },
        {
          "id": "ta-7-3-20",
          "chunkNumber": 20,
          "sanskrit": "वि॑द्या स॒न्धिः।"
        },
        {
          "id": "ta-7-3-21",
          "chunkNumber": 21,
          "sanskrit": "प्रवचन॑ꣳ सन्धा॒नम्।"
        },
        {
          "id": "ta-7-3-22",
          "chunkNumber": 22,
          "sanskrit": "इत्य॑धि वि॒द्यम्॥"
        },
        {
          "id": "ta-7-3-23",
          "chunkNumber": 23,
          "sanskrit": "अथाधि॒प्रजम्।"
        },
        {
          "id": "ta-7-3-24",
          "chunkNumber": 24,
          "sanskrit": "माता पू᳚र्वरू॒पम्।"
        },
        {
          "id": "ta-7-3-25",
          "chunkNumber": 25,
          "sanskrit": "पितोत्त॑ररू॒पम्।"
        },
        {
          "id": "ta-7-3-26",
          "chunkNumber": 26,
          "sanskrit": "प्र॑जा स॒न्धिः।"
        },
        {
          "id": "ta-7-3-27",
          "chunkNumber": 27,
          "sanskrit": "प्रजनन॑ꣳ सन्धा॒नम्।"
        },
        {
          "id": "ta-7-3-28",
          "chunkNumber": 28,
          "sanskrit": "इत्यधि॒प्रजम् अथाद्ध्या॒त्मम्।"
        },
        {
          "id": "ta-7-3-29",
          "chunkNumber": 29,
          "sanskrit": "अधराहनुः पू᳚र्व रू॒पम्।"
        },
        {
          "id": "ta-7-3-30",
          "chunkNumber": 30,
          "sanskrit": "उत्तराहनुरुत्त॑ररू॒पम्।"
        },
        {
          "id": "ta-7-3-31",
          "chunkNumber": 31,
          "sanskrit": "वाख् स॒न्धिः।"
        },
        {
          "id": "ta-7-3-32",
          "chunkNumber": 32,
          "sanskrit": "जिह्वा॑ सन्धा॒नम्।"
        },
        {
          "id": "ta-7-3-33",
          "chunkNumber": 33,
          "sanskrit": "इत्यद्ध्या॒त्मम्॥"
        },
        {
          "id": "ta-7-3-34",
          "chunkNumber": 34,
          "sanskrit": "इती माम॑हा स॒ꣳ॒हिताः॥"
        },
        {
          "id": "ta-7-3-35",
          "chunkNumber": 35,
          "sanskrit": "य एवमेता महासꣳहिता व्याख्या॑ता वे॒द।"
        },
        {
          "id": "ta-7-3-36",
          "chunkNumber": 36,
          "sanskrit": "सन्धीयते प्रज॑या प॒शुभिः।"
        },
        {
          "id": "ta-7-3-37",
          "chunkNumber": 37,
          "sanskrit": "ब्रह्मवर्चसेनान्नाद्येन सुवर्ग्येण॑ (सुवर्गेण॑) लोके॒न"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-7-4",
      "title": "Prapāṭhaka 7 · Anuvāka 4",
      "sectionNumber": 4,
      "chunks": [
        {
          "id": "ta-7-4-1",
          "chunkNumber": 1,
          "sanskrit": "यश्छन्द॑सामृष॒भो वि॒श्वरू॑पः।",
          "section": 4
        },
        {
          "id": "ta-7-4-2",
          "chunkNumber": 2,
          "sanskrit": "छन्दो॒भ्योऽद्ध्य॒मृता᳚थ् संब॒भूव॑।"
        },
        {
          "id": "ta-7-4-3",
          "chunkNumber": 3,
          "sanskrit": "स मेन्द्रो॑ मे॒धया᳚ स्पृणोतु।"
        },
        {
          "id": "ta-7-4-4",
          "chunkNumber": 4,
          "sanskrit": "अ॒मृत॑स्य देव॒ धार॑णो भूयासम्॥"
        },
        {
          "id": "ta-7-4-5",
          "chunkNumber": 5,
          "sanskrit": "शरी॑रं मे॒ विच॑र्षणम्।"
        },
        {
          "id": "ta-7-4-6",
          "chunkNumber": 6,
          "sanskrit": "जि॒ह्वा मे॒ मधु॑मत्तमा।"
        },
        {
          "id": "ta-7-4-7",
          "chunkNumber": 7,
          "sanskrit": "कर्णा᳚भ्यां॒ भूरि॒ विश्रु॑वम्।"
        },
        {
          "id": "ta-7-4-8",
          "chunkNumber": 8,
          "sanskrit": "ब्रह्म॑णः को॒शो॑ऽसि मे॒धया ऽपि॑हितः।"
        },
        {
          "id": "ta-7-4-9",
          "chunkNumber": 9,
          "sanskrit": "श्रु॒तं मे॑ गोपाय॥"
        },
        {
          "id": "ta-7-4-10",
          "chunkNumber": 10,
          "sanskrit": "आ॒वह॑न्ती वितन्वा॒ना कु॒र्वा॒णा चीर॑मा॒त्मनः॑।"
        },
        {
          "id": "ta-7-4-11",
          "chunkNumber": 11,
          "sanskrit": "वासा॑ꣳसि॒ मम॒ गाव॑श्च।"
        },
        {
          "id": "ta-7-4-12",
          "chunkNumber": 12,
          "sanskrit": "अ॒न्न॒पा॒ने च॑ सर्व॒दा।"
        },
        {
          "id": "ta-7-4-13",
          "chunkNumber": 13,
          "sanskrit": "ततो॑ मे॒ श्रिय॒माव॑ह।"
        },
        {
          "id": "ta-7-4-14",
          "chunkNumber": 14,
          "sanskrit": "लो॒म॒शां प॒शुभिः॑ स॒ह स्वाहा᳚॥"
        },
        {
          "id": "ta-7-4-15",
          "chunkNumber": 15,
          "sanskrit": "आमा॑यन्तु ब्रह्मचा॒रिणः॒ स्वाहा᳚।"
        },
        {
          "id": "ta-7-4-16",
          "chunkNumber": 16,
          "sanskrit": "विमा॑ऽऽयन्तु ब्रह्मचा॒रिणः॒ स्वाहा᳚।"
        },
        {
          "id": "ta-7-4-17",
          "chunkNumber": 17,
          "sanskrit": "प्रमा॑ऽऽयन्तु ब्रह्मचा॒रिणः॒ स्वाहा᳚।"
        },
        {
          "id": "ta-7-4-18",
          "chunkNumber": 18,
          "sanskrit": "दमा॑यन्तु ब्रह्मचा॒रिणः॒ स्वाहा᳚।"
        },
        {
          "id": "ta-7-4-19",
          "chunkNumber": 19,
          "sanskrit": "शमा॑यन्तु ब्रह्मचा॒रिणः॒ स्वाहा᳚ यशो॒ जने॑ऽसानि॒ स्वाहा᳚।"
        },
        {
          "id": "ta-7-4-20",
          "chunkNumber": 20,
          "sanskrit": "श्रेया॒न्॒वस्य॑सोऽसानि॒ स्वाहा᳚॥"
        },
        {
          "id": "ta-7-4-21",
          "chunkNumber": 21,
          "sanskrit": "तं त्वा॑ भग॒ प्रवि॑शानि॒ स्वाहा᳚।"
        },
        {
          "id": "ta-7-4-22",
          "chunkNumber": 22,
          "sanskrit": "स मा॑ भग॒ प्रवि॑श॒ स्वाहा᳚।"
        },
        {
          "id": "ta-7-4-23",
          "chunkNumber": 23,
          "sanskrit": "तस्मि᳚नथ् स॒हस्र॑ शाखे।"
        },
        {
          "id": "ta-7-4-24",
          "chunkNumber": 24,
          "sanskrit": "निभ॑गा॒हं त्वयि॑ मृजे॒ स्वाहा᳚॥"
        },
        {
          "id": "ta-7-4-25",
          "chunkNumber": 25,
          "sanskrit": "यथाऽऽपः॒ प्रव॑ता॒ऽऽयन्ति॑।"
        },
        {
          "id": "ta-7-4-26",
          "chunkNumber": 26,
          "sanskrit": "यथा॒ मासा॑ अहर्ज॒रम्।"
        },
        {
          "id": "ta-7-4-27",
          "chunkNumber": 27,
          "sanskrit": "ए॒वं मां ब्र॑ह्मचा॒रिणः॑।"
        },
        {
          "id": "ta-7-4-28",
          "chunkNumber": 28,
          "sanskrit": "धात॒राय॑न्तु स॒र्वतः॒ स्वाहा᳚॥"
        },
        {
          "id": "ta-7-4-29",
          "chunkNumber": 29,
          "sanskrit": "प्र॒ति॒वे॒शो॑ऽसि॒ प्र मा॑ भाहि॒ प्र मा॑ पद्यस्व"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-7-5",
      "title": "Prapāṭhaka 7 · Anuvāka 5",
      "sectionNumber": 5,
      "chunks": [
        {
          "id": "ta-7-5-1",
          "chunkNumber": 1,
          "sanskrit": "भूर्भुव॒स्सुव॒रिति॒ वा ए॒ता स्ति॒स्रो व्याहृ॑तयः॥",
          "section": 5
        },
        {
          "id": "ta-7-5-2",
          "chunkNumber": 2,
          "sanskrit": "तासा॑मुहस्मै॒ तां च॑तु॒र्त्थीम्।"
        },
        {
          "id": "ta-7-5-3",
          "chunkNumber": 3,
          "sanskrit": "माहा॑चमस्यः॒ प्रवे॑दयते।"
        },
        {
          "id": "ta-7-5-4",
          "chunkNumber": 4,
          "sanskrit": "मह॒ इति॑॥"
        },
        {
          "id": "ta-7-5-5",
          "chunkNumber": 5,
          "sanskrit": "तद् ब्रह्म॑।"
        },
        {
          "id": "ta-7-5-6",
          "chunkNumber": 6,
          "sanskrit": "स आ॒त्मा।"
        },
        {
          "id": "ta-7-5-7",
          "chunkNumber": 7,
          "sanskrit": "अङ्गा᳚न्य॒न्या दे॒वताः᳚॥"
        },
        {
          "id": "ta-7-5-8",
          "chunkNumber": 8,
          "sanskrit": "भूरिति॒ वा अ॒यल्ँलो॒कः।"
        },
        {
          "id": "ta-7-5-9",
          "chunkNumber": 9,
          "sanskrit": "भुव॒ इत्य॒न्तरि॑ख्षम्।"
        },
        {
          "id": "ta-7-5-10",
          "chunkNumber": 10,
          "sanskrit": "सुव॒रित्य॒सौ लो॒कः मह॒ इत्या॑दि॒त्यः।"
        },
        {
          "id": "ta-7-5-11",
          "chunkNumber": 11,
          "sanskrit": "आ॒दि॒त्येन॒ वाव सर्वे॑ लो॒का मही॑यन्ते॥"
        },
        {
          "id": "ta-7-5-12",
          "chunkNumber": 12,
          "sanskrit": "भूरिति॒ वा अ॒ग्निः।"
        },
        {
          "id": "ta-7-5-13",
          "chunkNumber": 13,
          "sanskrit": "भुव॒ इति॑ वा॒युः।"
        },
        {
          "id": "ta-7-5-14",
          "chunkNumber": 14,
          "sanskrit": "सुव॒रित्या॑दि॒त्यः।"
        },
        {
          "id": "ta-7-5-15",
          "chunkNumber": 15,
          "sanskrit": "मह॒ इति॑ च॒न्द्रमाः᳚।"
        },
        {
          "id": "ta-7-5-16",
          "chunkNumber": 16,
          "sanskrit": "च॒न्द्रम॑सा॒ वाव सर्वा॑णि॒ ज्योती॑ꣳषि॒ मही॑यन्ते॥"
        },
        {
          "id": "ta-7-5-17",
          "chunkNumber": 17,
          "sanskrit": "भूरिति॒ वा ऋचः॑।"
        },
        {
          "id": "ta-7-5-18",
          "chunkNumber": 18,
          "sanskrit": "भुव॒ इति॒ सामा॑नि।"
        },
        {
          "id": "ta-7-5-19",
          "chunkNumber": 19,
          "sanskrit": "सुव॒ रिति॒ यजू॑ꣳषि मह॒ इति॒ ब्रह्म॑।"
        },
        {
          "id": "ta-7-5-20",
          "chunkNumber": 20,
          "sanskrit": "ब्रह्म॑णा॒ वाव सर्वे॑ वे॒दा मही॑यन्ते॥"
        },
        {
          "id": "ta-7-5-21",
          "chunkNumber": 21,
          "sanskrit": "भूरिति॒ वै प्रा॒णः।"
        },
        {
          "id": "ta-7-5-22",
          "chunkNumber": 22,
          "sanskrit": "भुव॒ इत्य॑पा॒नः।"
        },
        {
          "id": "ta-7-5-23",
          "chunkNumber": 23,
          "sanskrit": "सुव॒रिति॑ व्या॒नः।"
        },
        {
          "id": "ta-7-5-24",
          "chunkNumber": 24,
          "sanskrit": "मह॒ इत्यन्नं᳚।"
        },
        {
          "id": "ta-7-5-25",
          "chunkNumber": 25,
          "sanskrit": "अन्ने॑न॒ वाव सर्वे᳚ प्रा॒णा मही॑यन्ते॥"
        },
        {
          "id": "ta-7-5-26",
          "chunkNumber": 26,
          "sanskrit": "ता वा ए॒ताश्चत॑स्र श्चतु॒द्र्धा।"
        },
        {
          "id": "ta-7-5-27",
          "chunkNumber": 27,
          "sanskrit": "चत॑स्रश्चतस्रो॒ व्याहृ॑तयः।"
        },
        {
          "id": "ta-7-5-28",
          "chunkNumber": 28,
          "sanskrit": "ता यो वेद॑।"
        },
        {
          "id": "ta-7-5-29",
          "chunkNumber": 29,
          "sanskrit": "स वे॑द॒ ब्रह्म॑।"
        },
        {
          "id": "ta-7-5-30",
          "chunkNumber": 30,
          "sanskrit": "सर्वे᳚ऽस्मै दे॒वा ब॒लिमाव॑हन्ति"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-7-6",
      "title": "Prapāṭhaka 7 · Anuvāka 6",
      "sectionNumber": 6,
      "chunks": [
        {
          "id": "ta-7-6-1",
          "chunkNumber": 1,
          "sanskrit": "स य ए॒षो᳚ऽन्तर्हृ॑दय आका॒शः।",
          "section": 6
        },
        {
          "id": "ta-7-6-2",
          "chunkNumber": 2,
          "sanskrit": "तस्मि॑न्न॒यं पुरु॑षो मनो॒मयः॑।"
        },
        {
          "id": "ta-7-6-3",
          "chunkNumber": 3,
          "sanskrit": "अमृ॑तो हिर॒ण्मयः॑॥"
        },
        {
          "id": "ta-7-6-4",
          "chunkNumber": 4,
          "sanskrit": "अन्त॑रेण॒ तालु॑के।"
        },
        {
          "id": "ta-7-6-5",
          "chunkNumber": 5,
          "sanskrit": "य ए॒ष स्तन॑ इवाव॒लंब॑ते।"
        },
        {
          "id": "ta-7-6-6",
          "chunkNumber": 6,
          "sanskrit": "से᳚न्द्र यो॒निः।"
        },
        {
          "id": "ta-7-6-7",
          "chunkNumber": 7,
          "sanskrit": "यत्रा॒सौ के॑शा॒न्तो वि॒वर्त॑ते।"
        },
        {
          "id": "ta-7-6-8",
          "chunkNumber": 8,
          "sanskrit": "व्य॒पोह्य॑ शीर्षकपा॒ले॥"
        },
        {
          "id": "ta-7-6-9",
          "chunkNumber": 9,
          "sanskrit": "भूरित्य॒ग्नौ प्रति॑तिष्ठति।"
        },
        {
          "id": "ta-7-6-10",
          "chunkNumber": 10,
          "sanskrit": "भुव॒ इति॑ वा॒यौ सुव॒रित्या॑दि॒त्ये।"
        },
        {
          "id": "ta-7-6-11",
          "chunkNumber": 11,
          "sanskrit": "मह॒ इति॒ ब्रह्म॑णि।"
        },
        {
          "id": "ta-7-6-12",
          "chunkNumber": 12,
          "sanskrit": "आ॒प्नोति॒ स्वारा᳚ज्यम्।"
        },
        {
          "id": "ta-7-6-13",
          "chunkNumber": 13,
          "sanskrit": "आ॒प्नोति॒ मन॑स॒स्पति᳚म्।"
        },
        {
          "id": "ta-7-6-14",
          "chunkNumber": 14,
          "sanskrit": "वाक्प॑ति॒ श्चख्षु॑ष्पतिः।"
        },
        {
          "id": "ta-7-6-15",
          "chunkNumber": 15,
          "sanskrit": "श्रोत्र॑पति र्वि॒ज्ञान॑पतिः।"
        },
        {
          "id": "ta-7-6-16",
          "chunkNumber": 16,
          "sanskrit": "ए॒तत् ततो॑ भवति।"
        },
        {
          "id": "ta-7-6-17",
          "chunkNumber": 17,
          "sanskrit": "आ॒का॒श श॑रीरं॒ ब्रह्म॑।"
        },
        {
          "id": "ta-7-6-18",
          "chunkNumber": 18,
          "sanskrit": "स॒त्यात्म॑ प्रा॒णारा॑मं॒ मन॑ आनन्दम्।"
        },
        {
          "id": "ta-7-6-19",
          "chunkNumber": 19,
          "sanskrit": "शान्ति॑ समृद्धम॒मृतं᳚॥"
        },
        {
          "id": "ta-7-6-20",
          "chunkNumber": 20,
          "sanskrit": "इति॑ प्राचीन यो॒ग्योपा᳚स्व"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-7-7",
      "title": "Prapāṭhaka 7 · Anuvāka 7",
      "sectionNumber": 7,
      "chunks": [
        {
          "id": "ta-7-7-1",
          "chunkNumber": 1,
          "sanskrit": "पृ॒थि॒व्य॑न्तरि॑ख्षं॒ द्यौर्दिशो॑ऽवान्तरदि॒शाः।",
          "section": 7
        },
        {
          "id": "ta-7-7-2",
          "chunkNumber": 2,
          "sanskrit": "अ॒ग्निर्वा॒युरा॑दि॒त्यश्च॒न्द्रमा॒ नख्ष॑त्राणि।"
        },
        {
          "id": "ta-7-7-3",
          "chunkNumber": 3,
          "sanskrit": "आप॒ ओष॑धयो॒ वन॒स्पत॑य आका॒श आ॒त्मा।"
        },
        {
          "id": "ta-7-7-4",
          "chunkNumber": 4,
          "sanskrit": "इत्य॑धिभू॒तम्॥"
        },
        {
          "id": "ta-7-7-5",
          "chunkNumber": 5,
          "sanskrit": "अथाद्ध्या॒त्मम्।"
        },
        {
          "id": "ta-7-7-6",
          "chunkNumber": 6,
          "sanskrit": "प्रा॒णो व्या॒नो॑ऽपा॒न उ॑दा॒नः स॑मा॒नः।"
        },
        {
          "id": "ta-7-7-7",
          "chunkNumber": 7,
          "sanskrit": "चख्षुः॒ श्रोत्रं॒ मनो॒ वाक् त्वक्।"
        },
        {
          "id": "ta-7-7-8",
          "chunkNumber": 8,
          "sanskrit": "चर्म॑ मा॒ꣳ॒ सꣴस्नावास्थि॑ म॒ज्जा॥"
        },
        {
          "id": "ta-7-7-9",
          "chunkNumber": 9,
          "sanskrit": "ए॒त द॑धिवि॒धाय॒र्षि॒ रवो॑चत्।"
        },
        {
          "id": "ta-7-7-10",
          "chunkNumber": 10,
          "sanskrit": "पाङ्क्त॒व्ँवा इ॒दꣳ सर्वं᳚।"
        },
        {
          "id": "ta-7-7-11",
          "chunkNumber": 11,
          "sanskrit": "पाङ्क्त॑नै॒व पाङ्क्त॑ꣴ स्पृणो॒तीति॑"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-7-8",
      "title": "Prapāṭhaka 7 · Anuvāka 8",
      "sectionNumber": 8,
      "chunks": [
        {
          "id": "ta-7-8-1",
          "chunkNumber": 1,
          "sanskrit": "ओमिति॒ ब्रह्म॑॥",
          "section": 8
        },
        {
          "id": "ta-7-8-2",
          "chunkNumber": 2,
          "sanskrit": "ओमिती॒दꣳ सर्व᳚म्॥"
        },
        {
          "id": "ta-7-8-3",
          "chunkNumber": 3,
          "sanskrit": "ओमित्ये॒तद॑नुकृति हस्म॒ वा अ॒प्यो श्रा॑व॒येत्याश्रा॑वयन्ति।"
        },
        {
          "id": "ta-7-8-4",
          "chunkNumber": 4,
          "sanskrit": "ओमिति॒ सामा॑नि गायन्ति।"
        },
        {
          "id": "ta-7-8-5",
          "chunkNumber": 5,
          "sanskrit": "ओꣳ शोमिति॑ श॒स्त्राणि॑ शꣳसन्ति।"
        },
        {
          "id": "ta-7-8-6",
          "chunkNumber": 6,
          "sanskrit": "ओमित्य॑द्ध्व॒र्युः प्र॑तिग॒रं प्रति॑गृणाति।"
        },
        {
          "id": "ta-7-8-7",
          "chunkNumber": 7,
          "sanskrit": "ओमिति॒ ब्रह्मा॒ प्रसौ॑ति।"
        },
        {
          "id": "ta-7-8-8",
          "chunkNumber": 8,
          "sanskrit": "ओमित्य॑ग्निहो॒त्रमनु॑जानाति।"
        },
        {
          "id": "ta-7-8-9",
          "chunkNumber": 9,
          "sanskrit": "ओमिति॑ ब्राह्म॒णः प्र॑व॒ख्ष्यन्ना॑ह॒ ब्रह्मोपा᳚प्नवा॒नीति॑।"
        },
        {
          "id": "ta-7-8-10",
          "chunkNumber": 10,
          "sanskrit": "ब्रह्मै॒वोपा᳚प्नोति"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-7-9",
      "title": "Prapāṭhaka 7 · Anuvāka 9",
      "sectionNumber": 9,
      "chunks": [
        {
          "id": "ta-7-9-1",
          "chunkNumber": 1,
          "sanskrit": "ऋतं च स्वाद्ध्याय प्रव॑चने॒ च।",
          "section": 9
        },
        {
          "id": "ta-7-9-2",
          "chunkNumber": 2,
          "sanskrit": "सत्यं च स्वाद्ध्याय प्रव॑चने॒ च।"
        },
        {
          "id": "ta-7-9-3",
          "chunkNumber": 3,
          "sanskrit": "तपश्च स्वाद्ध्याय प्रव॑चने॒ च।"
        },
        {
          "id": "ta-7-9-4",
          "chunkNumber": 4,
          "sanskrit": "दमश्च स्वाद्ध्याय प्रव॑चने॒ च।"
        },
        {
          "id": "ta-7-9-5",
          "chunkNumber": 5,
          "sanskrit": "शमश्च स्वाद्ध्याय प्रव॑चने॒ च।"
        },
        {
          "id": "ta-7-9-6",
          "chunkNumber": 6,
          "sanskrit": "अग्नयश्च स्वाद्ध्याय प्रव॑चने॒ च।"
        },
        {
          "id": "ta-7-9-7",
          "chunkNumber": 7,
          "sanskrit": "अग्निहोत्रं च स्वाद्ध्याय प्रव॑चने॒ च।"
        },
        {
          "id": "ta-7-9-8",
          "chunkNumber": 8,
          "sanskrit": "अतिथयश्च स्वाद्ध्याय प्रव॑चने॒ च।"
        },
        {
          "id": "ta-7-9-9",
          "chunkNumber": 9,
          "sanskrit": "मानुषं च स्वाद्ध्याय प्रव॑चने॒ च।"
        },
        {
          "id": "ta-7-9-10",
          "chunkNumber": 10,
          "sanskrit": "प्रजा च स्वाद्ध्याय प्रव॑चने॒ च।"
        },
        {
          "id": "ta-7-9-11",
          "chunkNumber": 11,
          "sanskrit": "प्रजनश्च स्वाद्ध्याय प्रव॑चने॒ च।"
        },
        {
          "id": "ta-7-9-12",
          "chunkNumber": 12,
          "sanskrit": "प्रजातिश्च स्वाद्ध्याय प्रव॑चने॒ च॥"
        },
        {
          "id": "ta-7-9-13",
          "chunkNumber": 13,
          "sanskrit": "सत्यमिति सत्यवचा॑ राथी॒ तरः।"
        },
        {
          "id": "ta-7-9-14",
          "chunkNumber": 14,
          "sanskrit": "तप इति तपोनित्यः पौ॑रुशि॒ष्टिः।"
        },
        {
          "id": "ta-7-9-15",
          "chunkNumber": 15,
          "sanskrit": "स्वाद्ध्याय प्रवचने एवेति नाको॑ मौद्ग॒ल्यः।"
        },
        {
          "id": "ta-7-9-16",
          "chunkNumber": 16,
          "sanskrit": "तद्धि तप॑स्तद्धि॒ तपः"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-7-10",
      "title": "Prapāṭhaka 7 · Anuvāka 10",
      "sectionNumber": 10,
      "chunks": [
        {
          "id": "ta-7-10-1",
          "chunkNumber": 1,
          "sanskrit": "अ॒हव्ँवृ॒ख्षस्य॒ रेरि॑वा।",
          "section": 10
        },
        {
          "id": "ta-7-10-2",
          "chunkNumber": 2,
          "sanskrit": "की॒र्तिः पृ॒ष्ठं गि॒रेरि॑व।"
        },
        {
          "id": "ta-7-10-3",
          "chunkNumber": 3,
          "sanskrit": "ऊ॒द्र्ध्व प॑वित्रो वा॒जिनी॑व स्व॒मृत॑मस्मि।"
        },
        {
          "id": "ta-7-10-4",
          "chunkNumber": 4,
          "sanskrit": "द्रवि॑ण॒ꣳ॒ सव॑र्चसम्।"
        },
        {
          "id": "ta-7-10-5",
          "chunkNumber": 5,
          "sanskrit": "सुमेधा अ॑मृतो॒ख्षितः।"
        },
        {
          "id": "ta-7-10-6",
          "chunkNumber": 6,
          "sanskrit": "इति त्रिशङ्कोर्वेदा॑नुव॒चनम्"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-7-11",
      "title": "Prapāṭhaka 7 · Anuvāka 11",
      "sectionNumber": 11,
      "chunks": [
        {
          "id": "ta-7-11-1",
          "chunkNumber": 1,
          "sanskrit": "वेदमनूच्या ऽचार्योन्तेवासिनम॑नुशा॒स्ति॥",
          "section": 11
        },
        {
          "id": "ta-7-11-2",
          "chunkNumber": 2,
          "sanskrit": "सत्य॒व्ँवद।"
        },
        {
          "id": "ta-7-11-3",
          "chunkNumber": 3,
          "sanskrit": "धर्मं॒ चर॥"
        },
        {
          "id": "ta-7-11-4",
          "chunkNumber": 4,
          "sanskrit": "स्वाद्ध्याया᳚न्मा प्र॒मदः।"
        },
        {
          "id": "ta-7-11-5",
          "chunkNumber": 5,
          "sanskrit": "आचार्याय प्रियं धनमाहृत्य प्रजातन्तुं मा व्य॑वच्छे॒थ्सीः।"
        },
        {
          "id": "ta-7-11-6",
          "chunkNumber": 6,
          "sanskrit": "सत्यान्न प्रम॑दित॒व्यम्।"
        },
        {
          "id": "ta-7-11-7",
          "chunkNumber": 7,
          "sanskrit": "धर्मान्न प्रम॑दित॒व्यम्।"
        },
        {
          "id": "ta-7-11-8",
          "chunkNumber": 8,
          "sanskrit": "कुशलान्न प्रम॑दित॒व्यम्।"
        },
        {
          "id": "ta-7-11-9",
          "chunkNumber": 9,
          "sanskrit": "भूत्यै न प्रम॑दित॒व्यम्।"
        },
        {
          "id": "ta-7-11-10",
          "chunkNumber": 10,
          "sanskrit": "स्वाद्ध्याय प्रवचनाभ्यां न प्रम॑दित॒व्यम् देवपितृकार्याभ्यां न प्रम॑दित॒व्यम्॥"
        },
        {
          "id": "ta-7-11-11",
          "chunkNumber": 11,
          "sanskrit": "मातृ॑देवो॒ भव।"
        },
        {
          "id": "ta-7-11-12",
          "chunkNumber": 12,
          "sanskrit": "पितृ॑देवो॒ भव।"
        },
        {
          "id": "ta-7-11-13",
          "chunkNumber": 13,
          "sanskrit": "आचार्य॑ देवो॒ भव।"
        },
        {
          "id": "ta-7-11-14",
          "chunkNumber": 14,
          "sanskrit": "अतिथि॑देवो॒ भव॥"
        },
        {
          "id": "ta-7-11-15",
          "chunkNumber": 15,
          "sanskrit": "यान्यनवद्यानि॑ कर्मा॒णि।"
        },
        {
          "id": "ta-7-11-16",
          "chunkNumber": 16,
          "sanskrit": "तानि सेवि॑तव्या॒नि।"
        },
        {
          "id": "ta-7-11-17",
          "chunkNumber": 17,
          "sanskrit": "नो इ॑तरा॒णि॥"
        },
        {
          "id": "ta-7-11-18",
          "chunkNumber": 18,
          "sanskrit": "यान्यस्माकꣳ सुच॑रिता॒नि।"
        },
        {
          "id": "ta-7-11-19",
          "chunkNumber": 19,
          "sanskrit": "तानि त्वयो॑पास्या॒नि नो इ॑तरा॒णि॥"
        },
        {
          "id": "ta-7-11-20",
          "chunkNumber": 20,
          "sanskrit": "ये के चास्मच्छ्रेया॑ꣳसो ब्रा॒ह्मणाः।"
        },
        {
          "id": "ta-7-11-21",
          "chunkNumber": 21,
          "sanskrit": "तेषां त्वयाऽऽसने न प्रश्व॑सित॒व्यम्॥"
        },
        {
          "id": "ta-7-11-22",
          "chunkNumber": 22,
          "sanskrit": "श्रद्ध॑या दे॒यम्।"
        },
        {
          "id": "ta-7-11-23",
          "chunkNumber": 23,
          "sanskrit": "अश्रद्ध॑याऽदे॒यम्।"
        },
        {
          "id": "ta-7-11-24",
          "chunkNumber": 24,
          "sanskrit": "श्रि॑या दे॒यम्।"
        },
        {
          "id": "ta-7-11-25",
          "chunkNumber": 25,
          "sanskrit": "ह्रि॑या दे॒यम्।"
        },
        {
          "id": "ta-7-11-26",
          "chunkNumber": 26,
          "sanskrit": "भि॑या दे॒यम्।"
        },
        {
          "id": "ta-7-11-27",
          "chunkNumber": 27,
          "sanskrit": "सव्ँवि॑दा दे॒यम्॥"
        },
        {
          "id": "ta-7-11-28",
          "chunkNumber": 28,
          "sanskrit": "अथ यदि ते कर्मविचिकिथ्सा वा वृत्त विचिकि॑थ्सा वा॒ स्यात् ये तत्र ब्राह्मणाः᳚ सम्म॒र॒शिनः।"
        },
        {
          "id": "ta-7-11-29",
          "chunkNumber": 29,
          "sanskrit": "युक्ता॑ आयु॒क्ताः।"
        },
        {
          "id": "ta-7-11-30",
          "chunkNumber": 30,
          "sanskrit": "अलूख्षा॑ धर्म॑कामाः॒ स्युः।"
        },
        {
          "id": "ta-7-11-31",
          "chunkNumber": 31,
          "sanskrit": "यथा ते॑ तत्र॑ वर्ते॒रन्न्।"
        },
        {
          "id": "ta-7-11-32",
          "chunkNumber": 32,
          "sanskrit": "तथा तत्र॑ वर्ते॒थाः॥"
        },
        {
          "id": "ta-7-11-33",
          "chunkNumber": 33,
          "sanskrit": "अथाभ्या᳚ख्याते॒षु।"
        },
        {
          "id": "ta-7-11-34",
          "chunkNumber": 34,
          "sanskrit": "ये तत्र ब्राह्मणाः᳚ सम्म॒र्॒शिनः।"
        },
        {
          "id": "ta-7-11-35",
          "chunkNumber": 35,
          "sanskrit": "युक्ता॑ आयु॒क्ताः।"
        },
        {
          "id": "ta-7-11-36",
          "chunkNumber": 36,
          "sanskrit": "अलूख्षा॑ धर्म॑ कामाः॒ स्युः।"
        },
        {
          "id": "ta-7-11-37",
          "chunkNumber": 37,
          "sanskrit": "यथा ते॑ तेषु॑ वर्ते॒रन्न् तथा तेषु॑ वर्ते॒थाः॥"
        },
        {
          "id": "ta-7-11-38",
          "chunkNumber": 38,
          "sanskrit": "एष॑ आदे॒शः।"
        },
        {
          "id": "ta-7-11-39",
          "chunkNumber": 39,
          "sanskrit": "एष उ॑पदे॒शः।"
        },
        {
          "id": "ta-7-11-40",
          "chunkNumber": 40,
          "sanskrit": "एषा वे॑दोप॒निषत्।"
        },
        {
          "id": "ta-7-11-41",
          "chunkNumber": 41,
          "sanskrit": "एतद॑नुशा॒सनम्।"
        },
        {
          "id": "ta-7-11-42",
          "chunkNumber": 42,
          "sanskrit": "एव मुपा॑सित॒व्यम्।"
        },
        {
          "id": "ta-7-11-43",
          "chunkNumber": 43,
          "sanskrit": "एव मुचैत॑दुपा॒स्यम्"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-7-12",
      "title": "Prapāṭhaka 7 · Anuvāka 12",
      "sectionNumber": 12,
      "chunks": [
        {
          "id": "ta-7-12-1",
          "chunkNumber": 1,
          "sanskrit": "शन्नो॑ मि॒त्रः शव्ँवरु॑णः।",
          "section": 12
        },
        {
          "id": "ta-7-12-2",
          "chunkNumber": 2,
          "sanskrit": "शन्नो॑ भवत्वर्य॒मा।"
        },
        {
          "id": "ta-7-12-3",
          "chunkNumber": 3,
          "sanskrit": "शन्न॒ इन्द्रो॒ बृह॒स्पतिः॑।"
        },
        {
          "id": "ta-7-12-4",
          "chunkNumber": 4,
          "sanskrit": "शन्नो॒ विष्णु॑ रुरुक्र॒मः।"
        },
        {
          "id": "ta-7-12-5",
          "chunkNumber": 5,
          "sanskrit": "नमो॒ ब्रह्म॑णे।"
        },
        {
          "id": "ta-7-12-6",
          "chunkNumber": 6,
          "sanskrit": "नम॑स्ते वायो।"
        },
        {
          "id": "ta-7-12-7",
          "chunkNumber": 7,
          "sanskrit": "त्वमे॒व प्र॒त्यख्षं॒ ब्रह्मा॑सि।"
        },
        {
          "id": "ta-7-12-8",
          "chunkNumber": 8,
          "sanskrit": "त्वामे॒व प्र॒त्यख्षं॒ ब्रह्मा वा॑दिषम्।"
        },
        {
          "id": "ta-7-12-9",
          "chunkNumber": 9,
          "sanskrit": "ऋ॒तम॑वादिषम्।"
        },
        {
          "id": "ta-7-12-10",
          "chunkNumber": 10,
          "sanskrit": "स॒त्यम॑वादिषं।"
        },
        {
          "id": "ta-7-12-11",
          "chunkNumber": 11,
          "sanskrit": "तन्मामा॑वीत्।"
        },
        {
          "id": "ta-7-12-12",
          "chunkNumber": 12,
          "sanskrit": "तद्व॒क्तार॑मावीत्।"
        },
        {
          "id": "ta-7-12-13",
          "chunkNumber": 13,
          "sanskrit": "आवी॒न्माम्।"
        },
        {
          "id": "ta-7-12-14",
          "chunkNumber": 14,
          "sanskrit": "आवी᳚द्व॒क्तार᳚म्॥"
        },
        {
          "id": "ta-7-12-15",
          "chunkNumber": 15,
          "sanskrit": "ओं शान्तिः॒ शान्तिः॒ शान्तिः॑"
        }
      ]
    }
  ]
}
