{
  "sections": [
    {
      "id": "taittiriya-brahmana-2-4-8",
      "title": "Aṣṭaka 2 · Prapāṭhaka 4 · Anuvāka 8",
      "sectionNumber": 8,
      "chunks": [
        {
          "id": "tb-2-4-8-1",
          "chunkNumber": 1,
          "sanskrit": "स प्र॑त्न॒वन्नवी॑यसा।",
          "section": 8
        },
        {
          "id": "tb-2-4-8-2",
          "chunkNumber": 2,
          "sanskrit": "अग्ने᳚ द्यु॒म्नेन॑ स॒य्ँयता᳚।"
        },
        {
          "id": "tb-2-4-8-3",
          "chunkNumber": 3,
          "sanskrit": "बृ॒हत् ततन्थ भा॒नुना᳚॥"
        },
        {
          "id": "tb-2-4-8-4",
          "chunkNumber": 4,
          "sanskrit": "नवं॒ नु स्तोम॑म॒ग्नये᳚।"
        },
        {
          "id": "tb-2-4-8-5",
          "chunkNumber": 5,
          "sanskrit": "दि॒वः श्ये॒नाय॑ जीजनम्।"
        },
        {
          "id": "tb-2-4-8-6",
          "chunkNumber": 6,
          "sanskrit": "वसोः᳚ कु॒विद्व॒नाति॑ नः॥"
        },
        {
          "id": "tb-2-4-8-7",
          "chunkNumber": 7,
          "sanskrit": "स्वा॒रु॒हा यस्य॒ श्रियो॑ दृ॒शे।"
        },
        {
          "id": "tb-2-4-8-8",
          "chunkNumber": 8,
          "sanskrit": "र॒यिर्वी॒रव॑तो यथा।"
        },
        {
          "id": "tb-2-4-8-9",
          "chunkNumber": 9,
          "sanskrit": "अग्रे॑ य॒ज्ञस्य॒ चेत॑तः॥"
        },
        {
          "id": "tb-2-4-8-10",
          "chunkNumber": 10,
          "sanskrit": "अदा᳚भ्यः पुर ए॒ता अ॒ग्निर्वि॒शां मानु॑षीणाम्।"
        },
        {
          "id": "tb-2-4-8-11",
          "chunkNumber": 11,
          "sanskrit": "तूर्णी॒ रथः॒ सदा॒ नवः॑॥"
        },
        {
          "id": "tb-2-4-8-12",
          "chunkNumber": 12,
          "sanskrit": "नव॒ꣳ॒ सोमा॑य वा॒जिने᳚।"
        },
        {
          "id": "tb-2-4-8-13",
          "chunkNumber": 13,
          "sanskrit": "आज्यं॒ पय॑सोऽजनि।"
        },
        {
          "id": "tb-2-4-8-14",
          "chunkNumber": 14,
          "sanskrit": "जुष्ट॒ꣳ॒ शुचि॑तम॒व्ँवसु॑॥"
        },
        {
          "id": "tb-2-4-8-15",
          "chunkNumber": 15,
          "sanskrit": "नव॑ꣳ सोम जुषस्व नः।"
        },
        {
          "id": "tb-2-4-8-16",
          "chunkNumber": 16,
          "sanskrit": "पी॒यूष॑स्ये॒ह तृ॑प्णुहि।"
        },
        {
          "id": "tb-2-4-8-17",
          "chunkNumber": 17,
          "sanskrit": "यस्ते॑ भा॒ग ऋ॒ताव॒यम्॥"
        },
        {
          "id": "tb-2-4-8-18",
          "chunkNumber": 18,
          "sanskrit": "नव॑स्य सोम ते व॒यम्।"
        },
        {
          "id": "tb-2-4-8-19",
          "chunkNumber": 19,
          "sanskrit": "आ सु॑म॒तिव्ँवृ॑णीमहे स नो॑ रास्व सह॒स्रिणः॑॥"
        },
        {
          "id": "tb-2-4-8-20",
          "chunkNumber": 20,
          "sanskrit": "नव॑ꣳ ह॒विर्जु॑षस्व नः।"
        },
        {
          "id": "tb-2-4-8-21",
          "chunkNumber": 21,
          "sanskrit": "ऋ॒तुभिः॑ सोम॒ भूत॑मम्।"
        },
        {
          "id": "tb-2-4-8-22",
          "chunkNumber": 22,
          "sanskrit": "तद॒ङ्ग प्रति॑हर्य नः।"
        },
        {
          "id": "tb-2-4-8-23",
          "chunkNumber": 23,
          "sanskrit": "राजन᳚थ् सोम स्व॒स्तये᳚॥"
        },
        {
          "id": "tb-2-4-8-24",
          "chunkNumber": 24,
          "sanskrit": "नव॒ꣴ॒ स्तोमं॒ नव॑ꣳ ह॒विः।"
        },
        {
          "id": "tb-2-4-8-25",
          "chunkNumber": 25,
          "sanskrit": "इ॒न्द्रा॒ग्निभ्यां॒ निवे॑दय।"
        },
        {
          "id": "tb-2-4-8-26",
          "chunkNumber": 26,
          "sanskrit": "तज्जु॑षेता॒ꣳ॒ सचे॑तसा॥"
        },
        {
          "id": "tb-2-4-8-27",
          "chunkNumber": 27,
          "sanskrit": "शुचिं॒ नु स्तोमं॒ नव॑जातम॒द्य।"
        },
        {
          "id": "tb-2-4-8-28",
          "chunkNumber": 28,
          "sanskrit": "इन्द्रा᳚ग्नी वृत्रहणा जु॒षेथा᳚म् उ॒भा हि वा॑ꣳ सु॒हवा॒ जोह॑वीमि।"
        },
        {
          "id": "tb-2-4-8-29",
          "chunkNumber": 29,
          "sanskrit": "ता वाज॑ꣳ स॒द्य उ॑श॒ते धेष्ठा᳚॥"
        },
        {
          "id": "tb-2-4-8-30",
          "chunkNumber": 30,
          "sanskrit": "अ॒ग्निरिन्द्रो॒ नव॑स्य नः।"
        },
        {
          "id": "tb-2-4-8-31",
          "chunkNumber": 31,
          "sanskrit": "अ॒स्य ह॒व्यस्य॑ तृप्यताम्।"
        },
        {
          "id": "tb-2-4-8-32",
          "chunkNumber": 32,
          "sanskrit": "इ॒ह दे॒वौ स॑ह॒स्रिणौ᳚॥"
        },
        {
          "id": "tb-2-4-8-33",
          "chunkNumber": 33,
          "sanskrit": "य॒ज्ञं न॒ आ हि गच्छ॑ताम्।"
        },
        {
          "id": "tb-2-4-8-34",
          "chunkNumber": 34,
          "sanskrit": "वसु॑मन्तꣳ सुव॒र्विद᳚म्।"
        },
        {
          "id": "tb-2-4-8-35",
          "chunkNumber": 35,
          "sanskrit": "अ॒स्य ह॒व्यस्य॑ तृप्यताम्।"
        },
        {
          "id": "tb-2-4-8-36",
          "chunkNumber": 36,
          "sanskrit": "अ॒ग्निरिन्द्रो॒ नव॑स्य नः॥"
        },
        {
          "id": "tb-2-4-8-37",
          "chunkNumber": 37,
          "sanskrit": "विश्वा᳚न् दे॒वाꣴ स्त॑र्पयत ह॒विषो॒ऽस्य नव॑स्य नः।"
        },
        {
          "id": "tb-2-4-8-38",
          "chunkNumber": 38,
          "sanskrit": "सु॒व॒र्विदो॒ हि ज॑ज्ञि॒रे॥"
        },
        {
          "id": "tb-2-4-8-39",
          "chunkNumber": 39,
          "sanskrit": "एदं ब॒र्॒हिः सु॒ष्टरी॑मा॒ नवे॑न।"
        },
        {
          "id": "tb-2-4-8-40",
          "chunkNumber": 40,
          "sanskrit": "अ॒यय्ँय॒ज्ञो यज॑मानस्य भा॒गः।"
        },
        {
          "id": "tb-2-4-8-41",
          "chunkNumber": 41,
          "sanskrit": "अ॒यं ब॑भूव॒ भुव॑नस्य॒ गर्भः॑।"
        },
        {
          "id": "tb-2-4-8-42",
          "chunkNumber": 42,
          "sanskrit": "विश्वे॑ दे॒वा इ॒दम॒द्याग॑मिष्ठाः॥"
        },
        {
          "id": "tb-2-4-8-43",
          "chunkNumber": 43,
          "sanskrit": "इ॒मे नु द्यावा॑पृथि॒वी स॒मीची᳚।"
        },
        {
          "id": "tb-2-4-8-44",
          "chunkNumber": 44,
          "sanskrit": "त॒न्वा॒ने य॒ज्ञं पु॑रु॒पेश॑सं धि॒या।"
        },
        {
          "id": "tb-2-4-8-45",
          "chunkNumber": 45,
          "sanskrit": "आऽस्मै॑ पृणीतां॒ भुव॑नानि॒ विश्वा᳚।"
        },
        {
          "id": "tb-2-4-8-46",
          "chunkNumber": 46,
          "sanskrit": "प्र॒जां पुष्टि॑म॒मृतं॒ नवे॑न इ॒मे धे॒नू अ॒मृत॒य्ँये दु॒हाते᳚।"
        },
        {
          "id": "tb-2-4-8-47",
          "chunkNumber": 47,
          "sanskrit": "पय॑स्वत्युत्त॒रामे॑तु॒ पुष्टिः॑।"
        },
        {
          "id": "tb-2-4-8-48",
          "chunkNumber": 48,
          "sanskrit": "इ॒मय्ँय॒ज्ञं जु॒षमा॑णे॒ नवे॑न।"
        },
        {
          "id": "tb-2-4-8-49",
          "chunkNumber": 49,
          "sanskrit": "स॒मीची॒ द्यावा॑पृथि॒वी घृ॒ताची᳚॥"
        },
        {
          "id": "tb-2-4-8-50",
          "chunkNumber": 50,
          "sanskrit": "यवि॑ष्ठो हव्य॒वाह॑नः।"
        },
        {
          "id": "tb-2-4-8-51",
          "chunkNumber": 51,
          "sanskrit": "चि॒त्रभा॑नुर्घृ॒तासु॑तिः।"
        },
        {
          "id": "tb-2-4-8-52",
          "chunkNumber": 52,
          "sanskrit": "नव॑जातो॒ विरो॑चसे।"
        },
        {
          "id": "tb-2-4-8-53",
          "chunkNumber": 53,
          "sanskrit": "अग्ने॒ तत्ते॑ महित्व॒नम्॥"
        },
        {
          "id": "tb-2-4-8-54",
          "chunkNumber": 54,
          "sanskrit": "त्वम॑ग्ने दे॒वता᳚भ्यः।"
        },
        {
          "id": "tb-2-4-8-55",
          "chunkNumber": 55,
          "sanskrit": "भा॒गे दे॑व॒ न मी॑यसे स ए॑ना वि॒द्वान्य॑ख्ष्यसि।"
        },
        {
          "id": "tb-2-4-8-56",
          "chunkNumber": 56,
          "sanskrit": "नव॒ꣴ॒ स्तोमं॑ जुषस्व नः॥"
        },
        {
          "id": "tb-2-4-8-57",
          "chunkNumber": 57,
          "sanskrit": "अ॒ग्निः प्र॑थ॒मः प्राश्ञा॑तु।"
        },
        {
          "id": "tb-2-4-8-58",
          "chunkNumber": 58,
          "sanskrit": "स हि वेद॒ यथा॑ ह॒विः।"
        },
        {
          "id": "tb-2-4-8-59",
          "chunkNumber": 59,
          "sanskrit": "शि॒वा अ॒स्मभ्य॒मोष॑धीः।"
        },
        {
          "id": "tb-2-4-8-60",
          "chunkNumber": 60,
          "sanskrit": "कृ॒णोतु॑ वि॒श्वच॑र्षणिः॥"
        },
        {
          "id": "tb-2-4-8-61",
          "chunkNumber": 61,
          "sanskrit": "भ॒द्रान्नः॒ श्रेयः॒ सम॑नैष्ट देवाः।"
        },
        {
          "id": "tb-2-4-8-62",
          "chunkNumber": 62,
          "sanskrit": "त्वया॑ऽव॒सेन॒ सम॑शीमहि त्वा।"
        },
        {
          "id": "tb-2-4-8-63",
          "chunkNumber": 63,
          "sanskrit": "स नो॑ मयो॒भूः पि॑तो॒ आवि॑शस्व।"
        },
        {
          "id": "tb-2-4-8-64",
          "chunkNumber": 64,
          "sanskrit": "शं तो॒काय॑ त॒नुवे᳚ स्यो॒नः॥"
        },
        {
          "id": "tb-2-4-8-65",
          "chunkNumber": 65,
          "sanskrit": "ए॒तमु॒ त्यं मधु॑ना॒ सय्ँयु॑त॒य्ँयव᳚म्।"
        },
        {
          "id": "tb-2-4-8-66",
          "chunkNumber": 66,
          "sanskrit": "सर॑स्वत्या॒ अधि॑म॒नाव॑चर्कृषुः।"
        },
        {
          "id": "tb-2-4-8-67",
          "chunkNumber": 67,
          "sanskrit": "इन्द्र॑ आसी॒थ् सीर॑पतिः श॒तक्र॑तुः।"
        },
        {
          "id": "tb-2-4-8-68",
          "chunkNumber": 68,
          "sanskrit": "की॒नाशा॑ आसन् म॒रुतः॑ सु॒दान॑वः"
        }
      ]
    }
  ]
}
