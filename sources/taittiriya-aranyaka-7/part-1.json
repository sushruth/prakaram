{
  "sections": [
    {
      "id": "taittiriya-aranyaka-7-1",
      "title": "Prapāṭhaka 7 · Anuvāka 1",
      "sectionNumber": 1,
      "chunks": [
        {
          "id": "ta-7-1-1",
          "chunkNumber": 1,
          "sanskrit": "śanno̍ mi̠traḥ śavm̐varu̍ṇaḥ|",
          "section": 1
        },
        {
          "id": "ta-7-1-2",
          "chunkNumber": 2,
          "sanskrit": "śanno̍ bhavatvarya̠mā|"
        },
        {
          "id": "ta-7-1-3",
          "chunkNumber": 3,
          "sanskrit": "śanna̠ indro̠ bṛha̠spatiḥ̍|"
        },
        {
          "id": "ta-7-1-4",
          "chunkNumber": 4,
          "sanskrit": "śanno̠ viṣṇu̍rurukra̠maḥ|"
        },
        {
          "id": "ta-7-1-5",
          "chunkNumber": 5,
          "sanskrit": "namo̠ brahma̍ṇe|"
        },
        {
          "id": "ta-7-1-6",
          "chunkNumber": 6,
          "sanskrit": "nama̍ste vāyo|"
        },
        {
          "id": "ta-7-1-7",
          "chunkNumber": 7,
          "sanskrit": "tvame̠va pra̠tyakhṣaṃ̠ brahmā̍si|"
        },
        {
          "id": "ta-7-1-8",
          "chunkNumber": 8,
          "sanskrit": "tvame̠va pra̠tyakhṣaṃ̠ brahma̍ vadiṣyāmi|"
        },
        {
          "id": "ta-7-1-9",
          "chunkNumber": 9,
          "sanskrit": "ṛ̠tavm̐va̍diṣyāmi|"
        },
        {
          "id": "ta-7-1-10",
          "chunkNumber": 10,
          "sanskrit": "sa̠tyavm̐va̍diṣyāmi|"
        },
        {
          "id": "ta-7-1-11",
          "chunkNumber": 11,
          "sanskrit": "tanmāma̍vatu|"
        },
        {
          "id": "ta-7-1-12",
          "chunkNumber": 12,
          "sanskrit": "tadva̠ktāra̍mavatu|"
        },
        {
          "id": "ta-7-1-13",
          "chunkNumber": 13,
          "sanskrit": "ava̍tu̠ mām|"
        },
        {
          "id": "ta-7-1-14",
          "chunkNumber": 14,
          "sanskrit": "ava̍tu va̠ktāraṃ̎||"
        },
        {
          "id": "ta-7-1-15",
          "chunkNumber": 15,
          "sanskrit": "oṃ śāntiḥ̠ śāntiḥ̠ śāntiḥ̍"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-7-2",
      "title": "Prapāṭhaka 7 · Anuvāka 2",
      "sectionNumber": 2,
      "chunks": [
        {
          "id": "ta-7-2-1",
          "chunkNumber": 1,
          "sanskrit": "śīkhṣāvm̐vyā̎khyāsyā̠maḥ|",
          "section": 2
        },
        {
          "id": "ta-7-2-2",
          "chunkNumber": 2,
          "sanskrit": "varṇaḥ̠ svaraḥ|"
        },
        {
          "id": "ta-7-2-3",
          "chunkNumber": 3,
          "sanskrit": "mātrā̠ balam|"
        },
        {
          "id": "ta-7-2-4",
          "chunkNumber": 4,
          "sanskrit": "sāma̍ santā̠naḥ|"
        },
        {
          "id": "ta-7-2-5",
          "chunkNumber": 5,
          "sanskrit": "ityuktaḥ śī̎khṣāddhyā̠yaḥ"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-7-3",
      "title": "Prapāṭhaka 7 · Anuvāka 3",
      "sectionNumber": 3,
      "chunks": [
        {
          "id": "ta-7-3-1",
          "chunkNumber": 1,
          "sanskrit": "sa̠ha nau̠ yaśaḥ|",
          "section": 3
        },
        {
          "id": "ta-7-3-2",
          "chunkNumber": 2,
          "sanskrit": "sa̠ha nau bra̍hmava̠rcasam||"
        },
        {
          "id": "ta-7-3-3",
          "chunkNumber": 3,
          "sanskrit": "athātaḥ sagͫhitāyā upaniṣadavm̐vyā̎khyāsyā̠maḥ|"
        },
        {
          "id": "ta-7-3-4",
          "chunkNumber": 4,
          "sanskrit": "pañcasvadhika̍raṇe̠ṣu|"
        },
        {
          "id": "ta-7-3-5",
          "chunkNumber": 5,
          "sanskrit": "adhilokamadhijyautiṣamadhividyamadhipraja̍maddhyā̠tmam|"
        },
        {
          "id": "ta-7-3-6",
          "chunkNumber": 6,
          "sanskrit": "tā mahāsagͫhitā i̍tyāca̠khṣate||"
        },
        {
          "id": "ta-7-3-7",
          "chunkNumber": 7,
          "sanskrit": "athā̍dhi lo̠kam|"
        },
        {
          "id": "ta-7-3-8",
          "chunkNumber": 8,
          "sanskrit": "pṛthivī pū̎rvarū̠pam|"
        },
        {
          "id": "ta-7-3-9",
          "chunkNumber": 9,
          "sanskrit": "dyaurutta̍rarū̠pam|"
        },
        {
          "id": "ta-7-3-10",
          "chunkNumber": 10,
          "sanskrit": "ākā̍śaḥ sa̠ndhiḥ vāyuḥ̍ sandhā̠nam|"
        },
        {
          "id": "ta-7-3-11",
          "chunkNumber": 11,
          "sanskrit": "itya̍dhi lo̠kam||"
        },
        {
          "id": "ta-7-3-12",
          "chunkNumber": 12,
          "sanskrit": "athā̍dhi jyau̠tiṣam|"
        },
        {
          "id": "ta-7-3-13",
          "chunkNumber": 13,
          "sanskrit": "agniḥ pū̎rva rū̠pam|"
        },
        {
          "id": "ta-7-3-14",
          "chunkNumber": 14,
          "sanskrit": "āditya utta̍rarū̠pam|"
        },
        {
          "id": "ta-7-3-15",
          "chunkNumber": 15,
          "sanskrit": "ā̍paḥ sa̠ndhiḥ|"
        },
        {
          "id": "ta-7-3-16",
          "chunkNumber": 16,
          "sanskrit": "vaidyutaḥ̍ sandhā̠nam|"
        },
        {
          "id": "ta-7-3-17",
          "chunkNumber": 17,
          "sanskrit": "itya̍dhi jyau̠tiṣam||"
        },
        {
          "id": "ta-7-3-18",
          "chunkNumber": 18,
          "sanskrit": "athā̍dhi vi̠dyam|"
        },
        {
          "id": "ta-7-3-19",
          "chunkNumber": 19,
          "sanskrit": "ācāryaḥ pū̎rva rū̠pam antevāsyutta̍rarū̠pam|"
        },
        {
          "id": "ta-7-3-20",
          "chunkNumber": 20,
          "sanskrit": "vi̍dyā sa̠ndhiḥ|"
        },
        {
          "id": "ta-7-3-21",
          "chunkNumber": 21,
          "sanskrit": "pravacana̍gͫ sandhā̠nam|"
        },
        {
          "id": "ta-7-3-22",
          "chunkNumber": 22,
          "sanskrit": "itya̍dhi vi̠dyam||"
        },
        {
          "id": "ta-7-3-23",
          "chunkNumber": 23,
          "sanskrit": "athādhi̠prajam|"
        },
        {
          "id": "ta-7-3-24",
          "chunkNumber": 24,
          "sanskrit": "mātā pū̎rvarū̠pam|"
        },
        {
          "id": "ta-7-3-25",
          "chunkNumber": 25,
          "sanskrit": "pitotta̍rarū̠pam|"
        },
        {
          "id": "ta-7-3-26",
          "chunkNumber": 26,
          "sanskrit": "pra̍jā sa̠ndhiḥ|"
        },
        {
          "id": "ta-7-3-27",
          "chunkNumber": 27,
          "sanskrit": "prajanana̍gͫ sandhā̠nam|"
        },
        {
          "id": "ta-7-3-28",
          "chunkNumber": 28,
          "sanskrit": "ityadhi̠prajam athāddhyā̠tmam|"
        },
        {
          "id": "ta-7-3-29",
          "chunkNumber": 29,
          "sanskrit": "adharāhanuḥ pū̎rva rū̠pam|"
        },
        {
          "id": "ta-7-3-30",
          "chunkNumber": 30,
          "sanskrit": "uttarāhanurutta̍rarū̠pam|"
        },
        {
          "id": "ta-7-3-31",
          "chunkNumber": 31,
          "sanskrit": "vākh sa̠ndhiḥ|"
        },
        {
          "id": "ta-7-3-32",
          "chunkNumber": 32,
          "sanskrit": "jihvā̍ sandhā̠nam|"
        },
        {
          "id": "ta-7-3-33",
          "chunkNumber": 33,
          "sanskrit": "ityaddhyā̠tmam||"
        },
        {
          "id": "ta-7-3-34",
          "chunkNumber": 34,
          "sanskrit": "itī māma̍hā sa̠g̠ͫhitāḥ||"
        },
        {
          "id": "ta-7-3-35",
          "chunkNumber": 35,
          "sanskrit": "ya evametā mahāsagͫhitā vyākhyā̍tā ve̠da|"
        },
        {
          "id": "ta-7-3-36",
          "chunkNumber": 36,
          "sanskrit": "sandhīyate praja̍yā pa̠śubhiḥ|"
        },
        {
          "id": "ta-7-3-37",
          "chunkNumber": 37,
          "sanskrit": "brahmavarcasenānnādyena suvargyeṇa̍ (suvargeṇa̍) loke̠na"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-7-4",
      "title": "Prapāṭhaka 7 · Anuvāka 4",
      "sectionNumber": 4,
      "chunks": [
        {
          "id": "ta-7-4-1",
          "chunkNumber": 1,
          "sanskrit": "yaśchanda̍sāmṛṣa̠bho vi̠śvarū̍paḥ|",
          "section": 4
        },
        {
          "id": "ta-7-4-2",
          "chunkNumber": 2,
          "sanskrit": "chando̠bhyo'ddhya̠mṛtā̎th saṃba̠bhūva̍|"
        },
        {
          "id": "ta-7-4-3",
          "chunkNumber": 3,
          "sanskrit": "sa mendro̍ me̠dhayā̎ spṛṇotu|"
        },
        {
          "id": "ta-7-4-4",
          "chunkNumber": 4,
          "sanskrit": "a̠mṛta̍sya deva̠ dhāra̍ṇo bhūyāsam||"
        },
        {
          "id": "ta-7-4-5",
          "chunkNumber": 5,
          "sanskrit": "śarī̍raṃ me̠ vica̍rṣaṇam|"
        },
        {
          "id": "ta-7-4-6",
          "chunkNumber": 6,
          "sanskrit": "ji̠hvā me̠ madhu̍mattamā|"
        },
        {
          "id": "ta-7-4-7",
          "chunkNumber": 7,
          "sanskrit": "karṇā̎bhyāṃ̠ bhūri̠ viśru̍vam|"
        },
        {
          "id": "ta-7-4-8",
          "chunkNumber": 8,
          "sanskrit": "brahma̍ṇaḥ ko̠śo̍'si me̠dhayā 'pi̍hitaḥ|"
        },
        {
          "id": "ta-7-4-9",
          "chunkNumber": 9,
          "sanskrit": "śru̠taṃ me̍ gopāya||"
        },
        {
          "id": "ta-7-4-10",
          "chunkNumber": 10,
          "sanskrit": "ā̠vaha̍ntī vitanvā̠nā ku̠rvā̠ṇā cīra̍mā̠tmanaḥ̍|"
        },
        {
          "id": "ta-7-4-11",
          "chunkNumber": 11,
          "sanskrit": "vāsā̍gͫsi̠ mama̠ gāva̍śca|"
        },
        {
          "id": "ta-7-4-12",
          "chunkNumber": 12,
          "sanskrit": "a̠nna̠pā̠ne ca̍ sarva̠dā|"
        },
        {
          "id": "ta-7-4-13",
          "chunkNumber": 13,
          "sanskrit": "tato̍ me̠ śriya̠māva̍ha|"
        },
        {
          "id": "ta-7-4-14",
          "chunkNumber": 14,
          "sanskrit": "lo̠ma̠śāṃ pa̠śubhiḥ̍ sa̠ha svāhā̎||"
        },
        {
          "id": "ta-7-4-15",
          "chunkNumber": 15,
          "sanskrit": "āmā̍yantu brahmacā̠riṇaḥ̠ svāhā̎|"
        },
        {
          "id": "ta-7-4-16",
          "chunkNumber": 16,
          "sanskrit": "vimā̍''yantu brahmacā̠riṇaḥ̠ svāhā̎|"
        },
        {
          "id": "ta-7-4-17",
          "chunkNumber": 17,
          "sanskrit": "pramā̍''yantu brahmacā̠riṇaḥ̠ svāhā̎|"
        },
        {
          "id": "ta-7-4-18",
          "chunkNumber": 18,
          "sanskrit": "damā̍yantu brahmacā̠riṇaḥ̠ svāhā̎|"
        },
        {
          "id": "ta-7-4-19",
          "chunkNumber": 19,
          "sanskrit": "śamā̍yantu brahmacā̠riṇaḥ̠ svāhā̎ yaśo̠ jane̍'sāni̠ svāhā̎|"
        },
        {
          "id": "ta-7-4-20",
          "chunkNumber": 20,
          "sanskrit": "śreyā̠n̠vasya̍so'sāni̠ svāhā̎||"
        },
        {
          "id": "ta-7-4-21",
          "chunkNumber": 21,
          "sanskrit": "taṃ tvā̍ bhaga̠ pravi̍śāni̠ svāhā̎|"
        },
        {
          "id": "ta-7-4-22",
          "chunkNumber": 22,
          "sanskrit": "sa mā̍ bhaga̠ pravi̍śa̠ svāhā̎|"
        },
        {
          "id": "ta-7-4-23",
          "chunkNumber": 23,
          "sanskrit": "tasmi̎nath sa̠hasra̍ śākhe|"
        },
        {
          "id": "ta-7-4-24",
          "chunkNumber": 24,
          "sanskrit": "nibha̍gā̠haṃ tvayi̍ mṛje̠ svāhā̎||"
        },
        {
          "id": "ta-7-4-25",
          "chunkNumber": 25,
          "sanskrit": "yathā''paḥ̠ prava̍tā̠''yanti̍|"
        },
        {
          "id": "ta-7-4-26",
          "chunkNumber": 26,
          "sanskrit": "yathā̠ māsā̍ aharja̠ram|"
        },
        {
          "id": "ta-7-4-27",
          "chunkNumber": 27,
          "sanskrit": "e̠vaṃ māṃ bra̍hmacā̠riṇaḥ̍|"
        },
        {
          "id": "ta-7-4-28",
          "chunkNumber": 28,
          "sanskrit": "dhāta̠rāya̍ntu sa̠rvataḥ̠ svāhā̎||"
        },
        {
          "id": "ta-7-4-29",
          "chunkNumber": 29,
          "sanskrit": "pra̠ti̠ve̠śo̍'si̠ pra mā̍ bhāhi̠ pra mā̍ padyasva"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-7-5",
      "title": "Prapāṭhaka 7 · Anuvāka 5",
      "sectionNumber": 5,
      "chunks": [
        {
          "id": "ta-7-5-1",
          "chunkNumber": 1,
          "sanskrit": "bhūrbhuva̠ssuva̠riti̠ vā e̠tā sti̠sro vyāhṛ̍tayaḥ||",
          "section": 5
        },
        {
          "id": "ta-7-5-2",
          "chunkNumber": 2,
          "sanskrit": "tāsā̍muhasmai̠ tāṃ ca̍tu̠rtthīm|"
        },
        {
          "id": "ta-7-5-3",
          "chunkNumber": 3,
          "sanskrit": "māhā̍camasyaḥ̠ prave̍dayate|"
        },
        {
          "id": "ta-7-5-4",
          "chunkNumber": 4,
          "sanskrit": "maha̠ iti̍||"
        },
        {
          "id": "ta-7-5-5",
          "chunkNumber": 5,
          "sanskrit": "tad brahma̍|"
        },
        {
          "id": "ta-7-5-6",
          "chunkNumber": 6,
          "sanskrit": "sa ā̠tmā|"
        },
        {
          "id": "ta-7-5-7",
          "chunkNumber": 7,
          "sanskrit": "aṅgā̎nya̠nyā de̠vatāḥ̎||"
        },
        {
          "id": "ta-7-5-8",
          "chunkNumber": 8,
          "sanskrit": "bhūriti̠ vā a̠yalm̐lo̠kaḥ|"
        },
        {
          "id": "ta-7-5-9",
          "chunkNumber": 9,
          "sanskrit": "bhuva̠ itya̠ntari̍khṣam|"
        },
        {
          "id": "ta-7-5-10",
          "chunkNumber": 10,
          "sanskrit": "suva̠ritya̠sau lo̠kaḥ maha̠ ityā̍di̠tyaḥ|"
        },
        {
          "id": "ta-7-5-11",
          "chunkNumber": 11,
          "sanskrit": "ā̠di̠tyena̠ vāva sarve̍ lo̠kā mahī̍yante||"
        },
        {
          "id": "ta-7-5-12",
          "chunkNumber": 12,
          "sanskrit": "bhūriti̠ vā a̠gniḥ|"
        },
        {
          "id": "ta-7-5-13",
          "chunkNumber": 13,
          "sanskrit": "bhuva̠ iti̍ vā̠yuḥ|"
        },
        {
          "id": "ta-7-5-14",
          "chunkNumber": 14,
          "sanskrit": "suva̠rityā̍di̠tyaḥ|"
        },
        {
          "id": "ta-7-5-15",
          "chunkNumber": 15,
          "sanskrit": "maha̠ iti̍ ca̠ndramāḥ̎|"
        },
        {
          "id": "ta-7-5-16",
          "chunkNumber": 16,
          "sanskrit": "ca̠ndrama̍sā̠ vāva sarvā̍ṇi̠ jyotī̍gͫṣi̠ mahī̍yante||"
        },
        {
          "id": "ta-7-5-17",
          "chunkNumber": 17,
          "sanskrit": "bhūriti̠ vā ṛcaḥ̍|"
        },
        {
          "id": "ta-7-5-18",
          "chunkNumber": 18,
          "sanskrit": "bhuva̠ iti̠ sāmā̍ni|"
        },
        {
          "id": "ta-7-5-19",
          "chunkNumber": 19,
          "sanskrit": "suva̠ riti̠ yajū̍gͫṣi maha̠ iti̠ brahma̍|"
        },
        {
          "id": "ta-7-5-20",
          "chunkNumber": 20,
          "sanskrit": "brahma̍ṇā̠ vāva sarve̍ ve̠dā mahī̍yante||"
        },
        {
          "id": "ta-7-5-21",
          "chunkNumber": 21,
          "sanskrit": "bhūriti̠ vai prā̠ṇaḥ|"
        },
        {
          "id": "ta-7-5-22",
          "chunkNumber": 22,
          "sanskrit": "bhuva̠ itya̍pā̠naḥ|"
        },
        {
          "id": "ta-7-5-23",
          "chunkNumber": 23,
          "sanskrit": "suva̠riti̍ vyā̠naḥ|"
        },
        {
          "id": "ta-7-5-24",
          "chunkNumber": 24,
          "sanskrit": "maha̠ ityannaṃ̎|"
        },
        {
          "id": "ta-7-5-25",
          "chunkNumber": 25,
          "sanskrit": "anne̍na̠ vāva sarve̎ prā̠ṇā mahī̍yante||"
        },
        {
          "id": "ta-7-5-26",
          "chunkNumber": 26,
          "sanskrit": "tā vā e̠tāścata̍sra ścatu̠drdhā|"
        },
        {
          "id": "ta-7-5-27",
          "chunkNumber": 27,
          "sanskrit": "cata̍sraścatasro̠ vyāhṛ̍tayaḥ|"
        },
        {
          "id": "ta-7-5-28",
          "chunkNumber": 28,
          "sanskrit": "tā yo veda̍|"
        },
        {
          "id": "ta-7-5-29",
          "chunkNumber": 29,
          "sanskrit": "sa ve̍da̠ brahma̍|"
        },
        {
          "id": "ta-7-5-30",
          "chunkNumber": 30,
          "sanskrit": "sarve̎'smai de̠vā ba̠limāva̍hanti"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-7-6",
      "title": "Prapāṭhaka 7 · Anuvāka 6",
      "sectionNumber": 6,
      "chunks": [
        {
          "id": "ta-7-6-1",
          "chunkNumber": 1,
          "sanskrit": "sa ya e̠ṣo̎'ntarhṛ̍daya ākā̠śaḥ|",
          "section": 6
        },
        {
          "id": "ta-7-6-2",
          "chunkNumber": 2,
          "sanskrit": "tasmi̍nna̠yaṃ puru̍ṣo mano̠mayaḥ̍|"
        },
        {
          "id": "ta-7-6-3",
          "chunkNumber": 3,
          "sanskrit": "amṛ̍to hira̠ṇmayaḥ̍||"
        },
        {
          "id": "ta-7-6-4",
          "chunkNumber": 4,
          "sanskrit": "anta̍reṇa̠ tālu̍ke|"
        },
        {
          "id": "ta-7-6-5",
          "chunkNumber": 5,
          "sanskrit": "ya e̠ṣa stana̍ ivāva̠laṃba̍te|"
        },
        {
          "id": "ta-7-6-6",
          "chunkNumber": 6,
          "sanskrit": "se̎ndra yo̠niḥ|"
        },
        {
          "id": "ta-7-6-7",
          "chunkNumber": 7,
          "sanskrit": "yatrā̠sau ke̍śā̠nto vi̠varta̍te|"
        },
        {
          "id": "ta-7-6-8",
          "chunkNumber": 8,
          "sanskrit": "vya̠pohya̍ śīrṣakapā̠le||"
        },
        {
          "id": "ta-7-6-9",
          "chunkNumber": 9,
          "sanskrit": "bhūritya̠gnau prati̍tiṣṭhati|"
        },
        {
          "id": "ta-7-6-10",
          "chunkNumber": 10,
          "sanskrit": "bhuva̠ iti̍ vā̠yau suva̠rityā̍di̠tye|"
        },
        {
          "id": "ta-7-6-11",
          "chunkNumber": 11,
          "sanskrit": "maha̠ iti̠ brahma̍ṇi|"
        },
        {
          "id": "ta-7-6-12",
          "chunkNumber": 12,
          "sanskrit": "ā̠pnoti̠ svārā̎jyam|"
        },
        {
          "id": "ta-7-6-13",
          "chunkNumber": 13,
          "sanskrit": "ā̠pnoti̠ mana̍sa̠spati̎m|"
        },
        {
          "id": "ta-7-6-14",
          "chunkNumber": 14,
          "sanskrit": "vākpa̍ti̠ ścakhṣu̍ṣpatiḥ|"
        },
        {
          "id": "ta-7-6-15",
          "chunkNumber": 15,
          "sanskrit": "śrotra̍pati rvi̠jñāna̍patiḥ|"
        },
        {
          "id": "ta-7-6-16",
          "chunkNumber": 16,
          "sanskrit": "e̠tat tato̍ bhavati|"
        },
        {
          "id": "ta-7-6-17",
          "chunkNumber": 17,
          "sanskrit": "ā̠kā̠śa śa̍rīraṃ̠ brahma̍|"
        },
        {
          "id": "ta-7-6-18",
          "chunkNumber": 18,
          "sanskrit": "sa̠tyātma̍ prā̠ṇārā̍maṃ̠ mana̍ ānandam|"
        },
        {
          "id": "ta-7-6-19",
          "chunkNumber": 19,
          "sanskrit": "śānti̍ samṛddhama̠mṛtaṃ̎||"
        },
        {
          "id": "ta-7-6-20",
          "chunkNumber": 20,
          "sanskrit": "iti̍ prācīna yo̠gyopā̎sva"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-7-7",
      "title": "Prapāṭhaka 7 · Anuvāka 7",
      "sectionNumber": 7,
      "chunks": [
        {
          "id": "ta-7-7-1",
          "chunkNumber": 1,
          "sanskrit": "pṛ̠thi̠vya̍ntari̍khṣaṃ̠ dyaurdiśo̍'vāntaradi̠śāḥ|",
          "section": 7
        },
        {
          "id": "ta-7-7-2",
          "chunkNumber": 2,
          "sanskrit": "a̠gnirvā̠yurā̍di̠tyaśca̠ndramā̠ nakhṣa̍trāṇi|"
        },
        {
          "id": "ta-7-7-3",
          "chunkNumber": 3,
          "sanskrit": "āpa̠ oṣa̍dhayo̠ vana̠spata̍ya ākā̠śa ā̠tmā|"
        },
        {
          "id": "ta-7-7-4",
          "chunkNumber": 4,
          "sanskrit": "itya̍dhibhū̠tam||"
        },
        {
          "id": "ta-7-7-5",
          "chunkNumber": 5,
          "sanskrit": "athāddhyā̠tmam|"
        },
        {
          "id": "ta-7-7-6",
          "chunkNumber": 6,
          "sanskrit": "prā̠ṇo vyā̠no̍'pā̠na u̍dā̠naḥ sa̍mā̠naḥ|"
        },
        {
          "id": "ta-7-7-7",
          "chunkNumber": 7,
          "sanskrit": "cakhṣuḥ̠ śrotraṃ̠ mano̠ vāk tvak|"
        },
        {
          "id": "ta-7-7-8",
          "chunkNumber": 8,
          "sanskrit": "carma̍ mā̠g̠ͫ sagͫͫsnāvāsthi̍ ma̠jjā||"
        },
        {
          "id": "ta-7-7-9",
          "chunkNumber": 9,
          "sanskrit": "e̠ta da̍dhivi̠dhāya̠rṣi̠ ravo̍cat|"
        },
        {
          "id": "ta-7-7-10",
          "chunkNumber": 10,
          "sanskrit": "pāṅkta̠vm̐vā i̠dagͫ sarvaṃ̎|"
        },
        {
          "id": "ta-7-7-11",
          "chunkNumber": 11,
          "sanskrit": "pāṅkta̍nai̠va pāṅkta̍gͫͫ spṛṇo̠tīti̍"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-7-8",
      "title": "Prapāṭhaka 7 · Anuvāka 8",
      "sectionNumber": 8,
      "chunks": [
        {
          "id": "ta-7-8-1",
          "chunkNumber": 1,
          "sanskrit": "omiti̠ brahma̍||",
          "section": 8
        },
        {
          "id": "ta-7-8-2",
          "chunkNumber": 2,
          "sanskrit": "omitī̠dagͫ sarva̎m||"
        },
        {
          "id": "ta-7-8-3",
          "chunkNumber": 3,
          "sanskrit": "omitye̠tada̍nukṛti hasma̠ vā a̠pyo śrā̍va̠yetyāśrā̍vayanti|"
        },
        {
          "id": "ta-7-8-4",
          "chunkNumber": 4,
          "sanskrit": "omiti̠ sāmā̍ni gāyanti|"
        },
        {
          "id": "ta-7-8-5",
          "chunkNumber": 5,
          "sanskrit": "ogͫ śomiti̍ śa̠strāṇi̍ śagͫsanti|"
        },
        {
          "id": "ta-7-8-6",
          "chunkNumber": 6,
          "sanskrit": "omitya̍ddhva̠ryuḥ pra̍tiga̠raṃ prati̍gṛṇāti|"
        },
        {
          "id": "ta-7-8-7",
          "chunkNumber": 7,
          "sanskrit": "omiti̠ brahmā̠ prasau̍ti|"
        },
        {
          "id": "ta-7-8-8",
          "chunkNumber": 8,
          "sanskrit": "omitya̍gniho̠tramanu̍jānāti|"
        },
        {
          "id": "ta-7-8-9",
          "chunkNumber": 9,
          "sanskrit": "omiti̍ brāhma̠ṇaḥ pra̍va̠khṣyannā̍ha̠ brahmopā̎pnavā̠nīti̍|"
        },
        {
          "id": "ta-7-8-10",
          "chunkNumber": 10,
          "sanskrit": "brahmai̠vopā̎pnoti"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-7-9",
      "title": "Prapāṭhaka 7 · Anuvāka 9",
      "sectionNumber": 9,
      "chunks": [
        {
          "id": "ta-7-9-1",
          "chunkNumber": 1,
          "sanskrit": "ṛtaṃ ca svāddhyāya prava̍cane̠ ca|",
          "section": 9
        },
        {
          "id": "ta-7-9-2",
          "chunkNumber": 2,
          "sanskrit": "satyaṃ ca svāddhyāya prava̍cane̠ ca|"
        },
        {
          "id": "ta-7-9-3",
          "chunkNumber": 3,
          "sanskrit": "tapaśca svāddhyāya prava̍cane̠ ca|"
        },
        {
          "id": "ta-7-9-4",
          "chunkNumber": 4,
          "sanskrit": "damaśca svāddhyāya prava̍cane̠ ca|"
        },
        {
          "id": "ta-7-9-5",
          "chunkNumber": 5,
          "sanskrit": "śamaśca svāddhyāya prava̍cane̠ ca|"
        },
        {
          "id": "ta-7-9-6",
          "chunkNumber": 6,
          "sanskrit": "agnayaśca svāddhyāya prava̍cane̠ ca|"
        },
        {
          "id": "ta-7-9-7",
          "chunkNumber": 7,
          "sanskrit": "agnihotraṃ ca svāddhyāya prava̍cane̠ ca|"
        },
        {
          "id": "ta-7-9-8",
          "chunkNumber": 8,
          "sanskrit": "atithayaśca svāddhyāya prava̍cane̠ ca|"
        },
        {
          "id": "ta-7-9-9",
          "chunkNumber": 9,
          "sanskrit": "mānuṣaṃ ca svāddhyāya prava̍cane̠ ca|"
        },
        {
          "id": "ta-7-9-10",
          "chunkNumber": 10,
          "sanskrit": "prajā ca svāddhyāya prava̍cane̠ ca|"
        },
        {
          "id": "ta-7-9-11",
          "chunkNumber": 11,
          "sanskrit": "prajanaśca svāddhyāya prava̍cane̠ ca|"
        },
        {
          "id": "ta-7-9-12",
          "chunkNumber": 12,
          "sanskrit": "prajātiśca svāddhyāya prava̍cane̠ ca||"
        },
        {
          "id": "ta-7-9-13",
          "chunkNumber": 13,
          "sanskrit": "satyamiti satyavacā̍ rāthī̠ taraḥ|"
        },
        {
          "id": "ta-7-9-14",
          "chunkNumber": 14,
          "sanskrit": "tapa iti taponityaḥ pau̍ruśi̠ṣṭiḥ|"
        },
        {
          "id": "ta-7-9-15",
          "chunkNumber": 15,
          "sanskrit": "svāddhyāya pravacane eveti nāko̍ maudga̠lyaḥ|"
        },
        {
          "id": "ta-7-9-16",
          "chunkNumber": 16,
          "sanskrit": "taddhi tapa̍staddhi̠ tapaḥ"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-7-10",
      "title": "Prapāṭhaka 7 · Anuvāka 10",
      "sectionNumber": 10,
      "chunks": [
        {
          "id": "ta-7-10-1",
          "chunkNumber": 1,
          "sanskrit": "a̠havm̐vṛ̠khṣasya̠ reri̍vā|",
          "section": 10
        },
        {
          "id": "ta-7-10-2",
          "chunkNumber": 2,
          "sanskrit": "kī̠rtiḥ pṛ̠ṣṭhaṃ gi̠reri̍va|"
        },
        {
          "id": "ta-7-10-3",
          "chunkNumber": 3,
          "sanskrit": "ū̠drdhva pa̍vitro vā̠jinī̍va sva̠mṛta̍masmi|"
        },
        {
          "id": "ta-7-10-4",
          "chunkNumber": 4,
          "sanskrit": "dravi̍ṇa̠g̠ͫ sava̍rcasam|"
        },
        {
          "id": "ta-7-10-5",
          "chunkNumber": 5,
          "sanskrit": "sumedhā a̍mṛto̠khṣitaḥ|"
        },
        {
          "id": "ta-7-10-6",
          "chunkNumber": 6,
          "sanskrit": "iti triśaṅkorvedā̍nuva̠canam"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-7-11",
      "title": "Prapāṭhaka 7 · Anuvāka 11",
      "sectionNumber": 11,
      "chunks": [
        {
          "id": "ta-7-11-1",
          "chunkNumber": 1,
          "sanskrit": "vedamanūcyā 'cāryontevāsinama̍nuśā̠sti||",
          "section": 11
        },
        {
          "id": "ta-7-11-2",
          "chunkNumber": 2,
          "sanskrit": "satya̠vm̐vada|"
        },
        {
          "id": "ta-7-11-3",
          "chunkNumber": 3,
          "sanskrit": "dharmaṃ̠ cara||"
        },
        {
          "id": "ta-7-11-4",
          "chunkNumber": 4,
          "sanskrit": "svāddhyāyā̎nmā pra̠madaḥ|"
        },
        {
          "id": "ta-7-11-5",
          "chunkNumber": 5,
          "sanskrit": "ācāryāya priyaṃ dhanamāhṛtya prajātantuṃ mā vya̍vacche̠thsīḥ|"
        },
        {
          "id": "ta-7-11-6",
          "chunkNumber": 6,
          "sanskrit": "satyānna prama̍dita̠vyam|"
        },
        {
          "id": "ta-7-11-7",
          "chunkNumber": 7,
          "sanskrit": "dharmānna prama̍dita̠vyam|"
        },
        {
          "id": "ta-7-11-8",
          "chunkNumber": 8,
          "sanskrit": "kuśalānna prama̍dita̠vyam|"
        },
        {
          "id": "ta-7-11-9",
          "chunkNumber": 9,
          "sanskrit": "bhūtyai na prama̍dita̠vyam|"
        },
        {
          "id": "ta-7-11-10",
          "chunkNumber": 10,
          "sanskrit": "svāddhyāya pravacanābhyāṃ na prama̍dita̠vyam devapitṛkāryābhyāṃ na prama̍dita̠vyam||"
        },
        {
          "id": "ta-7-11-11",
          "chunkNumber": 11,
          "sanskrit": "mātṛ̍devo̠ bhava|"
        },
        {
          "id": "ta-7-11-12",
          "chunkNumber": 12,
          "sanskrit": "pitṛ̍devo̠ bhava|"
        },
        {
          "id": "ta-7-11-13",
          "chunkNumber": 13,
          "sanskrit": "ācārya̍ devo̠ bhava|"
        },
        {
          "id": "ta-7-11-14",
          "chunkNumber": 14,
          "sanskrit": "atithi̍devo̠ bhava||"
        },
        {
          "id": "ta-7-11-15",
          "chunkNumber": 15,
          "sanskrit": "yānyanavadyāni̍ karmā̠ṇi|"
        },
        {
          "id": "ta-7-11-16",
          "chunkNumber": 16,
          "sanskrit": "tāni sevi̍tavyā̠ni|"
        },
        {
          "id": "ta-7-11-17",
          "chunkNumber": 17,
          "sanskrit": "no i̍tarā̠ṇi||"
        },
        {
          "id": "ta-7-11-18",
          "chunkNumber": 18,
          "sanskrit": "yānyasmākagͫ suca̍ritā̠ni|"
        },
        {
          "id": "ta-7-11-19",
          "chunkNumber": 19,
          "sanskrit": "tāni tvayo̍pāsyā̠ni no i̍tarā̠ṇi||"
        },
        {
          "id": "ta-7-11-20",
          "chunkNumber": 20,
          "sanskrit": "ye ke cāsmacchreyā̍gͫso brā̠hmaṇāḥ|"
        },
        {
          "id": "ta-7-11-21",
          "chunkNumber": 21,
          "sanskrit": "teṣāṃ tvayā''sane na praśva̍sita̠vyam||"
        },
        {
          "id": "ta-7-11-22",
          "chunkNumber": 22,
          "sanskrit": "śraddha̍yā de̠yam|"
        },
        {
          "id": "ta-7-11-23",
          "chunkNumber": 23,
          "sanskrit": "aśraddha̍yā'de̠yam|"
        },
        {
          "id": "ta-7-11-24",
          "chunkNumber": 24,
          "sanskrit": "śri̍yā de̠yam|"
        },
        {
          "id": "ta-7-11-25",
          "chunkNumber": 25,
          "sanskrit": "hri̍yā de̠yam|"
        },
        {
          "id": "ta-7-11-26",
          "chunkNumber": 26,
          "sanskrit": "bhi̍yā de̠yam|"
        },
        {
          "id": "ta-7-11-27",
          "chunkNumber": 27,
          "sanskrit": "savm̐vi̍dā de̠yam||"
        },
        {
          "id": "ta-7-11-28",
          "chunkNumber": 28,
          "sanskrit": "atha yadi te karmavicikithsā vā vṛtta viciki̍thsā vā̠ syāt ye tatra brāhmaṇāḥ̎ samma̠ra̠śinaḥ|"
        },
        {
          "id": "ta-7-11-29",
          "chunkNumber": 29,
          "sanskrit": "yuktā̍ āyu̠ktāḥ|"
        },
        {
          "id": "ta-7-11-30",
          "chunkNumber": 30,
          "sanskrit": "alūkhṣā̍ dharma̍kāmāḥ̠ syuḥ|"
        },
        {
          "id": "ta-7-11-31",
          "chunkNumber": 31,
          "sanskrit": "yathā te̍ tatra̍ varte̠rann|"
        },
        {
          "id": "ta-7-11-32",
          "chunkNumber": 32,
          "sanskrit": "tathā tatra̍ varte̠thāḥ||"
        },
        {
          "id": "ta-7-11-33",
          "chunkNumber": 33,
          "sanskrit": "athābhyā̎khyāte̠ṣu|"
        },
        {
          "id": "ta-7-11-34",
          "chunkNumber": 34,
          "sanskrit": "ye tatra brāhmaṇāḥ̎ samma̠r̠śinaḥ|"
        },
        {
          "id": "ta-7-11-35",
          "chunkNumber": 35,
          "sanskrit": "yuktā̍ āyu̠ktāḥ|"
        },
        {
          "id": "ta-7-11-36",
          "chunkNumber": 36,
          "sanskrit": "alūkhṣā̍ dharma̍ kāmāḥ̠ syuḥ|"
        },
        {
          "id": "ta-7-11-37",
          "chunkNumber": 37,
          "sanskrit": "yathā te̍ teṣu̍ varte̠rann tathā teṣu̍ varte̠thāḥ||"
        },
        {
          "id": "ta-7-11-38",
          "chunkNumber": 38,
          "sanskrit": "eṣa̍ āde̠śaḥ|"
        },
        {
          "id": "ta-7-11-39",
          "chunkNumber": 39,
          "sanskrit": "eṣa u̍pade̠śaḥ|"
        },
        {
          "id": "ta-7-11-40",
          "chunkNumber": 40,
          "sanskrit": "eṣā ve̍dopa̠niṣat|"
        },
        {
          "id": "ta-7-11-41",
          "chunkNumber": 41,
          "sanskrit": "etada̍nuśā̠sanam|"
        },
        {
          "id": "ta-7-11-42",
          "chunkNumber": 42,
          "sanskrit": "eva mupā̍sita̠vyam|"
        },
        {
          "id": "ta-7-11-43",
          "chunkNumber": 43,
          "sanskrit": "eva mucaita̍dupā̠syam"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-7-12",
      "title": "Prapāṭhaka 7 · Anuvāka 12",
      "sectionNumber": 12,
      "chunks": [
        {
          "id": "ta-7-12-1",
          "chunkNumber": 1,
          "sanskrit": "śanno̍ mi̠traḥ śavm̐varu̍ṇaḥ|",
          "section": 12
        },
        {
          "id": "ta-7-12-2",
          "chunkNumber": 2,
          "sanskrit": "śanno̍ bhavatvarya̠mā|"
        },
        {
          "id": "ta-7-12-3",
          "chunkNumber": 3,
          "sanskrit": "śanna̠ indro̠ bṛha̠spatiḥ̍|"
        },
        {
          "id": "ta-7-12-4",
          "chunkNumber": 4,
          "sanskrit": "śanno̠ viṣṇu̍ rurukra̠maḥ|"
        },
        {
          "id": "ta-7-12-5",
          "chunkNumber": 5,
          "sanskrit": "namo̠ brahma̍ṇe|"
        },
        {
          "id": "ta-7-12-6",
          "chunkNumber": 6,
          "sanskrit": "nama̍ste vāyo|"
        },
        {
          "id": "ta-7-12-7",
          "chunkNumber": 7,
          "sanskrit": "tvame̠va pra̠tyakhṣaṃ̠ brahmā̍si|"
        },
        {
          "id": "ta-7-12-8",
          "chunkNumber": 8,
          "sanskrit": "tvāme̠va pra̠tyakhṣaṃ̠ brahmā vā̍diṣam|"
        },
        {
          "id": "ta-7-12-9",
          "chunkNumber": 9,
          "sanskrit": "ṛ̠tama̍vādiṣam|"
        },
        {
          "id": "ta-7-12-10",
          "chunkNumber": 10,
          "sanskrit": "sa̠tyama̍vādiṣaṃ|"
        },
        {
          "id": "ta-7-12-11",
          "chunkNumber": 11,
          "sanskrit": "tanmāmā̍vīt|"
        },
        {
          "id": "ta-7-12-12",
          "chunkNumber": 12,
          "sanskrit": "tadva̠ktāra̍māvīt|"
        },
        {
          "id": "ta-7-12-13",
          "chunkNumber": 13,
          "sanskrit": "āvī̠nmām|"
        },
        {
          "id": "ta-7-12-14",
          "chunkNumber": 14,
          "sanskrit": "āvī̎dva̠ktāra̎m||"
        },
        {
          "id": "ta-7-12-15",
          "chunkNumber": 15,
          "sanskrit": "oṃ śāntiḥ̠ śāntiḥ̠ śāntiḥ̍"
        }
      ]
    }
  ]
}
