        },
        {
          "id": "rv-8-102-15",
          "chunkNumber": 15,
          "sanskrit": "अ॒यं यथा॑ न आ॒भुव॒त्त्वष्टा॑ रू॒पेव॒ तक्ष्या॑ ।",
          "padya": 8
        },
        {
          "id": "rv-8-102-16",
          "chunkNumber": 16,
