          "chunkNumber": 5,
          "sanskrit": "त्वया॑ ह स्विद्यु॒जा व॒यं चोदि॑ष्ठेन यविष्ठ्य ।",
          "padya": 3
        },
        {
          "id": "rv-8-102-6",
          "chunkNumber": 6,
          "sanskrit": "अ॒भि ष्मो॒ वाज॑सातये ॥ ३ ॥"
        },
        {
          "id": "rv-8-102-7",
          "chunkNumber": 7,
          "sanskrit": "औ॒र्व॒भृ॒गु॒वच्छुचि॑मप्नवान॒वदा हु॑वे ।",
          "padya": 4
        },
        {
          "id": "rv-8-102-8",
          "chunkNumber": 8,
          "sanskrit": "अ॒ग्निं स॑मु॒द्रवा॑ससम् ॥ ४ ॥"
        },
        {
          "id": "rv-8-102-9",
          "chunkNumber": 9,
          "sanskrit": "हु॒वे वात॑स्वनं क॒विं प॒र्जन्य॑क्रन्द्यं॒ सह॑: ।",
