{
  "sections": [
    {
      "id": "rigveda-8-98",
      "title": "Maṇḍala 8 · Sūkta 98",
      "sectionNumber": 98,
      "chunks": [
        {
          "id": "rv-8-98-1",
          "chunkNumber": 1,
          "sanskrit": "इन्द्रा॑य॒ साम॑ गायत॒ विप्रा॑य बृह॒ते बृ॒हत् ।",
          "section": 98,
          "padya": 1
        },
        {
          "id": "rv-8-98-2",
          "chunkNumber": 2,
          "sanskrit": "ध॒र्म॒कृते॑ विप॒श्चिते॑ पन॒स्यवे॑ ॥ १ ॥"
        },
        {
          "id": "rv-8-98-3",
          "chunkNumber": 3,
          "sanskrit": "त्वमि॑न्द्राभि॒भूर॑सि॒ त्वं सूर्य॑मरोचयः ।",
          "padya": 2
        },
        {
          "id": "rv-8-98-4",
          "chunkNumber": 4,
          "sanskrit": "वि॒श्वक॑र्मा वि॒श्वदे॑वो म॒हाँ अ॑सि ॥ २ ॥"
        },
        {
          "id": "rv-8-98-5",
          "chunkNumber": 5,
          "sanskrit": "वि॒भ्राज॒ञ्ज्योति॑षा॒ स्व१रग॑च्छो रोच॒नं दि॒वः ।",
          "padya": 3
        },
        {
          "id": "rv-8-98-6",
          "chunkNumber": 6,
          "sanskrit": "दे॒वास्त॑ इन्द्र स॒ख्याय॑ येमिरे ॥ ३ ॥"
        },
        {
          "id": "rv-8-98-7",
          "chunkNumber": 7,
          "sanskrit": "एन्द्र॑ नो गधि प्रि॒यः स॑त्रा॒जिदगो॑ह्यः ।",
          "padya": 4
        },
        {
          "id": "rv-8-98-8",
          "chunkNumber": 8,
          "sanskrit": "गि॒रिर्न वि॒श्वत॑स्पृ॒थुः पति॑र्दि॒वः ॥ ४ ॥"
        },
        {
          "id": "rv-8-98-9",
          "chunkNumber": 9,
          "sanskrit": "अ॒भि हि स॑त्य सोमपा उ॒भे ब॒भूथ॒ रोद॑सी ।",
          "padya": 5
        },
        {
          "id": "rv-8-98-10",
          "chunkNumber": 10,
          "sanskrit": "इन्द्रासि॑ सुन्व॒तो वृ॒धः पति॑र्दि॒वः ॥ ५ ॥"
        },
        {
          "id": "rv-8-98-11",
          "chunkNumber": 11,
          "sanskrit": "त्वं हि शश्व॑तीना॒मिन्द्र॑ द॒र्ता पु॒रामसि॑ ।",
          "padya": 6
        },
        {
          "id": "rv-8-98-12",
          "chunkNumber": 12,
          "sanskrit": "ह॒न्ता दस्यो॒र्मनो॑र्वृ॒धः पति॑र्दि॒वः ॥ ६ ॥"
        },
        {
          "id": "rv-8-98-13",
          "chunkNumber": 13,
          "sanskrit": "अधा॒ ही॑न्द्र गिर्वण॒ उप॑ त्वा॒ कामा॑न्म॒हः स॑सृ॒ज्महे॑ ।",
          "padya": 7
        },
        {
          "id": "rv-8-98-14",
          "chunkNumber": 14,
          "sanskrit": "उ॒देव॒ यन्त॑ उ॒दभि॑: ॥ ७ ॥"
        },
        {
          "id": "rv-8-98-15",
          "chunkNumber": 15,
          "sanskrit": "वार्ण त्वा॑ य॒व्याभि॒र्वर्ध॑न्ति शूर॒ ब्रह्मा॑णि ।",
          "padya": 8
        },
        {
          "id": "rv-8-98-16",
          "chunkNumber": 16,
          "sanskrit": "वा॒वृ॒ध्वांसं॑ चिदद्रिवो दि॒वेदि॑वे ॥ ८ ॥"
        },
        {
          "id": "rv-8-98-17",
          "chunkNumber": 17,
          "sanskrit": "यु॒ञ्जन्ति॒ हरी॑ इषि॒रस्य॒ गाथ॑यो॒रौ रथ॑ उ॒रुयु॑गे ।",
          "padya": 9
        },
        {
          "id": "rv-8-98-18",
          "chunkNumber": 18,
          "sanskrit": "इ॒न्द्र॒वाहा॑ वचो॒युजा॑ ॥ ९ ॥"
        },
        {
          "id": "rv-8-98-19",
          "chunkNumber": 19,
          "sanskrit": "त्वं न॑ इ॒न्द्रा भ॑रँ॒ ओजो॑ नृ॒म्णं श॑तक्रतो विचर्षणे ।",
          "padya": 10
        },
        {
          "id": "rv-8-98-20",
          "chunkNumber": 20,
          "sanskrit": "आ वी॒रं पृ॑तना॒षह॑म् ॥ १० ॥"
        },
        {
          "id": "rv-8-98-21",
          "chunkNumber": 21,
          "sanskrit": "त्वं हि न॑: पि॒ता व॑सो॒ त्वं मा॒ता श॑तक्रतो ब॒भूवि॑थ ।",
          "padya": 11
        },
        {
          "id": "rv-8-98-22",
          "chunkNumber": 22,
          "sanskrit": "अधा॑ ते सु॒म्नमी॑महे ॥ ११ ॥"
        },
        {
          "id": "rv-8-98-23",
          "chunkNumber": 23,
          "sanskrit": "त्वां शु॑ष्मिन्पुरुहूत वाज॒यन्त॒मुप॑ ब्रुवे शतक्रतो ।",
          "padya": 12
        },
        {
          "id": "rv-8-98-24",
          "chunkNumber": 24,
          "sanskrit": "स नो॑ रास्व सु॒वीर्य॑म् ॥ १२ ॥"
        }
      ]
    },
    {
      "id": "rigveda-8-99",
      "title": "Maṇḍala 8 · Sūkta 99",
      "sectionNumber": 99,
      "chunks": [
        {
          "id": "rv-8-99-1",
          "chunkNumber": 1,
          "sanskrit": "त्वामि॒दा ह्यो नरोऽपी॑प्यन्वज्रि॒न्भूर्ण॑यः ।",
          "section": 99,
          "padya": 1
        },
        {
          "id": "rv-8-99-2",
          "chunkNumber": 2,
          "sanskrit": "स इ॑न्द्र॒ स्तोम॑वाहसामि॒ह श्रु॒ध्युप॒ स्वस॑र॒मा ग॑हि ॥ १ ॥"
        },
        {
          "id": "rv-8-99-3",
          "chunkNumber": 3,
          "sanskrit": "मत्स्वा॑ सुशिप्र हरिव॒स्तदी॑महे॒ त्वे आ भू॑षन्ति वे॒धस॑: ।",
          "padya": 2
        },
        {
          "id": "rv-8-99-4",
          "chunkNumber": 4,
          "sanskrit": "तव॒ श्रवां॑स्युप॒मान्यु॒क्थ्या॑ सु॒तेष्वि॑न्द्र गिर्वणः ॥ २ ॥"
        },
        {
          "id": "rv-8-99-5",
          "chunkNumber": 5,
          "sanskrit": "श्राय॑न्त इव॒ सूर्यं॒ विश्वेदिन्द्र॑स्य भक्षत ।",
          "padya": 3
        },
        {
          "id": "rv-8-99-6",
          "chunkNumber": 6,
          "sanskrit": "वसू॑नि जा॒ते जन॑मान॒ ओज॑सा॒ प्रति॑ भा॒गं न दी॑धिम ॥ ३ ॥"
        },
        {
          "id": "rv-8-99-7",
          "chunkNumber": 7,
          "sanskrit": "अन॑र्शरातिं वसु॒दामुप॑ स्तुहि भ॒द्रा इन्द्र॑स्य रा॒तय॑: ।",
          "padya": 4
        },
        {
          "id": "rv-8-99-8",
          "chunkNumber": 8,
          "sanskrit": "सो अ॑स्य॒ कामं॑ विध॒तो न रो॑षति॒ मनो॑ दा॒नाय॑ चो॒दय॑न् ॥ ४ ॥"
        },
        {
          "id": "rv-8-99-9",
          "chunkNumber": 9,
          "sanskrit": "त्वमि॑न्द्र॒ प्रतू॑र्तिष्व॒भि विश्वा॑ असि॒ स्पृध॑: ।",
          "padya": 5
        },
        {
          "id": "rv-8-99-10",
          "chunkNumber": 10,
          "sanskrit": "अ॒श॒स्ति॒हा ज॑नि॒ता वि॑श्व॒तूर॑सि॒ त्वं तू॑र्य तरुष्य॒तः ॥ ५ ॥"
        },
        {
          "id": "rv-8-99-11",
          "chunkNumber": 11,
          "sanskrit": "अनु॑ ते॒ शुष्मं॑ तु॒रय॑न्तमीयतुः क्षो॒णी शिशुं॒ न मा॒तरा॑ ।",
          "padya": 6
        },
        {
          "id": "rv-8-99-12",
          "chunkNumber": 12,
          "sanskrit": "विश्वा॑स्ते॒ स्पृध॑: श्नथयन्त म॒न्यवे॑ वृ॒त्रं यदि॑न्द्र॒ तूर्व॑सि ॥ ६ ॥"
        },
        {
          "id": "rv-8-99-13",
          "chunkNumber": 13,
          "sanskrit": "इ॒त ऊ॒ती वो॑ अ॒जरं॑ प्रहे॒तार॒मप्र॑हितम् ।",
          "padya": 7
        },
        {
          "id": "rv-8-99-14",
          "chunkNumber": 14,
          "sanskrit": "आ॒शुं जेता॑रं॒ हेता॑रं र॒थीत॑म॒मतू॑र्तं तुग्र्या॒वृध॑म् ॥ ७ ॥"
        },
        {
          "id": "rv-8-99-15",
          "chunkNumber": 15,
          "sanskrit": "इ॒ष्क॒र्तार॒मनि॑ष्कृतं॒ सह॑स्कृतं श॒तमू॑तिं श॒तक्र॑तुम् ।",
          "padya": 8
        },
        {
          "id": "rv-8-99-16",
          "chunkNumber": 16,
          "sanskrit": "स॒मा॒नमिन्द्र॒मव॑से हवामहे॒ वस॑वानं वसू॒जुव॑म् ॥ ८ ॥"
        }
      ]
    },
    {
      "id": "rigveda-8-100",
      "title": "Maṇḍala 8 · Sūkta 100",
      "sectionNumber": 100,
      "chunks": [
        {
          "id": "rv-8-100-1",
          "chunkNumber": 1,
          "sanskrit": "अ॒यं त॑ एमि त॒न्वा॑ पु॒रस्ता॒द्विश्वे॑ दे॒वा अ॒भि मा॑ यन्ति प॒श्चात् ।",
          "section": 100,
          "padya": 1
        },
        {
          "id": "rv-8-100-2",
          "chunkNumber": 2,
          "sanskrit": "य॒दा मह्यं॒ दीध॑रो भा॒गमि॒न्द्राऽऽदिन्मया॑ कृणवो वी॒र्या॑णि ॥ १ ॥"
        },
        {
          "id": "rv-8-100-3",
          "chunkNumber": 3,
          "sanskrit": "दधा॑मि ते॒ मधु॑नो भ॒क्षमग्रे॑ हि॒तस्ते॑ भा॒गः सु॒तो अ॑स्तु॒ सोम॑: ।",
          "padya": 2
        },
        {
          "id": "rv-8-100-4",
          "chunkNumber": 4,
          "sanskrit": "अस॑श्च॒ त्वं द॑क्षिण॒तः सखा॒ मेऽधा॑ वृ॒त्राणि॑ जङ्घनाव॒ भूरि॑ ॥ २ ॥"
        },
        {
          "id": "rv-8-100-5",
          "chunkNumber": 5,
          "sanskrit": "प्र सु स्तोमं॑ भरत वाज॒यन्त॒ इन्द्रा॑य स॒त्यं यदि॑ स॒त्यमस्ति॑ ।",
          "padya": 3
        },
        {
          "id": "rv-8-100-6",
          "chunkNumber": 6,
          "sanskrit": "नेन्द्रो॑ अ॒स्तीति॒ नेम॑ उ त्व आह॒ क ईं॑ ददर्श॒ कम॒भि ष्ट॑वाम ॥ ३ ॥"
        },
        {
          "id": "rv-8-100-7",
          "chunkNumber": 7,
          "sanskrit": "अ॒यम॑स्मि जरित॒: पश्य॑ मे॒ह विश्वा॑ जा॒तान्य॒भ्य॑स्मि म॒ह्ना ।",
          "padya": 4
        },
        {
          "id": "rv-8-100-8",
          "chunkNumber": 8,
          "sanskrit": "ऋ॒तस्य॑ मा प्र॒दिशो॑ वर्धयन्त्यादर्दि॒रो भुव॑ना दर्दरीमि ॥ ४ ॥"
        },
        {
          "id": "rv-8-100-9",
          "chunkNumber": 9,
          "sanskrit": "आ यन्मा॑ वे॒ना अरु॑हन्नृ॒तस्यँ॒ एक॒मासी॑नं हर्य॒तस्य॑ पृ॒ष्ठे ।",
          "padya": 5
        },
        {
          "id": "rv-8-100-10",
          "chunkNumber": 10,
          "sanskrit": "मन॑श्चिन्मे हृ॒द आ प्रत्य॑वोच॒दचि॑क्रद॒ञ्छिशु॑मन्त॒: सखा॑यः ॥ ५ ॥"
        },
        {
          "id": "rv-8-100-11",
          "chunkNumber": 11,
          "sanskrit": "विश्वेत्ता ते॒ सव॑नेषु प्र॒वाच्या॒ या च॒कर्थ॑ मघवन्निन्द्र सुन्व॒ते ।",
          "padya": 6
        },
        {
          "id": "rv-8-100-12",
          "chunkNumber": 12,
          "sanskrit": "पारा॑वतं॒ यत्पु॑रुसम्भृ॒तं वस्व॒पावृ॑णोः शर॒भाय॒ ऋषि॑बन्धवे ॥ ६ ॥"
        },
        {
          "id": "rv-8-100-13",
          "chunkNumber": 13,
          "sanskrit": "प्र नू॒नं धा॑वता॒ पृथ॒ङ्नेह यो वो॒ अवा॑वरीत् ।",
          "padya": 7
        },
        {
          "id": "rv-8-100-14",
          "chunkNumber": 14,
          "sanskrit": "नि षीं॑ वृ॒त्रस्य॒ मर्म॑णि॒ वज्र॒मिन्द्रो॑ अपीपतत् ॥ ७ ॥"
        },
        {
          "id": "rv-8-100-15",
          "chunkNumber": 15,
          "sanskrit": "मनो॑जवा॒ अय॑मान आय॒सीम॑तर॒त्पुर॑म् ।",
          "padya": 8
        },
        {
          "id": "rv-8-100-16",
          "chunkNumber": 16,
          "sanskrit": "दिवं॑ सुप॒र्णो ग॒त्वाय॒ सोमं॑ व॒ज्रिण॒ आभ॑रत् ॥ ८ ॥"
        },
        {
          "id": "rv-8-100-17",
          "chunkNumber": 17,
          "sanskrit": "स॒मु॒द्रे अ॒न्तः श॑यत उ॒द्ना वज्रो॑ अ॒भीवृ॑तः ।",
          "padya": 9
        },
        {
          "id": "rv-8-100-18",
          "chunkNumber": 18,
          "sanskrit": "भर॑न्त्यस्मै सं॒यत॑: पु॒रःप्र॑स्रवणा ब॒लिम् ॥ ९ ॥"
        },
        {
          "id": "rv-8-100-19",
          "chunkNumber": 19,
          "sanskrit": "यद्वाग्वद॑न्त्यविचेत॒नानि॒ राष्ट्री॑ दे॒वानां॑ निष॒साद॑ म॒न्द्रा ।",
          "padya": 10
        },
        {
          "id": "rv-8-100-20",
          "chunkNumber": 20,
          "sanskrit": "चत॑स्र॒ ऊर्जं॑ दुदुहे॒ पयां॑सि॒ क्व॑ स्विदस्याः पर॒मं ज॑गाम ॥ १० ॥"
        },
        {
          "id": "rv-8-100-21",
          "chunkNumber": 21,
          "sanskrit": "दे॒वीं वाच॑मजनयन्त दे॒वास्तां वि॒श्वरू॑पाः प॒शवो॑ वदन्ति ।",
          "padya": 11
        },
        {
          "id": "rv-8-100-22",
          "chunkNumber": 22,
          "sanskrit": "सा नो॑ म॒न्द्रेष॒मूर्जं॒ दुहा॑ना धे॒नुर्वाग॒स्मानुप॒ सुष्टु॒तैतु॑ ॥ ११ ॥"
        },
        {
          "id": "rv-8-100-23",
          "chunkNumber": 23,
          "sanskrit": "सखे॑ विष्णो वित॒रं वि क्र॑मस्व॒ द्यौर्दे॒हि लो॒कं वज्रा॑य वि॒ष्कभे॑ ।",
          "padya": 12
        },
        {
          "id": "rv-8-100-24",
          "chunkNumber": 24,
          "sanskrit": "हना॑व वृ॒त्रं रि॒णचा॑व॒ सिन्धू॒निन्द्र॑स्य यन्तु प्रस॒वे विसृ॑ष्टाः ॥ १२ ॥"
        }
      ]
    },
    {
      "id": "rigveda-8-101",
      "title": "Maṇḍala 8 · Sūkta 101",
      "sectionNumber": 101,
      "chunks": [
        {
          "id": "rv-8-101-1",
          "chunkNumber": 1,
          "sanskrit": "ऋध॑गि॒त्था स मर्त्य॑: शश॒मे दे॒वता॑तये ।",
          "section": 101,
          "padya": 1
        },
        {
          "id": "rv-8-101-2",
          "chunkNumber": 2,
          "sanskrit": "यो नू॒नं मि॒त्रावरु॑णाव॒भिष्ट॑य आच॒क्रे ह॒व्यदा॑तये ॥ १ ॥"
        },
        {
          "id": "rv-8-101-3",
          "chunkNumber": 3,
          "sanskrit": "वर्षि॑ष्ठक्षत्रा उरु॒चक्ष॑सा॒ नरा॒ राजा॑ना दीर्घ॒श्रुत्त॑मा ।",
          "padya": 2
        },
        {
          "id": "rv-8-101-4",
          "chunkNumber": 4,
          "sanskrit": "ता बा॒हुता॒ न दं॒सना॑ रथर्यतः सा॒कं सूर्य॑स्य र॒श्मिभि॑: ॥ २ ॥"
        },
        {
          "id": "rv-8-101-5",
          "chunkNumber": 5,
          "sanskrit": "प्र यो वां॑ मित्रावरुणाऽजि॒रो दू॒तो अद्र॑वत् ।",
          "padya": 3
        },
        {
          "id": "rv-8-101-6",
          "chunkNumber": 6,
          "sanskrit": "अय॑:शीर्षा॒ मदे॑रघुः ॥ ३ ॥"
        },
        {
          "id": "rv-8-101-7",
          "chunkNumber": 7,
          "sanskrit": "न यः स॒म्पृच्छे॒ न पुन॒र्हवी॑तवे॒ न सं॑वा॒दाय॒ रम॑ते ।",
          "padya": 4
        },
        {
          "id": "rv-8-101-8",
          "chunkNumber": 8,
          "sanskrit": "तस्मा॑न्नो अ॒द्य समृ॑तेरुरुष्यतं बा॒हुभ्यां॑ न उरुष्यतम् ॥ ४ ॥"
        },
        {
          "id": "rv-8-101-9",
          "chunkNumber": 9,
          "sanskrit": "प्र मि॒त्राय॒ प्रार्य॒म्णे स॑च॒थ्य॑मृतावसो ।",
          "padya": 5
        },
        {
          "id": "rv-8-101-10",
          "chunkNumber": 10,
          "sanskrit": "व॒रू॒थ्यं१ वरु॑णे॒ छन्द्यं॒ वच॑: स्तो॒त्रं राज॑सु गायत ॥ ५ ॥"
        },
        {
          "id": "rv-8-101-11",
          "chunkNumber": 11,
          "sanskrit": "ते हि॑न्विरे अरु॒णं जेन्यं॒ वस्वेकं॑ पु॒त्रं ति॑सॄ॒णाम् ।",
          "padya": 6
        },
        {
          "id": "rv-8-101-12",
          "chunkNumber": 12,
          "sanskrit": "ते धामा॑न्य॒मृता॒ मर्त्या॑ना॒मद॑ब्धा अ॒भि च॑क्षते ॥ ६ ॥"
        },
        {
          "id": "rv-8-101-13",
          "chunkNumber": 13,
          "sanskrit": "आ मे॒ वचां॒स्युद्य॑ता द्यु॒मत्त॑मानि॒ कर्त्वा॑ ।",
          "padya": 7
        },
        {
          "id": "rv-8-101-14",
          "chunkNumber": 14,
          "sanskrit": "उ॒भा या॑तं नासत्या स॒जोष॑सा॒ प्रति॑ ह॒व्यानि॑ वी॒तये॑ ॥ ७ ॥"
        },
        {
          "id": "rv-8-101-15",
          "chunkNumber": 15,
          "sanskrit": "रा॒तिं यद्वा॑मर॒क्षसं॒ हवा॑महे यु॒वाभ्यां॑ वाजिनीवसू ।",
          "padya": 8
        },
        {
          "id": "rv-8-101-16",
          "chunkNumber": 16,
          "sanskrit": "प्राचीं॒ होत्रां॑ प्रति॒रन्ता॑वितं नरा गृणा॒ना ज॒मद॑ग्निना ॥ ८ ॥"
        },
        {
          "id": "rv-8-101-17",
          "chunkNumber": 17,
          "sanskrit": "आ नो॑ य॒ज्ञं दि॑वि॒स्पृशं॒ वायो॑ या॒हि सु॒मन्म॑भिः ।",
          "padya": 9
        },
        {
          "id": "rv-8-101-18",
          "chunkNumber": 18,
          "sanskrit": "अ॒न्तः प॒वित्र॑ उ॒परि॑ श्रीणा॒नो॒३ऽयं शु॒क्रो अ॑यामि ते ॥ ९ ॥"
        },
        {
          "id": "rv-8-101-19",
          "chunkNumber": 19,
          "sanskrit": "वेत्य॑ध्व॒र्युः प॒थिभी॒ रजि॑ष्ठै॒: प्रति॑ ह॒व्यानि॑ वी॒तये॑ ।",
          "padya": 10
        },
        {
          "id": "rv-8-101-20",
          "chunkNumber": 20,
          "sanskrit": "अधा॑ नियुत्व उ॒भय॑स्य नः पिब॒ शुचिं॒ सोमं॒ गवा॑शिरम् ॥ १० ॥"
        },
        {
          "id": "rv-8-101-21",
          "chunkNumber": 21,
          "sanskrit": "बण्म॒हाँ अ॑सि सूर्य॒ बळा॑दित्य म॒हाँ अ॑सि ।",
          "padya": 11
        },
        {
          "id": "rv-8-101-22",
          "chunkNumber": 22,
          "sanskrit": "म॒हस्ते॑ स॒तो म॑हि॒मा प॑नस्यते॒ऽद्धा दे॑व म॒हाँ अ॑सि ॥ ११ ॥"
        },
        {
          "id": "rv-8-101-23",
          "chunkNumber": 23,
          "sanskrit": "बट् सू॑र्य॒ श्रव॑सा म॒हाँ अ॑सि स॒त्रा दे॑व म॒हाँ अ॑सि ।",
          "padya": 12
        },
        {
          "id": "rv-8-101-24",
          "chunkNumber": 24,
          "sanskrit": "म॒ह्ना दे॒वाना॑मसु॒र्य॑: पु॒रोहि॑तो वि॒भु ज्योति॒रदा॑भ्यम् ॥ १२ ॥"
        },
        {
          "id": "rv-8-101-25",
          "chunkNumber": 25,
          "sanskrit": "इ॒यं या नीच्य॒र्किणी॑ रू॒पा रोहि॑ण्या कृ॒ता ।",
          "padya": 13
        },
        {
          "id": "rv-8-101-26",
          "chunkNumber": 26,
          "sanskrit": "चि॒त्रेव॒ प्रत्य॑दर्श्याय॒त्य१न्तर्द॒शसु॑ बा॒हुषु॑ ॥ १३ ॥"
        },
        {
          "id": "rv-8-101-27",
          "chunkNumber": 27,
          "sanskrit": "प्र॒जा ह॑ ति॒स्रो अ॒त्याय॑मीयु॒र्न्य१न्या अ॒र्कम॒भितो॑ विविश्रे ।",
          "padya": 14
        },
        {
          "id": "rv-8-101-28",
          "chunkNumber": 28,
          "sanskrit": "बृ॒हद्ध॑ तस्थौ॒ भुव॑नेष्व॒न्तः पव॑मानो ह॒रित॒ आ वि॑वेश ॥ १४ ॥"
        },
        {
          "id": "rv-8-101-29",
          "chunkNumber": 29,
          "sanskrit": "मा॒ता रु॒द्राणां॑ दुहि॒ता वसू॑नां॒ स्वसा॑दि॒त्याना॑म॒मृत॑स्य॒ नाभि॑: ।",
          "padya": 15
        },
        {
          "id": "rv-8-101-30",
          "chunkNumber": 30,
          "sanskrit": "प्र नु वो॑चं चिकि॒तुषे॒ जना॑य॒ मा गामना॑गा॒मदि॑तिं वधिष्ट ॥ १५ ॥"
        },
        {
          "id": "rv-8-101-31",
          "chunkNumber": 31,
          "sanskrit": "व॒चो॒विदं॒ वाच॑मुदी॒रय॑न्तीं॒ विश्वा॑भिर्धी॒भिरु॑प॒तिष्ठ॑मानाम् ।",
          "padya": 16
        },
        {
          "id": "rv-8-101-32",
          "chunkNumber": 32,
          "sanskrit": "दे॒वीं दे॒वेभ्य॒: पर्ये॒युषीं॒ गामा मा॑वृक्त॒ मर्त्यो॑ द॒भ्रचे॑ताः ॥ १६ ॥"
        }
      ]
    },
    {
      "id": "rigveda-8-102",
