          "id": "rv-8-103-8",
          "chunkNumber": 8,
          "sanskrit": "स वी॒रं ध॑त्ते अग्न उक्थशं॒सिनं॒ त्मना॑ सहस्रपो॒षिण॑म् ॥ ४ ॥"
        },
        {
          "id": "rv-8-103-9",
          "chunkNumber": 9,
          "sanskrit": "स दृ॒ळ्हे चि॑द॒भि तृ॑णत्ति॒ वाज॒मर्व॑ता॒ स ध॑त्ते॒ अक्षि॑ति॒ श्रव॑: ।",
          "padya": 5
        },
        {
          "id": "rv-8-103-10",
          "chunkNumber": 10,
          "sanskrit": "त्वे दे॑व॒त्रा सदा॑ पुरूवसो॒ विश्वा॑ वा॒मानि॑ धीमहि ॥ ५ ॥"
        },
        {
          "id": "rv-8-103-11",
          "chunkNumber": 11,
          "sanskrit": "यो विश्वा॒ दय॑ते॒ वसु॒ होता॑ म॒न्द्रो जना॑नाम् ।",
          "padya": 6
        },
        {
          "id": "rv-8-103-12",
          "chunkNumber": 12,
          "sanskrit": "मधो॒र्न पात्रा॑ प्रथ॒मान्य॑स्मै॒ प्र स्तोमा॑ यन्त्य॒ग्नये॑ ॥ ६ ॥"
        },
        {
          "id": "rv-8-103-13",
          "chunkNumber": 13,
          "sanskrit": "अश्वं॒ न गी॒र्भी र॒थ्यं॑ सु॒दान॑वो मर्मृ॒ज्यन्ते॑ देव॒यव॑: ।",
          "padya": 7
        },
        {
          "id": "rv-8-103-14",
          "chunkNumber": 14,
          "sanskrit": "उ॒भे तो॒के तन॑ये दस्म विश्पते॒ पर्षि॒ राधो॑ म॒घोना॑म् ॥ ७ ॥"
        },
        {
          "id": "rv-8-103-15",
          "chunkNumber": 15,
          "sanskrit": "प्र मंहि॑ष्ठाय गायत ऋ॒ताव्ने॑ बृह॒ते शु॒क्रशो॑चिषे ।",
          "padya": 8
        },
        {
          "id": "rv-8-103-16",
          "chunkNumber": 16,
          "sanskrit": "उप॑स्तुतासो अ॒ग्नये॑ ॥ ८ ॥"
        },
        {
          "id": "rv-8-103-17",
          "chunkNumber": 17,
          "sanskrit": "आ वं॑सते म॒घवा॑ वी॒रव॒द्यश॒: समि॑द्धो द्यु॒म्न्याहु॑तः ।",
          "padya": 9
        },
        {
          "id": "rv-8-103-18",
          "chunkNumber": 18,
          "sanskrit": "कु॒विन्नो॑ अस्य सुम॒तिर्नवी॑य॒स्यच्छा॒ वाजे॑भिरा॒गम॑त् ॥ ९ ॥"
        },
        {
          "id": "rv-8-103-19",
          "chunkNumber": 19,
          "sanskrit": "प्रेष्ठ॑मु प्रि॒याणां॑ स्तु॒ह्या॑सा॒वाति॑थिम् ।",
          "padya": 10
        },
        {
          "id": "rv-8-103-20",
          "chunkNumber": 20,
          "sanskrit": "अ॒ग्निं रथा॑नां॒ यम॑म् ॥ १० ॥"
        },
        {
          "id": "rv-8-103-21",
          "chunkNumber": 21,
          "sanskrit": "उदि॑ता॒ यो निदि॑ता॒ वेदि॑ता॒ वस्वा य॒ज्ञियो॑ व॒वर्त॑ति ।",
          "padya": 11
        },
        {
          "id": "rv-8-103-22",
          "chunkNumber": 22,
          "sanskrit": "दु॒ष्टरा॒ यस्य॑ प्रव॒णे नोर्मयो॑ धि॒या वाज॒  सिषा॑सतः ॥ ११ ॥"
        },
        {
          "id": "rv-8-103-23",
          "chunkNumber": 23,
          "sanskrit": "मा नो॑ हृणीता॒मति॑थि॒र्वसु॑र॒ग्निः पु॑रुप्रश॒स्त ए॒षः ।",
          "padya": 12
        },
        {
          "id": "rv-8-103-24",
          "chunkNumber": 24,
          "sanskrit": "यः सु॒होता॑ स्वध्व॒रः ॥ १२ ॥"
        },
        {
          "id": "rv-8-103-25",
          "chunkNumber": 25,
          "sanskrit": "मो ते रि॑ष॒न्ये अच्छो॑क्तिभिर्व॒सोऽग्ने॒ केभि॑श्चि॒देवै॑: ।",
          "padya": 13
        },
        {
          "id": "rv-8-103-26",
          "chunkNumber": 26,
          "sanskrit": "की॒रिश्चि॒द्धि त्वामीट्टे॑ दू॒त्या॑य रा॒तह॑व्यः स्वध्व॒रः ॥ १३ ॥"
        },
        {
          "id": "rv-8-103-27",
          "chunkNumber": 27,
          "sanskrit": "आग्ने॑ याहि म॒रुत्स॑खा रु॒द्रेभि॒: सोम॑पीतये ।",
          "padya": 14
        },
        {
          "id": "rv-8-103-28",
          "chunkNumber": 28,
          "sanskrit": "सोभ॑र्या॒ उप॑ सुष्टु॒तिं मा॒दय॑स्व॒ स्व॑र्णरे ॥ १४ ॥"
        }
      ]
    }
  ]
}
