        {
          "id": "rv-8-103-6",
          "chunkNumber": 6,
          "sanskrit": "स॒ह॒स्र॒सां मे॒धसा॑ताविव॒ त्मना॒ऽग्निं धी॒भिः स॑पर्यत ॥ ३ ॥"
        },
        {
          "id": "rv-8-103-7",
