        },
        {
          "id": "rv-8-102-10",
          "chunkNumber": 10,
          "sanskrit": "अ॒ग्निं स॑मु॒द्रवा॑ससम् ॥ ५ ॥"
        },
        {
          "id": "rv-8-102-11",
          "chunkNumber": 11,
          "sanskrit": "आ स॒वं स॑वि॒तुर्य॑था॒ भग॑स्येव भु॒जिं हु॑वे ।",
          "padya": 6
        },
        {
          "id": "rv-8-102-12",
          "chunkNumber": 12,
          "sanskrit": "अ॒ग्निं स॑मु॒द्रवा॑ससम् ॥ ६ ॥"
        },
        {
          "id": "rv-8-102-13",
          "chunkNumber": 13,
          "sanskrit": "अ॒ग्निं वो॑ वृ॒धन्त॑मध्व॒राणां॑ पुरू॒तम॑म् ।",
          "padya": 7
        },
        {
          "id": "rv-8-102-14",
          "chunkNumber": 14,
