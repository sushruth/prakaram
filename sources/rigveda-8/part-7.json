          "section": 103,
          "padya": 1
        },
        {
          "id": "rv-8-103-2",
          "chunkNumber": 2,
          "sanskrit": "उपो॒ षु जा॒तमार्य॑स्य॒ वर्ध॑नम॒ग्निं न॑क्षन्त नो॒ गिर॑: ॥ १ ॥"
        },
        {
          "id": "rv-8-103-3",
          "chunkNumber": 3,
          "sanskrit": "प्र दैवो॑दासो अ॒ग्निर्दे॒वाँ अच्छा॒ न म॒ज्मना॑ ।",
