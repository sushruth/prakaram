{
  "sections": [
    {
      "id": "rigveda-10-162",
      "title": "Maṇḍala 10 · Sūkta 162",
      "sectionNumber": 162,
      "chunks": [
        {
          "id": "rv-10-162-1",
          "chunkNumber": 1,
          "sanskrit": "ब्रह्म॑णा॒ग्निः सं॑विदा॒नो र॑क्षो॒हा बा॑धतामि॒तः ।",
          "section": 162,
          "padya": 1
        },
        {
          "id": "rv-10-162-2",
          "chunkNumber": 2,
          "sanskrit": "अमी॑वा॒ यस्ते॒ गर्भं॑ दु॒र्णामा॒ योनि॑मा॒शये॑ ॥ १ ॥"
        },
        {
          "id": "rv-10-162-3",
          "chunkNumber": 3,
          "sanskrit": "यस्ते॒ गर्भ॒ममी॑वा दु॒र्णामा॒ योनि॑मा॒शये॑ ।",
          "padya": 2
        },
        {
          "id": "rv-10-162-4",
          "chunkNumber": 4,
          "sanskrit": "अ॒ग्निष्टं ब्रह्म॑णा स॒ह निष्क्र॒व्याद॑मनीनशत् ॥ २ ॥"
        },
        {
          "id": "rv-10-162-5",
          "chunkNumber": 5,
          "sanskrit": "यस्ते॒ हन्ति॑ प॒तय॑न्तं निष॒त्स्नुं यः स॑रीसृ॒पम् ।",
          "padya": 3
        },
        {
          "id": "rv-10-162-6",
          "chunkNumber": 6,
          "sanskrit": "जा॒तं यस्ते॒ जिघां॑सति॒ तमि॒तो ना॑शयामसि ॥ ३ ॥"
        },
        {
          "id": "rv-10-162-7",
          "chunkNumber": 7,
          "sanskrit": "यस्त॑ ऊ॒रू वि॒हर॑त्यन्त॒रा दम्प॑ती॒ शये॑ ।",
          "padya": 4
        },
        {
          "id": "rv-10-162-8",
          "chunkNumber": 8,
          "sanskrit": "योनिं॒ यो अ॒न्तरा॒रेळ्हि॒ तमि॒तो ना॑शयामसि ॥ ४ ॥"
        },
        {
          "id": "rv-10-162-9",
          "chunkNumber": 9,
          "sanskrit": "यस्त्वा॒ भ्राता॒ पति॑र्भू॒त्वा जा॒रो भू॒त्वा नि॒पद्य॑ते ।",
          "padya": 5
        },
        {
          "id": "rv-10-162-10",
          "chunkNumber": 10,
          "sanskrit": "प्र॒जां यस्ते॒ जिघां॑सति॒ तमि॒तो ना॑शयामसि ॥ ५ ॥"
        },
        {
          "id": "rv-10-162-11",
          "chunkNumber": 11,
          "sanskrit": "यस्त्वा॒ स्वप्ने॑न॒ तम॑सा मोहयि॒त्वा नि॒पद्य॑ते ।",
          "padya": 6
        },
        {
          "id": "rv-10-162-12",
          "chunkNumber": 12,
          "sanskrit": "प्र॒जां यस्ते॒ जिघां॑सति॒ तमि॒तो ना॑शयामसि ॥ ६ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-163",
      "title": "Maṇḍala 10 · Sūkta 163",
      "sectionNumber": 163,
      "chunks": [
        {
          "id": "rv-10-163-1",
          "chunkNumber": 1,
          "sanskrit": "अ॒क्षीभ्यां॑ ते॒ नासि॑काभ्यां॒ कर्णा॑भ्यां॒ छुबु॑का॒दधि॑ ।",
          "section": 163,
          "padya": 1
        },
        {
          "id": "rv-10-163-2",
          "chunkNumber": 2,
          "sanskrit": "यक्ष्मं॑ शीर्ष॒ण्यं॑ म॒स्तिष्का॑ज्जि॒ह्वाया॒ वि वृ॑हामि ते ॥ १ ॥"
        },
        {
          "id": "rv-10-163-3",
          "chunkNumber": 3,
          "sanskrit": "ग्री॒वाभ्य॑स्त उ॒ष्णिहा॑भ्य॒: कीक॑साभ्यो अनू॒क्या॑त् ।",
          "padya": 2
        },
        {
          "id": "rv-10-163-4",
          "chunkNumber": 4,
          "sanskrit": "यक्ष्मं॑ दोष॒ण्य१मंसा॑भ्यां बा॒हुभ्यां॒ वि वृ॑हामि ते ॥ २ ॥"
        },
        {
          "id": "rv-10-163-5",
          "chunkNumber": 5,
          "sanskrit": "आ॒न्त्रेभ्य॑स्ते॒ गुदा॑भ्यो वनि॒ष्ठोर्हृद॑या॒दधि॑ ।",
          "padya": 3
        },
        {
          "id": "rv-10-163-6",
          "chunkNumber": 6,
          "sanskrit": "यक्ष्मं॒ मत॑स्नाभ्यां य॒क्नः प्ला॒शिभ्यो॒ वि वृ॑हामि ते ॥ ३ ॥"
        },
        {
          "id": "rv-10-163-7",
          "chunkNumber": 7,
          "sanskrit": "ऊ॒रुभ्यां॑ ते अष्ठी॒वद्भ्यां॒ पार्ष्णि॑भ्यां॒ प्रप॑दाभ्याम् ।",
          "padya": 4
        },
        {
          "id": "rv-10-163-8",
          "chunkNumber": 8,
          "sanskrit": "यक्ष्मं॒ श्रोणि॑भ्यां॒ भास॑दा॒द्भंस॑सो॒ वि वृ॑हामि ते ॥ ४ ॥"
        },
        {
          "id": "rv-10-163-9",
          "chunkNumber": 9,
          "sanskrit": "मेह॑नाद्वनं॒कर॑णा॒ल्लोम॑भ्यस्ते न॒खेभ्य॑: ।",
          "padya": 5
        },
        {
          "id": "rv-10-163-10",
          "chunkNumber": 10,
          "sanskrit": "यक्ष्मं॒ सर्व॑स्मादा॒त्मन॒स्तमि॒दं वि वृ॑हामि ते ॥ ५ ॥"
        },
        {
          "id": "rv-10-163-11",
          "chunkNumber": 11,
          "sanskrit": "अङ्गा॑दङ्गा॒ल्लोम्नो॑लोम्नो जा॒तं पर्व॑णिपर्वणि ।",
          "padya": 6
        },
        {
          "id": "rv-10-163-12",
          "chunkNumber": 12,
          "sanskrit": "यक्ष्मं॒ सर्व॑स्मादा॒त्मन॒स्तमि॒दं वि वृ॑हामि ते ॥ ६ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-164",
      "title": "Maṇḍala 10 · Sūkta 164",
      "sectionNumber": 164,
      "chunks": [
        {
          "id": "rv-10-164-1",
          "chunkNumber": 1,
          "sanskrit": "अपे॑हि मनसस्प॒तेऽप॑ क्राम प॒रश्च॑र ।",
          "section": 164,
          "padya": 1
        },
        {
          "id": "rv-10-164-2",
          "chunkNumber": 2,
          "sanskrit": "प॒रो निॠ॑त्या॒ आ च॑क्ष्व बहु॒धा जीव॑तो॒ मन॑: ॥ १ ॥"
        },
        {
          "id": "rv-10-164-3",
          "chunkNumber": 3,
          "sanskrit": "भ॒द्रं वै वरं॑ वृणते भ॒द्रं यु॑ञ्जन्ति॒ दक्षि॑णम् ।",
          "padya": 2
        },
        {
          "id": "rv-10-164-4",
          "chunkNumber": 4,
          "sanskrit": "भ॒द्रं वै॑वस्व॒ते चक्षु॑र्बहु॒त्रा जीव॑तो॒ मन॑: ॥ २ ॥"
        },
        {
          "id": "rv-10-164-5",
          "chunkNumber": 5,
          "sanskrit": "यदा॒शसा॑ नि॒:शसा॑भि॒शसो॑पारि॒म जाग्र॑तो॒ यत्स्व॒पन्त॑: ।",
          "padya": 3
        },
        {
          "id": "rv-10-164-6",
          "chunkNumber": 6,
          "sanskrit": "अ॒ग्निर्विश्वा॒न्यप॑ दुष्कृ॒तान्यजु॑ष्टान्या॒रे अ॒स्मद्द॑धातु ॥ ३ ॥"
        },
        {
          "id": "rv-10-164-7",
          "chunkNumber": 7,
          "sanskrit": "यदि॑न्द्र ब्रह्मणस्पतेऽभिद्रो॒हं चरा॑मसि ।",
          "padya": 4
        },
        {
          "id": "rv-10-164-8",
          "chunkNumber": 8,
          "sanskrit": "प्रचे॑ता न आङ्गिर॒सो द्वि॑ष॒तां पा॒त्वंह॑सः ॥ ४ ॥"
        },
        {
          "id": "rv-10-164-9",
          "chunkNumber": 9,
          "sanskrit": "अजै॑ष्मा॒द्यास॑नाम॒ चाभू॒माना॑गसो व॒यम् ।",
          "padya": 5
        },
        {
          "id": "rv-10-164-10",
          "chunkNumber": 10,
          "sanskrit": "जा॒ग्र॒त्स्व॒प्नः सं॑क॒ल्पः पा॒पो यं द्वि॒ष्मस्तं स ऋ॑च्छतु॒ यो नो॒ द्वेष्टि॒ तमृ॑च्छतु ॥ ५ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-165",
      "title": "Maṇḍala 10 · Sūkta 165",
      "sectionNumber": 165,
      "chunks": [
        {
          "id": "rv-10-165-1",
          "chunkNumber": 1,
          "sanskrit": "देवा॑: क॒पोत॑ इषि॒तो यदि॒च्छन्दू॒तो निॠ॑त्या इ॒दमा॑ज॒गाम॑ ।",
          "section": 165,
          "padya": 1
        },
        {
          "id": "rv-10-165-2",
          "chunkNumber": 2,
          "sanskrit": "तस्मा॑ अर्चाम कृ॒णवा॑म॒ निष्कृ॑तिं॒ शं नो॑ अस्तु द्वि॒पदे॒ शं चतु॑ष्पदे ॥ १ ॥"
        },
        {
          "id": "rv-10-165-3",
          "chunkNumber": 3,
          "sanskrit": "शि॒वः क॒पोत॑ इषि॒तो नो॑ अस्त्वना॒गा दे॑वाः शकु॒नो गृ॒हेषु॑ ।",
          "padya": 2
        },
        {
          "id": "rv-10-165-4",
          "chunkNumber": 4,
          "sanskrit": "अ॒ग्निर्हि विप्रो॑ जु॒षतां॑ ह॒विर्न॒: परि॑ हे॒तिः प॒क्षिणी॑ नो वृणक्तु ॥ २ ॥"
        },
        {
          "id": "rv-10-165-5",
          "chunkNumber": 5,
          "sanskrit": "हे॒तिः प॒क्षिणी॒ न द॑भात्य॒स्माना॒ष्ट्र्यां प॒दं कृ॑णुते अग्नि॒धाने॑ ।",
          "padya": 3
        },
        {
          "id": "rv-10-165-6",
          "chunkNumber": 6,
          "sanskrit": "शं नो॒ गोभ्य॑श्च॒ पुरु॑षेभ्यश्चास्तु॒ मा नो॑ हिंसीदि॒ह दे॑वाः क॒पोत॑: ॥ ३ ॥"
        },
        {
          "id": "rv-10-165-7",
          "chunkNumber": 7,
          "sanskrit": "यदुलू॑को॒ वद॑ति मो॒घमे॒तद्यत्क॒पोत॑: प॒दम॒ग्नौ कृ॒णोति॑ ।",
          "padya": 4
        },
        {
          "id": "rv-10-165-8",
          "chunkNumber": 8,
          "sanskrit": "यस्य॑ दू॒तः प्रहि॑त ए॒ष ए॒तत्तस्मै॑ य॒माय॒ नमो॑ अस्तु मृ॒त्यवे॑ ॥ ४ ॥"
        },
        {
          "id": "rv-10-165-9",
          "chunkNumber": 9,
          "sanskrit": "ऋ॒चा क॒पोतं॑ नुदत प्र॒णोद॒मिषं॒ मद॑न्त॒: परि॒ गां न॑यध्वम् ।",
          "padya": 5
        },
        {
          "id": "rv-10-165-10",
          "chunkNumber": 10,
          "sanskrit": "सं॒यो॒पय॑न्तो दुरि॒तानि॒ विश्वा॑ हि॒त्वा न॒ ऊर्जं॒ प्र प॑ता॒त्पति॑ष्ठः ॥ ५ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-166",
      "title": "Maṇḍala 10 · Sūkta 166",
      "sectionNumber": 166,
      "chunks": [
        {
          "id": "rv-10-166-1",
          "chunkNumber": 1,
          "sanskrit": "ऋ॒ष॒भं मा॑ समा॒नानां॑ स॒पत्ना॑नां विषास॒हिम् ।",
          "section": 166,
          "padya": 1
        },
        {
          "id": "rv-10-166-2",
          "chunkNumber": 2,
          "sanskrit": "ह॒न्तारं॒ शत्रू॑णां कृधि वि॒राजं॒ गोप॑तिं॒ गवा॑म् ॥ १ ॥"
        },
        {
          "id": "rv-10-166-3",
          "chunkNumber": 3,
          "sanskrit": "अ॒हम॑स्मि सपत्न॒हेन्द्र॑ इ॒वारि॑ष्टो॒ अक्ष॑तः ।",
          "padya": 2
        },
        {
          "id": "rv-10-166-4",
          "chunkNumber": 4,
          "sanskrit": "अ॒धः स॒पत्ना॑ मे प॒दोरि॒मे सर्वे॑ अ॒भिष्ठि॑ताः ॥ २ ॥"
        },
        {
          "id": "rv-10-166-5",
          "chunkNumber": 5,
          "sanskrit": "अत्रै॒व वोऽपि॑ नह्याम्यु॒भे आर्त्नी॑ इव॒ ज्यया॑ ।",
          "padya": 3
        },
        {
          "id": "rv-10-166-6",
          "chunkNumber": 6,
          "sanskrit": "वाच॑स्पते॒ नि षे॑धे॒मान्यथा॒ मदध॑रं॒ वदा॑न् ॥ ३ ॥"
        },
        {
          "id": "rv-10-166-7",
          "chunkNumber": 7,
          "sanskrit": "अ॒भि॒भूर॒हमाग॑मं वि॒श्वक॑र्मेण॒ धाम्ना॑ ।",
          "padya": 4
        },
        {
          "id": "rv-10-166-8",
          "chunkNumber": 8,
          "sanskrit": "आ व॑श्चि॒त्तमा वो॑ व्र॒तमा वो॒ऽहं समि॑तिं ददे ॥ ४ ॥"
        },
        {
          "id": "rv-10-166-9",
          "chunkNumber": 9,
          "sanskrit": "यो॒ग॒क्षे॒मं व॑ आ॒दाया॒ऽहं भू॑यासमुत्त॒म आ वो॑ मू॒र्धान॑मक्रमीम् ।",
          "padya": 5
        },
        {
          "id": "rv-10-166-10",
          "chunkNumber": 10,
          "sanskrit": "अ॒ध॒स्प॒दान्म॒ उद्व॑दत म॒ण्डूका॑ इवोद॒कान्म॒ण्डूका॑ उद॒कादि॑व ॥ ५ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-167",
      "title": "Maṇḍala 10 · Sūkta 167",
      "sectionNumber": 167,
      "chunks": [
        {
          "id": "rv-10-167-1",
          "chunkNumber": 1,
          "sanskrit": "तुभ्ये॒दमि॑न्द्र॒ परि॑ षिच्यते॒ मधु॒ त्वं सु॒तस्य॑ क॒लश॑स्य राजसि ।",
          "section": 167,
          "padya": 1
        },
        {
          "id": "rv-10-167-2",
          "chunkNumber": 2,
          "sanskrit": "त्वं र॒यिं पु॑रु॒वीरा॑मु नस्कृधि॒ त्वं तप॑: परि॒तप्या॑जय॒: स्व॑: ॥ १ ॥"
        },
        {
          "id": "rv-10-167-3",
          "chunkNumber": 3,
          "sanskrit": "स्व॒र्जितं॒ महि॑ मन्दा॒नमन्ध॑सो॒ हवा॑महे॒ परि॑ श॒क्रं सु॒ताँ उप॑ ।",
          "padya": 2
        },
        {
          "id": "rv-10-167-4",
          "chunkNumber": 4,
          "sanskrit": "इ॒मं नो॑ य॒ज्ञमि॒ह बो॒ध्या ग॑हि॒ स्पृधो॒ जय॑न्तं म॒घवा॑नमीमहे ॥ २ ॥"
        },
        {
          "id": "rv-10-167-5",
          "chunkNumber": 5,
          "sanskrit": "सोम॑स्य॒ राज्ञो॒ वरु॑णस्य॒ धर्म॑णि॒ बृह॒स्पते॒रनु॑मत्या उ॒ शर्म॑णि ।",
          "padya": 3
        },
        {
          "id": "rv-10-167-6",
          "chunkNumber": 6,
          "sanskrit": "तवा॒हम॒द्य म॑घव॒न्नुप॑स्तुतौ॒ धात॒र्विधा॑तः क॒लशाँ॑ अभक्षयम् ॥ ३ ॥"
        },
        {
          "id": "rv-10-167-7",
          "chunkNumber": 7,
          "sanskrit": "प्रसू॑तो भ॒क्षम॑करं च॒रावपि॒ स्तोमं॑ चे॒मं प्र॑थ॒मः सू॒रिरुन्मृ॑जे ।",
          "padya": 4
        },
        {
          "id": "rv-10-167-8",
          "chunkNumber": 8,
          "sanskrit": "सु॒ते सा॒तेन॒ यद्याग॑मं वां॒ प्रति॑ विश्वामित्रजमदग्नी॒ दमे॑ ॥ ४ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-168",
      "title": "Maṇḍala 10 · Sūkta 168",
      "sectionNumber": 168,
      "chunks": [
        {
          "id": "rv-10-168-1",
          "chunkNumber": 1,
          "sanskrit": "वात॑स्य॒ नु म॑हि॒मानं॒ रथ॑स्य रु॒जन्ने॑ति स्त॒नय॑न्नस्य॒ घोष॑: ।",
          "section": 168,
          "padya": 1
        },
        {
          "id": "rv-10-168-2",
          "chunkNumber": 2,
          "sanskrit": "दि॒वि॒स्पृग्या॑त्यरु॒णानि॑ कृ॒ण्वन्नु॒तो ए॑ति पृथि॒व्या रे॒णुमस्य॑न् ॥ १ ॥"
        },
        {
          "id": "rv-10-168-3",
          "chunkNumber": 3,
          "sanskrit": "सं प्रेर॑ते॒ अनु॒ वात॑स्य वि॒ष्ठा ऐनं॑ गच्छन्ति॒ सम॑नं॒ न योषा॑: ।",
          "padya": 2
        },
        {
          "id": "rv-10-168-4",
          "chunkNumber": 4,
          "sanskrit": "ताभि॑: स॒युक्स॒रथं॑ दे॒व ई॑यते॒ऽस्य विश्व॑स्य॒ भुव॑नस्य॒ राजा॑ ॥ २ ॥"
        },
        {
          "id": "rv-10-168-5",
          "chunkNumber": 5,
          "sanskrit": "अ॒न्तरि॑क्षे प॒थिभि॒रीय॑मानो॒ न नि वि॑शते कत॒मच्च॒नाह॑: ।",
          "padya": 3
        },
        {
          "id": "rv-10-168-6",
          "chunkNumber": 6,
          "sanskrit": "अ॒पां सखा॑ प्रथम॒जा ऋ॒तावा॒ क्व॑ स्विज्जा॒तः कुत॒ आ ब॑भूव ॥ ३ ॥"
        },
        {
          "id": "rv-10-168-7",
          "chunkNumber": 7,
          "sanskrit": "आ॒त्मा दे॒वानां॒ भुव॑नस्य॒ गर्भो॑ यथाव॒शं च॑रति दे॒व ए॒षः ।",
          "padya": 4
        },
        {
          "id": "rv-10-168-8",
          "chunkNumber": 8,
          "sanskrit": "घोषा॒ इद॑स्य शृण्विरे॒ न रू॒पं तस्मै॒ वाता॑य ह॒विषा॑ विधेम ॥ ४ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-169",
      "title": "Maṇḍala 10 · Sūkta 169",
      "sectionNumber": 169,
      "chunks": [
        {
          "id": "rv-10-169-1",
          "chunkNumber": 1,
          "sanskrit": "म॒यो॒भूर्वातो॑ अ॒भि वा॑तू॒स्रा ऊर्ज॑स्वती॒रोष॑धी॒रा रि॑शन्ताम् ।",
          "section": 169,
          "padya": 1
        },
        {
          "id": "rv-10-169-2",
          "chunkNumber": 2,
          "sanskrit": "पीव॑स्वतीर्जी॒वध॑न्याः पिबन्त्वव॒साय॑ प॒द्वते॑ रुद्र मृळ ॥ १ ॥"
        },
        {
          "id": "rv-10-169-3",
          "chunkNumber": 3,
          "sanskrit": "याः सरू॑पा॒ विरू॑पा॒ एक॑रूपा॒ यासा॑म॒ग्निरिष्ट्या॒ नामा॑नि॒ वेद॑ ।",
          "padya": 2
        },
        {
          "id": "rv-10-169-4",
          "chunkNumber": 4,
          "sanskrit": "या अङ्गि॑रस॒स्तप॑से॒ह च॒क्रुस्ताभ्य॑: पर्जन्य॒ महि॒ शर्म॑ यच्छ ॥ २ ॥"
        },
        {
          "id": "rv-10-169-5",
          "chunkNumber": 5,
          "sanskrit": "या दे॒वेषु॑ त॒न्व१मैर॑यन्त॒ यासां॒ सोमो॒ विश्वा॑ रू॒पाणि॒ वेद॑ ।",
          "padya": 3
        },
        {
          "id": "rv-10-169-6",
          "chunkNumber": 6,
          "sanskrit": "ता अ॒स्मभ्यं॒ पय॑सा॒ पिन्व॑मानाः प्र॒जाव॑तीरिन्द्र गो॒ष्ठे रि॑रीहि ॥ ३ ॥"
        },
        {
          "id": "rv-10-169-7",
          "chunkNumber": 7,
          "sanskrit": "प्र॒जाप॑ति॒र्मह्य॑मे॒ता ररा॑णो॒ विश्वै॑र्दे॒वैः पि॒तृभि॑: संविदा॒नः ।",
          "padya": 4
        },
        {
          "id": "rv-10-169-8",
          "chunkNumber": 8,
          "sanskrit": "शि॒वाः स॒तीरुप॑ नो गो॒ष्ठमाक॒स्तासां॑ व॒यं प्र॒जया॒ सं स॑देम ॥ ४ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-170",
      "title": "Maṇḍala 10 · Sūkta 170",
      "sectionNumber": 170,
      "chunks": [
        {
          "id": "rv-10-170-1",
          "chunkNumber": 1,
          "sanskrit": "वि॒भ्राड्बृ॒हत्पि॑बतु सो॒म्यं मध्वायु॒र्दध॑द्य॒ज्ञप॑ता॒ववि॑ह्रुतम् ।",
          "section": 170,
          "padya": 1
        },
        {
          "id": "rv-10-170-2",
          "chunkNumber": 2,
          "sanskrit": "वात॑जूतो॒ यो अ॑भि॒रक्ष॑ति॒ त्मना॑ प्र॒जाः पु॑पोष पुरु॒धा वि रा॑जति ॥ १ ॥"
        },
        {
          "id": "rv-10-170-3",
          "chunkNumber": 3,
          "sanskrit": "वि॒भ्राड्बृ॒हत्सुभृ॑तं वाज॒सात॑मं॒ धर्म॑न्दि॒वो ध॒रुणे॑ स॒त्यमर्पि॑तम् ।",
          "padya": 2
        },
        {
          "id": "rv-10-170-4",
          "chunkNumber": 4,
          "sanskrit": "अ॒मि॒त्र॒हा वृ॑त्र॒हा द॑स्यु॒हन्त॑मं॒ ज्योति॑र्जज्ञे असुर॒हा स॑पत्न॒हा ॥ २ ॥"
        },
        {
          "id": "rv-10-170-5",
          "chunkNumber": 5,
          "sanskrit": "इ॒दं श्रेष्ठं॒ ज्योति॑षां॒ ज्योति॑रुत्त॒मं वि॑श्व॒जिद्ध॑न॒जिदु॑च्यते बृ॒हत् ।",
          "padya": 3
        },
        {
          "id": "rv-10-170-6",
          "chunkNumber": 6,
          "sanskrit": "वि॒श्व॒भ्राड्भ्रा॒जो महि॒ सूर्यो॑ दृ॒श उ॒रु प॑प्रथे॒ सह॒ ओजो॒ अच्यु॑तम् ॥ ३ ॥"
        },
        {
          "id": "rv-10-170-7",
          "chunkNumber": 7,
          "sanskrit": "वि॒भ्राज॒ञ्ज्योति॑षा॒ स्व१रग॑च्छो रोच॒नं दि॒वः ।",
          "padya": 4
        },
        {
          "id": "rv-10-170-8",
          "chunkNumber": 8,
          "sanskrit": "येने॒मा विश्वा॒ भुव॑ना॒न्याभृ॑ता वि॒श्वक॑र्मणा वि॒श्वदे॑व्यावता ॥ ४ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-171",
      "title": "Maṇḍala 10 · Sūkta 171",
      "sectionNumber": 171,
      "chunks": [
        {
          "id": "rv-10-171-1",
          "chunkNumber": 1,
          "sanskrit": "त्वं त्यमि॒टतो॒ रथ॒मिन्द्र॒ प्राव॑: सु॒ताव॑तः ।",
          "section": 171,
          "padya": 1
        },
        {
          "id": "rv-10-171-2",
          "chunkNumber": 2,
          "sanskrit": "अशृ॑णोः सो॒मिनो॒ हव॑म् ॥ १ ॥"
        },
        {
          "id": "rv-10-171-3",
          "chunkNumber": 3,
          "sanskrit": "त्वं म॒खस्य॒ दोध॑त॒: शिरोऽव॑ त्व॒चो भ॑रः ।",
          "padya": 2
        },
        {
          "id": "rv-10-171-4",
          "chunkNumber": 4,
          "sanskrit": "अग॑च्छः सो॒मिनो॑ गृ॒हम् ॥ २ ॥"
        },
        {
          "id": "rv-10-171-5",
          "chunkNumber": 5,
          "sanskrit": "त्वं त्यमि॑न्द्र॒ मर्त्य॑मास्त्रबु॒ध्नाय॑ वे॒न्यम् ।",
          "padya": 3
        },
        {
          "id": "rv-10-171-6",
          "chunkNumber": 6,
          "sanskrit": "मुहु॑: श्रथ्ना मन॒स्यवे॑ ॥ ३ ॥"
        },
        {
          "id": "rv-10-171-7",
          "chunkNumber": 7,
          "sanskrit": "त्वं त्यमि॑न्द्र॒ सूर्यं॑ प॒श्चा सन्तं॑ पु॒रस्कृ॑धि ।",
          "padya": 4
        },
        {
          "id": "rv-10-171-8",
          "chunkNumber": 8,
          "sanskrit": "दे॒वानां॑ चित्ति॒रो वश॑म् ॥ ४ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-172",
      "title": "Maṇḍala 10 · Sūkta 172",
      "sectionNumber": 172,
      "chunks": [
        {
          "id": "rv-10-172-1",
          "chunkNumber": 1,
          "sanskrit": "आ या॑हि॒ वन॑सा स॒ह गाव॑: सचन्त वर्त॒निं यदूध॑भिः।",
          "section": 172,
          "padya": 1
        },
        {
          "id": "rv-10-172-2",
          "chunkNumber": 2,
          "sanskrit": "१\n\nआ या॑हि॒ वस्व्या॑ धि॒या मंहि॑ष्ठो जार॒यन्म॑खः सु॒दानु॑भिः ॥ १ ॥"
        },
        {
          "id": "rv-10-172-3",
          "chunkNumber": 3,
          "sanskrit": "२\n\nपि॒तु॒भृतो॒ न तन्तु॒मित्सु॒दान॑व॒: प्रति॑ दध्मो॒ यजा॑मसि।"
        },
        {
          "id": "rv-10-172-4",
          "chunkNumber": 4,
          "sanskrit": "३\n\nउ॒षा अप॒ स्वसु॒स्तम॒: सं व॑र्तयति वर्त॒निं सु॑जा॒तता॑ ॥ २ ॥ ४"
        }
      ]
    },
    {
      "id": "rigveda-10-173",
      "title": "Maṇḍala 10 · Sūkta 173",
      "sectionNumber": 173,
      "chunks": [
        {
          "id": "rv-10-173-1",
          "chunkNumber": 1,
          "sanskrit": "आ त्वा॑हार्षम॒न्तरे॑धि ध्रु॒वस्ति॒ष्ठावि॑चाचलिः ।",
          "section": 173,
          "padya": 1
        },
        {
          "id": "rv-10-173-2",
          "chunkNumber": 2,
          "sanskrit": "विश॑स्त्वा॒ सर्वा॑ वाञ्छन्तु॒ मा त्वद्रा॒ष्ट्रमधि॑ भ्रशत् ॥ १ ॥"
        },
        {
          "id": "rv-10-173-3",
          "chunkNumber": 3,
          "sanskrit": "इ॒हैवैधि॒ माप॑ च्योष्ठा॒: पर्व॑त इ॒वावि॑चाचलिः ।",
          "padya": 2
        },
        {
          "id": "rv-10-173-4",
          "chunkNumber": 4,
          "sanskrit": "इन्द्र॑ इवे॒ह ध्रु॒वस्ति॑ष्ठे॒ह रा॒ष्ट्रमु॑ धारय ॥ २ ॥"
        },
        {
          "id": "rv-10-173-5",
          "chunkNumber": 5,
          "sanskrit": "इ॒ममिन्द्रो॑ अदीधरद्ध्रु॒वं ध्रु॒वेण॑ ह॒विषा॑ ।",
          "padya": 3
        },
        {
          "id": "rv-10-173-6",
          "chunkNumber": 6,
          "sanskrit": "तस्मै॒ सोमो॒ अधि॑ ब्रव॒त्तस्मा॑ उ॒ ब्रह्म॑ण॒स्पति॑: ॥ ३ ॥"
        },
        {
          "id": "rv-10-173-7",
          "chunkNumber": 7,
          "sanskrit": "ध्रु॒वा द्यौर्ध्रु॒वा पृ॑थि॒वी ध्रु॒वास॒: पर्व॑ता इ॒मे ।",
          "padya": 4
        },
        {
          "id": "rv-10-173-8",
          "chunkNumber": 8,
          "sanskrit": "ध्रु॒वं विश्व॑मि॒दं जग॑द्ध्रु॒वो राजा॑ वि॒शाम॒यम् ॥ ४ ॥"
        },
        {
          "id": "rv-10-173-9",
          "chunkNumber": 9,
          "sanskrit": "ध्रु॒वं ते॒ राजा॒ वरु॑णो ध्रु॒वं दे॒वो बृह॒स्पति॑: ।",
          "padya": 5
        },
        {
          "id": "rv-10-173-10",
          "chunkNumber": 10,
          "sanskrit": "ध्रु॒वं त॒ इन्द्र॑श्चा॒ग्निश्च॑ रा॒ष्ट्रं धा॑रयतां ध्रु॒वम् ॥ ५ ॥"
        },
        {
          "id": "rv-10-173-11",
          "chunkNumber": 11,
          "sanskrit": "ध्रु॒वं ध्रु॒वेण॑ ह॒विषा॒ऽभि सोमं॑ मृशामसि ।",
          "padya": 6
        },
        {
          "id": "rv-10-173-12",
          "chunkNumber": 12,
          "sanskrit": "अथो॑ त॒ इन्द्र॒: केव॑ली॒र्विशो॑ बलि॒हृत॑स्करत् ॥ ६ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-174",
      "title": "Maṇḍala 10 · Sūkta 174",
      "sectionNumber": 174,
      "chunks": [
        {
          "id": "rv-10-174-1",
          "chunkNumber": 1,
          "sanskrit": "अ॒भी॒व॒र्तेन॑ ह॒विषा॒ येनेन्द्रो॑ अभिवावृ॒ते ।",
          "section": 174,
          "padya": 1
        },
        {
          "id": "rv-10-174-2",
          "chunkNumber": 2,
          "sanskrit": "तेना॒स्मान्ब्र॑ह्मणस्पते॒ऽभि रा॒ष्ट्राय॑ वर्तय ॥ १ ॥"
        },
        {
          "id": "rv-10-174-3",
          "chunkNumber": 3,
          "sanskrit": "अ॒भि॒वृत्य॑ स॒पत्ना॑न॒भि या नो॒ अरा॑तयः ।",
          "padya": 2
        },
        {
          "id": "rv-10-174-4",
          "chunkNumber": 4,
          "sanskrit": "अ॒भि पृ॑त॒न्यन्तं॑ तिष्ठा॒ऽभि यो न॑ इर॒स्यति॑ ॥ २ ॥"
        },
        {
          "id": "rv-10-174-5",
          "chunkNumber": 5,
          "sanskrit": "अ॒भि त्वा॑ दे॒वः स॑वि॒ताऽभि सोमो॑ अवीवृतत् ।",
          "padya": 3
        },
        {
          "id": "rv-10-174-6",
          "chunkNumber": 6,
          "sanskrit": "अ॒भि त्वा॒ विश्वा॑ भू॒तान्य॑भीव॒र्तो यथास॑सि ॥ ३ ॥"
        },
        {
          "id": "rv-10-174-7",
          "chunkNumber": 7,
          "sanskrit": "येनेन्द्रो॑ ह॒विषा॑ कृ॒त्व्यभ॑वद्द्यु॒म्न्यु॑त्त॒मः ।",
          "padya": 4
        },
        {
          "id": "rv-10-174-8",
          "chunkNumber": 8,
          "sanskrit": "इ॒दं तद॑क्रि देवा असप॒त्नः किला॑भुवम् ॥ ४ ॥"
        },
        {
          "id": "rv-10-174-9",
          "chunkNumber": 9,
          "sanskrit": "अ॒स॒प॒त्नः स॑पत्न॒हाऽभिरा॑ष्ट्रो विषास॒हिः ।",
          "padya": 5
        },
        {
          "id": "rv-10-174-10",
          "chunkNumber": 10,
          "sanskrit": "यथा॒हमे॑षां भू॒तानां॑ वि॒राजा॑नि॒ जन॑स्य च ॥ ५ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-175",
      "title": "Maṇḍala 10 · Sūkta 175",
      "sectionNumber": 175,
      "chunks": [
        {
          "id": "rv-10-175-1",
          "chunkNumber": 1,
          "sanskrit": "प्र वो॑ ग्रावाणः सवि॒ता दे॒वः सु॑वतु॒ धर्म॑णा ।",
          "section": 175,
          "padya": 1
        },
        {
          "id": "rv-10-175-2",
          "chunkNumber": 2,
          "sanskrit": "धू॒र्षु यु॑ज्यध्वं सुनु॒त ॥ १ ॥"
        },
        {
          "id": "rv-10-175-3",
          "chunkNumber": 3,
          "sanskrit": "ग्रावा॑णो॒ अप॑ दु॒च्छुना॒मप॑ सेधत दुर्म॒तिम् ।",
          "padya": 2
        },
        {
          "id": "rv-10-175-4",
          "chunkNumber": 4,
          "sanskrit": "उ॒स्राः क॑र्तन भेष॒जम् ॥ २ ॥"
        },
        {
          "id": "rv-10-175-5",
          "chunkNumber": 5,
          "sanskrit": "ग्रावा॑ण॒ उप॑रे॒ष्वा म॑ही॒यन्ते॑ स॒जोष॑सः ।",
          "padya": 3
        },
        {
          "id": "rv-10-175-6",
          "chunkNumber": 6,
          "sanskrit": "वृष्णे॒ दध॑तो॒ वृष्ण्य॑म् ॥ ३ ॥"
        },
        {
          "id": "rv-10-175-7",
          "chunkNumber": 7,
          "sanskrit": "ग्रावा॑णः सवि॒ता नु वो॑ दे॒वः सु॑वतु॒ धर्म॑णा ।",
          "padya": 4
        },
        {
          "id": "rv-10-175-8",
          "chunkNumber": 8,
          "sanskrit": "यज॑मानाय सुन्व॒ते ॥ ४ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-176",
      "title": "Maṇḍala 10 · Sūkta 176",
      "sectionNumber": 176,
      "chunks": [
        {
          "id": "rv-10-176-1",
          "chunkNumber": 1,
          "sanskrit": "प्र सू॒नव॑ ऋभू॒णां बृ॒हन्न॑वन्त वृ॒जना॑ ।",
          "section": 176,
          "padya": 1
        },
        {
          "id": "rv-10-176-2",
          "chunkNumber": 2,
          "sanskrit": "क्षामा॒ ये वि॒श्वधा॑य॒सोऽश्न॑न्धे॒नुं न मा॒तर॑म् ॥ १ ॥"
        },
        {
          "id": "rv-10-176-3",
          "chunkNumber": 3,
          "sanskrit": "प्र दे॒वं दे॒व्या धि॒या भर॑ता जा॒तवे॑दसम् ।",
          "padya": 2
        },
        {
          "id": "rv-10-176-4",
          "chunkNumber": 4,
          "sanskrit": "ह॒व्या नो॑ वक्षदानु॒षक् ॥ २ ॥"
        },
        {
          "id": "rv-10-176-5",
          "chunkNumber": 5,
          "sanskrit": "अ॒यमु॒ ष्य प्र दे॑व॒युर्होता॑ य॒ज्ञाय॑ नीयते ।",
          "padya": 3
        },
        {
          "id": "rv-10-176-6",
          "chunkNumber": 6,
          "sanskrit": "रथो॒ न योर॒भीवृ॑तो॒ घृणी॑वाञ्चेतति॒ त्मना॑ ॥ ३ ॥"
        },
        {
          "id": "rv-10-176-7",
          "chunkNumber": 7,
          "sanskrit": "अ॒यम॒ग्निरु॑रुष्यत्य॒मृता॑दिव॒ जन्म॑नः ।",
          "padya": 4
        },
        {
          "id": "rv-10-176-8",
          "chunkNumber": 8,
          "sanskrit": "सह॑सश्चि॒त्सही॑यान्दे॒वो जी॒वात॑वे कृ॒तः ॥ ४ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-177",
      "title": "Maṇḍala 10 · Sūkta 177",
      "sectionNumber": 177,
      "chunks": [
        {
          "id": "rv-10-177-1",
          "chunkNumber": 1,
          "sanskrit": "प॒तं॒गम॒क्तमसु॑रस्य मा॒यया॑ हृ॒दा प॑श्यन्ति॒ मन॑सा विप॒श्चित॑: ।",
          "section": 177,
          "padya": 1
        },
        {
          "id": "rv-10-177-2",
          "chunkNumber": 2,
          "sanskrit": "स॒मु॒द्रे अ॒न्तः क॒वयो॒ वि च॑क्षते॒ मरी॑चीनां प॒दमि॑च्छन्ति वे॒धस॑: ॥ १ ॥"
        },
        {
          "id": "rv-10-177-3",
          "chunkNumber": 3,
          "sanskrit": "प॒तं॒गो वाचं॒ मन॑सा बिभर्ति॒ तां ग॑न्ध॒र्वो॑ऽवद॒द्गर्भे॑ अ॒न्तः ।",
          "padya": 2
        },
        {
          "id": "rv-10-177-4",
          "chunkNumber": 4,
          "sanskrit": "तां द्योत॑मानां स्व॒र्यं॑ मनी॒षामृ॒तस्य॑ प॒दे क॒वयो॒ नि पा॑न्ति ॥ २ ॥"
        },
        {
          "id": "rv-10-177-5",
          "chunkNumber": 5,
          "sanskrit": "अप॑श्यं गो॒पामनि॑पद्यमान॒मा च॒ परा॑ च प॒थिभि॒श्चर॑न्तम् ।",
          "padya": 3
        },
        {
          "id": "rv-10-177-6",
          "chunkNumber": 6,
          "sanskrit": "स स॒ध्रीची॒: स विषू॑ची॒र्वसा॑न॒ आ व॑रीवर्ति॒ भुव॑नेष्व॒न्तः ॥ ३ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-178",
      "title": "Maṇḍala 10 · Sūkta 178",
      "sectionNumber": 178,
      "chunks": [
        {
          "id": "rv-10-178-1",
          "chunkNumber": 1,
          "sanskrit": "त्यमू॒ षु वा॒जिनं॑ दे॒वजू॑तं स॒हावा॑नं तरु॒तारं॒ रथा॑नाम् ।",
          "section": 178,
          "padya": 1
        },
        {
          "id": "rv-10-178-2",
          "chunkNumber": 2,
          "sanskrit": "अरि॑ष्टनेमिं पृत॒नाज॑मा॒शुं स्व॒स्तये॒ तार्क्ष्य॑मि॒हा हु॑वेम ॥ १ ॥"
        },
        {
          "id": "rv-10-178-3",
          "chunkNumber": 3,
          "sanskrit": "इन्द्र॑स्येव रा॒तिमा॒जोहु॑वानाः स्व॒स्तये॒ नाव॑मि॒वा रु॑हेम ।",
          "padya": 2
        },
        {
          "id": "rv-10-178-4",
          "chunkNumber": 4,
          "sanskrit": "उर्वी॒ न पृथ्वी॒ बहु॑ले॒ गभी॑रे॒ मा वा॒मेतौ॒ मा परे॑तौ रिषाम ॥ २ ॥"
        },
        {
          "id": "rv-10-178-5",
          "chunkNumber": 5,
          "sanskrit": "स॒द्यश्चि॒द्यः शव॑सा॒ पञ्च॑ कृ॒ष्टीः सूर्य॑ इव॒ ज्योति॑षा॒पस्त॒तान॑ ।",
          "padya": 3
        },
        {
          "id": "rv-10-178-6",
          "chunkNumber": 6,
          "sanskrit": "स॒ह॒स्र॒साः श॑त॒सा अ॑स्य॒ रंहि॒र्न स्मा॑ वरन्ते युव॒तिं न शर्या॑म् ॥ ३ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-179",
      "title": "Maṇḍala 10 · Sūkta 179",
      "sectionNumber": 179,
      "chunks": [
        {
          "id": "rv-10-179-1",
          "chunkNumber": 1,
          "sanskrit": "उत्ति॑ष्ठ॒ताव॑ पश्य॒तेन्द्र॑स्य भा॒गमृ॒त्विय॑म् ।",
          "section": 179,
          "padya": 1
        },
        {
          "id": "rv-10-179-2",
          "chunkNumber": 2,
          "sanskrit": "यदि॑ श्रा॒तो जु॒होत॑न॒ यद्यश्रा॑तो मम॒त्तन॑ ॥ १ ॥"
        },
        {
          "id": "rv-10-179-3",
          "chunkNumber": 3,
          "sanskrit": "श्रा॒तं ह॒विरो ष्वि॑न्द्र॒ प्र या॑हि ज॒गाम॒ सूरो॒ अध्व॑नो॒ विम॑ध्यम् ।",
          "padya": 2
        },
        {
          "id": "rv-10-179-4",
          "chunkNumber": 4,
          "sanskrit": "परि॑ त्वासते नि॒धिभि॒: सखा॑यः कुल॒पा न व्रा॒जप॑तिं॒ चर॑न्तम् ॥ २ ॥"
        },
        {
          "id": "rv-10-179-5",
          "chunkNumber": 5,
          "sanskrit": "श्रा॒तं म॑न्य॒ ऊध॑नि श्रा॒तम॒ग्नौ सुश्रा॑तं मन्ये॒ तदृ॒तं नवी॑यः ।",
          "padya": 3
        },
        {
          "id": "rv-10-179-6",
          "chunkNumber": 6,
          "sanskrit": "माध्यं॑दिनस्य॒ सव॑नस्य द॒ध्नः पिबे॑न्द्र वज्रिन्पुरुकृज्जुषा॒णः ॥ ३ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-180",
      "title": "Maṇḍala 10 · Sūkta 180",
      "sectionNumber": 180,
      "chunks": [
        {
          "id": "rv-10-180-1",
          "chunkNumber": 1,
          "sanskrit": "प्र स॑साहिषे पुरुहूत॒ शत्रू॒ञ्ज्येष्ठ॑स्ते॒ शुष्म॑ इ॒ह रा॒तिर॑स्तु ।",
          "section": 180,
          "padya": 1
        },
        {
          "id": "rv-10-180-2",
          "chunkNumber": 2,
          "sanskrit": "इन्द्रा भ॑र॒ दक्षि॑णेना॒ वसू॑नि॒ पति॒: सिन्धू॑नामसि रे॒वती॑नाम् ॥ १ ॥"
        },
        {
          "id": "rv-10-180-3",
          "chunkNumber": 3,
          "sanskrit": "मृ॒गो न भी॒मः कु॑च॒रो गि॑रि॒ष्ठाः प॑रा॒वत॒ आ ज॑गन्था॒ पर॑स्याः ।",
          "padya": 2
        },
        {
          "id": "rv-10-180-4",
          "chunkNumber": 4,
          "sanskrit": "सृ॒कं सं॒शाय॑ प॒विमि॑न्द्र ति॒ग्मं वि शत्रू॑न्ताळ्हि॒ वि मृधो॑ नुदस्व ॥ २ ॥"
        },
        {
          "id": "rv-10-180-5",
          "chunkNumber": 5,
          "sanskrit": "इन्द्र॑ क्ष॒त्रम॒भि वा॒ममोजोऽजा॑यथा वृषभ चर्षणी॒नाम् ।",
          "padya": 3
        },
        {
          "id": "rv-10-180-6",
          "chunkNumber": 6,
          "sanskrit": "अपा॑नुदो॒ जन॑ममित्र॒यन्त॑मु॒रुं दे॒वेभ्यो॑ अकृणोरु लो॒कम् ॥ ३ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-181",
      "title": "Maṇḍala 10 · Sūkta 181",
      "sectionNumber": 181,
      "chunks": [
        {
          "id": "rv-10-181-1",
          "chunkNumber": 1,
          "sanskrit": "प्रथ॑श्च॒ यस्य॑ स॒प्रथ॑श्च॒ नामाऽऽनु॑ष्टुभस्य ह॒विषो॑ ह॒विर्यत् ।",
          "section": 181,
          "padya": 1
        },
        {
          "id": "rv-10-181-2",
          "chunkNumber": 2,
          "sanskrit": "धा॒तुर्द्युता॑नात्सवि॒तुश्च॒ विष्णो॑ रथंत॒रमा ज॑भारा॒ वसि॑ष्ठः ॥ १ ॥"
        },
        {
          "id": "rv-10-181-3",
          "chunkNumber": 3,
          "sanskrit": "अवि॑न्द॒न्ते अति॑हितं॒ यदासी॑द्य॒ज्ञस्य॒ धाम॑ पर॒मं गुहा॒ यत् ।",
          "padya": 2
        },
        {
          "id": "rv-10-181-4",
          "chunkNumber": 4,
          "sanskrit": "धा॒तुर्द्युता॑नात्सवि॒तुश्च॒ विष्णो॑र्भ॒रद्वा॑जो बृ॒हदा च॑क्रे अ॒ग्नेः ॥ २ ॥"
        },
        {
          "id": "rv-10-181-5",
          "chunkNumber": 5,
          "sanskrit": "ते॑ऽविन्द॒न्मन॑सा॒ दीध्या॑ना॒ यजु॑: ष्क॒न्नं प्र॑थ॒मं दे॑व॒यान॑म् ।",
          "padya": 3
        },
        {
          "id": "rv-10-181-6",
          "chunkNumber": 6,
          "sanskrit": "धा॒तुर्द्युता॑नात्सवि॒तुश्च॒ विष्णो॒रा सूर्या॑दभरन्घ॒र्ममे॒ते ॥ ३ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-182",
      "title": "Maṇḍala 10 · Sūkta 182",
      "sectionNumber": 182,
      "chunks": [
        {
          "id": "rv-10-182-1",
          "chunkNumber": 1,
          "sanskrit": "बृह॒स्पति॑र्नयतु दु॒र्गहा॑ ति॒रः पुन॑र्नेषद॒घशं॑साय॒ मन्म॑ ।",
          "section": 182,
          "padya": 1
        },
        {
          "id": "rv-10-182-2",
          "chunkNumber": 2,
          "sanskrit": "क्षि॒पदश॑स्ति॒मप॑ दुर्म॒तिं ह॒न्नथा॑ कर॒द्यज॑मानाय॒ शं योः ॥ १ ॥"
        },
        {
          "id": "rv-10-182-3",
          "chunkNumber": 3,
          "sanskrit": "नरा॒शंसो॑ नोऽवतु प्रया॒जे शं नो॑ अस्त्वनुया॒जो हवे॑षु ।",
          "padya": 2
        },
        {
          "id": "rv-10-182-4",
          "chunkNumber": 4,
          "sanskrit": "क्षि॒पदश॑स्ति॒मप॑ दुर्म॒तिं ह॒न्नथा॑ कर॒द्यज॑मानाय॒ शं योः ॥ २ ॥"
        },
        {
          "id": "rv-10-182-5",
          "chunkNumber": 5,
          "sanskrit": "तपु॑र्मूर्धा तपतु र॒क्षसो॒ ये ब्र॑ह्म॒द्विष॒: शर॑वे॒ हन्त॒वा उ॑ ।",
          "padya": 3
        },
        {
          "id": "rv-10-182-6",
          "chunkNumber": 6,
          "sanskrit": "क्षि॒पदश॑स्ति॒मप॑ दुर्म॒तिं ह॒न्नथा॑ कर॒द्यज॑मानाय॒ शं योः ॥ ३ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-183",
      "title": "Maṇḍala 10 · Sūkta 183",
      "sectionNumber": 183,
      "chunks": [
        {
          "id": "rv-10-183-1",
          "chunkNumber": 1,
          "sanskrit": "अप॑श्यं त्वा॒ मन॑सा॒ चेकि॑तानं॒ तप॑सो जा॒तं तप॑सो॒ विभू॑तम् ।",
          "section": 183,
          "padya": 1
        },
        {
          "id": "rv-10-183-2",
          "chunkNumber": 2,
          "sanskrit": "इ॒ह प्र॒जामि॒ह र॒यिं ररा॑ण॒: प्र जा॑यस्व प्र॒जया॑ पुत्रकाम ॥ १ ॥"
        },
        {
          "id": "rv-10-183-3",
          "chunkNumber": 3,
          "sanskrit": "अप॑श्यं त्वा॒ मन॑सा॒ दीध्या॑नां॒ स्वायां॑ त॒नू ऋत्व्ये॒ नाध॑मानाम् ।",
          "padya": 2
        },
        {
          "id": "rv-10-183-4",
          "chunkNumber": 4,
          "sanskrit": "उप॒ मामु॒च्चा यु॑व॒तिर्ब॑भूया॒: प्र जा॑यस्व प्र॒जया॑ पुत्रकामे ॥ २ ॥"
        },
        {
          "id": "rv-10-183-5",
          "chunkNumber": 5,
          "sanskrit": "अ॒हं गर्भ॑मदधा॒मोष॑धीष्व॒हं विश्वे॑षु॒ भुव॑नेष्व॒न्तः ।",
          "padya": 3
        },
        {
          "id": "rv-10-183-6",
          "chunkNumber": 6,
          "sanskrit": "अ॒हं प्र॒जा अ॑जनयं पृथि॒व्याम॒हं जनि॑भ्यो अप॒रीषु॑ पु॒त्रान् ॥ ३ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-184",
      "title": "Maṇḍala 10 · Sūkta 184",
      "sectionNumber": 184,
      "chunks": [
        {
          "id": "rv-10-184-1",
          "chunkNumber": 1,
          "sanskrit": "विष्णु॒र्योनिं॑ कल्पयतु॒ त्वष्टा॑ रू॒पाणि॑ पिंशतु ।",
          "section": 184,
          "padya": 1
        },
        {
          "id": "rv-10-184-2",
          "chunkNumber": 2,
          "sanskrit": "आ सि॑ञ्चतु प्र॒जाप॑तिर्धा॒ता गर्भं॑ दधातु ते ॥ १ ॥"
        },
        {
          "id": "rv-10-184-3",
          "chunkNumber": 3,
          "sanskrit": "गर्भं॑ धेहि सिनीवालि॒ गर्भं॑ धेहि सरस्वति ।",
          "padya": 2
        },
        {
          "id": "rv-10-184-4",
          "chunkNumber": 4,
          "sanskrit": "गर्भं॑ ते अ॒श्विनौ॑ दे॒वावा ध॑त्तां॒ पुष्क॑रस्रजा ॥ २ ॥"
        },
        {
          "id": "rv-10-184-5",
          "chunkNumber": 5,
          "sanskrit": "हि॒र॒ण्ययी॑ अ॒रणी॒ यं नि॒र्मन्थ॑तो अ॒श्विना॑ ।",
          "padya": 3
        },
        {
          "id": "rv-10-184-6",
          "chunkNumber": 6,
          "sanskrit": "तं त॒त गर्भं॑ हवामहे दश॒मे मा॒सि सूत॑वे ॥ ३ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-185",
      "title": "Maṇḍala 10 · Sūkta 185",
      "sectionNumber": 185,
      "chunks": [
        {
          "id": "rv-10-185-1",
          "chunkNumber": 1,
          "sanskrit": "महि॑ त्री॒णामवो॑ऽस्तु द्यु॒क्षं मि॒त्रस्या॑र्य॒म्णः ।",
          "section": 185,
          "padya": 1
        },
        {
          "id": "rv-10-185-2",
          "chunkNumber": 2,
          "sanskrit": "दु॒रा॒धर्षं॒ वरु॑णस्य ॥ १ ॥"
        },
        {
          "id": "rv-10-185-3",
          "chunkNumber": 3,
          "sanskrit": "न॒हि तेषा॑म॒मा च॒न नाध्व॑सु वार॒णेषु॑ ।",
          "padya": 2
        },
        {
          "id": "rv-10-185-4",
          "chunkNumber": 4,
          "sanskrit": "ईशे॑ रि॒पुर॒घशं॑सः ॥ २ ॥"
        },
        {
          "id": "rv-10-185-5",
          "chunkNumber": 5,
          "sanskrit": "यस्मै॑ पु॒त्रासो॒ अदि॑ते॒: प्र जी॒वसे॒ मर्त्या॑य ।",
          "padya": 3
        },
        {
          "id": "rv-10-185-6",
          "chunkNumber": 6,
          "sanskrit": "ज्योति॒र्यच्छ॒न्त्यज॑स्रम् ॥ ३ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-186",
      "title": "Maṇḍala 10 · Sūkta 186",
      "sectionNumber": 186,
      "chunks": [
        {
          "id": "rv-10-186-1",
          "chunkNumber": 1,
          "sanskrit": "वात॒ आ वा॑तु भेष॒जं श॒म्भु म॑यो॒भु नो॑ हृ॒दे ।",
          "section": 186,
          "padya": 1
        },
        {
          "id": "rv-10-186-2",
          "chunkNumber": 2,
          "sanskrit": "प्र ण॒ आयूं॑षि तारिषत् ॥ १ ॥"
        },
        {
          "id": "rv-10-186-3",
          "chunkNumber": 3,
          "sanskrit": "उ॒त वा॑त पि॒तासि॑ न उ॒त भ्रातो॒त न॒: सखा॑ ।",
          "padya": 2
        },
        {
          "id": "rv-10-186-4",
          "chunkNumber": 4,
          "sanskrit": "स नो॑ जी॒वात॑वे कृधि ॥ २ ॥"
        },
        {
          "id": "rv-10-186-5",
          "chunkNumber": 5,
          "sanskrit": "यद॒दो वा॑त ते गृ॒हे॒३ऽमृत॑स्य नि॒धिर्हि॒तः ।",
          "padya": 3
        },
        {
          "id": "rv-10-186-6",
          "chunkNumber": 6,
          "sanskrit": "ततो॑ नो देहि जी॒वसे॑ ॥ ३ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-187",
      "title": "Maṇḍala 10 · Sūkta 187",
      "sectionNumber": 187,
      "chunks": [
        {
          "id": "rv-10-187-1",
          "chunkNumber": 1,
          "sanskrit": "प्राग्नये॒ वाच॑मीरय वृष॒भाय॑ क्षिती॒नाम् ।",
          "section": 187,
          "padya": 1
        },
        {
          "id": "rv-10-187-2",
          "chunkNumber": 2,
          "sanskrit": "स न॑: पर्ष॒दति॒ द्विष॑: ॥ १ ॥"
        },
        {
          "id": "rv-10-187-3",
          "chunkNumber": 3,
          "sanskrit": "यः पर॑स्याः परा॒वत॑स्ति॒रो धन्वा॑ति॒रोच॑ते ।",
          "padya": 2
        },
        {
          "id": "rv-10-187-4",
          "chunkNumber": 4,
          "sanskrit": "स न॑: पर्ष॒दति॒ द्विष॑: ॥ २ ॥"
        },
        {
          "id": "rv-10-187-5",
          "chunkNumber": 5,
          "sanskrit": "यो रक्षां॑सि नि॒जूर्व॑ति॒ वृषा॑ शु॒क्रेण॑ शो॒चिषा॑ ।",
          "padya": 3
        },
        {
          "id": "rv-10-187-6",
          "chunkNumber": 6,
          "sanskrit": "स न॑: पर्ष॒दति॒ द्विष॑: ॥ ३ ॥"
        },
        {
          "id": "rv-10-187-7",
          "chunkNumber": 7,
          "sanskrit": "यो विश्वा॒भि वि॒पश्य॑ति॒ भुव॑ना॒ सं च॒ पश्य॑ति ।",
          "padya": 4
        },
        {
          "id": "rv-10-187-8",
          "chunkNumber": 8,
          "sanskrit": "स न॑: पर्ष॒दति॒ द्विष॑: ॥ ४ ॥"
        },
        {
          "id": "rv-10-187-9",
          "chunkNumber": 9,
          "sanskrit": "यो अ॒स्य पा॒रे रज॑सः शु॒क्रो अ॒ग्निरजा॑यत ।",
          "padya": 5
        },
        {
          "id": "rv-10-187-10",
          "chunkNumber": 10,
          "sanskrit": "स न॑: पर्ष॒दति॒ द्विष॑: ॥ ५ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-188",
      "title": "Maṇḍala 10 · Sūkta 188",
      "sectionNumber": 188,
      "chunks": [
        {
          "id": "rv-10-188-1",
          "chunkNumber": 1,
          "sanskrit": "प्र नू॒नं जा॒तवे॑दस॒मश्वं॑ हिनोत वा॒जिन॑म् ।",
          "section": 188,
          "padya": 1
        },
        {
          "id": "rv-10-188-2",
          "chunkNumber": 2,
          "sanskrit": "इ॒दं नो॑ ब॒र्हिरा॒सदे॑ ॥ १ ॥"
        },
        {
          "id": "rv-10-188-3",
          "chunkNumber": 3,
          "sanskrit": "अ॒स्य प्र जा॒तवे॑दसो॒ विप्र॑वीरस्य मी॒ळ्हुष॑: ।",
          "padya": 2
        },
        {
          "id": "rv-10-188-4",
          "chunkNumber": 4,
          "sanskrit": "म॒हीमि॑यर्मि सुष्टु॒तिम् ॥ २ ॥"
        },
        {
          "id": "rv-10-188-5",
          "chunkNumber": 5,
          "sanskrit": "या रुचो॑ जा॒तवे॑दसो देव॒त्रा ह॑व्य॒वाह॑नीः ।",
          "padya": 3
        },
        {
          "id": "rv-10-188-6",
          "chunkNumber": 6,
          "sanskrit": "ताभि॑र्नो य॒ज्ञमि॑न्वतु ॥ ३ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-189",
      "title": "Maṇḍala 10 · Sūkta 189",
      "sectionNumber": 189,
      "chunks": [
        {
          "id": "rv-10-189-1",
          "chunkNumber": 1,
          "sanskrit": "आयं गौः पृश्नि॑रक्रमी॒दस॑दन्मा॒तरं॑ पु॒रः ।",
          "section": 189,
          "padya": 1
        },
        {
          "id": "rv-10-189-2",
          "chunkNumber": 2,
          "sanskrit": "पि॒तरं॑ च प्र॒यन्त्स्व॑: ॥ १ ॥"
        },
        {
          "id": "rv-10-189-3",
          "chunkNumber": 3,
          "sanskrit": "अ॒न्तश्च॑रति रोच॒नाऽस्य प्रा॒णाद॑पान॒ती ।",
          "padya": 2
        },
        {
          "id": "rv-10-189-4",
          "chunkNumber": 4,
          "sanskrit": "व्य॑ख्यन्महि॒षो दिव॑म् ॥ २ ॥"
        },
        {
          "id": "rv-10-189-5",
          "chunkNumber": 5,
          "sanskrit": "त्रिं॒शद्धाम॒ वि रा॑जति॒ वाक्प॑तं॒गाय॑ धीयते ।",
          "padya": 3
        },
        {
          "id": "rv-10-189-6",
          "chunkNumber": 6,
          "sanskrit": "प्रति॒ वस्तो॒रह॒ द्युभि॑: ॥ ३ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-190",
      "title": "Maṇḍala 10 · Sūkta 190",
      "sectionNumber": 190,
      "chunks": [
        {
          "id": "rv-10-190-1",
          "chunkNumber": 1,
          "sanskrit": "ऋ॒तं च॑ स॒त्यं चा॒भी॑द्धा॒त्तप॒सोऽध्य॑जायत ।",
          "section": 190,
          "padya": 1
        },
        {
          "id": "rv-10-190-2",
          "chunkNumber": 2,
          "sanskrit": "ततो॒ रात्र्य॑जायत॒ तत॑: समु॒द्रो अ॑र्ण॒वः ॥ १ ॥"
        },
        {
          "id": "rv-10-190-3",
          "chunkNumber": 3,
          "sanskrit": "स॒मु॒द्राद॑र्ण॒वादधि॑ संवत्स॒रो अ॑जायत ।",
          "padya": 2
        },
        {
          "id": "rv-10-190-4",
          "chunkNumber": 4,
          "sanskrit": "अ॒हो॒रा॒त्राणि॑ वि॒दध॒द्विश्व॑स्य मिष॒तो व॒शी ॥ २ ॥"
        },
        {
          "id": "rv-10-190-5",
          "chunkNumber": 5,
          "sanskrit": "सू॒र्या॒च॒न्द्र॒मसौ॑ धा॒ता य॑थापू॒र्वम॑कल्पयत् ।",
          "padya": 3
        },
        {
          "id": "rv-10-190-6",
          "chunkNumber": 6,
          "sanskrit": "दिवं॑ च पृथि॒वीं चा॒ऽन्तरि॑क्ष॒मथो॒ स्व॑: ॥ ३ ॥"
        }
      ]
    },
    {
      "id": "rigveda-10-191",
      "title": "Maṇḍala 10 · Sūkta 191",
      "sectionNumber": 191,
      "chunks": [
        {
          "id": "rv-10-191-1",
          "chunkNumber": 1,
          "sanskrit": "संस॒मिद्यु॑वसे वृष॒न्नग्ने॒ विश्वा॑न्य॒र्य आ ।",
          "section": 191,
          "padya": 1
        },
        {
          "id": "rv-10-191-2",
          "chunkNumber": 2,
          "sanskrit": "इ॒ळस्प॒दे समि॑ध्यसे॒ स नो॒ वसू॒न्या भ॑र ॥ १ ॥"
        },
        {
          "id": "rv-10-191-3",
          "chunkNumber": 3,
          "sanskrit": "सं ग॑च्छध्वं॒ सं व॑दध्वं॒ सं वो॒ मनां॑सि जानताम् ।",
          "padya": 2
        },
        {
          "id": "rv-10-191-4",
          "chunkNumber": 4,
          "sanskrit": "दे॒वा भा॒गं यथा॒ पूर्वे॑ संजाना॒ना उ॒पास॑ते ॥ २ ॥"
        },
        {
          "id": "rv-10-191-5",
          "chunkNumber": 5,
          "sanskrit": "स॒मा॒नो मन्त्र॒: समि॑तिः समा॒नी स॑मा॒नं मन॑: स॒ह चि॒त्तमे॑षाम् ।",
          "padya": 3
        },
        {
          "id": "rv-10-191-6",
          "chunkNumber": 6,
          "sanskrit": "स॒मा॒नं मन्त्र॑म॒भि म॑न्त्रये वः समा॒नेन॑ वो ह॒विषा॑ जुहोमि ॥ ३ ॥"
        },
        {
          "id": "rv-10-191-7",
          "chunkNumber": 7,
          "sanskrit": "स॒मा॒नी व॒ आकू॑तिः समा॒ना हृद॑यानि वः ।",
          "padya": 4
        },
        {
          "id": "rv-10-191-8",
          "chunkNumber": 8,
          "sanskrit": "स॒मा॒नम॑स्तु वो॒ मनो॒ यथा॑ व॒: सुस॒हास॑ति ॥ ४ ॥"
        }
      ]
    }
  ]
}
