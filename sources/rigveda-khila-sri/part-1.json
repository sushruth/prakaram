{
  "sections": [
    {
      "id": "rigveda-khila-sri-1",
      "title": "Śrī Sūkta (RvKh 2.6)",
      "sectionNumber": 1,
      "chunks": [
        {
          "id": "rigveda-khila-sri-1-1",
          "chunkNumber": 1,
          "sanskrit": "ōṃ ||"
        },
        {
          "id": "rigveda-khila-sri-1-2",
          "chunkNumber": 2,
          "sanskrit": "hira̍ṇyavarṇāṃ̠ hari̍ṇīṃ su̠varṇa̍raja̠tasra̍jām |"
        },
        {
          "id": "rigveda-khila-sri-1-3",
          "chunkNumber": 3,
          "sanskrit": "ca̠ndrāṃ hi̠raṇma̍yīṃ la̠kṣmīṃ jāta̍vedo ma̠ āva̍ha || 1||"
        },
        {
          "id": "rigveda-khila-sri-1-4",
          "chunkNumber": 4,
          "sanskrit": "tāṃ ma̠ āva̍ha̠ jāta̍vedo la̠kṣmīmana̍pagā̠minī̎m |"
        },
        {
          "id": "rigveda-khila-sri-1-5",
          "chunkNumber": 5,
          "sanskrit": "yasyāṃ̠ hira̍ṇyaṃ vi̠ndeyaṃ̠ gāmaśvaṃ̠ puru̍ṣāna̠ham || 2||"
        },
        {
          "id": "rigveda-khila-sri-1-6",
          "chunkNumber": 6,
          "sanskrit": "a̠śva̠pū̠rvāṃ ra̍thama̠dhyāṃ ha̠stinā̎dapra̠bodhi̍nīm |"
        },
        {
          "id": "rigveda-khila-sri-1-7",
          "chunkNumber": 7,
          "sanskrit": "śriyaṃ̍ de̠vīmupa̍hvaye̠ śrīrmā̎de̠vīrju̍ṣatām || 3||"
        },
        {
          "id": "rigveda-khila-sri-1-8",
          "chunkNumber": 8,
          "sanskrit": "kāṃ̠ so̠smi̠tāṃ hira̍ṇyaprā̠kārā̍mā̠rdrāṃ jvala̍ntīṃ tṛ̠ptāṃ ta̠rpaya̍ntīm |"
        },
        {
          "id": "rigveda-khila-sri-1-9",
          "chunkNumber": 9,
          "sanskrit": "pa̠dme̠ sthi̠tāṃ pa̠dmava̍rṇāṃ̠ tāmi̠hopa̍hvaye̠ śriyam || 4||"
        },
        {
          "id": "rigveda-khila-sri-1-10",
          "chunkNumber": 10,
          "sanskrit": "ca̠ndrāṃ pra̍bhā̠sāṃ ya̠śasā̠ jvala̍ntīṃ̠ śriyaṃ̍ lo̠ke de̠vaju̍ṣṭāmudā̠rām |"
        },
        {
          "id": "rigveda-khila-sri-1-11",
          "chunkNumber": 11,
          "sanskrit": "tāṃ pa̠dminī̍mīṃ̠ śara̍ṇama̠haṃ prapa̍dye'la̠kṣmīrme̍ naśyatāṃ̠ tvāṃ vṛ̍ṇe || 5||"
        },
        {
          "id": "rigveda-khila-sri-1-12",
          "chunkNumber": 12,
          "sanskrit": "ā̠di̠tyava̍rṇe̠ tapa̠so'dhi̍jā̠to vana̠spati̠stava̍ vṛ̠kṣo'tha bi̠lvaḥ |"
        },
        {
          "id": "rigveda-khila-sri-1-13",
          "chunkNumber": 13,
          "sanskrit": "tasya̠ phalā̎ni̠ tapa̠sā nu̍dantu mā̠yānta̍rā̠yāśca̍ bā̠hyā a̍la̠kṣmīḥ || 6||"
        },
        {
          "id": "rigveda-khila-sri-1-14",
          "chunkNumber": 14,
          "sanskrit": "upai̍tu̠ māṃ de̍vasa̠khaḥ kī̠rtiśca̠ maṇi̍nā sa̠ha |"
        },
        {
          "id": "rigveda-khila-sri-1-15",
          "chunkNumber": 15,
          "sanskrit": "prā̠du̠rbhū̠to'smi̍ rāṣṭre̠'smin kī̠rtimṛ̍ddhiṃ da̠dātu̍ me || 7||"
        },
        {
          "id": "rigveda-khila-sri-1-16",
          "chunkNumber": 16,
          "sanskrit": "kṣutpi̍pā̠sāma̍lāṃ jye̠ṣṭhāma̍la̠kṣmīṃ nā̍śayā̠myaham |"
        },
        {
          "id": "rigveda-khila-sri-1-17",
          "chunkNumber": 17,
          "sanskrit": "abhū̍ti̠masa̍mṛddhiṃ̠ ca sarvāṃ̠ nirṇu̍da me̠ gṛhā̎t || 8||"
        },
        {
          "id": "rigveda-khila-sri-1-18",
          "chunkNumber": 18,
          "sanskrit": "gaṃ̠dha̠dvā̠rāṃ du̍rādha̠rṣāṃ̠ ni̠tyapu̍ṣṭāṃ karī̠ṣiṇī̎m |"
        },
        {
          "id": "rigveda-khila-sri-1-19",
          "chunkNumber": 19,
          "sanskrit": "ī̠śvarī̍gͫ sarva̍bhūtā̠nāṃ̠ tāmi̠hopa̍hvaye̠ śriyam || 9||"
        },
        {
          "id": "rigveda-khila-sri-1-20",
          "chunkNumber": 20,
          "sanskrit": "mana̍saḥ̠ kāma̠mākū̎tiṃ vā̠caḥ sa̠tyama̍śīmahi |"
        },
        {
          "id": "rigveda-khila-sri-1-21",
          "chunkNumber": 21,
          "sanskrit": "pa̠śū̠nāṃ rū̠pamanna̍sya̠ mayi̠ śrīḥ śra̍yatāṃ̠ yaśaḥ̍ || 10||"
        },
        {
          "id": "rigveda-khila-sri-1-22",
          "chunkNumber": 22,
          "sanskrit": "ka̠rdame̍na pra̍jābhū̠tā̠ ma̠yi̠ sambha̍va ka̠rdama |"
        },
        {
          "id": "rigveda-khila-sri-1-23",
          "chunkNumber": 23,
          "sanskrit": "śriyaṃ̍ vā̠saya̍ me ku̠le mā̠taraṃ̍ padma̠māli̍nīm || 11||"
        },
        {
          "id": "rigveda-khila-sri-1-24",
          "chunkNumber": 24,
          "sanskrit": "āpaḥ̍ sṛ̠jantu̍ sni̠gdhā̠ni̠ ci̠klī̠ta va̍sa me̠ gṛhe |"
        },
        {
          "id": "rigveda-khila-sri-1-25",
          "chunkNumber": 25,
          "sanskrit": "ni ca̍ de̠vīṃ mā̠taraṃ̠ śriyaṃ̍ vā̠saya̍ me ku̠le || 12||"
        },
        {
          "id": "rigveda-khila-sri-1-26",
          "chunkNumber": 26,
          "sanskrit": "ā̠rdrāṃ pu̠ṣkari̍ṇīṃ pu̠ṣṭiṃ̠ pi̠ṅga̠lāṃ pa̍dmamā̠linīm |"
        },
        {
          "id": "rigveda-khila-sri-1-27",
          "chunkNumber": 27,
          "sanskrit": "ca̠ndrāṃ hi̠raṇma̍yīṃ la̠kṣmīṃ jāta̍vedo ma̠ āva̍ha || 13||"
        },
        {
          "id": "rigveda-khila-sri-1-28",
          "chunkNumber": 28,
          "sanskrit": "ā̠rdrāṃ yaḥ̠ kari̍ṇīṃ ya̠ṣṭiṃ̠ su̠va̠rṇāṃ he̍mamā̠linīm |"
        },
        {
          "id": "rigveda-khila-sri-1-29",
          "chunkNumber": 29,
          "sanskrit": "sū̠ryāṃ hi̠raṇma̍yīṃ la̠kṣmīṃ̠ jāta̍vedo ma̠ āva̍ha || 14||"
        },
        {
          "id": "rigveda-khila-sri-1-30",
          "chunkNumber": 30,
          "sanskrit": "tāṃ ma̠ āva̍ha̠ jāta̍vedo la̠kṣmīmana̍pagā̠minī̎m |"
        },
        {
          "id": "rigveda-khila-sri-1-31",
          "chunkNumber": 31,
          "sanskrit": "yasyāṃ̠ hi̍raṇyaṃ̠ prabhū̍taṃ̠ gāvo̍ dā̠syo'śvā̎nvi̠ndeyaṃ̠ puru̍ṣāna̠ham || 15||"
        },
        {
          "id": "rigveda-khila-sri-1-32",
          "chunkNumber": 32,
          "sanskrit": "yaḥ śuciḥ̠ praya̍to bhū̠tvā ju̠huyā̎dājya̠ manva̍ham |"
        },
        {
          "id": "rigveda-khila-sri-1-33",
          "chunkNumber": 33,
          "sanskrit": "śriyaḥ̍ pa̠ñcada̍śarcaṃ̠ ca śrī̠kāmaḥ̍ sata̠taṃ ja̍pet || 16||"
        },
        {
          "id": "rigveda-khila-sri-1-34",
          "chunkNumber": 34,
          "sanskrit": "pa̠dmā̠na̠ne pa̍dma ū̠rū̠ pa̠dmākṣī̍ padma̠sambha̍ve |"
        },
        {
          "id": "rigveda-khila-sri-1-35",
          "chunkNumber": 35,
          "sanskrit": "tvaṃ māṃ̎ bha̠jasva̍ pa̠dmā̠kṣī̠ ye̠na sau̎khyaṃ la̠bhāmya̍ham ||"
        },
        {
          "id": "rigveda-khila-sri-1-36",
          "chunkNumber": 36,
          "sanskrit": "aśva̍dā̠yī go̍dā̠yī̠ dha̠nadā̍yī ma̠hādha̍ne |"
        },
        {
          "id": "rigveda-khila-sri-1-37",
          "chunkNumber": 37,
          "sanskrit": "dhanaṃ me̠ juṣa̍tāṃ de̠vi̠ sa̠rvakā̍māṃśca̠ dehi̍ me ||"
        },
        {
          "id": "rigveda-khila-sri-1-38",
          "chunkNumber": 38,
          "sanskrit": "putrapau̠tra dha̍naṃ dhā̠nyaṃ ha̠styaśvā̍diga̠ve ra̍tham |"
        },
        {
          "id": "rigveda-khila-sri-1-39",
          "chunkNumber": 39,
          "sanskrit": "pra̠jā̠nāṃ bha̍vasi mā̠tā ā̠yuṣma̍ntaṃ ka̠rotu̍ mām ||"
        },
        {
          "id": "rigveda-khila-sri-1-40",
          "chunkNumber": 40,
          "sanskrit": "dhana̍ma̠gnirdha̍naṃ vā̠yurdha̍naṃ̠ sūryo̍ dhanaṃ̠ vasuḥ̍ |"
        },
        {
          "id": "rigveda-khila-sri-1-41",
          "chunkNumber": 41,
          "sanskrit": "dhana̠mindro̠ bṛha̠spati̠rvaru̍ṇaṃ̠ dhana̠maśnu̍ te ||"
        },
        {
          "id": "rigveda-khila-sri-1-42",
          "chunkNumber": 42,
          "sanskrit": "vaina̍teya̠ somaṃ̍ piba̠ somaṃ̍ pibatu vṛtra̠hā |"
        },
        {
          "id": "rigveda-khila-sri-1-43",
          "chunkNumber": 43,
          "sanskrit": "somaṃ̠ dhana̍sya so̠mino̠ mahyaṃ̠ dadā̍tu so̠minaḥ̍ ||"
        },
        {
          "id": "rigveda-khila-sri-1-44",
          "chunkNumber": 44,
          "sanskrit": "na krodho na ca̍ mātsa̠ryaṃ na̠ lobho̍ nāśu̠bhā ma̍tiḥ |"
        },
        {
          "id": "rigveda-khila-sri-1-45",
          "chunkNumber": 45,
          "sanskrit": "bhava̍nti̠ kṛta̍puṇyā̠nāṃ bha̠ktānāṃ śrīsū̎ktaṃ ja̠petsa̍dā ||"
        },
        {
          "id": "rigveda-khila-sri-1-46",
          "chunkNumber": 46,
          "sanskrit": "varṣa̍ntu̠ te vi̍bhāva̠ri̠ di̠vo a̍bhrasya̠ vidyu̍taḥ |"
        },
        {
          "id": "rigveda-khila-sri-1-47",
          "chunkNumber": 47,
          "sanskrit": "roha̍ntu̠ sarva̍bī̠jā̠nya̠va bra̍hma dvi̠ṣo ja̍hi ||"
        },
        {
          "id": "rigveda-khila-sri-1-48",
          "chunkNumber": 48,
          "sanskrit": "padma̍priye padmini padma̠haste padmā̍laye padmadalāya̍tākṣi |"
        },
        {
          "id": "rigveda-khila-sri-1-49",
          "chunkNumber": 49,
          "sanskrit": "viśva̍priye̠ viṣṇu mano̍'nukū̠le tvatpā̍dapa̠dmaṃ mayi̠ sanni̍dhatsva ||"
        },
        {
          "id": "rigveda-khila-sri-1-50",
          "chunkNumber": 50,
          "sanskrit": "yā sā padmā̍sana̠sthā vipulakaṭitaṭī padma̠patrā̍yatā̠kṣī |"
        },
        {
          "id": "rigveda-khila-sri-1-51",
          "chunkNumber": 51,
          "sanskrit": "gambhīrā va̍rtanā̠bhiḥ stanabhara namitā śubhra vastro̍ttarī̠yā |"
        },
        {
          "id": "rigveda-khila-sri-1-52",
          "chunkNumber": 52,
          "sanskrit": "lakṣmīrdi̠vyairgajendrairma̠ṇigaṇa khacitaissnāpitā he̍maku̠mbhaiḥ |"
        },
        {
          "id": "rigveda-khila-sri-1-53",
          "chunkNumber": 53,
          "sanskrit": "ni̠tyaṃ sā pa̍dmaha̠stā mama vasa̍tu gṛ̠he sarva̠māṅgalya̍yuktā ||"
        },
        {
          "id": "rigveda-khila-sri-1-54",
          "chunkNumber": 54,
          "sanskrit": "la̠kṣmīṃ kṣīrasamudra rājatanayāṃ śrī̠raṃgadhāme̍śvarīm |"
        },
        {
          "id": "rigveda-khila-sri-1-55",
          "chunkNumber": 55,
          "sanskrit": "dā̠sībhūtasamasta deva va̠nitāṃ lo̠kaika̠ dīpāṃ̍kurām |"
        },
        {
          "id": "rigveda-khila-sri-1-56",
          "chunkNumber": 56,
          "sanskrit": "śrīmanmandakaṭākṣalabdha vibhava bra̠hmendragaṅgā̍dharām |"
        },
        {
          "id": "rigveda-khila-sri-1-57",
          "chunkNumber": 57,
          "sanskrit": "tvāṃ trai̠lokya̠ kuṭu̍mbinīṃ sa̠rasijāṃ vande̠ muku̍ndapriyām ||"
        },
        {
          "id": "rigveda-khila-sri-1-58",
          "chunkNumber": 58,
          "sanskrit": "si̠ddha̠la̠kṣmīrmo̍kṣala̠kṣmī̠rja̠yala̍kṣmīssa̠rasva̍tī |"
        },
        {
          "id": "rigveda-khila-sri-1-59",
          "chunkNumber": 59,
          "sanskrit": "śrīlakṣmīrva̍rala̠kṣmī̠śca̠ pra̠sannā ma̍ma sa̠rvadā ||"
        },
        {
          "id": "rigveda-khila-sri-1-60",
          "chunkNumber": 60,
          "sanskrit": "varāṃkuśau pāśamabhī̍timu̠drāṃ̠ ka̠rairvahantīṃ ka̍malā̠sanasthām |"
        },
        {
          "id": "rigveda-khila-sri-1-61",
          "chunkNumber": 61,
          "sanskrit": "bālārka koṭi prati̍bhāṃ tri̠ṇe̠trāṃ̠ bha̠jehamādyāṃ ja̍gadī̠śvarīṃ tām ||"
        },
        {
          "id": "rigveda-khila-sri-1-62",
          "chunkNumber": 62,
          "sanskrit": "sa̠rva̠ma̠ṅga̠lamā̠ṅgalye̍ śi̠ve sa̠rvārtha̍ sādhike |"
        },
        {
          "id": "rigveda-khila-sri-1-63",
          "chunkNumber": 63,
          "sanskrit": "śara̍ṇye tryamba̍ke de̠vi̠ nā̠rāya̍ṇi na̠mo'stu̍ te ||"
        },
        {
          "id": "rigveda-khila-sri-1-64",
          "chunkNumber": 64,
          "sanskrit": "sarasijanilaye saro̍jaha̠ste dhavalatarāṃśuka gandhamā̎lyaśo̠bhe |"
        },
        {
          "id": "rigveda-khila-sri-1-65",
          "chunkNumber": 65,
          "sanskrit": "bhagavati harivallabhe̍ mano̠jñe tribhuvanabhūtikaripra̍sīda ma̠hyam ||"
        },
        {
          "id": "rigveda-khila-sri-1-66",
          "chunkNumber": 66,
          "sanskrit": "viṣṇu̍pa̠tnīṃ kṣa̍māṃ de̠vīṃ̠ mā̠dhavīṃ̎ mādha̠vapri̍yām |"
        },
        {
          "id": "rigveda-khila-sri-1-67",
          "chunkNumber": 67,
          "sanskrit": "viṣṇoḥ̎ pri̠yasa̍khīṃm de̠vīṃ̠ na̠mā̠myacyu̍tava̠llabhām ||"
        },
        {
          "id": "rigveda-khila-sri-1-68",
          "chunkNumber": 68,
          "sanskrit": "ma̠hā̠la̠kṣmī ca̍ vi̠dmahe̍ viṣṇupa̠tnī ca̍ dhīmahī |"
        },
        {
          "id": "rigveda-khila-sri-1-69",
          "chunkNumber": 69,
          "sanskrit": "tanno̍ lakṣmīḥ praco̠dayā̎t ||"
        },
        {
          "id": "rigveda-khila-sri-1-70",
          "chunkNumber": 70,
          "sanskrit": "śrī̠varca̍sya̠māyu̍ṣya̠māro̎gya̠māvi̍dhā̠t pava̍mānaṃ mahī̠yate̎ |"
        },
        {
          "id": "rigveda-khila-sri-1-71",
          "chunkNumber": 71,
          "sanskrit": "dha̠naṃ dhā̠nyaṃ pa̠śuṃ ba̠hupu̍tralā̠bhaṃ śa̠tasaṃ̍vatsa̠raṃ dī̠rghamāyuḥ̍ ||"
        },
        {
          "id": "rigveda-khila-sri-1-72",
          "chunkNumber": 72,
          "sanskrit": "ṛṇarogādidāridryapā̠pakṣu̍da̠pamṛtya̍vaḥ |"
        },
        {
          "id": "rigveda-khila-sri-1-73",
          "chunkNumber": 73,
          "sanskrit": "bhaya̍śo̠kama̍nastā̠pā na̠śyantu̍ mama̠ sarva̍dā ||"
        },
        {
          "id": "rigveda-khila-sri-1-74",
          "chunkNumber": 74,
          "sanskrit": "śriye̍ jā̠ta śriya̠ āni̍ryāya̠ śriyaṃ̠ vayo̎ jani̠tṛbhyo̎ dadhātu |"
        },
        {
          "id": "rigveda-khila-sri-1-75",
          "chunkNumber": 75,
          "sanskrit": "śriyaṃ̠ vasā̎nā amṛta̠tvamā̎ya̠n bhajaṃ̎ti sa̠dyaḥ sa̍vi̠tā vi̠dadhyūn̍ ||"
        },
        {
          "id": "rigveda-khila-sri-1-76",
          "chunkNumber": 76,
          "sanskrit": "śriya̍ evainaṃ tacchri̠yāmā̍dadhā̠ti |"
        },
        {
          "id": "rigveda-khila-sri-1-77",
          "chunkNumber": 77,
          "sanskrit": "sa̠nta̠ta̠mṛ̠cā va̍ṣaṭkṛ̠tyaṃ sandha̍ttaṃ̠ sandhī̍yate praja̠yā pa̠śubhiḥ |"
        },
        {
          "id": "rigveda-khila-sri-1-78",
          "chunkNumber": 78,
          "sanskrit": "ya e̍vaṃ ve̠da |"
        },
        {
          "id": "rigveda-khila-sri-1-79",
          "chunkNumber": 79,
          "sanskrit": "ōṃ ma̠hā̠de̠vyai ca̍ vi̠dmahe̍ viṣṇupa̠tnī ca̍ dhīmahi |"
        },
        {
          "id": "rigveda-khila-sri-1-80",
          "chunkNumber": 80,
          "sanskrit": "tanno̍ lakṣmīḥ praco̠dayā̎t ||"
        },
        {
          "id": "rigveda-khila-sri-1-81",
          "chunkNumber": 81,
          "sanskrit": "ōṃ śāntiḥ̠ śāntiḥ̠ śāntiḥ̍ ||"
        }
      ]
    }
  ]
}
