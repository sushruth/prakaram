        {
          "id": "ta-9-15-90",
          "chunkNumber": 90,
          "sanskrit": "पृ॒थि॒व्यामा॑का॒शः प्रति॑ष्ठितः।"
        },
        {
          "id": "ta-9-15-91",
          "chunkNumber": 91,
          "sanskrit": "आ॒का॒शे पृ॑थि॒वी प्रति॑ष्ठिता।"
