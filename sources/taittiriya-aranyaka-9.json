          "sanskrit": "म॒हान्की॒र्त्या न कञ्चन वसतौ प्रत्या॑चख्षी॒त।"
        },
        {
          "id": "ta-9-15-97",
          "chunkNumber": 97,
          "sanskrit": "तद्व्र॒तम्॥"
        },
        {
          "id": "ta-9-15-98",
          "chunkNumber": 98,
          "sanskrit": "तस्माद्यया कया च विधया बह्व॑न्नं प्रा॒प्नुयात्॥"
        },
        {
          "id": "ta-9-15-99",
          "chunkNumber": 99,
          "sanskrit": "अराद्ध्यस्मा अन्नमि॑त्याच॒ख्षते॥"
        },
        {
          "id": "ta-9-15-100",
          "chunkNumber": 100,
          "sanskrit": "एतद्वै मुखतो᳚ऽन्नꣳ रा॒द्धम्।"
        },
        {
          "id": "ta-9-15-101",
          "chunkNumber": 101,
          "sanskrit": "मुखतोऽस्मा अ॑न्नꣳ रा॒द्ध्यते।"
        },
        {
          "id": "ta-9-15-102",
          "chunkNumber": 102,
          "sanskrit": "एतद्वै मद्ध्यतो᳚ऽन्नꣳ रा॒द्धम्।"
        },
        {
          "id": "ta-9-15-103",
          "chunkNumber": 103,
          "sanskrit": "मद्ध्यतोऽस्मा अ॑न्नꣳ रा॒द्ध्यते।"
        },
        {
          "id": "ta-9-15-104",
          "chunkNumber": 104,
          "sanskrit": "एदद्वा अन्ततो᳚ऽन्नꣳ रा॒द्धम्।"
        },
        {
          "id": "ta-9-15-105",
          "chunkNumber": 105,
          "sanskrit": "अन्ततोऽस्मा अ॑न्नꣳ रा॒द्ध्यते।"
        },
        {
          "id": "ta-9-15-106",
          "chunkNumber": 106,
          "sanskrit": "य ए॑वव्ँवे॒द॥"
        },
        {
          "id": "ta-9-15-107",
          "chunkNumber": 107,
          "sanskrit": "ख्षेम इ॑ति वा॒चि।"
        },
        {
          "id": "ta-9-15-108",
          "chunkNumber": 108,
          "sanskrit": "योगख्षेम इति प्रा॑णापा॒नयोः।"
        },
        {
          "id": "ta-9-15-109",
          "chunkNumber": 109,
          "sanskrit": "कर्मे॑ति ह॒स्तयोः।"
        },
        {
          "id": "ta-9-15-110",
          "chunkNumber": 110,
          "sanskrit": "गतिरि॑ति पा॒दयोः।"
        },
        {
          "id": "ta-9-15-111",
          "chunkNumber": 111,
          "sanskrit": "विमुक्तिरि॑ति पा॒यौ।"
        },
        {
          "id": "ta-9-15-112",
          "chunkNumber": 112,
          "sanskrit": "इति मानुषी᳚स्समा॒ज्ञाः॥"
        },
        {
          "id": "ta-9-15-113",
          "chunkNumber": 113,
          "sanskrit": "अथ दै॒वीः।"
        },
        {
          "id": "ta-9-15-114",
          "chunkNumber": 114,
          "sanskrit": "तृप्तिरि॑ति वृ॒ष्टौ।"
        },
        {
          "id": "ta-9-15-115",
          "chunkNumber": 115,
          "sanskrit": "बलमि॑ति वि॒द्युति।"
        },
        {
          "id": "ta-9-15-116",
          "chunkNumber": 116,
          "sanskrit": "यश इ॑ति प॒शुषु।"
        },
        {
          "id": "ta-9-15-117",
          "chunkNumber": 117,
          "sanskrit": "ज्योतिरिति न॑ख्षत्रे॒षु।"
        },
        {
          "id": "ta-9-15-118",
          "chunkNumber": 118,
          "sanskrit": "प्रजातिरमृतमानन्द इ॑त्युप॒स्थे।"
        },
        {
          "id": "ta-9-15-119",
          "chunkNumber": 119,
          "sanskrit": "सर्वमि॑त्याका॒शे॥"
        },
        {
          "id": "ta-9-15-120",
          "chunkNumber": 120,
          "sanskrit": "तत्प्रतिष्ठेत्यु॑पासी॒त।"
        },
        {
          "id": "ta-9-15-121",
          "chunkNumber": 121,
          "sanskrit": "प्रतिष्ठा॑वान्भ॒वति।"
        },
        {
          "id": "ta-9-15-122",
          "chunkNumber": 122,
          "sanskrit": "तन्मह इत्यु॑पासी॒त।"
        },
        {
          "id": "ta-9-15-123",
          "chunkNumber": 123,
          "sanskrit": "म॑हान्भ॒वति।"
        },
        {
          "id": "ta-9-15-124",
          "chunkNumber": 124,
          "sanskrit": "तन्मन इत्यु॑पासी॒त।"
        },
        {
          "id": "ta-9-15-125",
          "chunkNumber": 125,
          "sanskrit": "मान॑वान्भ॒वति।"
        },
        {
          "id": "ta-9-15-126",
          "chunkNumber": 126,
          "sanskrit": "तन्नम इत्यु॑पासी॒त।"
        },
        {
          "id": "ta-9-15-127",
          "chunkNumber": 127,
          "sanskrit": "नम्यन्ते᳚ऽस्मै का॒माः।"
        },
        {
          "id": "ta-9-15-128",
          "chunkNumber": 128,
          "sanskrit": "तद्ब्रह्मेत्यु॑पासी॒त।"
        },
        {
          "id": "ta-9-15-129",
          "chunkNumber": 129,
          "sanskrit": "ब्रह्म॑वान्भ॒वति।"
        },
        {
          "id": "ta-9-15-130",
          "chunkNumber": 130,
          "sanskrit": "तद्ब्रह्मणः परिमर इत्यु॑पासी॒त।"
        },
        {
          "id": "ta-9-15-131",
          "chunkNumber": 131,
          "sanskrit": "पर्येणम्म्रियन्ते द्विषन्त॑स्सप॒त्नाः।"
        },
        {
          "id": "ta-9-15-132",
          "chunkNumber": 132,
          "sanskrit": "परि ये᳚ऽप्रिया᳚ भ्रातृ॒व्याः॥"
        },
        {
          "id": "ta-9-15-133",
          "chunkNumber": 133,
          "sanskrit": "स यश्चा॑यम्पु॒रुषे।"
        },
        {
          "id": "ta-9-15-134",
          "chunkNumber": 134,
          "sanskrit": "यश्चासा॑वादि॒त्ये।"
        },
        {
          "id": "ta-9-15-135",
          "chunkNumber": 135,
          "sanskrit": "स एकः॑।"
        },
        {
          "id": "ta-9-15-136",
          "chunkNumber": 136,
          "sanskrit": "स य॑ एव॒व्ँवित्।"
        },
        {
          "id": "ta-9-15-137",
          "chunkNumber": 137,
          "sanskrit": "अस्माल्लो॑कात्प्रे॒त्य।"
        },
        {
          "id": "ta-9-15-138",
          "chunkNumber": 138,
          "sanskrit": "एतमन्नमयमात्मानमुप॑सङ्क्र॒म्य।"
        },
        {
          "id": "ta-9-15-139",
          "chunkNumber": 139,
          "sanskrit": "एतम्प्राणमयमात्मानमुप॑सङ्क्र॒म्य।"
        },
        {
          "id": "ta-9-15-140",
          "chunkNumber": 140,
          "sanskrit": "एतम्मनोमयमात्मानमुप॑सङ्क्र॒म्य।"
        },
        {
          "id": "ta-9-15-141",
          "chunkNumber": 141,
          "sanskrit": "एतव्ँविज्ञानमयमात्मानमुप॑सङ्क्र॒म्य।"
        },
        {
          "id": "ta-9-15-142",
          "chunkNumber": 142,
          "sanskrit": "एतमानन्दमयमात्मानमुप॑सङ्क्र॒म्य।"
        },
        {
          "id": "ta-9-15-143",
          "chunkNumber": 143,
          "sanskrit": "इमाल्ँलोकान्कामान्नी कामरूप्य॑नुस॒ञ्चरन्।"
        },
        {
          "id": "ta-9-15-144",
          "chunkNumber": 144,
          "sanskrit": "एतथ्सामगा॑यन्ना॒स्ते॥"
        },
        {
          "id": "ta-9-15-145",
          "chunkNumber": 145,
          "sanskrit": "हा(३)वु॒ हा(३)वु॒ हा(३)वु॑।"
        },
        {
          "id": "ta-9-15-146",
          "chunkNumber": 146,
          "sanskrit": "अ॒हमन्नम॒हमन्नम॒हमन्नम्।"
        },
        {
          "id": "ta-9-15-147",
          "chunkNumber": 147,
          "sanskrit": "अ॒हमन्ना॒दोऽ(२॒)हमन्ना॒दोऽ(२॒)हमन्ना॒दः।"
        },
        {
          "id": "ta-9-15-148",
          "chunkNumber": 148,
          "sanskrit": "अ॒हꣴ श्लोक॒कृद॒हꣴ श्लोक॒कृद॒हꣴ श्लोक॒कृत्।"
        },
        {
          "id": "ta-9-15-149",
          "chunkNumber": 149,
          "sanskrit": "अ॒हमस्मि प्रथमजा ऋता(३)स्य॒।"
        },
        {
          "id": "ta-9-15-150",
          "chunkNumber": 150,
          "sanskrit": "पूर्वन्देवेभ्यो अमृतस्य ना(३)भा॒इ॒।"
        },
        {
          "id": "ta-9-15-151",
          "chunkNumber": 151,
          "sanskrit": "यो मा ददाति स इदेव मा(३)वाः॒।"
        },
        {
          "id": "ta-9-15-152",
          "chunkNumber": 152,
          "sanskrit": "अ॒हमन्न॒मन्न॑म॒दन्त॒मा(३)द्मि॒।"
        },
        {
          "id": "ta-9-15-153",
          "chunkNumber": 153,
          "sanskrit": "अ॒हव्ँविश्व॒म्भुव॑न॒मभ्य॑भ॒वाम्।"
        },
        {
          "id": "ta-9-15-154",
          "chunkNumber": 154,
          "sanskrit": "सुव॒र्न ज्योतीः᳚॥"
        },
        {
          "id": "ta-9-15-155",
          "chunkNumber": 155,
          "sanskrit": "य ए॒वव्ँवेद॑॥"
        },
        {
          "id": "ta-9-15-156",
          "chunkNumber": 156,
          "sanskrit": "इत्यु॑प॒निष॑त्"
        }
      ]
    }
  ]
}
