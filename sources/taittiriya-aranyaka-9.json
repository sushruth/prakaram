        {
          "id": "ta-9-15-42",
          "chunkNumber": 42,
          "sanskrit": "तꣳ हो॑वाच।"
        },
        {
          "id": "ta-9-15-43",
          "chunkNumber": 43,
          "sanskrit": "तप॑सा॒ ब्रह्म॒ विजि॑ज्ञासस्व।"
        },
        {
          "id": "ta-9-15-44",
          "chunkNumber": 44,
          "sanskrit": "तपो॒ ब्रह्मेति॑।"
        },
        {
          "id": "ta-9-15-45",
