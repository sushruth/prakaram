      "id": "taittiriya-aranyaka-9-15",
      "title": "Prapāṭhaka 9 · Anuvāka 15",
      "sectionNumber": 15,
      "chunks": [
        {
          "id": "ta-9-15-1",
          "chunkNumber": 1,
          "sanskrit": "भृगु॒र्वै वा॑रु॒णिः।",
          "section": 15
        },
        {
          "id": "ta-9-15-2",
          "chunkNumber": 2,
          "sanskrit": "वरु॑ण॒म्पित॑र॒मुप॑ससार।"
        },
        {
          "id": "ta-9-15-3",
          "chunkNumber": 3,
          "sanskrit": "अधी॑हि भगवो॒ ब्रह्मेति॑॥"
        },
        {
          "id": "ta-9-15-4",
          "chunkNumber": 4,
          "sanskrit": "तस्मा॑ ए॒तत्प्रो॑वाच।"
        },
        {
          "id": "ta-9-15-5",
          "chunkNumber": 5,
          "sanskrit": "अन्न॑म्प्रा॒णञ्चख्षु॒श्श्रोत्र॒म्मनो॒ वाच॒मिति॑॥"
        },
        {
          "id": "ta-9-15-6",
          "chunkNumber": 6,
          "sanskrit": "तꣳ हो॑वाच।"
        },
        {
          "id": "ta-9-15-7",
          "chunkNumber": 7,
          "sanskrit": "यतो॒ वा इ॒मानि॒ भूता॑नि॒ जाय॑न्ते।"
        },
        {
          "id": "ta-9-15-8",
          "chunkNumber": 8,
          "sanskrit": "येन॒ जाता॑नि॒ जीव॑न्ति।"
        },
        {
          "id": "ta-9-15-9",
          "chunkNumber": 9,
          "sanskrit": "यत्प्रय॑न्त्य॒भिसव्ँवि॑शन्ति।"
        },
        {
          "id": "ta-9-15-10",
          "chunkNumber": 10,
          "sanskrit": "तद्विजि॑ज्ञासस्व।"
        },
        {
          "id": "ta-9-15-11",
          "chunkNumber": 11,
          "sanskrit": "तद्ब्रह्मेति॑॥"
        },
        {
          "id": "ta-9-15-12",
          "chunkNumber": 12,
          "sanskrit": "स तपो॑ऽतप्यत।"
        },
        {
          "id": "ta-9-15-13",
          "chunkNumber": 13,
          "sanskrit": "स तप॑स्त॒प्त्वा अन्न॒म्ब्रह्मेति॒ व्य॑जानात्।"
        },
        {
          "id": "ta-9-15-14",
          "chunkNumber": 14,
          "sanskrit": "अ॒न्नाद्ध्ये॑व खल्वि॒मानि॒ भूता॑नि॒ जाय॑न्ते।"
        },
        {
          "id": "ta-9-15-15",
          "chunkNumber": 15,
          "sanskrit": "अन्ने॑न॒ जाता॑नि॒ जीव॑न्ति।"
        },
        {
          "id": "ta-9-15-16",
          "chunkNumber": 16,
          "sanskrit": "अन्न॒म्प्रय॑न्त्य॒भिसव्ँवि॑श॒न्तीति॑॥"
        },
        {
          "id": "ta-9-15-17",
          "chunkNumber": 17,
          "sanskrit": "तद्वि॒ज्ञाय॑।"
        },
        {
          "id": "ta-9-15-18",
          "chunkNumber": 18,
          "sanskrit": "पुन॑रे॒व वरु॑ण॒म्पित॑र॒मुप॑ससार।"
        },
        {
          "id": "ta-9-15-19",
          "chunkNumber": 19,
          "sanskrit": "अधी॑हि भगवो॒ ब्रह्मेति॑।"
        },
        {
          "id": "ta-9-15-20",
          "chunkNumber": 20,
          "sanskrit": "तꣳ हो॑वाच।"
        },
        {
          "id": "ta-9-15-21",
          "chunkNumber": 21,
          "sanskrit": "तप॑सा॒ ब्रह्म॒ विजि॑ज्ञासस्व।"
        },
        {
          "id": "ta-9-15-22",
          "chunkNumber": 22,
          "sanskrit": "तपो॒ ब्रह्मेति॑।"
        },
        {
          "id": "ta-9-15-23",
          "chunkNumber": 23,
          "sanskrit": "स तपो॑ऽतप्यत।"
        },
        {
          "id": "ta-9-15-24",
          "chunkNumber": 24,
          "sanskrit": "स तप॑स्त॒प्त्वा प्रा॒णो ब्र॒ह्मेति॒ व्य॑जानात्।"
        },
        {
          "id": "ta-9-15-25",
          "chunkNumber": 25,
          "sanskrit": "प्रा॒णाद्ध्ये॑व खल्वि॒मानि॒ भूता॑नि॒ जाय॑न्ते।"
        },
        {
          "id": "ta-9-15-26",
          "chunkNumber": 26,
          "sanskrit": "प्रा॒णेन॒ जाता॑नि॒ जीव॑न्ति।"
        },
        {
          "id": "ta-9-15-27",
          "chunkNumber": 27,
          "sanskrit": "प्रा॒णम्प्रय॑न्त्य॒भिसव्ँवि॑श॒न्तीति॑॥"
        },
        {
          "id": "ta-9-15-28",
