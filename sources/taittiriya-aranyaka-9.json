          "sanskrit": "स तपो॑ऽतप्यत।"
        },
        {
          "id": "ta-9-15-35",
          "chunkNumber": 35,
          "sanskrit": "स तप॑स्त॒प्त्वा मनो॒ ब्रह्मेति॒ व्य॑जानात्।"
        },
        {
          "id": "ta-9-15-36",
          "chunkNumber": 36,
          "sanskrit": "मन॑सो॒ ह्ये॑व खल्वि॒मानि॒ भूता॑नि॒ जाय॑न्ते।"
        },
        {
          "id": "ta-9-15-37",
          "chunkNumber": 37,
          "sanskrit": "मन॑सा॒ जाता॑नि॒ जीव॑न्ति।"
        },
        {
          "id": "ta-9-15-38",
          "chunkNumber": 38,
          "sanskrit": "मनः॒ प्रय॑न्त्य॒भिसव्ँवि॑श॒न्तीति॑॥"
        },
        {
          "id": "ta-9-15-39",
          "chunkNumber": 39,
          "sanskrit": "तद्वि॒ज्ञाय॑।"
        },
        {
          "id": "ta-9-15-40",
          "chunkNumber": 40,
          "sanskrit": "पुन॑रे॒व वरु॑ण॒म्पित॑र॒मुप॑ससार।"
