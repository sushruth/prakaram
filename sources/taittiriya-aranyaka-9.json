          "sanskrit": "स तपो॑ऽतप्यत।"
        },
        {
          "id": "ta-9-15-46",
          "chunkNumber": 46,
          "sanskrit": "स तप॑स्त॒प्त्वा वि॒ज्ञानं॒ ब्रह्मेति॒ व्य॑जानात्।"
        },
        {
          "id": "ta-9-15-47",
          "chunkNumber": 47,
          "sanskrit": "वि॒ज्ञाना॒द्ध्ये॑व खल्वि॒मानि॒ भूता॑नि॒ जाय॑न्ते।"
        },
        {
          "id": "ta-9-15-48",
          "chunkNumber": 48,
          "sanskrit": "वि॒ज्ञाने॑न॒ जाता॑नि॒ जीव॑न्ति।"
        },
        {
          "id": "ta-9-15-49",
          "chunkNumber": 49,
          "sanskrit": "वि॒ज्ञान॒म्प्रय॑न्त्य॒भिसव्ँवि॑श॒न्तीति॑॥"
        },
        {
          "id": "ta-9-15-50",
          "chunkNumber": 50,
          "sanskrit": "तद्वि॒ज्ञाय॑।"
        },
        {
          "id": "ta-9-15-51",
          "chunkNumber": 51,
          "sanskrit": "पुन॑रे॒व वरु॑ण॒म्पित॑र॒मुप॑ससार।"
        },
        {
          "id": "ta-9-15-52",
          "chunkNumber": 52,
          "sanskrit": "अधी॑हि भगवो॒ ब्रह्मेति॑।"
        },
        {
          "id": "ta-9-15-53",
          "chunkNumber": 53,
          "sanskrit": "तꣳ हो॑वाच।"
        },
        {
          "id": "ta-9-15-54",
          "chunkNumber": 54,
          "sanskrit": "तप॑सा॒ ब्रह्म॒ विजि॑ज्ञासस्व।"
        },
        {
          "id": "ta-9-15-55",
          "chunkNumber": 55,
          "sanskrit": "तपो॒ ब्रह्मेति॑।"
        },
        {
          "id": "ta-9-15-56",
          "chunkNumber": 56,
          "sanskrit": "स तपो॑ऽतप्यत।"
        },
        {
          "id": "ta-9-15-57",
          "chunkNumber": 57,
          "sanskrit": "स तप॑स्त॒प्त्वा आ॒न॒न्दो ब्र॒ह्मेति॒ व्य॑जानात्।"
        },
        {
          "id": "ta-9-15-58",
          "chunkNumber": 58,
          "sanskrit": "आ॒नन्दा॒द्ध्ये॑व खल्वि॒मानि॒ भूता॑नि॒ जाय॑न्ते।"
        },
        {
          "id": "ta-9-15-59",
          "chunkNumber": 59,
          "sanskrit": "आ॒न॒न्देन॒ जाता॑नि॒ जीव॑न्ति।"
        },
        {
          "id": "ta-9-15-60",
          "chunkNumber": 60,
          "sanskrit": "आ॒न॒न्दम्प्रय॑न्त्य॒भिसव्ँवि॑श॒न्तीति॑॥"
        },
        {
          "id": "ta-9-15-61",
          "chunkNumber": 61,
          "sanskrit": "सैषा भा᳚र्ग॒वी वा॑रु॒णी वि॒द्या।"
        },
        {
          "id": "ta-9-15-62",
          "chunkNumber": 62,
          "sanskrit": "प॒र॒मे व्यो॑म॒न्प्रति॑ष्ठिता॥"
        },
        {
          "id": "ta-9-15-63",
          "chunkNumber": 63,
          "sanskrit": "य ए॒वव्ँवेद॒ प्रति॑तिष्ठति।"
        },
        {
          "id": "ta-9-15-64",
          "chunkNumber": 64,
          "sanskrit": "अन्न॑वानन्ना॒दो भ॑वति।"
        },
        {
          "id": "ta-9-15-65",
          "chunkNumber": 65,
          "sanskrit": "म॒हान्भ॑वति प्र॒जया॑ प॒शुभि॑र्ब्रह्मवर्च॒सेन॑।"
        },
        {
          "id": "ta-9-15-66",
          "chunkNumber": 66,
          "sanskrit": "म॒हान्की॒र्त्या अन्न॒न्न नि॑न्द्यात्।"
        },
        {
          "id": "ta-9-15-67",
          "chunkNumber": 67,
          "sanskrit": "तद्व्र॒तम्॥"
        },
        {
          "id": "ta-9-15-68",
          "chunkNumber": 68,
          "sanskrit": "प्रा॒णो वा अन्न᳚म्।"
        },
        {
          "id": "ta-9-15-69",
          "chunkNumber": 69,
          "sanskrit": "शरी॑रमन्ना॒दम्।"
        },
        {
          "id": "ta-9-15-70",
          "chunkNumber": 70,
          "sanskrit": "प्रा॒णे शरी॑र॒म्प्रति॑ष्ठितम्।"
        },
        {
          "id": "ta-9-15-71",
          "chunkNumber": 71,
          "sanskrit": "शरी॑रे प्रा॒णः प्रति॑ष्ठितः।"
        },
        {
          "id": "ta-9-15-72",
          "chunkNumber": 72,
          "sanskrit": "तदे॒तदन्न॒मन्ने॒ प्रति॑ष्ठितम्॥"
        },
        {
          "id": "ta-9-15-73",
          "chunkNumber": 73,
          "sanskrit": "स य ए॒तदन्न॒मन्ने॒ प्रति॑ष्ठित॒व्ँवेद॒ प्रति॑तिष्ठति।"
        },
        {
          "id": "ta-9-15-74",
          "chunkNumber": 74,
          "sanskrit": "अन्न॑वानन्ना॒दो भ॑वति।"
        },
        {
          "id": "ta-9-15-75",
          "chunkNumber": 75,
          "sanskrit": "म॒हान्भ॑वति प्र॒जया॑ प॒शुभि॑र्ब्रह्मवर्च॒सेन॑।"
        },
        {
          "id": "ta-9-15-76",
          "chunkNumber": 76,
          "sanskrit": "म॒हान्की॒र्त्या अन्न॒न्न परि॑चख्षीत।"
        },
        {
          "id": "ta-9-15-77",
          "chunkNumber": 77,
          "sanskrit": "तद्व्र॒तम्।"
        },
        {
          "id": "ta-9-15-78",
          "chunkNumber": 78,
          "sanskrit": "आपो॒ वा अन्न᳚म्।"
        },
        {
          "id": "ta-9-15-79",
          "chunkNumber": 79,
          "sanskrit": "ज्योति॑रन्ना॒दम्।"
        },
        {
          "id": "ta-9-15-80",
          "chunkNumber": 80,
          "sanskrit": "अ॒फ्सु ज्योतिः॒ प्रति॑ष्ठितम्।"
        },
        {
          "id": "ta-9-15-81",
          "chunkNumber": 81,
          "sanskrit": "ज्योति॒ष्यापः॒ प्रति॑ष्ठिताः।"
        },
        {
          "id": "ta-9-15-82",
          "chunkNumber": 82,
          "sanskrit": "तदे॒तदन्न॒मन्ने॒ प्रति॑ष्ठितम्॥"
        },
        {
          "id": "ta-9-15-83",
          "chunkNumber": 83,
          "sanskrit": "स य ए॒तदन्न॒मन्ने॒ प्रति॑ष्ठित॒व्ँवेद॒ प्रति॑तिष्ठति।"
        },
        {
          "id": "ta-9-15-84",
          "chunkNumber": 84,
          "sanskrit": "अन्न॑वानन्ना॒दो भ॑वति।"
        },
        {
          "id": "ta-9-15-85",
          "chunkNumber": 85,
          "sanskrit": "म॒हान्भ॑वति प्र॒जया॑ प॒शुभि॑र्ब्रह्मवर्च॒सेन॑।"
        },
        {
          "id": "ta-9-15-86",
          "chunkNumber": 86,
          "sanskrit": "म॒हान्कीर्त्या अन्न॑म्ब॒हु कु॑र्वीत।"
        },
        {
          "id": "ta-9-15-87",
          "chunkNumber": 87,
          "sanskrit": "तद्व्र॒तम्॥"
        },
        {
          "id": "ta-9-15-88",
          "chunkNumber": 88,
          "sanskrit": "पृ॒थि॒वी वा अन्न᳚म्।"
        },
        {
          "id": "ta-9-15-89",
          "chunkNumber": 89,
          "sanskrit": "आ॒का॒शो᳚ऽन्ना॒दः।"
