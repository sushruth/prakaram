          "sanskrit": "diśaḥ̠ pādaḥ̍|"
        },
        {
          "id": "ta-1-25-31",
          "chunkNumber": 31,
          "sanskrit": "pa̠rora̍jāḥ̠ pādaḥ̍||"
        },
        {
