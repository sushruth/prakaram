        {
          "id": "ta-1-25-17",
          "chunkNumber": 17,
          "sanskrit": "sa̠ha sa̍ñcaska̠rarddhi̍yā̠ iti̍|"
        },
        {
          "id": "ta-1-25-18",
          "chunkNumber": 18,
          "sanskrit": "vā̠yvaśvā̍ raśmi̠pata̍yaḥ§·11·||"
