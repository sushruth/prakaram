          "sanskrit": "kū̠rmamupa̍dadhāti|"
        },
        {
          "id": "ta-1-25-12",
          "chunkNumber": 12,
          "sanskrit": "a̠pāme̠va medha̠mava̍rundhe|"
        },
        {
          "id": "ta-1-25-13",
          "chunkNumber": 13,
