          "chunkNumber": 20,
          "sanskrit": "kama̠gniñci̍nute|"
        },
        {
          "id": "ta-1-26-21",
          "chunkNumber": 21,
          "sanskrit": "i̠mamā̍ruṇaketuka ma̠gniñci̍nvā̠na iti̍||"
