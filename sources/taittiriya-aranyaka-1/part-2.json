          "id": "ta-1-25-25",
          "chunkNumber": 25,
          "sanskrit": "lo̠kaṃ pṛ̍ṇayā dvi̠tīyā̠mupa̍dadhāti|"
        },
        {
          "id": "ta-1-25-26",
          "chunkNumber": 26,
          "sanskrit": "pañca̍padā̠ vai vi̠rāṭ|"
        },
        {
          "id": "ta-1-25-27",
