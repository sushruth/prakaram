          "chunkNumber": 3,
          "sanskrit": "a̠pāgͫ sa̍rva̠tvāya̍|"
        },
        {
          "id": "ta-1-25-4",
          "chunkNumber": 4,
          "sanskrit": "pu̠ṣka̠ra̠pa̠rṇagͫ ru̠kmaṃ puru̍ṣa̠mityupa̍dadhāti|"
        },
        {
          "id": "ta-1-25-5",
          "chunkNumber": 5,
          "sanskrit": "tapo̠ vai pu̍ṣkarapa̠rṇam|"
        },
        {
