          "sanskrit": "āpa̍māpāma̠paḥ sarvāḥ̎|"
        },
        {
          "id": "ta-1-25-15",
          "chunkNumber": 15,
          "sanskrit": "a̠smāda̠smā di̠to'mutaḥ̍|"
        },
        {
          "id": "ta-1-25-16",
          "chunkNumber": 16,
          "sanskrit": "a̠gnirvā̠yuśca̠ sūrya̍śca|"
