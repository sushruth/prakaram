{
  "sections": [
    {
      "id": "taittiriya-aranyaka-1-24",
      "title": "Prapāṭhaka 1 · Anuvāka 24",
      "sectionNumber": 24,
      "chunks": [
        {
          "id": "ta-1-24-1",
          "chunkNumber": 1,
          "sanskrit": "catu̍ṣṭayya̠ āpo̍ gṛhṇāti|",
          "section": 24
        },
        {
          "id": "ta-1-24-2",
          "chunkNumber": 2,
          "sanskrit": "ca̠tvāri̠ vā a̠pāgͫ rū̠pāṇi̍|"
        },
        {
          "id": "ta-1-24-3",
          "chunkNumber": 3,
          "sanskrit": "megho̍ vi̠dyut|"
        },
        {
          "id": "ta-1-24-4",
          "chunkNumber": 4,
          "sanskrit": "sta̠na̠yi̠tnurvṛ̠ṣṭiḥ|"
        },
        {
          "id": "ta-1-24-5",
          "chunkNumber": 5,
          "sanskrit": "tānye̠vā va̍rundhe||"
        },
        {
          "id": "ta-1-24-6",
          "chunkNumber": 6,
          "sanskrit": "ā̠tapa̍ti̠ varṣyā̍ gṛhṇāti|"
        },
        {
          "id": "ta-1-24-7",
          "chunkNumber": 7,
          "sanskrit": "tāḥ pu̠rastā̠dupa̍dadhāti|"
        },
        {
          "id": "ta-1-24-8",
          "chunkNumber": 8,
          "sanskrit": "e̠tā vai bra̍hmavarca̠syā āpaḥ̍|"
        },
        {
          "id": "ta-1-24-9",
          "chunkNumber": 9,
          "sanskrit": "mu̠kha̠ta e̠va bra̍hmavarca̠samava̍rundhe|"
        },
        {
          "id": "ta-1-24-10",
          "chunkNumber": 10,
          "sanskrit": "tasmā̎nmukha̠to bra̍hmavarca̠sita̍raḥ kūpyā̍ gṛhṇāti|"
        },
        {
          "id": "ta-1-24-11",
          "chunkNumber": 11,
          "sanskrit": "tā da̍khṣiṇa̠ta upa̍dadhāti|"
        },
        {
          "id": "ta-1-24-12",
          "chunkNumber": 12,
          "sanskrit": "e̠tā vai te̍ja̠svinī̠rāpaḥ̍|"
        },
        {
          "id": "ta-1-24-13",
          "chunkNumber": 13,
          "sanskrit": "teja̍ e̠vāsya̍ dakhṣiṇa̠to da̍dhāti|"
        },
        {
          "id": "ta-1-24-14",
          "chunkNumber": 14,
          "sanskrit": "tasmā̠d dakhṣi̠ṇodrdha̍ 'steja̠svita̍raḥ||"
        },
        {
          "id": "ta-1-24-15",
          "chunkNumber": 15,
          "sanskrit": "sthā̠va̠rā gṛ̍hṇāti|"
        },
        {
          "id": "ta-1-24-16",
          "chunkNumber": 16,
          "sanskrit": "tāḥ pa̠ścādupa̍dadhāti|"
        },
        {
          "id": "ta-1-24-17",
          "chunkNumber": 17,
          "sanskrit": "prati̍ṣṭhitā̠ vai sthā̍va̠rāḥ|"
        },
        {
          "id": "ta-1-24-18",
          "chunkNumber": 18,
          "sanskrit": "pa̠ścāde̠va prati̍tiṣṭhati||"
        },
        {
          "id": "ta-1-24-19",
          "chunkNumber": 19,
          "sanskrit": "vaha̍ntīr gṛhṇāti tā u̍ttara̠ta upa̍dadhāti|"
        },
        {
          "id": "ta-1-24-20",
          "chunkNumber": 20,
          "sanskrit": "oja̍sā̠ vā e̠tā vaha̍ntīri̠vodga̍tīri̠va ākūja̍tīri̠va dhāva̍ntīḥ|"
        },
        {
          "id": "ta-1-24-21",
          "chunkNumber": 21,
          "sanskrit": "oja̍ e̠vāsyo̎ttara̠to da̍dhāti|"
        },
        {
          "id": "ta-1-24-22",
          "chunkNumber": 22,
          "sanskrit": "tasmā̠dutta̠ro'ddha̍ oja̠svita̍raḥ||"
        },
        {
          "id": "ta-1-24-23",
          "chunkNumber": 23,
          "sanskrit": "sa̠bhāṃ̠ryā gṛ̍hṇāti|"
        },
        {
          "id": "ta-1-24-24",
          "chunkNumber": 24,
          "sanskrit": "tā maddhya̠ upa̍dadhāti|"
        },
        {
          "id": "ta-1-24-25",
          "chunkNumber": 25,
          "sanskrit": "i̠yavm̐vai sa̍bhāṃ̠ryāḥ|"
        },
        {
          "id": "ta-1-24-26",
          "chunkNumber": 26,
          "sanskrit": "a̠syāme̠va prati̍tiṣṭhati||"
        },
        {
          "id": "ta-1-24-27",
          "chunkNumber": 27,
          "sanskrit": "pa̠lva̠lyā gṛ̍hṇāti|"
        },
        {
          "id": "ta-1-24-28",
          "chunkNumber": 28,
          "sanskrit": "tā u̠pari̍ṣṭādu̠pāda̍dhāti a̠sau vai pa̍lva̠lyāḥ|"
        },
        {
          "id": "ta-1-24-29",
          "chunkNumber": 29,
          "sanskrit": "a̠muṣyā̍me̠va prati̍tiṣṭhati||"
        },
        {
          "id": "ta-1-24-30",
          "chunkNumber": 30,
          "sanskrit": "di̠khṣūpa̍dadhāti|"
        },
        {
          "id": "ta-1-24-31",
          "chunkNumber": 31,
          "sanskrit": "di̠khṣu vā āpaḥ̍|"
        },
        {
          "id": "ta-1-24-32",
          "chunkNumber": 32,
          "sanskrit": "anna̠vm̐vā āpaḥ̍|"
        },
        {
          "id": "ta-1-24-33",
          "chunkNumber": 33,
          "sanskrit": "a̠dbhyo vā anna̍ñjāyate|"
        },
        {
          "id": "ta-1-24-34",
          "chunkNumber": 34,
          "sanskrit": "yade̠vādbhyo'nnaṃ̠ jāya̍te|"
        },
        {
          "id": "ta-1-24-35",
          "chunkNumber": 35,
          "sanskrit": "tadava̍rundhe||"
        },
        {
          "id": "ta-1-24-36",
          "chunkNumber": 36,
          "sanskrit": "tavm̐vā e̠tama̍ru̠ṇāḥ ke̠tavo̠ vāta̍raśa̠nā ṛṣa̍yo'cinvann|"
        },
        {
          "id": "ta-1-24-37",
          "chunkNumber": 37,
          "sanskrit": "tasmā̍dāruṇa ke̠tukaḥ̍||"
        },
        {
          "id": "ta-1-24-38",
          "chunkNumber": 38,
          "sanskrit": "tade̠ṣā'bhyanū̎ktā||"
        },
        {
          "id": "ta-1-24-39",
          "chunkNumber": 39,
          "sanskrit": "ke̠tavo̠ aru̍ṇāsaśca|"
        },
        {
          "id": "ta-1-24-40",
          "chunkNumber": 40,
          "sanskrit": "ṛ̠ṣa̠yo vāta̍raśa̠nāḥ|"
        },
        {
          "id": "ta-1-24-41",
          "chunkNumber": 41,
          "sanskrit": "pra̠ti̠ṣṭhāgͫ śa̠tadhā̍ hi|"
        },
        {
          "id": "ta-1-24-42",
          "chunkNumber": 42,
          "sanskrit": "sa̠māhi̍tāso sahasra̠dhāya̍sa̠miti̍||"
        },
        {
          "id": "ta-1-24-43",
          "chunkNumber": 43,
          "sanskrit": "śa̠taśa̍ścai̠va 'sa̠hasra̍śaśca̠ prati̍tiṣṭhati|"
        },
        {
          "id": "ta-1-24-44",
          "chunkNumber": 44,
          "sanskrit": "ya e̠tama̠gniñci̍nu̠te|"
        },
        {
          "id": "ta-1-24-45",
          "chunkNumber": 45,
          "sanskrit": "ya u̍cainame̠vavm̐veda̍"
        }
      ]
    },
    {
