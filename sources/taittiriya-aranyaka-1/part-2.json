          "sanskrit": "yanma̠ ājā̍yate̠ punaḥ̍|"
        },
        {
          "id": "ta-1-30-11",
          "chunkNumber": 11,
          "sanskrit": "tena̍ māma̠mṛtaṃ̍ kuru|"
        },
        {
          "id": "ta-1-30-12",
          "chunkNumber": 12,
          "sanskrit": "tena̍ supra̠jasa̍ṅkuru"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-1-31",
      "title": "Prapāṭhaka 1 · Anuvāka 31",
      "sectionNumber": 31,
      "chunks": [
        {
          "id": "ta-1-31-1",
          "chunkNumber": 1,
          "sanskrit": "a̠dbhyastiro̠dhā jā̍yata|",
          "section": 31
        },
        {
          "id": "ta-1-31-2",
          "chunkNumber": 2,
          "sanskrit": "tava̍ vaiśrava̠ṇaḥ sa̍dā|"
        },
        {
          "id": "ta-1-31-3",
          "chunkNumber": 3,
          "sanskrit": "tiro̍ dhehi sapa̠tnānnaḥ̍|"
        },
        {
          "id": "ta-1-31-4",
          "chunkNumber": 4,
          "sanskrit": "ye apo̠'śnanti̍ keca̠na||"
        },
        {
          "id": "ta-1-31-5",
          "chunkNumber": 5,
          "sanskrit": "tvā̠ṣṭrīṃ mā̠yāvm̐va̎śrava̠ṇaḥ|"
        },
        {
          "id": "ta-1-31-6",
          "chunkNumber": 6,
          "sanskrit": "ratha̍gͫ sahasra̠ vandhu̍ram|"
        },
        {
          "id": "ta-1-31-7",
          "chunkNumber": 7,
          "sanskrit": "pu̠ru̠śca̠kragͫ saha̍srāśvam|"
        },
        {
          "id": "ta-1-31-8",
          "chunkNumber": 8,
          "sanskrit": "āsthā̠ yāyā̍hi no ba̠lim||"
        },
        {
          "id": "ta-1-31-9",
          "chunkNumber": 9,
          "sanskrit": "yasmai̍ bhū̠tāni̍ ba̠limāva̍hanti|"
        },
        {
          "id": "ta-1-31-10",
          "chunkNumber": 10,
          "sanskrit": "dhana̠ṅgāvo̠ hasti̠ hira̍ṇya̠maśvā̍n asā̍ma suma̠tau ya̠jñiya̍sya|"
        },
        {
          "id": "ta-1-31-11",
          "chunkNumber": 11,
          "sanskrit": "śriyaṃ̠ bibhra̠to 'nna̍mukhīvm̐vi̠rāja̎m||"
        },
        {
          "id": "ta-1-31-12",
          "chunkNumber": 12,
          "sanskrit": "su̠da̠r̠śa̠ne ca̍ krau̠ñce ca̍|"
        },
        {
          "id": "ta-1-31-13",
          "chunkNumber": 13,
          "sanskrit": "mai̠nā̠ge ca̍ ma̠hāgi̍rau|"
        },
        {
          "id": "ta-1-31-14",
          "chunkNumber": 14,
          "sanskrit": "śa̠tadvā̠ṭṭara̍gama̠ntā (sa̠tadvā̠ṭṭara̍gama̠ntā)|"
        },
        {
          "id": "ta-1-31-15",
          "chunkNumber": 15,
          "sanskrit": "sa̠g̠ͫhāryaṃ̠ naga̍raṃ̠ tava̍||"
        },
        {
          "id": "ta-1-31-16",
          "chunkNumber": 16,
          "sanskrit": "iti mantrāḥ̎|"
        },
        {
          "id": "ta-1-31-17",
          "chunkNumber": 17,
          "sanskrit": "kalpo̍'ta ū̠drdhvam||"
        },
        {
          "id": "ta-1-31-18",
          "chunkNumber": 18,
          "sanskrit": "yadi̠ bali̠g̠ͫ hare̎t|"
        },
        {
          "id": "ta-1-31-19",
          "chunkNumber": 19,
          "sanskrit": "hi̠ra̠ṇya̠nā̠bhaye̍ vitu̠daye̍ kaube̠rāyā̠yaṃ ba̍liḥ sarvabhūtādhipataye na̍ma i̠ti|"
        },
        {
          "id": "ta-1-31-20",
          "chunkNumber": 20,
          "sanskrit": "atha baligͫ hṛtvopa̍tiṣṭhe̠ta||"
        },
        {
          "id": "ta-1-31-21",
          "chunkNumber": 21,
          "sanskrit": "khṣa̠traṃ khṣa̠travm̐vai̎śrava̠ṇaḥ|"
        },
        {
          "id": "ta-1-31-22",
          "chunkNumber": 22,
          "sanskrit": "brāhmaṇā̍ vaya̠g̠ͫͫ smaḥ|"
        },
        {
          "id": "ta-1-31-23",
          "chunkNumber": 23,
          "sanskrit": "nama̍ste astu̠ mā mā̍ higͫsīḥ|"
        },
        {
          "id": "ta-1-31-24",
          "chunkNumber": 24,
          "sanskrit": "asmāt praviśyānna̍maddhī̠ti||"
        },
        {
          "id": "ta-1-31-25",
          "chunkNumber": 25,
          "sanskrit": "atha tamagnimā̍dadhī̠ta|"
        },
        {
          "id": "ta-1-31-26",
          "chunkNumber": 26,
          "sanskrit": "yasminne tatkarma pra̍yuñjī̠ta||"
        },
        {
          "id": "ta-1-31-27",
          "chunkNumber": 27,
          "sanskrit": "ti̠rodhā̠ bhūḥ|"
        },
        {
          "id": "ta-1-31-28",
          "chunkNumber": 28,
          "sanskrit": "ti̠rodhā̠ bhuvaḥ̍ ti̠rodhāḥ̠ svaḥ̍|"
        },
        {
          "id": "ta-1-31-29",
          "chunkNumber": 29,
          "sanskrit": "ti̠rodhā̠ bhūrbhuva̠ssvaḥ̍|"
        },
        {
          "id": "ta-1-31-30",
          "chunkNumber": 30,
          "sanskrit": "sarveṣālm̐lokānāmādhipatye̍ sīde̠ti||"
        },
        {
          "id": "ta-1-31-31",
          "chunkNumber": 31,
          "sanskrit": "atha tamagni̍mindhī̠ta|"
        },
        {
          "id": "ta-1-31-32",
          "chunkNumber": 32,
          "sanskrit": "yasminne tatkarma pra̍yuñjī̠ta||"
        },
        {
          "id": "ta-1-31-33",
          "chunkNumber": 33,
          "sanskrit": "ti̠rodhā̠ bhūḥ svāhā̎|"
        },
        {
          "id": "ta-1-31-34",
          "chunkNumber": 34,
          "sanskrit": "ti̠rodhā̠ bhuvaḥ̠ svāhā̎|"
        },
        {
          "id": "ta-1-31-35",
          "chunkNumber": 35,
          "sanskrit": "ti̠rodhāḥ̠ svaḥ̍ svāhā̎|"
        },
        {
          "id": "ta-1-31-36",
          "chunkNumber": 36,
          "sanskrit": "ti̠rodhā̠ bhūrbhuva̠ssva̍ssvāhā̎||"
        },
        {
          "id": "ta-1-31-37",
          "chunkNumber": 37,
          "sanskrit": "yasminnasya kāle sarvā āhutīrhutā̍ bhave̠yuḥ api brāhmaṇa̍mukhī̠nāḥ|"
        },
        {
          "id": "ta-1-31-38",
          "chunkNumber": 38,
          "sanskrit": "tasminnahnaḥ kāle pra̍yuñjī̠ta|"
        },
        {
          "id": "ta-1-31-39",
          "chunkNumber": 39,
          "sanskrit": "paraḥ̍ su̠ptaja̍nādve̠pi||"
        },
        {
          "id": "ta-1-31-40",
          "chunkNumber": 40,
          "sanskrit": "mā sma pramādyanta̍ māddhyā̠payet|"
        },
        {
          "id": "ta-1-31-41",
          "chunkNumber": 41,
          "sanskrit": "sarvārthāḥ̎ siddhya̠nte|"
        },
        {
          "id": "ta-1-31-42",
          "chunkNumber": 42,
          "sanskrit": "ya e̍vavm̐ve̠da|"
        },
        {
          "id": "ta-1-31-43",
          "chunkNumber": 43,
          "sanskrit": "khṣuddhyannida̍majā̠natām|"
        },
        {
          "id": "ta-1-31-44",
          "chunkNumber": 44,
          "sanskrit": "sarvārthā na̍ siddhya̠nte||"
        },
        {
          "id": "ta-1-31-45",
          "chunkNumber": 45,
          "sanskrit": "yaste̍ vi̠ghātu̍ko bhrā̠tā|"
        },
        {
          "id": "ta-1-31-46",
          "chunkNumber": 46,
          "sanskrit": "mamāntarhṛ̍daye̠ śritaḥ tasmā̍ i̠mamagra̠ piṇḍa̍ñjuhomi|"
        },
        {
          "id": "ta-1-31-47",
          "chunkNumber": 47,
          "sanskrit": "sa me̎'rthā̠n mā viva̍dhīt|"
        },
        {
          "id": "ta-1-31-48",
          "chunkNumber": 48,
          "sanskrit": "mayi̠ svāhā̎||"
        },
        {
          "id": "ta-1-31-49",
          "chunkNumber": 49,
          "sanskrit": "rā̠jā̠dhi̠rā̠jāya̍ prasahya sā̠hine̎|"
        },
        {
          "id": "ta-1-31-50",
          "chunkNumber": 50,
          "sanskrit": "namo̍ va̠yavm̐vai̎śrava̠ṇāya̍ kurmahe|"
        },
        {
          "id": "ta-1-31-51",
          "chunkNumber": 51,
          "sanskrit": "sa me̠ kāmā̠n kāma̠ kāmā̍ya̠ mahya̎m|"
        },
        {
          "id": "ta-1-31-52",
          "chunkNumber": 52,
          "sanskrit": "kā̠me̠śva̠ro vai̎śrava̠ṇo da̍dātu|"
        },
        {
          "id": "ta-1-31-53",
          "chunkNumber": 53,
          "sanskrit": "ku̠be̠rāya̍ vaiśrava̠ṇāya̍|"
        },
        {
          "id": "ta-1-31-54",
          "chunkNumber": 54,
          "sanskrit": "ma̠hā̠rā̠jāya̠ namaḥ̍|"
        },
        {
          "id": "ta-1-31-55",
          "chunkNumber": 55,
          "sanskrit": "ke̠tavo̠ aru̍ṇāsaśca|"
        },
        {
          "id": "ta-1-31-56",
          "chunkNumber": 56,
          "sanskrit": "ṛ̠ṣa̠yo vāta̍raśa̠nāḥ|"
        },
        {
          "id": "ta-1-31-57",
          "chunkNumber": 57,
          "sanskrit": "pra̠ti̠ṣṭhāgͫ śa̠tadhā̍ hi|"
        },
        {
          "id": "ta-1-31-58",
          "chunkNumber": 58,
          "sanskrit": "sa̠māhi̍tāso sahasra̠dhāya̍sam|"
        },
        {
          "id": "ta-1-31-59",
          "chunkNumber": 59,
          "sanskrit": "śi̠vā naḥ̠ śanta̍mā bhavantu|"
        },
        {
          "id": "ta-1-31-60",
          "chunkNumber": 60,
          "sanskrit": "di̠vyā āpa̠ oṣa̍dhayaḥ|"
        },
        {
          "id": "ta-1-31-61",
          "chunkNumber": 61,
          "sanskrit": "su̠mṛ̠ḍī̠kā sara̍svati|"
        },
        {
          "id": "ta-1-31-62",
          "chunkNumber": 62,
          "sanskrit": "mā te̠ vyo̍ma sa̠ndṛśi̍"
        }
      ]
    },
    {
      "id": "taittiriya-aranyaka-1-32",
      "title": "Prapāṭhaka 1 · Anuvāka 32",
      "sectionNumber": 32,
      "chunks": [
        {
          "id": "ta-1-32-1",
          "chunkNumber": 1,
          "sanskrit": "savm̐vathsarameta̍d vrata̠ñcaret|",
          "section": 32
        },
        {
          "id": "ta-1-32-2",
          "chunkNumber": 2,
          "sanskrit": "dvau̍ vā mā̠sau||"
        },
        {
          "id": "ta-1-32-3",
          "chunkNumber": 3,
          "sanskrit": "niyamaḥ sa̍māse̠na||"
        },
        {
          "id": "ta-1-32-4",
          "chunkNumber": 4,
          "sanskrit": "tasmin niyama̍ viśe̠ṣāḥ|"
        },
        {
          "id": "ta-1-32-5",
          "chunkNumber": 5,
          "sanskrit": "triṣavaṇamudako̍paspa̠r̠śī|"
        },
        {
          "id": "ta-1-32-6",
          "chunkNumber": 6,
          "sanskrit": "caturtha kālapāna̍bhaktaḥ̠ syāt|"
        },
        {
          "id": "ta-1-32-7",
          "chunkNumber": 7,
          "sanskrit": "aharaharvā bhaikhṣa̍maśna̠yāt|"
        },
        {
          "id": "ta-1-32-8",
          "chunkNumber": 8,
          "sanskrit": "audumbarībhiḥ samidbhiragniṃ̍ pari̠caret|"
        },
        {
          "id": "ta-1-32-9",
          "chunkNumber": 9,
          "sanskrit": "punarmā maitvindriyamityetenā'nu̍vāke̠na|"
        },
        {
          "id": "ta-1-32-10",
          "chunkNumber": 10,
          "sanskrit": "uddhṛta paripūtābhiradbhiḥ kāryaṃ̍ kurvī̠ta a̍sañca̠yavān|"
        },
        {
          "id": "ta-1-32-11",
          "chunkNumber": 11,
          "sanskrit": "agnaye vāyave̍ sūryā̠ya|"
        },
        {
          "id": "ta-1-32-12",
          "chunkNumber": 12,
          "sanskrit": "brahmaṇe pra̍jāpa̠taye|"
        },
        {
          "id": "ta-1-32-13",
          "chunkNumber": 13,
          "sanskrit": "candramase na̍khṣatre̠bhyaḥ|"
        },
        {
          "id": "ta-1-32-14",
          "chunkNumber": 14,
          "sanskrit": "ṛtubhyaḥ savm̐va̍thsarā̠ya|"
        },
        {
          "id": "ta-1-32-15",
          "chunkNumber": 15,
          "sanskrit": "varuṇāyāruṇāyeti vra̍taho̠māḥ|"
        },
        {
          "id": "ta-1-32-16",
          "chunkNumber": 16,
          "sanskrit": "pra̠va̠rgyava̍dāde̠śaḥ|"
        },
        {
          "id": "ta-1-32-17",
          "chunkNumber": 17,
          "sanskrit": "aruṇāḥ kā̎ṇḍa ṛ̠ṣayaḥ||"
        },
        {
          "id": "ta-1-32-18",
          "chunkNumber": 18,
          "sanskrit": "araṇye̍'dhīyī̠rann|"
        },
        {
          "id": "ta-1-32-19",
          "chunkNumber": 19,
          "sanskrit": "bhadraṃkarṇebhiriti dve̍ japi̠tvā mahānāmnībhirudakagͫ sa̍gͫͫspa̠rśya|"
        },
        {
          "id": "ta-1-32-20",
          "chunkNumber": 20,
          "sanskrit": "tamācā̎ryo da̠dyāt|"
        },
        {
          "id": "ta-1-32-21",
          "chunkNumber": 21,
          "sanskrit": "śivānaḥ śantametyoṣadhī̍rāla̠bhate|"
        },
        {
          "id": "ta-1-32-22",
          "chunkNumber": 22,
          "sanskrit": "sumṛḍīke̍ti bhū̠mim|"
        },
        {
          "id": "ta-1-32-23",
          "chunkNumber": 23,
          "sanskrit": "evama̍pava̠rge|"
        },
        {
          "id": "ta-1-32-24",
          "chunkNumber": 24,
          "sanskrit": "dhe̍nur da̠khṣiṇā|"
        },
        {
          "id": "ta-1-32-25",
          "chunkNumber": 25,
          "sanskrit": "kagͫ savm̐vāsa̍śca khṣau̠mam|"
        },
        {
          "id": "ta-1-32-26",
          "chunkNumber": 26,
          "sanskrit": "anya̍dvā śu̠klam|"
        },
        {
          "id": "ta-1-32-27",
          "chunkNumber": 27,
          "sanskrit": "ya̍thā śa̠kti vā|"
        },
        {
          "id": "ta-1-32-28",
          "chunkNumber": 28,
          "sanskrit": "evagͫͫ svāddhyāya̍ dharme̠ṇa|"
        },
        {
          "id": "ta-1-32-29",
          "chunkNumber": 29,
          "sanskrit": "araṇye̍'dhīyī̠ta|"
        },
        {
          "id": "ta-1-32-30",
          "chunkNumber": 30,
          "sanskrit": "tapasvī puṇyo bhavati tapasvī pu̍ṇyo bha̠vati"
        }
      ]
    }
  ]
}
