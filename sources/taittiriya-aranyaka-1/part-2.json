          "chunkNumber": 17,
          "sanskrit": "kama̠gniñci̍nute|"
        },
        {
          "id": "ta-1-26-18",
          "chunkNumber": 18,
          "sanskrit": "vai̠śva̠sṛ̠ja ma̠gniñci̍nvā̠naḥ|"
        },
        {
          "id": "ta-1-26-19",
          "chunkNumber": 19,
          "sanskrit": "kama̠gniñci̍nute u̠pā̠nu̠vā̠kya̍mā̠śu ma̠gniñci̍nvā̠naḥ|"
